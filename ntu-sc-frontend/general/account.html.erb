<div class="modal fade" id="addEducationModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addEducationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="addEducationModalLabel">新增學歷</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group mb-3">
                    <label for="educationSchoolName" class="form-label">學校名稱</label>
                    <input type="text" class="form-control" id="educationSchoolName">
                </div>
                <div class="form-group mb-3">
                    <label for="educationCountry" class="form-label">國別</label>
                    <input type="text" class="form-control" id="educationCountry">
                </div>
                <div class="form-group mb-3">
                    <label for="educationMajor" class="form-label">主修學門系所</label>
                    <input type="text" class="form-control" id="educationMajor">
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">學位</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="educationDegree" id="degreeDoctorate" value="博士">
                            <label class="form-check-label" for="degreeDoctorate">博士</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="educationDegree" id="degreeMaster" value="碩士">
                            <label class="form-check-label" for="degreeMaster">碩士</label>
