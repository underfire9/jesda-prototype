<!-- template: 學生 / 討論列表 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>討論列表</h3>
        </div>
        <div class="row g-3 discuss-list">
            <% (1..5).map do |i| %>
            <div class="col-lg-4 col-md-6 discuss-list-item">
                <a href="#" class="item-link">
                    <span class="num"></span>
                    <div class="mb-2">
                        <h4><%= lorem_sentence %></h4>
                        <span class="date d-block fs-6 text-muted">2026-05-0<%= i %> 12:00</span>
                    </div>
                    <div class="my-3">回應數 <strong class="ms-2">2</strong></div>
                    <div>討論 <i class="fas fa-long-arrow-alt-right fs-6 ms-2"></i></div>
                </a>
            </div>
            <% end %>
        </div>
        <div class="form-action">
            <span class="backhome">
                <a href="#" class="btn btn-light"><i class="fas fa-long-arrow-alt-left"></i> 回列表</a>
            </span>
        </div>
    </div>
</div>



