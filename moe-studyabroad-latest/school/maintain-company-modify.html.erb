                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="newMeetingRecordDate" class="form-label">審核通過會議紀錄日期</label>
                                                        <input type="date" id="newMeetingRecordDate" class="form-control">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="newMeetingRecordHost" class="form-label">會議主持人</label>
                                                        <input type="text" id="newMeetingRecordHost" class="form-control" placeholder="請輸入">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="attached-item">
                                            <h6 class="fw-bold mb-3">2. 實習機構同意書或合作契約書影本</h6>
                                            <div class="contract-wrapper">
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="checkbox" value="" id="newHasContract">
                                                    <label class="form-check-label" for="newHasContract">
                                                        契約書中實習期間尚未過期
                                                    </label>
                                                </div>
                                                <div class="contract-textarea">
                                                    <textarea class="form-control" rows="3" placeholder="如未勾選實習期間尚未過期，需填寫此處說明"></textarea>
                                                </div>
                                            </div>
                                            <div class="form-check mb-2 mt-4">
                                                <input class="form-check-input" type="checkbox" value="" id="newHasContractStamped">
                                                <label class="form-check-label" for="newHasContractStamped">
                                                    確認契約書中已用印
                                                </label>
                                            </div>
                                            <div class="form-text">若國外實習機構確實無印章可提供用印，需由計畫主持人另提書面說明，因配合國外實習機構無印章，故該國外實習機構以簽名代替，由計畫主持人提供書面說明並無誤後簽名，上傳說明檔案。</div>
                                        </div>
                                        <div class="attached-item">
                                            <h6 class="fw-bold mb-3">3. 新實習機構詳細介紹</h6>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-target="#modifyModal" data-bs-toggle="modal">取消</button>

                <!-- 送出後畫面同樣回到上一個 modal -->
                <button type="submit" class="btn btn-primary" data-bs-target="#modifyModal" data-bs-toggle="modal">送出</button>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>
<!-- 編號 -->
<script>
    document.querySelectorAll('.company-modify-wrapper .company-card').forEach(function(card, i) {
        card.querySelector('.card-bd').dataset.index = i + 1;
    });
</script>

<!-- Bootstrap tooltip -->
<script>
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
</script>

<!-- 實習國別/區域連動 -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const country = document.querySelector("#internship-country");
        const region = document.querySelector("#internship-region");

        if (!country || !region) return;

        region.disabled = true;

        country.addEventListener("change", () => {
            const hasSelection = country.value && country.value !== "請選擇";
            region.disabled = !hasSelection;
        });
    });
</script>
<% end %>

