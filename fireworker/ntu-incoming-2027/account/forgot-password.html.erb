<% content_for :title do %>Forgot your password?<% end %>
<% content_for :title_key do %>forgot.title<% end %>
<% content_for :page do %>forgot<% end %>

<div class="container auth">
  <section class="auth__card" aria-labelledby="page-title">
    <div class="auth__head">
      <h1 class="auth__title" id="page-title" data-i18n="forgot.title">Forgot your password?</h1>
      <p class="auth__lead" data-i18n="forgot.lead">Enter the email address you registered with. We will send you a link to reset your password.</p>
    </div>

    <form class="auth__form" data-validate data-next="/account/check-email.html" data-pass-email>
      <div class="field">
        <label class="field__label" for="forgot-email"><span data-i18n="common.email">Email</span><span class="field__req" aria-hidden="true">*</span></label>
        <input class="input" type="email" id="forgot-email" name="email" autocomplete="email" required>
      </div>

      <div class="captcha">
        <div class="field">
          <label class="field__label" for="forgot-captcha"><span data-i18n="login.captcha">Verification code</span><span class="field__req" aria-hidden="true">*</span></label>
          <input class="input" type="text" id="forgot-captcha" name="captcha" autocomplete="off" required data-captcha-input>
        </div>
        <span class="captcha__image" role="img" aria-label="Verification code image" data-i18n-attr="aria-label:login.captchaAlt" data-captcha-image></span>
        <button type="button" class="link captcha__refresh" data-captcha-refresh data-i18n="login.captchaRefresh">Refresh</button>
      </div>

      <button type="submit" class="btn btn--primary btn--block" data-i18n="forgot.submit">Send reset link</button>
    </form>

    <hr class="auth__divider">

    <p class="auth__center">
      <a class="link" href="/account/login.html" data-i18n="common.backLogin">Back to log in</a>
    </p>
  </section>
</div>
