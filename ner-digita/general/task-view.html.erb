<!-- template: 檢視行程 -->

<div class="page-content">
    <div class="container-lg">
        <div class="task-container task-add-container">
            <div class="page-title">
                <h3>任務行程</h3>
            </div>

            <div class="form-output">
                <!-- 主管才有 -->
                <div class="form-group">
                    <label class="form-label">行程人員</label>
                    <div class="output">陳曉明</div>
                </div>

                <!-- 欄位有填資料(required)的才出現，必填星號拿掉 -->
                <div class="form-group">
                    <label for="taskTitle" class="form-label">標題</label>
                    <div class="output">國立教育資料館教育廣播電台組織規程</div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="taskStartTime" class="form-label">開始時間</label>
                            <div class="output">2025-09-18 10:00</div>

                            <!-- 無論有沒有勾選全天都不用出現 -->
                            <!--div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" value="" id="checkDefault" checked />
                                <label class="form-check-label" for="checkDefault">
                                    全天
                                </label>
                            </div-->
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="taskEndTime" class="form-label">結束時間</label>
                            <div class="output">2025-09-18 18:00</div>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="taskLocation" class="form-label">地點</label>
                    <div class="output">國立教育資料館教育廣播電台組織規程</div>
                </div>
                <div class="form-group">
                    <label for="taskDescription" class="form-label">說明</label>
                    <div class="textarea-output sm">
                        <div class="scrollbar-inner">
                            <%= lorem_paragraphs(5) %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-action border-0 pt-0">
                <span class="action-start"><a href="task.html" class="btn btn-lg btn-back px-3" title="回任務行程"></a></span>

                <!-- 只有自己的行程才有建立稿件跟修改按鈕 -->
                <a href="manuscript-add.html" class="btn btn-lg btn-main btn-plus">建立新聞稿件</a>
                <span class="action-end"><a href="task-add.html" class="btn btn-lg btn-outline-dark btn-edit-task">修改</a></span>
            </div>

        </div>

    </div>
</div>

    



<% content_for :js do %>
<!-- jquery scrollbar -->
<script src="../javascripts/jquery.scrollbar.min.js"></script>
<script>
    jQuery(document).ready(function(){
        jQuery('.scrollbar-inner').scrollbar();
    });
</script>
<% end %>

