<!-- template: 技術需求者 - STEP2 回覆媒合意願 -->

<!-- 產學媒合所有頁面都沒有 breadcrumb 麵包屑 -->

<div class="container-fixed">
    <div class="matchmaking-container">

        <ul class="nav matchmaking-nav-sheet" id="sheetTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="sheet-link active" id="sheet2-tab" data-bs-toggle="tab" data-bs-target="#sheet2-tab-pane" type="button" role="tab" aria-controls="sheet2-tab-pane" aria-selected="true"><span>STEP2</span> 回覆媒合意願</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="sheet-link" id="sheet1-tab" data-bs-toggle="tab" data-bs-target="#sheet1-tab-pane" type="button" role="tab" aria-controls="sheet1-tab-pane" aria-selected="true"><span>STEP1</span> 回覆接洽意願</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="sheet-link" id="application-tab" data-bs-toggle="tab" data-bs-target="#application-tab-pane" type="button" role="tab" aria-controls="application-tab-pane" aria-selected="false">出題資料表</button>
            </li>
        </ul>
        <div class="tab-content" id="sheetTabContent">
            
            <div class="tab-pane fade show active" id="sheet2-tab-pane" role="tabpanel" aria-labelledby="sheet2-tab" tabindex="0">
                <%= render :partial => "/partials/sheet-s2" %>
            </div>

            <div class="tab-pane fade" id="sheet1-tab-pane" role="tabpanel" aria-labelledby="sheet1-tab" tabindex="0">
                <%= render :partial => "/partials/sheet-s1" %>
            </div>

            <div class="tab-pane fade" id="application-tab-pane" role="tabpanel" aria-labelledby="application-tab" tabindex="0">
                <%= render :partial => "/partials/sheet" %>
            </div>
        </div>

        <div class="form-action">
            <a href="needers-home.html" class="turnback">
                <svg width="72" height="48" viewBox="0 0 72 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.99951 24H64" stroke="#CEDADA" stroke-linecap="round"></path>
                <path d="M13 29.5L7.99951 24L13 18.5" stroke="#00b9c6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>回列表</span>
            </a>
        </div>
    </div>
</div>



