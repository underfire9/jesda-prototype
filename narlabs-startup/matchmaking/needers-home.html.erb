<!-- template: 技術需求者首頁 -->

<div class="container-fixed">
    <div class="matchmaking-container has-side-container">
        <aside class="side-container">
            <a href="#" class="turnback">
                <svg width="72" height="48" viewBox="0 0 72 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.99951 24H64" stroke="#CEDADA" stroke-linecap="round"></path>
                <path d="M13 29.5L7.99951 24L13 18.5" stroke="#00AFC5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>產學媒合</span>
            </a>
            <div class="side-container-title">技術需求者</div>
            <ul class="nav">
                <li class="nav-item">
                    <a class="nav-link active" href="#">技術媒合需求管理</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">商化技術洽詢管理</a>
                </li>
            </ul>
        </aside>

        <main class="main">
            <h4>已提出申請紀錄</h4>
            <div class="list-filter">
                <div>
                    <select class="form-select" aria-label="Default select example">
                        <option value="1">114</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
                <div>
                    <select class="form-select">
                        <option selected>狀態</option>
                        <option value="1">專家合作確認中</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
                <div class="list-search">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="主題、技術關鍵字" aria-describedby="button-list-search" />
                        <button class="btn btn-outline-secondary" type="button" id="button-list-search"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"></path>
                    </svg></button>
                    </div>
                </div>
            </div>
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>技術主題</th>
                        <th>申請日期</th>
                        <th>辦理進度</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% (1..6).map do |i| %>
                    <tr>
                        <td><%= i %></td>
                        <td>提升微創手術用內視鏡輔助器械的視野穩定性與影像清晰度技術</td>
                        <td>114-01-01</td>
                        <td>專家合作確認中</td>
                        <td><a href="#" class="btn btn-sm btn-outline-primary btn-rounded">合作確認</a></td>
                    </tr>
                    <% end %>
                </tbody>
            </table>
        </main>

    </div>
</div>



<% content_for :js do %>

<% end %>

