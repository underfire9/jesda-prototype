<!-- Cropper Modal -->
<div class="modal fade" id="cropModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="cropModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white" data-bs-theme="dark">
                <h5 class="modal-title" id="cropModalLabel">裁切圖片</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="img-container-modal">
                    <img id="image-to-crop" src="">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-lg btn-light" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-lg btn-primary" id="crop-and-upload-btn">裁切並上傳</button>
            </div>
        </div>
    </div>
</div>


<% content_for :js do %>

    <!-- 儲存後開啟下一步 -->
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Get the save and next buttons
        const saveBtn = document.querySelector('.btn-save');
        const nextBtn = document.querySelector('.btn-next');
        
        console.log('Save button:', saveBtn);
        console.log('Next button:', nextBtn);
        
        if (saveBtn && nextBtn) {
            // Add click event listener to save button
            saveBtn.addEventListener('click', function () {
                console.log('Save button clicked');
                
                // 模擬儲存過程 (可以在這裡加入實際的儲存邏輯)
                // 顯示儲存中的狀態
                saveBtn.textContent = '儲存中...';
                saveBtn.disabled = true;
                
                // 模擬 API 呼叫延遲
                setTimeout(function() {
                    // 恢復按鈕狀態
                    saveBtn.textContent = '儲存';
                    saveBtn.disabled = false;
                    
                    // 啟用下一步按鈕
                    nextBtn.classList.remove('disabled');
                    nextBtn.style.pointerEvents = 'auto';
                    nextBtn.style.opacity = '1';
                    
                    console.log('Next button enabled');
                    
                    // 可選：顯示成功訊息
                    // alert('資料已儲存！');
                }, 1000); // 1秒後啟用下一步按鈕
            });
            
            // 防止在禁用狀態下點擊下一步按鈕
            nextBtn.addEventListener('click', function(e) {
                if (nextBtn.classList.contains('disabled')) {
                    e.preventDefault();
                    alert('請先點擊儲存按鈕儲存資料！');
                    return false;
                }
            });
        } else {
            console.error('Save or Next button not found');
        }
    });
    </script>

    <!-- Cropper -->
    <script src="../javascripts/cropper.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // DOM 元素
        const imageInput = document.getElementById('image-input');
        const imagePreviewBox = document.getElementById('image-preview-box');
        const imagePreview = document.getElementById('image-preview');
        const deleteBtn = document.getElementById('delete-btn');
        const cropModalElement = document.getElementById('cropModal');
        const imageToCrop = document.getElementById('image-to-crop');
        const cropAndUploadBtn = document.getElementById('crop-and-upload-btn');

        // 初始化 Bootstrap Modal
        const cropModal = new bootstrap.Modal(cropModalElement);
        
        let cropper; // Cropper 實例
        let originalFileName = ''; // 保存原始檔名

        // 監聽文件選擇
        imageInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) {
                return;
            }
            originalFileName = file.name; // 保存原始檔名

            // 使用 FileReader 讀取圖片
            const reader = new FileReader();
            reader.onload = (event) => {
                imageToCrop.src = event.target.result;
                cropModal.show(); // 顯示 Modal
            };
            reader.readAsDataURL(file);
        });
        
        // Modal 顯示時，初始化 Cropper
        cropModalElement.addEventListener('shown.bs.modal', () => {
            if (cropper) {
                cropper.destroy(); // 如果已有實例，先銷毀
            }
            cropper = new Cropper(imageToCrop, {
                aspectRatio: 16 / 9, // 設定裁切框的長寬比
                viewMode: 1,      // 限制裁切框不能超出圖片範圍
                background: false,
                autoCropArea: 0.8,
            });
        });

        // Modal 隱藏時，銷毀 Cropper 並清空 input
        cropModalElement.addEventListener('hidden.bs.modal', () => {
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }
            // 清空 file input，這樣才能重新選擇同一張圖片
            imageInput.value = ''; 
        });

        // 點擊 "裁切並上傳" 按鈕
        cropAndUploadBtn.addEventListener('click', () => {
            if (!cropper) {
                return;
            }
            
            // 獲取裁切後的 Canvas
            const canvas = cropper.getCroppedCanvas({
                width: 1000, // 您可以指定輸出圖片的寬度
                // height 會根據 aspectRatio 自動計算
                fillColor: '#fff',
                imageSmoothingEnabled: true,
                imageSmoothingQuality: 'high',
            });

            // 將 Canvas 轉換為 Blob 物件 (類似於檔案)
            canvas.toBlob((blob) => {
                // 產生一個暫時的 URL 以供預覽
                const croppedImageUrl = URL.createObjectURL(blob);
                imagePreview.src = croppedImageUrl;
                
                // 更新 UI
                imagePreviewBox.classList.add('has-image');
                deleteBtn.style.display = 'inline-block';
                
                // *** 模擬上傳到後端 ***
                // 這是您需要與後端 API 對接的地方
                const formData = new FormData();
                
                // 將 blob 附加到 formData，第三個參數是檔名
                formData.append('uploaded_image', blob, `cropped-${originalFileName}`);
                
                console.log('準備上傳的 FormData:', formData);
                // 您可以在這裡使用 fetch 或 axios 將 formData 送出
                // fetch('/your-upload-api-endpoint', {
                //     method: 'POST',
                //     body: formData,
                // })
                // .then(response => response.json())
                // .then(data => console.log('上傳成功:', data))
                // .catch(error => console.error('上傳失敗:', error));
                
                // ------------------------

            }, 'image/jpeg', 0.9); // 指定輸出格式和品質

            cropModal.hide(); // 關閉 Modal
        });
        
        // 點擊 "刪除圖片" 按鈕
        deleteBtn.addEventListener('click', () => {
            // 清空預覽
            imagePreview.src = '';
            imagePreviewBox.classList.remove('has-image');
            
            // 清空 file input
            imageInput.value = '';
            
            // 隱藏刪除按鈕
            deleteBtn.style.display = 'none';
            
            console.log('圖片已刪除');
        });
    });
    </script>
<% end %>

