<% content_for :js do %>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var englishIndex = 1;
    var experienceIndex = 1;

    function createUploadControl(file) {
        var control = document.createElement('div');
        control.className = 'upload-file-control';

        var link = document.createElement('a');
        link.href = URL.createObjectURL(file);
        link.title = '下載';
        link.target = '_blank';
        link.textContent = file.name;

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-sm btn-delete';
        btn.title = '刪除檔案';
        btn.innerHTML = '<i class="fas fa-times"></i>';

        control.appendChild(link);
        control.appendChild(btn);

        return control;
    }

    function handleFileChange(input) {
        var file = input.files && input.files[0];
        var uploadItem = input.closest('.upload-item');
        if (!uploadItem) return;

        var existing = uploadItem.querySelector('.upload-file-control');
        if (existing) {
            existing.remove();
        }

        if (!file) return;

        var control = createUploadControl(file);
        uploadItem.appendChild(control);
    }

    function clearUploadItem(input) {
        if (!input) return;
        input.value = '';
        var uploadItem = input.closest('.upload-item');
        if (!uploadItem) return;
        var existing = uploadItem.querySelector('.upload-file-control');
        if (existing) {
            existing.remove();
        }
    }

    function createEnglishItem() {
        englishIndex += 1;
        var idx = englishIndex;
        var wrapper = document.createElement('div');
        wrapper.className = 'upload-item upload-item-removeable';
        wrapper.innerHTML = [
            '<button type="button" class="btn btn-trash" title="移除這筆資料"><i class="far fa-trash-alt"></i></button>',
            '<div class="row">',
            '  <div class="col-6">',
            '    <div class="form-group">',
            '      <label for="domestic_eng_name_' + idx + '" class="form-label">檢定名稱</label>',
            '      <input type="text" id="domestic_eng_name_' + idx + '" name="eng_name_' + idx + '" class="form-control">',
            '    </div>',
            '  </div>',
            '  <div class="col-6">',
            '    <div class="form-group">',
            '      <label for="domestic_eng_score_' + idx + '" class="form-label">檢定成績</label>',
            '      <input type="text" id="domestic_eng_score_' + idx + '" name="eng_score_' + idx + '" class="form-control">',
            '    </div>',
            '  </div>',
            '</div>',
            '<input type="file" id="domestic_eng_proof_' + idx + '" name="eng_proof_' + idx + '" class="form-control">'
        ].join('');
        return wrapper;
    }

    document.addEventListener('change', function (event) {
        var target = event.target;
        if (target && target.matches('input[type="file"]')) {
            handleFileChange(target);
        }
    });

    document.addEventListener('click', function (event) {
        var deleteBtn = event.target.closest('.btn-delete');
        if (deleteBtn) {
            var uploadItem = deleteBtn.closest('.upload-item');
            if (uploadItem) {
                var input = uploadItem.querySelector('input[type="file"]');
                clearUploadItem(input);
            }
            return;
        }

        var trashBtn = event.target.closest('.btn-trash');
        if (trashBtn) {
            var removable = trashBtn.closest('.upload-item-removeable');
            if (removable) {
                removable.remove();
            }
            return;
        }

        var addBtn = event.target.closest('.btn-add');
        if (addBtn) {
            var addType = addBtn.getAttribute('data-add-type');
            var section = addBtn.closest('.section');
            var addWrap = addBtn.closest('.add-wrap');
            if (!section || !addWrap) return;

            if (addType === 'english') {
                addWrap.insertAdjacentElement('beforebegin', createEnglishItem());
            } else if (addType === 'experience') {
                addWrap.insertAdjacentElement('beforebegin', createExperienceItem());
            }
        }
    });
});
</script>
<% end %>

