<% content_for :title do %>Online Blessings<% end %>
<% content_for :alt_url do %>/blessings/index.html<% end %>
<% content_for :section do %>blessings<% end %>
<% content_for :data_js do %><script src="/javascripts/blessings-data.js"></script><% end %>

<header class="page-head">
  <div class="container page-head__inner">
    <div class="page-head__text">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/en/index.html">Home</a></li><li aria-current="page">Online Blessings</li></ol></nav>
      <h1 class="page-title">A Century of Love, Celebrated Across the Seas</h1>
      <p class="page-subtitle">Online Blessings for the NTU Centennial</p>
      <p class="lead">One old photo, one heartfelt wish. Moments left at NTU by generations of overseas Chinese, mainland Chinese and international students, shared by alumni around the world as we celebrate NTU's 100th year.</p>
    </div>
    <p class="page-head__deco" aria-hidden="true">100</p>
  </div>
</header>

<section class="filter-bar" aria-label="Filter blessings">
  <div class="container filter-bar__inner">
    <div class="filters">
      <div class="filter-row" role="group" aria-labelledby="f-identity">
        <span class="filter-row__label" id="f-identity">Identity</span>
        <ul class="chips" data-filter="identity">
          <li><button class="chip is-active" type="button" data-value="" aria-pressed="true">All</button></li>
          <li><button class="chip" type="button" data-value="oc" aria-pressed="false">Overseas Chinese</button></li>
          <li><button class="chip" type="button" data-value="mc" aria-pressed="false">Mainland Chinese</button></li>
          <li><button class="chip" type="button" data-value="intl" aria-pressed="false">International</button></li>
        </ul>
      </div>
      <div class="filter-row" role="group" aria-labelledby="f-region">
        <span class="filter-row__label" id="f-region">Region</span>
        <ul class="chips" data-filter="region">
          <li><button class="chip is-active" type="button" data-value="" aria-pressed="true">All</button></li>
          <li><button class="chip" type="button" data-value="asia" aria-pressed="false">Asia</button></li>
          <li><button class="chip" type="button" data-value="europe" aria-pressed="false">Europe</button></li>
          <li><button class="chip" type="button" data-value="namerica" aria-pressed="false">North America</button></li>
          <li><button class="chip" type="button" data-value="samerica" aria-pressed="false">South America</button></li>
          <li><button class="chip" type="button" data-value="oceania" aria-pressed="false">Oceania</button></li>
          <li><button class="chip" type="button" data-value="africa" aria-pressed="false">Africa</button></li>
        </ul>
      </div>
    </div>
    <div class="filter-bar__side">
      <p class="result-count" id="result-count" aria-live="polite">0 blessings</p>
      <label class="select select--sm"><span class="visually-hidden">Year</span>
        <select id="year-filter">
          <option value="">Year: All</option>
          <option value="1950">1950s</option><option value="1960">1960s</option><option value="1970">1970s</option><option value="1980">1980s</option><option value="1990">1990s</option><option value="2000">2000s</option><option value="2010">2010s</option><option value="2020">2020s</option>
        </select>
      </label>
    </div>
  </div>
</section>

<section class="wall-section" aria-label="Blessing photos">
  <div class="container">
    <ul class="wall" id="wall"></ul>
    <p class="wall-empty" id="wall-empty" hidden>No blessings match these filters yet. Try another combination.</p>
    <div class="load-more">
      <button class="btn btn--outline" type="button" id="load-more">Load more blessings</button>
      <p class="load-more__status" id="load-status"></p>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>Do you have an old photo from NTU?</h2>
      <p>Share your NTU memory and send your blessing for the Centennial.</p>
    </div>
    <a class="btn btn--light" href="/en/submit/index.html">Submit a Blessing<span class="btn__arrow" aria-hidden="true">→</span></a>
  </div>
</section>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-labelledby="lb-title" hidden>
  <div class="lightbox__top">
    <p class="lightbox__count" id="lb-count"></p>
    <button class="lightbox__close" type="button" id="lb-close">Close<span aria-hidden="true" class="x"></span></button>
  </div>
  <button class="lightbox__nav lightbox__nav--prev" type="button" id="lb-prev" aria-label="Previous photo"></button>
  <div class="lightbox__card">
    <div class="lightbox__photo ph" id="lb-photo" role="img" aria-label="Placeholder photo"></div>
    <div class="lightbox__info">
      <p class="tags" id="lb-tags"></p>
      <h2 class="lightbox__title" id="lb-title"></h2>
      <dl class="meta-list" id="lb-meta"></dl>
      <blockquote class="blessing">
        <p id="lb-message"></p>
        <footer id="lb-signer"></footer>
      </blockquote>
    </div>
  </div>
  <button class="lightbox__nav lightbox__nav--next" type="button" id="lb-next" aria-label="Next photo"></button>
</div>
