<!-- template: 選擇登入身分 -->
<!-- 登入時判斷該帳號有多角色時導進此頁面 -->

<div class="workspace" canvas="container">
    <h1 class="h1-brands">
        <span class="brands-logo">臺大夏季學院</span>
    </h1>
    <div class="language-switcher">
        <a href="?lang=en" title="English"><span>EN</span></a>
    </div>
    <div class="login-page">
        <div class="login-container">
            <div class="login-card">
                <div class="card-hd">
                    <h3>選擇登入身分</h3>
                </div>
                <form class="login-form" action="../teacher/dashboard.html" method="post">
                    <div class="card-bd">
                        <div class="form-group">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault1" />
                                <label class="form-check-label" for="radioDefault1">
                                    系統管理人員
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault2" />
                                <label class="form-check-label" for="radioDefault2">
                                    行政人員
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault3" />
                                <label class="form-check-label" for="radioDefault3">
                                    教師
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault4" />
                                <label class="form-check-label" for="radioDefault4">
                                    助教
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault5" />
                                <label class="form-check-label" for="radioDefault5">
                                    學生
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="login-action d-grid">
                        <button class="btn btn-lg btn-main" type="submit">送出</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<% content_for :js do %>

<% end %>

