<% content_for :js do %>
<script>

    // Tooltip 初始化
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))

    // 文字截斷展開功能，可調整字元上限
    const TRUNCATE_LIMIT = 30;

    function initTruncate(limit = TRUNCATE_LIMIT) {
        document.querySelectorAll('.bd-data-value').forEach(el => {
            const text = el.textContent.trim();
            if (text.length <= limit) return;

            el.dataset.fullText = text;

            const textSpan = document.createElement('span');
            textSpan.className = 'truncate-text';
            textSpan.textContent = text.slice(0, limit) + '\u2026';

            const toggleBtn = document.createElement('button');
            toggleBtn.className = 'btn-truncate-toggle';
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.setAttribute('title', '展開');
            toggleBtn.innerHTML = '<i class="fas fa-chevron-down"></i>';

            el.textContent = '';
            el.appendChild(textSpan);
            el.appendChild(toggleBtn);

            toggleBtn.addEventListener('click', e => {
                e.stopPropagation();
                const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
                if (isExpanded) {
                    textSpan.textContent = el.dataset.fullText.slice(0, limit) + '\u2026';
                    toggleBtn.setAttribute('aria-expanded', 'false');
                    toggleBtn.title = '展開';
                } else {
                    textSpan.textContent = el.dataset.fullText;
                    toggleBtn.setAttribute('aria-expanded', 'true');
                    toggleBtn.title = '收合';
                }
            });
        });
    }

    initTruncate();
</script>
<% end %>

