            </ul>
        </div>
    </div>
</div>



<% content_for :js do %>

<!-- Lightbox -->
<script src="../javascripts/bs5-lightbox.min.js"></script>
<script>
    import Lightbox from 'bs5-lightbox';
    document.querySelectorAll('.lightbox').forEach(el => el.addEventListener('click', Lightbox.initialize));
</script>

<!-- img to background -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.lightbox-cover').forEach(function(cover) {
        var img = cover.querySelector('.cover-img');
        if (img) {
            img.style.display = 'none';
            cover.style.backgroundImage = 'url(' + img.src + ')';
            cover.style.backgroundSize = 'cover';
            cover.style.backgroundPosition = 'center';
            cover.style.display = 'block';
        }
    });
});
</script>

<% end %>

