<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/applications/index.html">
      <%= render :partial => "/partials/brand" %>
    </a>
    <div class="site-header__tools">
      <%= render :partial => "/partials/lang_toggle" %>
      <div class="user-menu" data-user-menu>
        <button type="button" class="user-menu__btn" aria-haspopup="true" aria-expanded="false" aria-controls="user-menu-dropdown" aria-label="Account menu" data-i18n-attr="aria-label:header.userMenu">
          <!-- 頭像縮寫先放靜態文字，實作時再處理產生邏輯 -->
          <span class="avatar" aria-hidden="true">AW</span>
          <span class="user-menu__name">
            <b data-i18n="header.greeting" data-i18n-vars='{"name":"Angela Winson"}'>Hi, Angela Winson</b>
            <small>angela.winson@uw.edu</small>
          </span>
          <span class="user-menu__chev" aria-hidden="true"></span>
        </button>
        <div class="user-menu__dropdown" id="user-menu-dropdown" hidden>
          <a href="/applications/index.html" data-i18n="header.menu.applications">My applications</a>
          <a href="/account/change-password.html" data-i18n="header.menu.changePassword">Change password</a>
          <hr>
          <a href="/account/login.html" data-i18n="header.menu.logout">Log out</a>
        </div>
      </div>
    </div>
  </div>
</header>
