<% content_for :js do %>
<!-- 選擇日期 flatpickr + monthSelect -->
<script src="../javascripts/flatpickr.js"></script>
<script src="../javascripts/monthselect.js"></script>
<script>
['#rocMonthStart', '#rocMonthEnd'].forEach(function(selector) {
    flatpickr(selector, {
        plugins: [
            new monthSelectPlugin({
                shorthand: true,
                dateFormat: "Y-m", // 儲存的值
                altFormat: "Y 年 m 月", // 顯示的值
                monthNames: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"],
            }),
        ],
        locale: {
            ...flatpickr.l10ns.zh,
            months: {
                shorthand: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"],
                longhand: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"]
            }
        },
        onChange: function (selectedDates, dateStr, instance) {
            const [y, m] = dateStr.split("-");
            instance.input.value = `${y} 年 ${parseInt(m)} 月`;
        },
    });
});
</script>

<!-- 體驗類型其他欄位 -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const consultOtherCheckbox = document.getElementById("consult-other");
        const consultOtherInput = document.querySelector(".consult-other-input");

        // 預設隱藏
        consultOtherInput.style.display = "none";

        consultOtherCheckbox.addEventListener("change", function() {
            if (consultOtherCheckbox.checked) {
                consultOtherInput.style.display = "inline-block";
            } else {
                consultOtherInput.style.display = "none";
            }
        });
    });
</script>

<!-- 調整內容字數限制 -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const textarea = document.getElementById("proposalContentAdjustmentReason");
        const textCount = document.getElementById("textCount");
        const MAX_FULLWIDTH_COUNT = 100;

        if (!textarea || !textCount) return;

        function getCharUnit(char) {
            return /[\u0000-\u00ff]/.test(char) ? 0.5 : 1;
        }

        function getFullwidthEquivalentLength(text) {
            return Array.from(text).reduce(function(total, char) {
                return total + getCharUnit(char);
            }, 0);
        }

        function trimToLimit(text) {
            let total = 0;
            let result = "";

            for (const char of Array.from(text)) {
                const unit = getCharUnit(char);
                if (total + unit > MAX_FULLWIDTH_COUNT) break;
                total += unit;
                result += char;
            }

            return { text: result, count: total };
        }

        function formatCount(count) {
            return Number.isInteger(count) ? String(count) : count.toFixed(1).replace(/\.0$/, "");
        }

        function updateCount() {
            const trimmed = trimToLimit(textarea.value);

            if (trimmed.text !== textarea.value) {
                textarea.value = trimmed.text;
            }

            textCount.textContent = formatCount(getFullwidthEquivalentLength(textarea.value));
        }

        textarea.addEventListener("input", updateCount);
        textarea.addEventListener("compositionend", updateCount);
        updateCount();
    });
</script>
<% end %>
