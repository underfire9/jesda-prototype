<!-- template: 客製化 - 關於計畫 / 核心亮點 -->

<div class="container-lg">
    <div class="page-content about-content">
        <aside class="aside about-aside" aria-label="關於計畫子選單">
            <ul class="about-nav menu-item">
                <li><a href="about-understanding.html" class="nav-link" title="認識青領">認識青領</a></li>
                <li><a href="about-background.html" class="nav-link" title="計畫背景">計畫背景</a></li>
                <li><a href="about-highlights.html" class="nav-link current" title="核心亮點">核心亮點</a></li>
            </ul>
        </aside>
        <main class="main">
            <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
            <div class="page-head">
                <div class="page-title">
                    <h3>計畫背景</h3>
                </div>
                <div class="page-tools">
                    <ul class="menu-item action-options">
                        <li>
                            <a href="#" title="分享到 Facebook" class="btn-action"><img src="../assets/facebook_b.png" alt="Facebook"></a>
                        </li>
                        <li>
                            <a href="#" title="分享到 Line" class="btn-action"><img src="../assets/line_b.png" alt="Line"></a>
                        </li>
                        <li>
                            <a href="#" class="btn-action" title="列印本頁面" onclick="window.print(); return false;"><img src="../assets/printer_b.png" alt="列印"></a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="article-content about-highlights">
                <div class="highlight-group">
                    <h4 class="highlight-title"><span>亮點一</span>心向遠方，自由啟航</h4>
                    <h5>看得遠，才能走得穩。</h5>
                    <p>補習文化與升學焦慮壓抑了青年的想像力、創新力與探索熱情，只為追趕分數與比拚學歷，卻在進入大學後更感迷惘。</p>
                    <p>青領計畫鼓勵青年放下升學焦慮，轉向真實世界的探索與實作。從分數競賽退一步，是為了看得更遠，走得更穩。不先進大學，先看清自己要去哪裡，再出發。比起盲目趕路，更重要的是走對的路。</p>
                </div>

                <div class="highlight-group">
                    <h4 class="highlight-title"><span>亮點二</span>不拼分數，也能上榜</h4>
                    <h5>升學可以不靠分數，青年的價值，不該只用考卷衡量。</h5>
                    <p>青領計畫設立專屬特殊選才通道，僅限參與本計畫的青年申請，不看學測、不比統測，而是依據青年在探索歷程中展現的學習動機、實作經驗與企劃成果，綜合評估其潛力與特質。<b>不補習、不刷題，也能進入理想校系。</b></p>
                    <p>青領選才跳脫制式模板與過度競爭的升學窠臼，鼓勵青年展現真實觀點與成長軌跡，走出屬於自己版本的學習歷程。</p>
                </div>

                <div class="highlight-group">
                    <h4 class="highlight-title"><span>亮點三</span>敢夢敢試，獎金護航</h4>
                    <h5>你的每一步勇敢，都是國家願意投資的未來。</h5>
                    <p>探索需要勇氣，更需要資源支持。為了讓更多青年能安心出發、穩健前行，青領計畫提供最高 28.5 萬元獎金，依執行進度分三階段核發。</p>
                    <p>這筆資源支持青年認真規劃、踏實執行、有始有終地完成自己的企劃。</p>
                    <p>不必為經濟壓力分心，讓青年能專注在探索與成長的歷程中，打造屬於自己的未來藍圖。</p>
                </div>

                <div class="highlight-group">
                    <h4 class="highlight-title"><span>亮點四</span>兩年淬鍊，軟硬皆強</h4>
                    <h5>在 AI 時代，養成無法被取代的實力。</h5>
                    <p>青領計畫給青年一段為期兩年的探索歷程，不是填鴨式課表，也不是保母式照顧，而是一場由自主規劃、自我驅動的成長挑戰。青年自行設定目標與節奏，透過就業、創業、志工、壯遊等多元方式，從實作中理解世界，也重塑對自己的認識。</p>
                    <p>探索過程青年並非孤軍奮戰。青領計畫設有「雙週誌回饋機制」，由專業輔導團隊定期檢閱青年紀錄、提供具體建議與回饋，協助其穩定前行，累積真正屬於自己的能力與信心。</p>
                    <p>這段歷程所淬鍊的，不只是技能，更是AI時代無法被取代的底層實力—自我覺察、跨域溝通、獨立思考與面對不確定的韌性。當青年願意主動探索世界，也將更有力量迎向人生每一個未知的挑戰。</p>
                </div>
            </div>
        </main>
    </div>
</div>



<% content_for :js do %>
<!-- Sticky Navigation -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    var nav = document.querySelector('.about-nav');
    var navOffset = nav.getBoundingClientRect().top + window.pageYOffset;

    function onScroll() {
        if (window.pageYOffset > navOffset) {
            nav.style.position = 'fixed';
            nav.style.top = '0';
            nav.style.zIndex = '1000';
            nav.style.width = nav.offsetWidth + 'px';
        } else {
            nav.style.position = '';
            nav.style.top = '';
            nav.style.zIndex = '';
            nav.style.width = '';
        }
    }

    window.addEventListener('scroll', onScroll);
});
</script>

<!-- Mouse Movement Effect -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script>
// 後備載入 CustomEase
if (!window.CustomEase) {
    var script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/CustomEase.min.js';
    document.head.appendChild(script);
}
// 後備載入 MotionPathPlugin
if (!window.MotionPathPlugin) {
    var script2 = document.createElement('script');
    script2.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/MotionPathPlugin.min.js';
    document.head.appendChild(script2);
}
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    var banner = document.querySelector('.about-banner');
    var copywrite = document.querySelector('.copywrite');
    var hero = document.querySelector('.banner-hero');

    if (banner && copywrite && hero) {
        banner.addEventListener('mousemove', function(e) {
            var rect = banner.getBoundingClientRect();
            var x = e.clientX - rect.left;
            var y = e.clientY - rect.top;
            var xPercent = (x / rect.width - 0.5) * 2; // -1 ~ 1
            var yPercent = (y / rect.height - 0.5) * 2;

            // 2D movement
            gsap.to(copywrite, {
                x: xPercent * 15,
                y: yPercent * 5,
                duration: 0.4,
                ease: "power2.out"
            });
            gsap.to(hero, {
                x: xPercent * 10,
                y: yPercent * 3,
                duration: 0.4,
                ease: "power2.out"
            });

            // 3D effect for banner-hero
            gsap.to(hero, {
                rotateY: xPercent * 10,
                rotateX: -yPercent * 5,
                transformPerspective: 1000,
                duration: 0.4,
                ease: "power2.out"
            });
        });

        banner.addEventListener('mouseleave', function() {
            gsap.to(copywrite, { x: 0, y: 0, duration: 0.5, ease: "power2.out" });
            gsap.to(hero, { x: 0, y: 0, rotateY: 0, rotateX: 0, duration: 0.5, ease: "power2.out" });
        });
    }
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    "use strict";
    
    // 檢查是否載入了必要的 GSAP 插件
    if (typeof gsap === 'undefined') {
        console.error('GSAP library not loaded');
        return;
    }
    
    // 註冊 GSAP 插件
    if (window.CustomEase) {
        gsap.registerPlugin(CustomEase);
    }
    if (window.MotionPathPlugin) {
        gsap.registerPlugin(MotionPathPlugin);
    }
    
    function animateEllipse(element, index) {
        let timeline = gsap.timeline({ defaults: { ease: customEase }, repeat: -1 });
        gsap.set(element, { 
            opacity: 1 - index / ellipses.length, 
            stroke: colorInterpolate(index / ellipses.length) 
        });
        timeline.to(element, { 
            attr: { ry: `-=${index * 5.75}`, rx: `+=${index * 3.5}` }, 
            ease: easeOut 
        })
        .to(element, { 
            attr: { ry: `+=${index * 5.75}`, rx: `-=${index * 3.5}` }, 
            ease: easeIn 
        })
        .to(element, { 
            duration: 1, 
            rotation: -180, 
            transformOrigin: "50% 50%" 
        }, 0)
        .timeScale(0.5);
    }
    
    gsap.config({ trialWarn: false });
    
    let svgElement = document.querySelector("#aiSVG"),
        ellipses = gsap.utils.toArray(".ell"),
        customEase, easeIn, easeOut, colorInterpolate;
    
    // 創建自定義緩動函數，如果 CustomEase 可用的話
    if (window.CustomEase) {
        customEase = CustomEase.create("custom", "M0,0 C0.2,0 0.432,0.147 0.507,0.374 0.59,0.629 0.822,1 1,1 ");
        easeIn = CustomEase.create("custom", "M0,0 C0.266,0.412 0.297,0.582 0.453,0.775 0.53,0.87 0.78,1 1,1 ");
        easeOut = CustomEase.create("custom", "M0,0 C0.594,0.062 0.79,0.698 1,1 ");
    } else {
        // 後備緩動函數
        customEase = "power2.out";
        easeIn = "power2.in";
        easeOut = "power2.out";
    }
    
    colorInterpolate = gsap.utils.interpolate(["#359EEE", "#FFC43D", "#EF476F", "#03CEA4"]);
    
    // 設定 SVG 可見性和透明度
    if (svgElement) {
        gsap.set(svgElement, { 
            visibility: "visible",
            opacity: 1
        });
        
        // 設定 AI 路徑初始狀態
        gsap.set("#ai", { opacity: 0 });
        
        // 啟動橢圓動畫
        ellipses.forEach((element, index) => {
            gsap.delayedCall(index / (ellipses.length - 1), animateEllipse, [element, index + 1]);
        });
        
        // 漸層動畫
        gsap.to("#aiGrad", { 
            duration: 4, 
            delay: 0.75, 
            attr: { x1: "-=480", x2: "-=480" }, 
            scale: 1.2, 
            transformOrigin: "80% 80%", 
            repeat: -1, 
            ease: "none" 
        });
        
        // AI 圖示動畫
        gsap.to("#ai", { 
            duration: 1, 
            opacity: 1,
            scale: 1.1, 
            transformOrigin: "50% 50%", 
            repeat: -1, 
            yoyo: true, 
            ease: customEase,
            delay: 1
        });
        
        console.log('aiSVG animation initialized successfully');
    } else {
        console.error('SVG element #aiSVG not found');
    }
    
    // 後備動畫，如果 GSAP 載入失敗
    setTimeout(function() {
        var svg = document.querySelector("#aiSVG");
        if (svg && svg.style.visibility === 'hidden') {
            svg.style.visibility = 'visible';
            svg.style.opacity = '1';
            console.log('Fallback: SVG made visible');
        }
    }, 2000);
});
</script>
<% end %>

