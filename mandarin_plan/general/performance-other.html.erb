<% content_for :js do %>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // 定義每個 wrap-item 的 radio 與 wrap-hide 對應
    const items = [
        { radioName: 'quickOptions', showValue: 'option1', hideSelector: '.quick-gearing' },
        { radioName: 'aptitudeOptions', showValue: 'option1', hideSelector: '.aptitude-test' },
        { radioName: 'suitabilityOptions', showValue: 'option1', hideSelector: '.suitability-test' },
        { radioName: 'onlineOptions', showValue: 'option1', hideSelector: '.online-courses' },
        { radioName: 'briefingOptions', showValue: 'option1', hideSelector: '.briefing-session' }
    ];

    items.forEach(function(item) {
        // 預設隱藏
        document.querySelectorAll(item.hideSelector).forEach(function(el) {
            el.style.display = 'none';
        });

        // 綁定 radio 事件
        document.querySelectorAll('input[name="' + item.radioName + '"]').forEach(function(radio) {
            radio.addEventListener('change', function() {
                document.querySelectorAll(item.hideSelector).forEach(function(el) {
                    el.style.display = (radio.value === item.showValue && radio.checked) ? '' : 'none';
                });
            });

            // 頁面載入時根據預設值顯示
            if (radio.checked && radio.value === item.showValue) {
                document.querySelectorAll(item.hideSelector).forEach(function(el) {
                    el.style.display = '';
                });
            }
        });
    });
});
</script>
<% end %>
