<!-- template: 計畫合約簽章 - 下載合約附件 -->

<div class="container-lg">

    <div class="step-wrapper">
        <ul class="step-menu menu-item">
            <li class="step-item done">
                <span class="number">1</span>
                <span class="description">填寫合約資料</span>
            </li>
            <li class="step-item current">
                <span class="number">2</span>
                <span class="description">下載合約與上傳附件</span>
            </li>
            <li class="step-item">
                <span class="number">3</span>
                <span class="description">送出申請</span>
            </li>
        </ul>
    </div>

    <div class="notice-wrapper">
        <p><%= zh_lorem_paragraph %></p>
        <p><%= zh_lorem_paragraph %></p>
    </div>

    <div class="dl-group align-items-center">
        <div class="group-start">
            <h4 class="mb-0">合約檔案</h4>
        </div>
        <div class="group-end">
            <a href="#" class="btn btn-outline-info btn-rounded"><i class="far fa-file-alt"></i> 檔案下載</a>
        </div>
    </div>

    <div class="dl-group">
        <div class="group-start">
            <h4 class="title">合約連帶保證人附件檔案</h4>
            <p class="description">連帶保證人可選擇下列方式進行擔保，需繳交文件說明如下 :</p>
            <ol>
                <li>房地產擔保，需繳交房契或地契證明。</li>
                <li>個人所得擔保，需繳交個人所得證明文件。</li>
            </ol>
        </div>
        <div class="group-end">
            <a href="#" class="btn btn-outline-info btn-rounded"><i class="far fa-file-alt"></i> 檔案下載</a>
        </div>
    </div>

    <div class="upload-wrapper">
        <!-- 檔案上傳後多出 .file-pill，當再次上傳時則覆蓋上一筆，點選檔名另開視窗觀看文件 -->
        <div class="upload-item">
            <h4>身分證影本</h4>
            <div class="form-group">
                <input class="form-control" type="file" id="photoFile">
            </div>
            <div class="ft-action">
                <span>
                    <div class="file-pill">
                        <!-- 避免檔名過長有限制最大寬度 256px，超出時會字元會省略 -->
                        <a href="#" target="_blank" class="filename">file_name.jpg</a>
                        <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </span>
            </div>
        </div>
        <div class="upload-item">
            <h4>銀行帳戶封面</h4>
            <div class="form-group">
                <input class="form-control" type="file" id="passportFile">
            </div>
            <div class="ft-action">
                <span>
                    <div class="file-pill">
                        <!-- 避免檔名過長有限制最大寬度 256px，超出時會字元會省略 -->
                        <a href="#" target="_blank" class="filename">避免檔名過長有限制最大寬度256px超出時會字元會省略.jpg</a>
                        <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </span>
            </div>
        </div>
    </div>

    <div class="form-action">
        <button type="submit" class="btn btn-lg btn-outline-primary">上一步</button>
        <button type="button" class="btn btn-lg btn-outline-primary">暫存</button>
        <button type="submit" class="btn btn-lg btn-primary">下一步</button>
    </div>

</div>



<% content_for :js do %>

<% end %>

