<% content_for :js do %>
<!-- jquery scrollbar -->
<script src="../javascripts/jquery.scrollbar.min.js"></script>
<script>
    jQuery(document).ready(function(){
        jQuery('.scrollbar-inner').scrollbar();
    });
</script>

<!-- diff -->
<!-- white-space: pre-wrap 會保留原始文字中的換行符號與多餘空白，會換行的內容務必按照下方格式或其他解法 -->
<script src="../javascripts/diff.min.js"></script>
<script>
    function renderDiff(oldText, newText, leftId, rightId){
        // ✅ 改用 diffChars → 精準到單字
        const diff = Diff.diffChars(oldText, newText);
        let leftHTML = "", rightHTML = "";

        diff.forEach(part => {
            if (part.removed) {
                leftHTML += `<del>${part.value}</del>`;
            } else if (part.added) {
                rightHTML += `<ins>${part.value}</ins>`;
            } else {
                leftHTML += part.value;
                rightHTML += part.value;
            }
        });

        document.getElementById(leftId).innerHTML = leftHTML;
        document.getElementById(rightId).innerHTML = rightHTML;
    }

    // 測試資料
    const oldTitle = "迎接新學期到來 北京教育局呼籲家長重視孩子安全";
    const newTitle = "迎接新學期到來 北京教育局呼籲家長務必重視孩子安全 12345";

    const oldLead = "研究也發現，人工的回應也呈現相同模式。這意味著，當越來越多人透過人工智慧獲得心理健康建議時，這種偏誤可能被放大。研究者提醒，過多的增益性建議，可能讓心理健康變成一份永無止境的待辦清單，反而增加壓力。";
    const newLead = "研究也發現，人工智慧的回應也呈現相同模式。這意味著，當越來越多人透過AI獲得心理健康建議時，這種偏誤可能被放大。研究者提醒，過多的增益性建議，可能讓心理健康變成一份永無止境的待辦清單，反而增加壓力。";

    const oldContent =
`迎接新學期到來，家長在接送孩子時應遵守交通規則。

學生在校期間，應遵守校園秩序，注意個人安全，諮商心理師公會全聯會常務理事胡延薇說明，這項研究顯示，許多人對待自己比對待朋友更嚴苛，總覺得「應該要做更多」才算努力。

董氏基金會指出，研究整合了8項實驗，囊括了數百名參與者，並分析了社群媒體上的建議內容，甚至測試人工智慧的回應，請參與者針對有關賭博等不良習慣，及錯失運動等有益活動的情境，向陌生人、朋友或自己提供建議。結果顯示，人們大多建議「增加新行動」，而非「減少有害行為」。人們認為「多做」比「少做」更容易、更有效，也較願意接受。但當建議對象是朋友時，大家比較容易提出「少做」的選項，反觀給自己的建議，則更傾向加上新任務。

臺北市青年局「2025臺北市校園創意舞蹈影片競賽」結果揭曉，10組入圍決選團隊以創意舞蹈短片和現場舞臺演出，展現青春能量，最後由華岡藝校《Pinky Bomb》和《Tequila》分別拿下冠亞軍，麗山高中《麗山舞漾》獲得季軍。臺北市青年局長周羿希表示，學生勇敢嘗試、勇於展現自我，每支作品本身就是最好的青春紀錄。`;

    const newContent =
`迎接新學期到來，家長在接送孩子時應遵守交通規則，避免違規停車。

學生在校期間，應遵守校園秩序，並注意上下樓梯的安全，諮商心理師公會全聯會常務理事胡延薇說明，這項研究顯示，許多人對待自己比對待朋友更嚴苛，總覺得「應該再做更多」才算努力。

董氏基金會指出，研究整合了8項實驗，囊括了數百名參與者，並分析了社群媒體上的建議內容，甚至測試人工智慧的回應，請參與者針對有關賭博等不良習慣，及錯失運動等有益活動的情境，向陌生人、朋友或自己提供建議。結果顯示，人們大多建議「增加新行動」，而非「減少有害行為」。人們認為「多做」比「少做」更容易、更有效，也較願意接受。但當建議對象是朋友時，大家比較容易提出「少做」的選項，反觀給自己的建議，則更傾向加上新任務。

臺北市青年局「2025臺北市校園創意舞蹈影片競賽」結果揭曉，10組入圍決選團隊以創意舞蹈短片和現場舞臺演出，展現青春能量，最後由華岡藝校《Pinky Bomb》和《Tequila》分別拿下冠亞軍，麗山高中《麗山舞漾》獲得季軍。臺北市青年局長周羿希表示，學生勇敢嘗試、勇於展現自我，每支作品本身就是最好的青春紀錄。`;

    // 各區塊比對
    renderDiff(oldTitle, newTitle, "title-left", "title-right");
    renderDiff(oldLead, newLead, "lead-left", "lead-right");
    renderDiff(oldContent, newContent, "content-left", "content-right");
</script>
<% end %>

