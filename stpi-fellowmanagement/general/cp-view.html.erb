<!-- template: 自訂流程 - 檢視 -->

<div class="container-lg">
    <div class="leave-container-head">
        <h2 class="mb-0 fw-light">自訂流程</h2>
    </div>
    <div class="request-form-wrapper">
        <div class="notice-wrapper">
            <p><%= zh_lorem_paragraphs(3) %></p>
        </div>
        <div class="form-group">
            <label class="form-label fw-bold fs-5">申請類型</label>
            <div class="form-check cp-check">
                <label class="form-check-label fw-bold mb-2">文件繳交</label>
                <div>
                    <div class="upload-wrapper fluid-wrapper">
                        <div class="upload-item border-0 p-0">
                            <div class="mb-3">
                                <label class="form-label fw-bold">繳交文件名稱</label>
                                <p><a href="#" class="btn btn-light btn-rounded">est aut non quae.pdf</a></p>
                            </div>
                        </div>
                        <div class="upload-item border-0 p-0">
                            <div class="mb-3">
                                <label class="form-label fw-bold">繳交文件名稱</label>
                                <p><a href="#" class="btn btn-light btn-rounded">est aut non quae.pdf</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-check cp-check">
                <label class="form-check-label fw-bold mb-2">展延申請</label>
                <div>
                    <div class="upload-wrapper fluid-wrapper">
                        <div class="upload-item border-0 p-0">
                            <div class="mb-3">
                                <label class="form-label fw-bold">繳交文件名稱</label>
                                <p><a href="#" class="btn btn-light btn-rounded">est aut non quae.pdf</a></p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">展延期限</label>
                                <input type="date" class="form-control" id="extensionDeadline" value="2026-06-01" disabled readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label for="notesTextarea" class="form-label fw-bold fs-5">備註說明</label>
            <textarea type="text" class="form-control" id="notesTextarea" rows="4" disabled readonly><%= zh_lorem_paragraphs(2) %></textarea>
        </div>
        <div class="additional-notice-outer">
            <h5>目前狀態：審查中</h5>
            <div class="additional-notice-wrapper"><%= zh_lorem_paragraphs(2) %></div>
            <div class="mt-3"><a href="#" class="btn btn-outline-primary btn-rounded"><i class="fas fa-cloud-download-alt"></i> 國內派遣證明函.pdf</a></div>
        </div>
    </div>
    <div class="form-action border-0 mt-0">
        <span class="backhome">
            <a href="#" class="btn btn-lg btn-light"><i class="fas fa-long-arrow-alt-left"></i> 返回</a>
        </span>
        <button type="button" class="btn btn-lg btn-outline-primary">重新繳交</button>
    </div>
</div>



<% content_for :js do %>

<% end %>

