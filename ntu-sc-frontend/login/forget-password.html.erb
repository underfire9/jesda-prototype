<!-- template: 忘記密碼 -->
<div class="workspace" canvas="container">
    <h1 class="h1-brands">
        <span class="brands-logo">國立教育廣播電臺</span>
    </h1>
    <div class="language-switcher">
        <a href="?lang=en" title="English"><span>EN</span></a>
    </div>
    <div class="login-page">
        <div class="login-container">
            <div class="login-card">
                <div class="card-hd">
                    <h4 class="text-center mb-5">忘記密碼</h4>
                </div>
                <div class="card-bd">
                    <div class="form-group">
                        <label for="exampleFormControlInput1" class="form-label">註冊信箱</label>
                        <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="name@example.com" />
                        <div class="form-text">送出後你會收到一封重設密碼郵件，請點擊郵件中的連結進行密碼重置</div>
                    </div>
                    <div class="form-group">
                        <label for="loginInput4" class="form-label">驗證碼</label>
                        <div class="d-flex align-items-center">
                            <span class="me-1" style="width: 160px;"><input type="text" class="form-control" id="loginInput4" /></span>
                            <span class="me-1"><img class="captcha" src="http://nfu-map.dev.com.tw/common/captcha.image" /></span>
                            <span>
                                <button class="btn btn-outline-dark" type="button"><i class="fas fa-sync-alt"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="login-action d-grid">
                    <button class="btn btn-lg btn-main" type="submit">送出</button>
                </div>
                <div class="bottom-link"><a href="login.html">返回登入</a></div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

