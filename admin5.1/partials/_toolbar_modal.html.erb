    class="modal fade"
    id="modalPreview"
    tabindex="-1"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    role="dialog"
    aria-labelledby="previewModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-datatable modal-datatable-medium">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewModalLabel">寄件預覽</h5>
            </div>
            <div class="modal-body">
                <div class="mail-content">
                    <div class="mail-operating-header">
                        <div class="operating-left">
                            <button type="button" class="btn btn-previous">
                                <i class="fa fa-chevron-left"></i>
                                <span>上一位</span>
                            </button>
                        </div>
                        <div class="operating-center">
                            <div class="d-inline-block">
                                <select class="form-select operating-select">
                                    <option selected>陳麒文 lilycheng@nctu.edu.tw</option>
                                    <option>林韋廷 maggic@nctu.edu.tw</option>
                                    <option>吳晨璿 leehow@nctu.edu.tw</option>
                                    <option>楊佳昕 whang@nctu.edu.tw</option>
                                </select>
                            </div>
                            <button
                                type="button"
                                data-bs-toggle="modal"
                                data-bs-target="#modalAddresseeTable"
                                class="btn btn-list"
                                title="列表"
                            >
                                <i class="fa fa-th-list"></i>
                            </button>
                        </div>
                        <div class="operating-right">
                            <button type="button" class="btn btn-next">
                                <span>下一位</span>
                                <i class="fa fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mail-compose">
                        <div class="form-group row">
                            <label class="col-sm-2 col-form-label">收件人</label>
                            <div class="col-sm-10">
                                <div class="form-control">陳麒文 &lt;lilycheng@nctu.edu.tw&gt;</div>
                            </div>
                        </div>
                        <div class="form-group row last">
                            <label class="col-sm-2 col-form-label" for="subject">主旨</label>
                            <div class="col-sm-10">
                                <div class="form-control">Keep Calm and Carry On</div>
                            </div>
                        </div>
                    </div>
                    <div
                        class="editor-wrapper"
                        style="border: 1px solid #eee; margin: 0 1.25rem 1.25rem; height: 450px"
                    >
                        <!-- ckeditor 放這裡，請將 .editor-wrapper 的 inline style 拿掉 -->
                        <p>
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean ut vehicula nibh. Nullam ut
                            nisi sollicitudin, fringilla orci quis, iaculis magna. Nulla vitae nisl pulvinar, varius
                            elit at, vestibulum est. Aliquam erat volutpat. Aliquam finibus orci a lorem mattis, et
                            viverra libero cursus. Phasellus facilisis id nunc eu consequat. Integer eleifend, nunc vel
                            tincidunt iaculis, augue velit interdum arcu, et ullamcorper metus sapien gravida leo.
                        </p>
                    </div>
                    <div class="editor-files-wrapper">
                        <div class="editor-files-inner">附加檔案</div>
                        <div class="d-flex flex-wrap align-items-center">
                            <div class="file-wrapper exhibit">
                                <div class="file-name">Datacolor Spyder3Express_.pdf</div>
                            </div>
                            <div class="file-wrapper exhibit">
                                <div class="file-name">Dani_Box_Mini_manual.pdf</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-trtransparent" data-bs-target="#modalEmail" data-bs-toggle="modal">
                    返回
                </button>
                <button type="button" class="btn btn-primary">寄送</button>
            </div>
        </div>
    </div>
</div>

<!-- 批次寄送/收件人清單 Modal -->
<div
    class="modal fade"
    id="modalAddressee"
    tabindex="-1"
    role="dialog"
    aria-labelledby="previewModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-datatable modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewModalLabel">所有收件人</h5>
                <button type="button" class="btn-close" data-bs-target="#modalEmail" data-bs-toggle="modal"></button>
            </div>
            <div class="modal-body">
                <div class="modal_addressee">
                    <ul class="menu-item modal-addressee-list">
                        <% (1..128).each do |n| %>
                        <li>
                            <span class="name"><%= zh_lorem_name %></span>
                            <span class="email">(<%= lorem_email %>)</span>
                        </li>
                        <% end %>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 批次寄送/寄件預覽所有收件人 Modal -->
<div
    class="modal fade modal_addressee_table"
    id="modalAddresseeTable"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    tabindex="-1"
    role="dialog"
    aria-labelledby="previewModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-datatable modal-datatable-medium modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewModalLabel">寄件預覽 所有收件人</h5>
            </div>
            <div class="modal-body">
                <div class="integral-head">
                    <div>
                        <button type="button" class="btn btn-sm btn-secondary btn-rounded">全選</button>
                        <div class="integral-search">
                            <input
                                type="search"
                                class="form-control form-control-sm"
                                placeholder="搜尋"
                                aria-controls="addresseeTable"
                            />
                        </div>
                    </div>
                    <div>
                        <span>1 - 30 共 1789 筆</span>
                        <div
                            class="btn-group btn-group-sm d-inline-block unshadow ml-2"
                            role="group"
                            aria-label="pagination"
                        >
                            <button type="button" class="btn btn-white">
                                <i class="fa fa-chevron-left mr-0"></i>
                            </button>
                            <button type="button" class="btn btn-white">
                                <i class="fa fa-chevron-right mr-0"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal_addressee modal_addressee_table">
                    <div class="addressee-table" role="table" aria-label="寄件預覽收件人清單">
                        <div class="addressee-row" role="row">
                            <div class="addressee-cell cell-check" role="cell">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" id="" />
                                </div>
                            </div>
                            <div class="addressee-cell cell-name" role="cell"><%= zh_lorem_name %></div>
                            <div class="addressee-cell cell-message" role="cell">
                                <div class="message-main"><%= lorem_sentence %></div>
                                <div class="message-status text-muted">已送出，送出時間2020-01-08 09:29</div>
                            </div>
                            <div class="addressee-cell cell-action" role="cell">
                                <!--div class="btn-group btn-group-sm unshadow" role="group" aria-label="action button">
                                    <button type="button" class="btn btn-me">重新寄送</button>
                                    <button type="button" class="btn btn-me">寄給自己</button>
								</div-->
                                <button type="button" class="btn btn-sm btn-me btn-loading">
                                    <svg
                                        class="spinner"
                                        width="65px"
                                        height="65px"
                                        viewBox="0 0 66 66"
                                        xmlns="http://www.w3.org/2000/svg"
                                    >
                                        <circle
                                            class="path"
                                            fill="none"
                                            stroke-width="6"
                                            stroke-linecap="round"
                                            cx="33"
                                            cy="33"
                                            r="30"
                                        ></circle>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <% (1..2).each do |n| %>
                        <div class="addressee-row" role="row">
                            <div class="addressee-cell cell-check" role="cell">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="" />
                                    <label class="custom-control-label" for=""></label>
                                </div>
                            </div>
                            <div class="addressee-cell cell-name" role="cell"><%= zh_lorem_name %></div>
                            <div class="addressee-cell cell-message" role="cell">
                                <div class="message-main"><%= zh_lorem_sentence %></div>
                                <div class="message-status text-muted">已送出，送出時間2020-01-08 09:29</div>
                            </div>
                            <div class="addressee-cell cell-action" role="cell">
                                <div class="btn-group btn-group-sm unshadow" role="group" aria-label="action button">
                                    <button type="button" class="btn btn-me">重新寄送</button>
                                    <button type="button" class="btn btn-me">寄給自己</button>
								</div>
                            </div>
                        </div>
                        <% end %>
                        <% (1..40).each do |n| %>
                        <div class="addressee-row" role="row">
                            <div class="addressee-cell cell-check" role="cell">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" id="" />
                                    <label class="custom-control-label" for=""></label>
                                </div>
                            </div>
                            <div class="addressee-cell cell-name" role="cell"><%= zh_lorem_name %></div>
                            <div class="addressee-cell cell-message" role="cell">
                                <div class="message-main"><%= lorem_sentence %></div>
                            </div>
                            <div class="addressee-cell cell-action" role="cell">
                                <button type="button" class="btn btn-sm btn-me">寄給自己</button>
                            </div>
                        </div>
                        <% end %>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-target="#modalPreview" data-bs-toggle="modal">返回</button>
                <button type="button" class="btn btn-primary">確認寄送</button>
                <div class="send-success">寄送完成，成功1封、失敗0封</div>
                <button type="button" class="btn btn-dark">重新寄送所有失敗郵件</button>
            </div>
        </div>
    </div>
</div>

<!-- 匯出 Modal -->
<div
    class="modal fade"
    id="outboundModal"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    tabindex="-1"
    aria-labelledby="outboundModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-datatable modal-datatable-medium">
        <div class="modal-content">
            <div class="modal-header">

                <!-- modal-title 下方有簡短說明時才多包一層 div -->
                <div>
                    <h1 class="modal-title fs-5 fw-bold" id="outboundModalLabel"><i class="bi bi-file-earmark-excel text-success me-1"></i> 匯出 Excel</h1>
                    <div class="outbound-note">選擇匯出欄位、調整順序，並可儲存為常用匯出範本</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="outbound-wrapper">
                    <div class="outbound-toolbar">
                        <div class="start-group">
                            <div class="btn-group">
                                <button type="button" id="outboundSelectAll" class="btn btn-sm btn-secondary"><i class="far fa-check-square"></i> 全選</button>
                                <button type="button" id="outboundDeselectAll" class="btn btn-sm btn-secondary"><i class="far fa-square"></i> 取消</button>
                            </div>
                            <div class="btn-group">
                                <button type="button" id="outboundSaveTemplate" class="btn btn-sm btn-outline-white" data-bs-target="#outboundSaveToggle" data-bs-toggle="modal"><i class="far fa-save"></i> 儲存範本</button>
                                <button type="button" id="outboundSelectTemplate" class="btn btn-sm btn-outline-white" data-bs-target="#outboundChooseToggle" data-bs-toggle="modal"><i class="far fa-check-circle"></i> 選擇範本</button>
                            </div>
                        </div>
                        <div class="end-group">
                            <button type="button" class="btn btn-sm btn-primary px-4">匯出 <i class="fas fa-share ms-2"></i></button>
                        </div>
                    </div>
                    <div class="wrapper-inner">
                        <div class="data-list">
                            <h5>欄位清單</h5>
                            <ul class="outbound-menu menu-item">
                                <% (1..20).map do |i| %>
                                <li class="data-item">
                                    <span class="item-number"></span>
                                    <span class="item-title"><%= lorem_words(4) %></span>
                                    <button class="btn btn-light"></button>
                                </li>
                                <% end %>
                            </ul>
                        </div>
                        <div class="outbound-list">
                            <h5>匯出欄位</h5>
                            <ul class="outbound-menu menu-item">
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- 匯出 / 儲存範本 Modal -->
<div
    class="modal fade"
    id="outboundSaveToggle"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    aria-hidden="true"
    aria-labelledby="outboundSaveToggleLabel"
    tabindex="-1"
>
    <div class="modal-dialog modal-datatable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="outboundSaveToggleLabel">儲存範本</h1>
            </div>
            <div class="modal-body">
                <div>
                    <input type="text" class="form-control" id="templateName" placeholder="請輸入範本名稱">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-target="#outboundModal" data-bs-toggle="modal">
                    取消
                </button>
                <button type="submit" class="btn btn-primary" data-bs-target="#outboundModal" data-bs-toggle="modal">
                    儲存
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 匯出 / 選擇範本 Modal -->
<div
    class="modal fade"
    id="outboundChooseToggle"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    aria-hidden="true"
    aria-labelledby="outboundChooseToggleLabel"
    tabindex="-1"
>
    <div class="modal-dialog modal-datatable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="outboundChooseToggleLabel">選擇範本</h1>
            </div>
            <div class="modal-body">
                <ul class="menu-item outbound-template-list">
                    <% (1..6).map do |i| %>
                    <li class="template-item">
                        <span>
                            <button type="button" class="btn btn-choose" data-bs-target="#outboundModal" data-bs-toggle="modal" title="選擇範本"><i class="fas fa-check"></i></button>
                        </span>
                        <span>
                            <button type="button" class="btn btn-delete" data-bs-target="#outboundDeleteToggle" data-bs-toggle="modal" title="刪除範本"><i class="far fa-trash-alt"></i></button>
                        </span>
                        <span class="template-name"><%= lorem_words(2) %></span>
                    </li>
                    <% end %>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-target="#outboundModal" data-bs-toggle="modal">取消</button>
            </div>
        </div>
    </div>
</div>

<!-- 匯出 / 刪除範本 Modal -->
<div
    class="modal fade"
    id="outboundDeleteToggle"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    aria-hidden="true"
    aria-labelledby="outboundDeleteToggleLabel"
    tabindex="-1"
>
    <div class="modal-dialog modal-datatable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="outboundDeleteToggleLabel">確定刪除範本嗎?</h1>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-target="#outboundChooseToggle" data-bs-toggle="modal">取消</button>
                <button type="submit" class="btn btn-danger" data-bs-target="#outboundChooseToggle" data-bs-toggle="modal">確定</button>
            </div>
        </div>
    </div>
</div>

<!-- 多重排序 Modal -->
<div
