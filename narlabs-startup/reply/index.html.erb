<!-- template: 技術需求媒合表 -->

<div class="reply-container">
    <div class="container-lg">
        <div class="expose-wrap">
            <h4><%= zh_lorem_name %> 教授您好：</h4>
            <p>經過媒合評估，您的專長高度符合使用者的技術需求。我們誠摯邀請您參與此技術媒合，請回覆您的參與意願。感謝您的時間與支持！</p>
        </div>
        <div class="form-group">
            <label class="form-label">公司名稱</label>
            <input type="text" class="form-control" value="捷思達數位開發" readonly />
        </div>
        <div class="form-group">
            <label class="form-label">主題</label>
            <textarea class="form-control" rows="4" readonly><%= lorem_paragraph %></textarea>
        </div>

        <div class="confirm-wrap">
            <h5>請問您是否有意願參加學界解題技術揭露</h5>
            <div class="mb-3">
                <button type="button" onclick="location.href='reply-form.html';" class="btn btn-lg px-5 me-1 btn-main">願意</button>
                <button type="button" onclick="location.href='unwilling.html';" class="btn btn-lg btn-outline-secondary">不願意</button>
            </div>
            <div class="form-text">如尚未登入或註冊，系統會帶領您進行下一個動作</div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

