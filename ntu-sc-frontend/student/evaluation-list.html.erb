<!-- template: 學生 / 評鑑列表 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title mobile-only">
            <h3>評鑑填寫</h3>
        </div>
        <div class="row">
            <div class="col-lg-3">
                <div class="mb-3">blah blah <%= lorem_sentence %></div>
                <div class="mb-3">
                    <select class="form-select w-auto" aria-label="選擇年度">
                        <option selected>115</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
                <div class="mb-3">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="課程名稱、開課學校" aria-label="Recipient’s username" aria-describedby="button-addon2">
                        <button class="btn btn-outline-secondary" type="button" id="button-addon2"><i class="fas fa-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="row">
                    <div class="col-md-6">
                        <div class="border rounded-3 p-4 mb-4">
                            <h4 class="mb-4"><%= lorem_words(8) %></h4>
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">課程編號</span>
                                <span class="d-block">25N002</span>
                            </div>
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">授課教師</span>
                                <span class="d-block has-multiple-values">
                                    <span><%= zh_lorem_name %></span>
                                    <span><%= zh_lorem_name %></span>
                                    <span><%= zh_lorem_name %></span>
                                </span>
                                <div class="d-flex align-items-center gap-2 mt-2">
                                    <a href="#" class="btn btn-secondary">瀏覽</a>
                                    <div class="form-text mb-1">送出時間：YYYY/MM/DD HH:mm</div>
                                </div>
                            </div>
                            <div class="py-2">
                                <span class="d-block text-secondary fs-6">助教</span>
                                <span class="d-block">
                                    <span class="d-inline-block me-1"><%= zh_lorem_name %></span>
                                    <span class="d-inline-block me-1">, <%= zh_lorem_name %></span>
                                </span>
                                <div class="mt-2"><a href="#" class="btn btn-primary">助教評鑑題目</a></div>
                            </div>
                        </div>
                    </div>
                    <% (1..2).map do |i| %>
                    <div class="col-md-6">
                        <div class="border rounded-3 p-4 mb-4">
                            <h4 class="mb-4"><%= lorem_words(8) %></h4>
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">課程編號</span>
                                <span class="d-block">25N002</span>
                            </div>
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">授課教師</span>
                                <span class="d-block has-multiple-values">
                                    <span><%= zh_lorem_name %></span>
                                    <span><%= zh_lorem_name %></span>
                                    <span><%= zh_lorem_name %></span>
                                </span>
                                <div class="mt-2"><a href="#" class="btn btn-primary">老師評鑑題目</a></div>
                            </div>
                            <div class="py-2">
                                <span class="d-block text-secondary fs-6">助教</span>
                                <span class="d-block">
                                    <span class="d-inline-block me-1"><%= zh_lorem_name %></span>
                                    <span class="d-inline-block me-1">, <%= zh_lorem_name %></span>
                                </span>
                                <div class="mt-2"><a href="#" class="btn btn-primary">助教評鑑題目</a></div>
                            </div>
                        </div>
                    </div>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

