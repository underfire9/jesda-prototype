<!-- template: 各項工作報告 - 期中報告 -->

<div class="container-lg">
    <div class="leave-container-head">
        <h2 class="mb-0 fw-light">期中報告</h2>
    </div>
    <div class="request-form-wrapper">
        <div class="notice-wrapper">
            <p><%= zh_lorem_paragraphs(5) %></p>
        </div>
        <div class="form-group">
            <label for="reportPaper" class="form-label fw-bold">期中{期末}報告論文或專書名稱</label>
            <input type="text" id="reportPaper" name="reportPaper" class="form-control">
        </div>
        <div class="upload-wrapper fluid-wrapper">
            <!-- 檔案上傳後多出 .file-pill，當再次上傳時則覆蓋上一筆，點選檔名另開視窗觀看文件 -->
            <div class="upload-item border-0 p-0">
                <div class="mb-3">
                    <label for="interimReport" class="form-label fw-bold">期中報告</label>
                    <p>如果有說明放在這裡</p>
                    <input class="form-control" type="file" id="interimReport">
                    <div class="form-text">檔案格式限制 : pdf、jpg、png、gif，檔案大小限制 : 10MB</div>
                </div>
                <div class="ft-action">
                    <span>
                        <div class="file-pill">
                            <!-- 避免檔名過長有限制最大寬度 256px，超出時會字元會省略 -->
                            <a href="#" target="_blank" class="filename"><%= lorem_sentence %>.pdf</a>
                            <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </span>
                </div>
            </div>
            <div class="upload-item border-0 p-0">
                <div class="mb-3">
                    <label for="otherReport" class="form-label fw-bold">其他檔案名稱很長</label>
                    <input class="form-control" type="file" id="otherReport">
                    <div class="form-text">檔案格式限制 : pdf、jpg、png、gif，檔案大小限制 : 10MB</div>
                </div>
                <div class="ft-action">
                    <span>
                        <div class="file-pill">
                            <!-- 避免檔名過長有限制最大寬度 256px，超出時會字元會省略 -->
                            <a href="#" target="_blank" class="filename"><%= lorem_sentence %>.pdf</a>
                            <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="form-action border-0 pt-0">
        <button type="button" class="btn btn-lg btn-outline-primary">暫存</button>
        <button type="submit" class="btn btn-lg btn-primary">送出</button>
    </div>
</div>



<% content_for :js do %>

<% end %>

