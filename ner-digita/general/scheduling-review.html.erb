<!-- template: 排播紀錄 - 審查 -->
<div class="page-content">
    <div class="container-lg">

        <div class="scheduling-review-container">
            <div class="back-wrap">
                <a href="scheduling.html" class="btn btn-lg btn-block btn-light" title="返回排播紀錄"><img src="../assets/arrow-left-long.svg" /></a>
            </div>
            <div class="scheduling-data-wrapper">
                <div class="page-title">
                    <h3>審查排播</h3>
                </div>
                <div class="data-head">
                    <div class="head-start">
                        <span class="data-label">播報時間</span>
                        <span class="data-output">2025-12-12 12:00</span>
                    </div>
                    <div class="head-end">
                        <span class="data-label">播報人員</span>
                        <span class="data-output"><%= zh_lorem_name %></span>
                    </div>
                </div>
                <div class="data-body">
                    <span class="data-label">排程表</span>
                    <ol class="data-list">
                        <li class="list-item">
                            鏟子超人注意了 疾管署提供花蓮光復鄉公費疫苗接種
                        </li>
                        <% (1..5).map do |i| %>
                        <li class="list-item">
                            <%= lorem_sentence %>
                        </li>
                        <% end %>
                    </ol>
                </div>
            </div>
            <div class="pass-wrap">
                <button type="button" class="btn btn-lg btn-block btn-outline-main">審查通過</button>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>

<% end %>

