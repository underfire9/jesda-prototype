<!-- template: 首頁 (已登入) -->

<div class="container-lg">
	<div class="page-content d-block">
        <div class="partner-wrap">
            <div class="wrap-title">
                <h4>執行中合作學校</h4>
            </div>
            <table class="table table-borderless align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="text-center">期程年度</th>
                        <th scope="col">所屬計畫期數</th>
                        <th scope="col">狀態</th>
                        <th scope="col">合作學校</th>
                        <th scope="col">計畫聯絡人</th>
                        <th scope="col" class="text-center">瀏覽申請紀錄</th>
                    </tr>
                </thead>
                <tbody>
                    <% (1..3).map do |i| %>
                    <tr>
                        <th scope="row" class="text-center">114</th>
                        <td>5-2 (原5-1)</td>
                        <td>已核准</td>
                        <td>加州大學爾灣分校</td>
                        <td><%= zh_lorem_name %></td>
                        <td class="text-center"><a href="#" class="btn btn-outline-primary">開啟</a></td>
                    </tr>
                    <% end %>
                    <tr>
                        <th scope="row" class="text-center">115</th>
                        <td>5-2</td>
                        <td>申請中</td>
                        <td>猶他科技大學</td>
                        <td><%= zh_lorem_name %></td>
                        <td class="text-center"><a href="#" class="btn btn-outline-primary">開啟</a></td>
                    </tr>
                </tbody>
            </table>
            <span class="maintain-link">
                <a href="#"><i class="fas fa-tools text-secondary me-1"></i> 承辦人通訊錄維護</a>
            </span>
        </div>

        <div class="progress-wrap">
            <div class="wrap-title">
                <h4>計畫申請及進度瀏覽</h4>
            </div>
            <div class="mb-3">
                <div class="d-inline-block me-1">
                    <select class="form-select" aria-label="Default select example">
                        <option value="1" selected>115 年第 5-2 期</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select> 
                </div>
                <div class="d-inline-block"><a href="#" class="btn btn-primary">前往</a></div>
            </div>
            <p>申請開放時間：2025 年 06 月 01 日 09:00 至 2025 年 09 月 30 日 18:00</p>
            <div class="step-bar four-step">
                <ul>
                    <li class="done">
                        <span>
                            <span class="step">1</span>
                            <h4>計畫申請</h4>
                            <p class="brief">2025-06-12 14:31</p>
                        </span>
                    </li>
                    <li class="active">
                        <span>
                            <span class="step">2</span>
                            <h4>審查會議</h4>
                            <p class="brief">2025-06-16 10:00</p>
                        </span>
                    </li>
                    <li>
                        <span>
                            <span class="step">3</span>
                            <h4>計畫核定</h4>
                        </span>
                    </li>
                    <li>
                        <span>
                            <span class="step">4</span>
                            <h4>學校回覆修正計畫書</h4>
                        </span>
                    </li>
                    <li>
                        <span>
                            <span class="step">5</span>
                            <h4>計畫結案</h4>
                        </span>
                    </li>
                </ul>
            </div>

            <div class="alert alert-primary" role="alert">
                <div>
                    初審結果：通過
                </div>
            </div>

            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <i class="fas fa-exclamation-circle me-3"></i>
                <div>
                    您有 2 件待補件 <a href="#" class="alert-link ms-2">前往補件</a>
                </div>
            </div>

            <div class="alert alert-success" role="alert">
                <div>
                    審查結果公告日期：2025/08/20 11:00 <a href="#" class="alert-link ms-2">瀏覽核定金額</a>
                </div>
            </div>
        </div>

        <div class="">
            <div class="wrap-title">
                <h4>計畫績效填報</h4>
            </div>
            <div class="row">
                <div class="col-6">
                    <div class="card customized-card">
                        <div class="card-head">
                            <h5>優華語計畫</h5>
                        </div>
                        <div class="card-body">
                            <h6>績效回報起訖時間</h6>
                            <p class="project-calendar"><i class="far fa-calendar-alt"></i> 2024 年 02 月 10 日 12:00  至  2024 年 05 月 20 日 18:00</p>
                            <div>
                                <a href="#" class="btn btn-primary">前往</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card customized-card">
                        <div class="card-head">
                            <h5>海外華語教學中心</h5>
                        </div>
                        <div class="card-body">
                            <h6>績效回報起訖時間</h6>
                            <p class="project-calendar"><i class="far fa-calendar-alt"></i> 2024 年 02 月 10 日 12:00  至  2024 年 05 月 20 日 18:00</p>
                            <div>
                                <a href="#" class="btn btn-primary">前往</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
	</div>
</div>

<% content_for :js do %>

<% end %>
