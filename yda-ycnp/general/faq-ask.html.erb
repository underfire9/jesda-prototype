<!-- template: 我要提問 -->

<div class="container-lg">
    <div class="page-content">
        <div class="ask-wrapper">
            <div class="wrap-start">
                <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
                <h3>我要提問</h3>
                <p>提問、回答機制介紹，檔案上傳相關限制說明，使用者應遵守的規範等。</p>
            </div>
            <div class="wrap-end">
                <div class="form-group">
                    <label for="ask-email" class="form-label">聯絡信箱</label>
                    <input type="email" class="form-control" id="ask-email" placeholder="username@email.com">
                </div>
                <div class="form-group">
                    <label for="ask-email" class="form-label">提問內容</label>
                    <textarea class="form-control" id="ask-content" rows="8" placeholder="請輸入您的問題"></textarea>
                </div>
                <div class="form-group">
                    <label for="ask-file" class="form-label">附件上傳</label>
                    <input type="file" class="form-control" id="ask-file">
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">送出提問</button>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

