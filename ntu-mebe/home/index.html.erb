<% content_for :js do %>
<script src="../javascripts/gsap.min.js"></script>
<script src="../javascripts/ScrollTrigger.min.js"></script>
<script>

	// 首頁背景圖片
	document.addEventListener("DOMContentLoaded", function() {
		var landing = document.querySelector('.landing-content');
		if (landing) {
			landing.style.backgroundImage = "url('../assets/fake/hero.jpg')";
			landing.style.backgroundSize = "cover";
			landing.style.backgroundPosition = "center";
			landing.style.backgroundRepeat = "no-repeat";
		}
		// Optionally remove the <img> if you want
		var heroImg = landing.querySelector('.hero');
		if (heroImg) {
			heroImg.remove();
		}
	});

	// GSAP 與 ScrollTrigger 實現 landing-content 固定與 home-content 上移覆蓋
	gsap.registerPlugin(ScrollTrigger);

	gsap.to(".landing-content", {
		scrollTrigger: {
			trigger: ".landing-content",
			start: "top top",
			end: "bottom top",
			scrub: true,
			pin: true,
			pinSpacing: false
		}
	});

	// 當 .header-nav 顯示時，隱藏 .mouse-semicircle
	const headerNav = document.querySelector('.header-nav');
	const mouseSemicircle = document.querySelector('.mouse-semicircle');

	const observer = new MutationObserver(() => {
		if (headerNav && mouseSemicircle) {
			const isShown = headerNav.classList.contains('show');
			mouseSemicircle.style.display = isShown ? 'none' : '';
		}
	});

	if (headerNav && mouseSemicircle) {
		observer.observe(headerNav, { attributes: true, attributeFilter: ['class'] });
		// 初始化狀態
		const isShown = headerNav.classList.contains('show');
		mouseSemicircle.style.display = isShown ? 'none' : '';
	}
	
</script>

<% end %>

