<!-- template: 審查委員 - 聯絡計畫辦公室 -->

<div class="container-lg">
    <h3 class="mb-4 fw-light">聯絡計畫辦公室</h3>
	<div class="committee-contact">
        <div class="contact-start">  
            <div class="committee-contact-info">
                <button class="btn btn-zoom"><i class="fas fa-times"></i></button>
                <div class="info-inner">
                    <p>說明文案如有任何關於審查程序的問題請聯絡計畫辦公室，我們將盡快回覆您的詢問，謝謝！</p>
                </div>
            </div>
            <div class="textarea-wrapper">
                <textarea class="form-control" rows="6"></textarea>
                <div class="upload-wrapper fluid-wrapper my-3">
                    <div class="upload-item border-0 p-0 mb-0">
                        <div class="mb-3">
                            <input class="form-control" type="file" id="document3" multiple>
                            <div class="form-text">檔案格式限制 : pdf、jpg、png、gif，檔案大小限制 : 10MB</div>
                        </div>
                        <div class="ft-action flex-wrap">
                            <span class="me-2 mb-2">
                                <div class="file-pill">
                                    <!-- 避免檔名過長有限制最大寬度 256px，超出時會字元會省略 -->
                                    <a href="#" target="_blank" class="filename"><%= lorem_words(4) %>.pdf</a>
                                    <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </span>
                            <span class="me-2 mb-2">
                                <div class="file-pill">
                                    <!-- 避免檔名過長有限制最大寬度 256px，超出時會字元會省略 -->
                                    <a href="#" target="_blank" class="filename"><%= lorem_words(2) %>.pdf</a>
                                    <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </span>
                            <span class="me-2 mb-2">
                                <div class="file-pill">
                                    <!-- 避免檔名過長有限制最大寬度 256px，超出時會字元會省略 -->
                                    <a href="#" target="_blank" class="filename"><%= lorem_words(5) %>.pdf</a>
                                    <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="d-flex align-items-center">
                        <span class="me-1"><input type="text" class="form-control" id="loginInput4"></span>
                        <span class="me-1"><img class="captcha" src="http://nfu-map.dev.com.tw/common/captcha.image"></span>
                        <span>
                            <button class="btn btn-xs btn-outline-primary" type="button"><i class="fas fa-sync-alt"></i></button>
                        </span>
                    </div>
                </div>
                <div class="form-action mt-4 pt-4 text-end">
                    <button type="button" class="btn btn-lg btn-primary">送出</button>
                </div>
            </div>
        </div>
        <div class="contact-end">
            <div class="messages-wrapper">
                <div class="character align-items-start oneself">
                    <div class="d-flex align-items-center">
                        <div class="avatar">
                            <img alt="Pic" src="../assets/default-avatar.svg">
                        </div>
                        <div>
                            <spa class="symbol">我
                            <span class="text-clock">3 分鐘前</span>
                        </spa></div>
                    </div>
                    <div class="messages-item">
                        <p>Discover what students who viewed Learn Figma - UI/UX Design. Essential Training also viewed</p>
                    </div>
                </div>
                <div class="character align-items-start">
                    <div class="d-flex align-items-center">
                        <div class="avatar">
                            <img alt="Pic" src="../assets/stpi-avatar.png">
                        </div>
                        <div>
                            <spa class="symbol">計畫辦公室
                            <span class="text-clock">3 小時前</span>
                        </spa></div>
                    </div>
                    <div class="messages-item">
                        <p>Most purchased Business courses during this sale!</p>
                    </div>
                </div>
                <div class="character align-items-start oneself">
                    <div class="d-flex align-items-center">
                        <div class="avatar">
                            <img alt="Pic" src="../assets/default-avatar.svg">
                        </div>
                        <div>
                            <spa class="symbol">我
                            <span class="text-clock">2 天前</span>
                        </spa></div>
                    </div>
                    <div class="messages-item">
                        <p><%= zh_lorem_paragraph %></p>
                        <div class="file-wrap">
                            <a href="#" class="pdf-file">檔案名稱.pdf</a>
                            <a href="#" class="excel-file">Tempore nostrum voluptatem repellat eaque cumque.xls</a>
                            <a href="#" class="doc-file">檔案名稱.docx</a>
                            <a href="#" class="text-file">檔案名稱.txt</a>
                            <a href="#" class="zip-file">壓縮檔名稱.zip</a>
                        </div>
                    </div>
                </div>
                <% (1..6).map do |i| %>
                <div class="character align-items-start oneself">
                    <div class="d-flex align-items-center">
                        <div class="avatar">
                            <img alt="Pic" src="../assets/default-avatar.svg">
                        </div>
                        <div>
                            <spa class="symbol">我
                            <span class="text-clock">3 天前</span>
                        </spa></div>
                    </div>
                    <div class="messages-item">
                        <p><%= lorem_paragraph %></p>
                    </div>
                </div>
                <% end %>
            </div>
        </div>
	</div>
</div>



<% content_for :js do %>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnZoom = document.querySelector('.btn-zoom');
    const contactInfo = document.querySelector('.committee-contact-info');
    const icon = btnZoom ? btnZoom.querySelector('i') : null;

    if (!btnZoom || !contactInfo || !icon) return;

    btnZoom.addEventListener('click', function() {
        contactInfo.classList.toggle('block-hide');
        btnZoom.classList.toggle('wrap-hide');
        icon.classList.toggle('fa-times');
        icon.classList.toggle('fa-info');
    });
});
</script>

<% end %>

