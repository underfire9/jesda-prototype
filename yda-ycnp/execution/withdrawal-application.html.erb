<!-- template: 執行 - 退出計畫申請 -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="wrapper-inner">
            
            <%= render :partial => "/partials/execution_sidenav" %>

            <main class="main">
                <div class="content-title">
                    <h3>退出計畫</h3>
                </div>
                <form action="home.html" method="post" enctype="multipart/form-data">
                    <div class="withdrawal-container">
                        <section class="form-section">
                            <div class="notice-wrapper generally-notice">
                                <h5>相關權益須知</h5>
                                <ol class="notice-list">
                                    <li>本人已瞭解「青年教育與就業儲蓄帳戶方案」、「青年就業領航計畫」、「教育部青年儲蓄帳戶補助要點」等規定及相關權利義務。</li>
                                    <li>本人未於執行領航計畫期間，重複領取本部其他為促進就業之相關補助或獎勵金。</li>
                                    <li>本人已於申請青年儲蓄帳戶提領前填寫完整體驗學習雙週誌，並已瞭解如有缺漏，在補填完成前教育部將暫緩發付準備金。</li>
                                    <li>本人已瞭解於執行計畫期間，如有違反規定並經查證屬實將不予補助。</li>
                                    <li>本人已瞭解「青年儲蓄帳戶」儲蓄金金額依照勞動部提供之青年就業保險起迄日、實際就業狀況，檢核是否違反本須知第1點相關規定等情況，並經勞動部及教育部確認金額後匯款。</li>
                                    <li>本人已瞭解「青年儲蓄帳戶」儲蓄金作業流程會參考「教育部青年儲蓄帳戶補助要點」，儲蓄金審核須確認青年就業保險日、實際與計畫執行狀況，並經勞動部與教育部審核核發款流程，本人同意教育部為保障青年權益，自通過申請資格審查或通過計畫完成資格審查後起算，至完成撥付青年儲蓄帳戶，作業時間約需3-6個月（送件順序以申請日期排序，並依申請人數多寡會有作業時間調整）。</li>
                                    <li>本人已瞭解務必填寫正確銀行帳號，如因資料填寫錯誤致須第2次匯款，儲蓄金匯款手續費由青年自行負擔。</li>
                                </ol>
                                <div class="d-flex justify-content-center mt-4">
                                    <div class="form-check form-check-lg">
                                        <input class="form-check-input" type="checkbox" value="" id="agreeCheck" required>
                                        <label class="form-check-label" for="agreeCheck">
                                            我已詳細閱讀上述相關權益須知
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="form-section">
                            <h5>退出方案原因</h5>
                            <div>可複選，若無對應的原因可選擇其他並輸入內容</div>
                            <div class="option-wrap">
                                <h6>個人因素</h6>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason1">
                                    <label class="form-check-label" for="withdrawalReason1">
                                        繼續升學
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason2">
                                    <label class="form-check-label" for="withdrawalReason2">
                                        依計畫規定須退出
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason3">
                                    <label class="form-check-label" for="withdrawalReason3">
                                        學非所用
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason4">
                                    <label class="form-check-label" for="withdrawalReason4">
                                        與期待不符
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason5">
                                    <label class="form-check-label" for="withdrawalReason5">
                                        家庭或健康因素
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason6">
                                    <label class="form-check-label" for="withdrawalReason6">
                                        非自願離職（如公司關廠、遷廠、休業、解散、破產宣告等）
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason7">
                                    <label class="form-check-label" for="withdrawalReason7">
                                        其他（請說明）
                                    </label>
                                    <input type="text" class="form-control other-input mt-2" id="withdrawalOtherInput1" placeholder="請輸入其他原因說明">
                                </div>
                            </div>
                            <div class="option-wrap">
                                <h6>職場因素</h6>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason8">
                                    <label class="form-check-label" for="withdrawalReason8">
                                        薪資及福利制度
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason9">
                                    <label class="form-check-label" for="withdrawalReason9">
                                        工時、工作條件、工作安全、工作環境因素
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason10">
                                    <label class="form-check-label" for="withdrawalReason10">
                                        更換工作地點
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason11">
                                    <label class="form-check-label" for="withdrawalReason11">
                                        工作壓力
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason12">
                                    <label class="form-check-label" for="withdrawalReason12">
                                        同事或主管相處問題
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason13">
                                    <label class="form-check-label" for="withdrawalReason13">
                                        工作景氣不佳
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason14">
                                    <label class="form-check-label" for="withdrawalReason14">
                                        非自願離職（如公司關廠、遷廠、休業、解散、破產宣告等）
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason15">
                                    <label class="form-check-label" for="withdrawalReason15">
                                        其他（請說明）
                                    </label>
                                    <input type="text" class="form-control other-input mt-2" id="withdrawalOtherReason" placeholder="請輸入其他原因說明">
                                </div>
                            </div>
                            <div class="option-wrap">
                                <h6>其他生涯規劃</h6>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason16">
                                    <label class="form-check-label" for="withdrawalReason16">
                                        出國讀書或工作
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason17">
                                    <label class="form-check-label" for="withdrawalReason17">
                                        準備考試
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason18">
                                    <label class="form-check-label" for="withdrawalReason18">
                                        想自行創業
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason19">
                                    <label class="form-check-label" for="withdrawalReason19">
                                        服兵役（含志願役）
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="withdrawalReason20">
                                    <label class="form-check-label" for="withdrawalReason20">
                                        其他（請說明）
                                    </label>
                                    <input type="text" class="form-control other-input mt-2" id="withdrawalOtherReason" placeholder="請輸入其他原因說明">
                                </div>
                            </div>
                            <div class="option-wrap">
                                <label for="withdrawalNote">備註說明</label>
                                <textarea class="form-control" id="withdrawalNote" rows="3" placeholder="請敘述您的問題"></textarea>
                            </div>
                        </section>
                    </div>
                    <div class="form-action">
                        <button type="submit" class="btn btn-lg btn-rounded btn-main px-5">送出</button>
                    </div>
                </form>
            </main>
        </div>
    </div>
</div>



<% content_for :js do %>
    <!-- JavaScript for handling file uploads -->
<% end %>