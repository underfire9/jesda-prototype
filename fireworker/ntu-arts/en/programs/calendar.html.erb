<div class="container page-body">
  <nav aria-label="Programme sections"><ul class="tabs subnav"><li><a class="tab" href="/en/programs/index.html">What's on</a></li><li><a class="tab is-current" href="/en/programs/calendar.html" aria-current="page">Calendar</a></li><li><a class="tab" href="/en/programs/archive.html">Archive</a></li></ul></nav>
  <div class="cal-page">
    <div class="cal-panel js-calendar" data-month="2026-10" data-mode="page" data-list="day-list">
  <div class="cal-head">
    <h2 id="cal-title-page">Calendar</h2>
    <div class="cal-nav">
