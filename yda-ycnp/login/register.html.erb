<!-- template: 申請 - 註冊 -->

<div class="container-lg">
	<div class="login-wrapper">
		<div class="login-card">
		    <div class="card-hd">
			    <h2>註冊</h2>
			</div>
			<div class="card-bd">
                <div class="form-group">
                    <label for="exampleFormControlInput0" class="form-label">身分證字號</label>
                    <input type="text" class="form-control" id="exampleFormControlInput0" />
                </div>
				<div class="form-group">
                    <label for="exampleFormControlInput1" class="form-label">登入帳號</label>
                    <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="email@example.com" />
                </div>
				<div class="form-group">
                    <label for="loginInput4" class="form-label">驗證碼</label>
                    <div class="d-flex align-items-center">
                        <span class="me-1"><input type="text" class="form-control" id="loginInput4" /></span>
                        <span class="me-1"><img class="captcha" src="http://nfu-map.dev.com.tw/common/captcha.image" /></span>
                        <span>
                            <button class="btn btn-outline-primary" type="button"><i class="fas fa-sync-alt"></i></button>
                        </span>
                    </div>
                </div>
			</div>
            <div class="d-grid mt-4">
                <button class="btn btn-lg btn-main" type="submit">送出</button>
            </div>
            <p class="mt-5 text-center">已有帳號? <a href="#">登入</a></p>
		</div>
	</div>
</div>



<% content_for :js do %>

<% end %>

