    const creditRecognitionNo = document.getElementById('creditRecognitionNo');
    const creditYesWrapper = document.querySelector('.credit-yes-wrapper');
    const creditNoWrapper = document.querySelector('.credit-no-wrapper');

    function toggleCreditRecognitionFields() {
        if (creditYesWrapper) {
