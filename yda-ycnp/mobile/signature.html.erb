<!-- template: 申請 - 電子簽章 -- mobile -->

    <div class="sign-container sign-mobile-container">
        <div class="sign-wrapper">
            <p>請在下方方框空白處簽名</p>
            <div class="sign-board">
                <canvas id="canvas" class="signature-pad"></canvas>
                <div class="sign-actions">
                    <button id="clear" class="btn btn-sm btn-rounded btn-warning">清除</button>
                    <button id="undo" class="btn btn-sm btn-rounded btn-secondary">復原</button>
                    <button id="load" class="btn btn-sm btn-rounded btn-dark">載入</button>
                </div>
            </div>
            <div class="mt-3 text-center">
                <button type="submit" class="btn btn-lg btn-primary">確認送出</button>
            </div>
        </div>
    </div>



