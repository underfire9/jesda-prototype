<!-- template: 學生 / 課程列表 -->
<div class="page-content">
    <div class="container-lg">
        <div class="row">
            <div class="col-lg-3">
                <div class="courses-sorting-bar">
                    <h5 class="mb-3">115年度可選擇課程</h5>
                    <p>選擇課程點加入即可，未送出前可隨時取消</p>
                    <div class="sorting-wrap">
                        <div class="sorting-item">
                            <select class="form-select" id="school-select-field" data-placeholder="選擇開課學校">
                                <option></option>
                                <option>Reactive</option>
                                <option>Solution</option>
                                <option>Conglomeration</option>
                                <option>Algoritm</option>
                                <option>Holistic</option>
                            </select>
                        </div>
                        <div class="sorting-item">
                            <select class="form-select" id="location-select-field" data-placeholder="選擇上課地點">
                                <option></option>
                                <option>Reactive</option>
                                <option>Solution</option>
                                <option>Conglomeration</option>
                                <option>Algoritm</option>
                                <option>Holistic</option>
                            </select>
                        </div>
                        <div class="sorting-item">
                            <label class="form-label" for="start-date-field">開課時間</label>
                            <input type="date" class="form-control" id="start-date-field">
                        </div>
                        <div class="sorting-item">
                            <select class="form-select" aria-label="就讀學校認抵">
                                <option selected>就讀學校認抵</option>
                                <option value="1">One</option>
                                <option value="2">Two</option>
                                <option value="3">Three</option>
                            </select>
                        </div>
                    </div>
                    <a href="#" class="btn btn-lg btn-link"><i class="fas fa-long-arrow-alt-left me-2"></i> 回申請列表</a>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="border rounded-3 p-4 mb-4">
                    <h4 class="d-flex align-items-center flex-wrap mb-4">
                        <small class="badge text-bg-secondary fs-6 me-2">25N000</small>
                        <span class="me-2">程式理解與觸媒體創作統合</span>
                        <small class="fs-6"><%= zh_lorem_words(5) %>類別</small>
                    </h4>
                    <div class="row">
                        <div class="col-md-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">教師</span>
                                <span class="d-block">
                                    <span class="d-inline-block me-1"><%= zh_lorem_name %></span>
                                    <span class="d-inline-block me-1">, <%= zh_lorem_name %></span>
                                    <span class="d-inline-block me-1">, <%= zh_lorem_name %></span>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-8 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">上課地點</span>
                                <span class="d-block">國立臺灣大學 校總區 7/14 博雅教學館408電腦教室</span>
                            </div>
                        </div>
                        <div class="col-md-12 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">日期</span>
                                <span class="d-block">2025-10-31 ~ 2025-12-31　週二13:20-17:20</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">報名</span>
                                <span class="d-block">16</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">錄取</span>
                                <span class="d-block">41</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">上限</span>
                                <span class="d-block">70</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">認抵學分</span>
                                <span class="d-block">1</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">認抵領域</span>
                                <span class="d-block">自然科學</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">金額</span>
                                <span class="d-block">1000</span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <button type="button" class="btn btn-outline-danger"><i class="fas fa-times"></i> 取消加入</button>
                        <a href="#" class="btn btn-link">瀏覽</a>
                    </div>
                </div>
                <% (1..99).map do |i| %>
                <div class="border rounded-3 p-4 mb-4">
                    <h4 class="d-flex align-items-center flex-wrap mb-4">
                        <small class="badge text-bg-secondary fs-6 me-2">25N0<%= i %></small>
                        <span class="me-2"><%= lorem_words(10) %></span>
                        <small class="fs-6"><%= lorem_words(3) %></small>
                    </h4>
                    <div class="row">
                        <div class="col-md-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">教師</span>
                                <span class="d-block">
                                    <span class="d-inline-block me-1"><%= zh_lorem_name %></span>
                                    <span class="d-inline-block me-1">, <%= zh_lorem_name %></span>
                                    <span class="d-inline-block me-1">, <%= zh_lorem_name %></span>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-8 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">上課地點</span>
                                <span class="d-block"><%= lorem_words(10) %></span>
                            </div>
                        </div>
                        <div class="col-md-12 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">日期</span>
                                <span class="d-block">2025-10-31 ~ 2025-12-31　週二13:20-17:20</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">報名</span>
                                <span class="d-block">16</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">錄取</span>
                                <span class="d-block">41</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">上限</span>
                                <span class="d-block">70</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">認抵學分</span>
                                <span class="d-block">1</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">認抵領域</span>
                                <span class="d-block">自然科學</span>
                            </div>
                        </div>
                        <div class="col-sm-4 py-2">
                            <div class="border-bottom">
                                <span class="d-block text-secondary fs-6">金額</span>
                                <span class="d-block">1000</span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <button type="button" class="btn btn-main"><i class="fas fa-plus"></i> 加入</button>
                        <a href="#" class="btn btn-link">瀏覽</a>
                    </div>
                </div>
                <% end %>

                <div class="back-wrap mobile-only mt-3"><a href="#" class="btn btn-lg btn-link"><i class="fas fa-long-arrow-alt-left me-2"></i> 回申請列表</a></div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>
    <!-- 課程排序欄固定效果 -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const sortingBar = document.querySelector('.courses-sorting-bar');
        
        if (sortingBar) {
            const originalOffsetTop = sortingBar.offsetTop;
            
            function handleScroll() {
                if (window.innerWidth >= 991) {
                    if (window.pageYOffset >= originalOffsetTop) {
                        sortingBar.style.position = 'fixed';
                        sortingBar.style.top = '20px';
                    } else {
                        sortingBar.style.position = 'static';
                    }
                } else {
                    sortingBar.style.position = 'static';
                }
            }
            
            window.addEventListener('scroll', handleScroll);
            window.addEventListener('resize', handleScroll);
        }
    });
    </script>
    
    <!-- Select2 -->
    <script src="../javascripts/select2.min.js"></script>
    <script>
    $( '#school-select-field' ).select2( {
        theme: "bootstrap-5",
        width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
        placeholder: $( this ).data( 'placeholder' ),
    } );
    $( '#location-select-field' ).select2( {
        theme: "bootstrap-5",
        width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
        placeholder: $( this ).data( 'placeholder' ),
    } );
    </script>
<% end %>

