<div class="question-sheet-container">
    <div class="company-info-wrapper">
        <div class="company-logo">
            <img src="../assets/fake/h-logo4.jpg">
        </div>
        <div class="company-info">
            <div class="row">
                <div class="col-4">
                    <div class="form-group">
                        <label class="form-label">公司統編</label>
                        <input type="text" class="form-control" value="0123456789" disabled readonly>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label class="form-label">聯絡窗口姓名</label>
                        <input type="text" class="form-control" value="<%= lorem_name %>" disabled readonly>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label class="form-label">聯絡窗口職稱</label>
                        <input type="text" class="form-control" value="System Analyst" disabled readonly>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group">
                        <label class="form-label">公司簡介</label>
                            <textarea class="form-control" rows="4" disabled readonly><%= lorem_paragraph %></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="sheet-section">
        <div class="sheet-title">企業出題內容</div>
        <div class="row">
            <div class="col-12">
                <div class="form-group">
                    <label class="form-label">參加目的</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="inlineCheckbox1" value="option1" disabled>
                            <label class="form-check-label" for="inlineCheckbox1">徵才需求</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="inlineCheckbox2" value="option2" checked>
                            <label class="form-check-label" for="inlineCheckbox2">共同研發</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="inlineCheckbox3" value="option3" checked>
                            <label class="form-check-label" for="inlineCheckbox3">技術轉移</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="inlineCheckbox4" value="option4" disabled>
                            <label class="form-check-label" for="inlineCheckbox4">其他</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label" for="textarea001">主題</label>
                    <textarea id="textarea001" class="form-control" rows="4" disabled readonly><%= lorem_paragraph %></textarea>
                </div>
            </div>
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label" for="textarea002">技術關鍵字</label>
                    <textarea id="textarea002" class="form-control" rows="4" disabled readonly><%= lorem_paragraph %></textarea>
                </div>
            </div>
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label" for="textarea003">技術痛點與需求</label>
                    <textarea id="textarea003" class="form-control" rows="4" disabled readonly><%= lorem_paragraph %></textarea>
                </div>
            </div>
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label" for="textarea004">目標或預期使用情境</label>
                    <textarea id="textarea004" class="form-control" rows="4" disabled readonly><%= lorem_paragraph %></textarea>
                </div>
            </div>
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label">預計研發期程</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="inlineRadioOptions99" id="inlineRadio1" value="option1" disabled>
                            <label class="form-check-label" for="inlineRadio1">1-2 年</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="inlineRadioOptions99" id="inlineRadio2" value="option2" checked>
                            <label class="form-check-label" for="inlineRadio2">3-5 年</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="inlineRadioOptions99" id="inlineRadio3" value="option3" disabled>
                            <label class="form-check-label" for="inlineRadio3">超過 5 年</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label">合作方式</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="inlineCheckbox11" value="option1" checked>
                            <label class="form-check-label" for="inlineCheckbox11">尚未提供</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="inlineCheckbox12" value="option2" checked>
                            <label class="form-check-label" for="inlineCheckbox12">尚未提供</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="inlineCheckbox13" value="option3" disabled>
                            <label class="form-check-label" for="inlineCheckbox13">尚未提供</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="sheet-section">
        <div class="sheet-title">其他可提供資源</div>
        <div class="form-group">
            <label class="form-label">研發資金</label>
            <div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="inlineRadioOptions100" id="inlineRadio11" value="option1" disabled>
                    <label class="form-check-label" for="inlineRadio11">100 萬元以下</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="inlineRadioOptions100" id="inlineRadio12" value="option2" disabled>
                    <label class="form-check-label" for="inlineRadio12">101-300 萬元</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="inlineRadioOptions100" id="inlineRadio13" value="option3" disabled>
                    <label class="form-check-label" for="inlineRadio13">301-500 萬元</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="inlineRadioOptions100" id="inlineRadio14" value="option3" disabled>
                    <label class="form-check-label" for="inlineRadio14">501-800 萬元</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="inlineRadioOptions100" id="inlineRadio15" value="option3" disabled>
                    <label class="form-check-label" for="inlineRadio15">801-1000 萬元</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="inlineRadioOptions100" id="inlineRadio16" value="option3" checked>
                    <label class="form-check-label" for="inlineRadio16">超過 1000 萬元</label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">實習機會</label>
            <div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="inlineRadioOptions101" id="inlineRadio17" value="option1" disabled>
                    <label class="form-check-label" for="inlineRadio17">1 名</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="inlineRadioOptions101" id="inlineRadio18" value="option2" disabled>
                    <label class="form-check-label" for="inlineRadio18">2-3 名</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="inlineRadioOptions101" id="inlineRadio19" value="option3" checked>
                    <label class="form-check-label" for="inlineRadio19">4-5 名</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="inlineRadioOptions101" id="inlineRadio20" value="option3" disabled>
                    <label class="form-check-label" for="inlineRadio20">超過 5 名</label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label" for="textarea011">其他</label>
            <textarea id="textarea011" class="form-control" rows="4" disabled readonly><%= lorem_paragraph %></textarea>
        </div>
    </div>
</div>
<div class="form-action text-end">
    <button type="submit" class="btn btn-outline-dark">要求編輯權限</button>
</div>