<!-- template: 教師 / 成果報告列表 -->
<div class="alert alert-primary alert-dismissible fade show portal-alert" role="alert">
    <div class="container-lg">
        成果及心得報告上傳： 2025-06-01 (日) 12:00 ~ 2025-11-29 (六) 23:55
    </div>
</div>
<div class="page-content">
    <div class="container-lg">
        <div class="page-title mobile-only">
            <h3>成果報告</h3>
        </div>
        <div class="mb-4">
            <select class="form-select w-auto" aria-label="選擇年度">
                <option selected>115</option>
                <option value="1">One</option>
                <option value="2">Two</option>
                <option value="3">Three</option>
            </select>
        </div>
        <div class="row">
            <% (1..3).map do |i| %>
            <div class="col-lg-6">
                <div class="border rounded-3 p-4 mb-4">
                    <h4 class="mb-4"><%= lorem_words(8) %></h4>
                    <div class="border-bottom py-2">
                        <span class="d-block text-secondary fs-6">課程編號</span>
                        <span class="d-block">25N002</span>
                    </div>
                    <div class="border-bottom py-2">
                        <span class="d-block text-secondary fs-6">授課教師</span>
                        <span class="d-block has-multiple-values">
                            <span><%= zh_lorem_name %></span>
                            <span><%= zh_lorem_name %></span>
                            <span><%= zh_lorem_name %></span>
                        </span>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">助教</span>
                                <span class="d-block has-multiple-values">
                                    <span><%= zh_lorem_name %></span>
                                </span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">課程類別</span>
                                <span class="d-block">C類一般類</span>
                            </div>
                        </div>
                    </div>
                    <div class="border-bottom py-2">
                        <span class="d-block text-secondary fs-6">開課學校</span>
                        <span class="d-block">國立臺灣大學</span>
                    </div>
                    <div class="border-bottom py-2">
                        <span class="d-block text-secondary fs-6">報告檔案</span>
                        <span class="d-block"><a href="#" class="text-primary text-break"><%= lorem_words(4) %>.docx</a></span>
                    </div>
                    <div class="border-bottom py-2">
                        <span class="d-block text-secondary fs-6">上傳時間</span>
                        <span class="d-block">2026-06-01 12:00</span>
                    </div>
                    <div class="text-end mt-4">
                        <a href="#" class="btn btn-outline-primary">前往上傳</a>
                    </div>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

