    interval: 6000, // 秒
    ride: 'carousel', // 自動撥放
    touch: false,
});
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script>
function handleGsapSpanResponsive() {
    const gsapSpans = document.querySelectorAll('.gsap-span');
    if (window.innerWidth < 1199) {
        gsapSpans.forEach(function(el) {
            el.style.display = 'none';
            // 移除 GSAP 動畫
            gsap.killTweensOf(el);
            ScrollTrigger.getAll().forEach(st => {
                if (st.trigger === el) st.kill();
            });
        });
    } else {
        gsapSpans.forEach(function(el) {
            el.style.display = '';
        });
        // 重新啟用動畫
        const gsapConfigs = {
            'gsap-one':   { x: 60, y: -300, blur: 2, scale: .9, opacity: 0.9, rotate: 14, speed: 1.2 },
            'gsap-two':   { x: 100, y: 40, blur: 4, scale: 1.3, opacity: 0.7, rotate: -20, speed: 2 },
            'gsap-three': { x: 80, y: -100, blur: 5, scale: 1.2, opacity: 0.85, rotate: 30, speed: 1.5 },
            'gsap-four':  { x: -60, y: 100, blur: 4, scale: 1.05, opacity: 0.95, rotate: -10, speed: 1.8 },
            'gsap-five':  { x: 150, y: -80, blur: 6, scale: 1.25, opacity: 0.75, rotate: 45, speed: 2.2 },
            'gsap-six':   { x: -120, y: -20, blur: 3, scale: 1.15, opacity: 0.8, rotate: -30, speed: 1.4 }
        };
        gsapSpans.forEach(function(el) {
            const key = Array.from(el.classList).find(cls => cls.startsWith('gsap-'));
            const cfg = gsapConfigs[key] || {};
            gsap.fromTo(el,
                { x: 0, y: 0, scale: 1, opacity: 1, rotate: 0, filter: 'blur(0px)' },
                {
                    x: cfg.x || 0,
                    y: cfg.y || 0,
                    scale: cfg.scale || 1,
                    opacity: cfg.opacity || 1,
                    rotate: cfg.rotate || 0,
                    filter: `blur(${cfg.blur || 0}px)`,
                    scrollTrigger: {
                        trigger: el,
                        start: 'top 90%',
                        end: 'bottom 10%',
                        scrub: cfg.speed || 1
                    }
                }
            );
        });
    }
}
window.addEventListener('resize', handleGsapSpanResponsive);
document.addEventListener('DOMContentLoaded', handleGsapSpanResponsive);
</script>

