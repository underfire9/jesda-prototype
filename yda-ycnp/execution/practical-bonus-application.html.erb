<!-- template: 執行 - 實踐獎金請領 -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="wrapper-inner">
            
            <%= render :partial => "/partials/execution_sidenav" %>

            <main class="main">
                <form action="home.html" method="post" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="practical-bonus-bank">銀行代號</label>
                                <select class="form-select" id="practical-bonus-bank" data-placeholder="請選擇銀行">
                                    <option></option>
                                    <option>Reactive</option>
                                    <option>Solution</option>
                                    <option>Conglomeration</option>
                                    <option>Algoritm</option>
                                    <option>Holistic</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="practical-bonus-branch">分行代號</label>
                                <select class="form-select" id="practical-bonus-branch" data-placeholder="請選擇分行">
                                    <option></option>
                                    <option>Reactive</option>
                                    <option>Solution</option>
                                    <option>Conglomeration</option>
                                    <option>Algoritm</option>
                                    <option>Holistic</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="practical-bonus-account">銀行帳戶</label>
                                <input type="text" class="form-control" id="practical-bonus-account" placeholder="請輸入銀行帳戶">
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="practical-bonus-name">戶名</label>
                                <input type="text" class="form-control" id="practical-bonus-name" placeholder="請輸入戶名">
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="practical-bonus-passbook">銀行存摺掃描檔</label>
                                <input type="file" class="form-control" id="practical-bonus-passbook">
                            </div>
                        </div>
                    </div>
                    <div class="mt-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="practical-bonus-agree">
                            <label class="form-check-label" for="practical-bonus-agree">
                                本人確認個人指定帳戶之銀行代碼、分行代碼及帳號(存摺影本)均正確無誤
                            </label>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="practical-bonus-agree2">
                            <label class="form-check-label" for="practical-bonus-agree2">
                                確認為本人上傳
                            </label>
                        </div>
                    </div>
                    <div class="form-action">
                        <button type="submit" class="btn btn-lg btn-rounded btn-main px-5">送出申請</button>
                    </div>
                </form>
            </main>
        </div>
    </div>
</div>



<% content_for :js do %>
    <script src="../javascripts/select2.min.js"></script>
    <script>
        $( '#practical-bonus-bank, #practical-bonus-branch' ).select2( {
            theme: "bootstrap-5",
            width: function() {
                return $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style';
            },
            placeholder: function() {
                return $( this ).data( 'placeholder' );
            }
        } );
    </script>
<% end %>