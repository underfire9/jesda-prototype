<% content_for :js do %>
<!-- 編號 + 附件上傳 -->
<script>
    document.querySelectorAll('.maintain-student-list .student-card').forEach(function(card, i) {
        card.querySelector('.card-bd').dataset.index = i + 1;
    });

    document.querySelectorAll('.upload-attachment-item').forEach(function(item, i) {
        item.dataset.index = i + 1;

        var fileInput = item.querySelector('input[type="file"]');
        if (!fileInput) return;

        fileInput.setAttribute('accept', '.pdf,application/pdf');

        var fileWrapper = item.querySelector('.file-wrapper');
        var fileName = fileWrapper ? fileWrapper.querySelector('.file-name') : null;
        var deleteButton = fileWrapper ? fileWrapper.querySelector('button') : null;
        var previewUrl = null;

        function clearSelectedFile() {
            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }

            fileInput.value = '';
            if (fileName) {
                fileName.textContent = '';
                fileName.removeAttribute('href');
            }
            if (fileWrapper) fileWrapper.hidden = true;
        }

        function showSelectedFile(file) {
            if (!fileWrapper || !fileName) return;

            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
            }

            previewUrl = URL.createObjectURL(file);
            fileName.textContent = file.name;
            fileName.href = previewUrl;
            fileWrapper.hidden = false;
        }

        fileInput.addEventListener('change', function(e) {
            var selectedFile = e.target.files && e.target.files[0];

            if (!selectedFile) {
                clearSelectedFile();
                return;
            }

            var fileNameLower = selectedFile.name.toLowerCase();
            var isPdfType = selectedFile.type === 'application/pdf' || fileNameLower.endsWith('.pdf');

            if (!isPdfType) {
                alert('僅接受 PDF 檔案格式');
                clearSelectedFile();
                return;
            }

            showSelectedFile(selectedFile);
        });

        if (deleteButton) {
            deleteButton.addEventListener('click', function() {
                clearSelectedFile();
            });
        }
    });
</script>

<!-- Bootstrap tooltip -->
<script>
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
</script>

<!-- Select2 -->
<script src="../javascripts/select2.min.js"></script>
<script>
    $( '#topHundred, #studentCountry, #fatherNationality, #motherNationality, #aboriginal' ).select2( {
        theme: "bootstrap-5",
        width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
        placeholder: $( this ).data( 'placeholder' ),
    } );

    var $toolbarStudentName = $('#toolbarStudentName');

    if ($toolbarStudentName.length) {
        var studentNames = [];

        document.querySelectorAll('.maintain-student-list .student-card .item-name').forEach(function(nameNode) {
            var nameText = nameNode.textContent.trim();
            if (nameText) studentNames.push(nameText);
        });

        var uniqueNames = Array.from(new Set(studentNames)).sort(function(a, b) {
            return a.localeCompare(b, 'zh-Hant-TW');
        });

        uniqueNames.forEach(function(name) {
            $toolbarStudentName.append(new Option(name, name, false, false));
        });

        $toolbarStudentName.select2({
            theme: 'bootstrap-5',
            width: '160px',
            placeholder: '搜尋姓名',
            allowClear: true,
        });

        $toolbarStudentName.on('change', function() {
            var selectedName = this.value;

            document.querySelectorAll('.maintain-student-list .student-card').forEach(function(card) {
                var cardNameNode = card.querySelector('.item-name');
                var cardName = cardNameNode ? cardNameNode.textContent.trim() : '';
                var isMatch = !selectedName || cardName === selectedName;
                card.style.display = isMatch ? '' : 'none';
            });
        });
    }
</script>

<!-- 下拉選擇 -->
<script>
    const hostInstitution = document.getElementById('hostInstitution');
    const selectTop100 = document.querySelector('.select-100');
    const selectOther = document.querySelector('.select-other');

    function toggleHostInstitutionFields() {
        const selectedValue = hostInstitution ? hostInstitution.value : '';

        if (selectTop100) {
            selectTop100.style.display = selectedValue === 'top100' ? 'block' : 'none';
        }

        if (selectOther) {
            selectOther.style.display = selectedValue === 'other' ? 'block' : 'none';
        }
    }

    if (hostInstitution) {
        hostInstitution.addEventListener('change', toggleHostInstitutionFields);
        toggleHostInstitutionFields();
    }
</script>

<!-- 新住民國籍 -->
<script>
    const newResidentNo = document.getElementById('newResidentNo');
    const newResidentYes = document.getElementById('newResidentYes');
    const newResidentWrapper = document.querySelector('.new-resident-wrapper');

    function toggleNewResidentFields() {
        if (!newResidentWrapper) return;
        newResidentWrapper.style.display = newResidentYes && newResidentYes.checked ? 'flex' : 'none';
