<!-- template: 申請 - 電子簽章/個資聲明與使用條款 -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="step-wrapper">
            <ul class="step-menu six-step menu-item">
                <li class="step-item current">
                    <span class="number">1</span>
                    <span class="description">個資聲明與使用條款</span>
                </li>
                <li class="step-item">
                    <span class="number">2</span>
                    <span class="description">OTP身分驗證</span>
                </li>
                <li class="step-item">
                    <span class="number">3</span>
                    <span class="description">檢視簽署文件</span>
                </li>
                <li class="step-item">
                    <span class="number">4</span>
                    <span class="description">電子簽名</span>
                </li>
                <li class="step-item">
                    <span class="number">5</span>
                    <span class="description">簽署完成</span>
                </li>
            </ul>
        </div>

        <div class="notice-wrapper">
            <p><%= zh_lorem_paragraph %></p>
            <p><%= zh_lorem_paragraph %></p>
        </div>

        <div class="signature-wrapper">
            <section class="section">
                <h3 class="fw-bold mb-4">個資聲明</h3>
                <div class="section-content">
                    <h5><%= lorem_words(6) %></h5>
                    <p><%= lorem_paragraph %></p>
                    <p><%= lorem_paragraph %></p>
                    <h5><%= lorem_words(6) %></h5>
                    <p><%= lorem_paragraph %></p>
                    <h5><%= lorem_words(6) %></h5>
                    <p><%= lorem_paragraph %></p>
                    <p><%= lorem_paragraph %></p>
                    <p><%= lorem_paragraph %></p>
                </div>
            </section>
            <section class="section">
                <h3 class="fw-bold mb-4">使用條款</h3>
                <div class="section-content">
                    <h5><%= lorem_words(6) %></h5>
                    <p><%= lorem_paragraph %></p>
                    <p><%= lorem_paragraph %></p>
                    <h5><%= lorem_words(6) %></h5>
                    <p><%= lorem_paragraph %></p>
                    <h5><%= lorem_words(6) %></h5>
                    <p><%= lorem_paragraph %></p>
                    <p><%= lorem_paragraph %></p>
                    <p><%= lorem_paragraph %></p>
                </div>
            </section>

            <div class="mt-5">
                <div class="mb-3">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="privacyAgree" name="privacyAgree">
                        <label class="form-check-label" for="privacyAgree">
                            我已閱讀並同意上述 個資聲明
                        </label>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="termsAgree" name="termsAgree">
                        <label class="form-check-label" for="termsAgree">
                            我已閱讀並同意上述 使用條款
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-action">
            <button type="submit" class="btn btn-lg btn-primary">下一步</button>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

