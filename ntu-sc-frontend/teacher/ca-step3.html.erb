                    <a href="ca-step4.html" class="btn btn-primary btn-lg btn-next disabled">下一步 <i class="fas fa-long-arrow-alt-right fs-6 ms-1"></i></a>
                </div>
            </main>
        </div>
    </div>
</div>

<!-- 單筆新增 Modal -->
<div class="modal fade" id="singleEntryModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="singleEntryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="singleEntryModalLabel">單筆新增</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">上課日期</label>
                    <div class="ca-class-period">
                        <span class="flex-grow-1"><input type="date" class="form-control" id="class_date_start" /></span>
                        <span class="sm-hide">-</span>
                        <span class="flex-grow-1"><input type="date" class="form-control" id="class_date_end" /></span>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">上課節次</label>
                    <div class="ca-class-period">
                        <span class="flex-grow-1"><input type="time" class="form-control" id="class_period_start" /></span>
                        <span class="sm-hide">-</span>
                        <span class="flex-grow-1"><input type="time" class="form-control" id="class_period_end" /></span>
                        <span><button type="button" class="btn btn-dark">加入</button></span>
                    </div>

                    <!-- 有資料才秀區塊 -->
                    <div class="ca-class-period-list">
                        <% (1..6).map do |i| %>
                        <div class="item-period">
                            <button type="button" class="btn btn-sm btn-rounded btn-light" title="移除">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x" viewBox="0 0 16 16">
                                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
                                </svg>
                            </button>
                            <span class="time-range">09:00 - 10:30</span>
                        </div>
                        <% end %>
                    </div>
                    <div class="form-text text-muted">每節至少需滿50分鐘</div>
                </div>
                <div class="form-group">
                    <label for="class_content" class="form-label">上課內容</label>
                    <textarea class="form-control" id="class_content" rows="4"></textarea>
                    <div class="form-text text-muted mt-3">
                        <ol>
                            <li>如課程邀請學者專家演講，請敘明其姓名、單位、職稱及演講主題；每課程以1人次*2節為限。</li>
                            <li>如安排與課程內容相關之校內外教學活動，請敘明活動之性質、合作機構名稱、時間之規劃、場地之妥適性及課程進行之安全措施等。若有須修課同學自行負擔之費用，需加註說明，供同學選課時參考。</li>
