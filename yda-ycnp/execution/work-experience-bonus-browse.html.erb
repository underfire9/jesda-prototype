<!-- template: 執行 - 職場歷練獎金 (瀏覽) -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="wrapper-inner">
            
            <%= render :partial => "/partials/execution_sidenav" %>

            <main class="main">
                <div class="content-title">
                    <h3>職場歷練獎金申請</h3>
                </div>
                <div class="notice-wrapper bonus-notice">
                    <% notice_list = [
                        "職場歷練獎金申請表",
                        "職場歷練獎金申請表應附上相關證明文件，包含但不限於：工作證明、薪資單、工作內容說明等。",
                        "申請人需確保所提供的資料真實且完整，若有任何虛假或不實資料，將可能導致申請被拒絕或追回已發放的獎金。",
                        "申請人需同意相關條款與規定，並遵守申請流程及截止日期。"
                    ] %>
                    <ul class="menu-item custom-list">
                        <% notice_list.each do |notice| %>
                            <li><%= notice %></li>
                        <% end %>
                    </ul>
                </div>
                <div class="experience-bonus-container">
                    <div class="inner-wrapper">
                        <h5 class="mb-4">投保資料</h5>
                        <div class="experience-bonus-list">
                            <% (1..4).map do |i| %>
                            <div class="experience-bonus-item">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">公司名稱</label>
                                            <div class="output"><%= lorem_words(5) %></div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">日期區間</label>
                                            <div class="total-group">
                                                <div class="input-group w-auto">
                                                    <span class="output">2026/01/01</span>
                                                    <span class="px-2">~</span>
                                                    <span class="output">2026/01/31</span>
                                                </div>
                                                <div class="output count">共<strong>30</strong>日</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">全職或兼職證明文件</label>
                                            <div class="output"><a href="#" download><%= zh_lorem_words(5) %>.pdf</a></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% end %>
                        </div>
                        <div class="grand-total">
                            <span>累計天數  <strong>369</strong> 天</span>
                            <span>可請領金額 <strong>20,000</strong> 元整</span>
                        </div>
                    </div>
                    <div class="form-group form-group-output">
                        <label class="form-label">就業保險文件上傳</label>
                        <div class="output output-inline-block"><a href="#" download><%= zh_lorem_words(5) %>.pdf</a></div>
                    </div>
                </div>
                <div class="form-action">
                    <span class="backhome"><a href="home.html" class="btn btn-lg btn-back" title="回首頁"><i class="fas fa-long-arrow-alt-left"></i></a></span>
                </div>
            </main>
        </div>
    </div>
</div>



<% content_for :js do %>
<% end %>