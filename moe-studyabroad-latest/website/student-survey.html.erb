<!-- template: 學生滿意度問卷與登錄心得 -->

<div class="container-lg">
    <div class="page-content">
        <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
        <div class="student-survey-wrapper">
            <h3>滿意度問卷與登錄心得</h3>

            <div class="wrapper-inner">
                <aside class="info-sidebar">
                    <div class="sidebar-head card-header">
                        <span class="head-start"><i class="fas fa-user-circle"></i></span>
                        <div class="head-end">
                            <div class="student-name"><%= zh_lorem_name %> <button type="button" class="btn btn-link">登出</button></div>
                            <div class="student-id">A123456</div>
                        </div>
                    </div>
                    <div class="sidebar-body card-body">
                        <h4 class="h5">補助資料</h4>
                        <div class="item-info-row">
                            <div class="item-info">
                                <div class="item-label">研修國別/期程</div>
                                <div class="item-value">
                                    <div class="item-default">澳大利亞</div>
                                    <div class="item-sec">
                                        <span>2026 年 06 月 01 日 至 </span>
                                        <span>2026 年 12 月 31 日</span>
                                    </div>
                                </div>
                            </div>
                            <div class="item-info">
                                <div class="item-label">研修學校/系所(學程)</div>
                                <div class="item-value">
                                    <div class="item-default">國立澳大利亞大學</div>
                                    <div class="item-sec">資訊工程學系</div>
                                </div>
                            </div>
                        </div>
                        <div class="item-info">
                            <div class="item-label">獲補助經費合計</div>
                            <div class="item-value">新台幣 <strong>70,000 元</strong></div>
                        </div>
                        <div class="item-info-row">
                            <div class="info-subsidy">
                                <h5 class="h6">補助經費來源 (TWD)</h5>
                                <div class="info-value">
                                    <span>教育部補助款 <strong>50,000 +</strong></span>
                                    <span>學校配合款 <strong>20,000</strong></span>
                                </div>
                            </div>
                            <div class="info-expenses">
                                <h5 class="h6">經費核銷項目 (TWD)</h5>
                                <div class="info-value">
                                    <span>學費 <strong>30,000 +</strong></span>
                                    <span>生活費 <strong>20,000 +</strong></span>
                                    <span>來回機票款 <strong>20,000</strong></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>
                <div class="survey-content">
                    <div class="survey-progress" aria-live="polite">
                        <div class="d-flex align-items-center justify-content-between mb-2"><span>填答進度</span><span><span class="js-survey-step">1</span> / 3</span></div>
                        <div class="progress" role="progressbar" aria-label="問卷填答進度" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1"><div class="progress-bar js-survey-progress-bar" style="width: 33.333%"></div></div>
                    </div>
                    <div class="survey-stage">
                        <section class="survey-pane is-active" data-survey-pane aria-labelledby="survey-login-title">
                            <div class="survey-intro">
                                <h5 class="fs-6 fw-medium">教育部鼓勵國內大專校院選送學生出國研修計畫調查問卷</h6>
                                <p>本調查問卷之主要目的，是為瞭解大專校院自行選送優秀學生出國研修計畫對於國家競爭力之影響。本國研修生在外系所、受獎生學習成效。本問卷需 5 分鐘時間完成，您所填寫的資料僅做成效觀測及計畫執行之參考，調查之結果將會保密，不會影響您原有的權益，請您務必確實填寫，謝謝。</p>
                                <p class="survey-signature">教育部<br>國立臺灣科技大學數位人力資源專案辦公室</p>
                            </div>

                            <h4 id="survey-login-title" class="survey-section-title">一、登入資料</h4>
                            <fieldset class="survey-question">
                                <legend>1、國內就讀學校類別：</legend>
                                <label><input type="radio" name="school_type"> 一般大學</label>
                                <label><input type="radio" name="school_type"> 技專校院</label>
                            </fieldset>
                            <fieldset class="survey-question is-tinted">
                                <legend>2、國內就讀科系類別：</legend>
                                <select class="form-select" aria-label="國內就讀科系類別"><option>藝術、傳播類</option><option>工程、製造及營建類</option><option>商業及管理類</option></select>
                            </fieldset>
                            <fieldset class="survey-question">
                                <legend>3、國內就讀身分別：</legend>
                                <label><input type="radio" name="degree"> 大學部</label>
                                <label><input type="radio" name="degree"> 碩士</label>
                                <label><input type="radio" name="degree"> 博士</label>
                            </fieldset>
                            <fieldset class="survey-question is-tinted">
                                <legend>4、國內就讀年級：</legend>
                                <label><input type="radio" name="grade"> 一年級</label><label><input type="radio" name="grade"> 二年級</label><label><input type="radio" name="grade"> 三年級</label><label><input type="radio" name="grade"> 四年級</label><label><input type="radio" name="grade"> 五年級</label><label><input type="radio" name="grade"> 六年級</label><label><input type="radio" name="grade"> 七年級</label>
                            </fieldset>
                            <fieldset class="survey-question">
                                <legend>5、納國您的研修身分別：</legend>
                                <label><input type="radio" name="program_type"> 籌學學位</label><label><input type="radio" name="program_type"> 短期研修</label><label><input type="radio" name="program_type"> 交換生</label>
                            </fieldset>
                            <fieldset class="survey-question is-tinted">
                                <legend>6、請問您出國研修前英文檢定成績為 (單選個人最佳成績即可)：</legend>
                                <div class="survey-options"><span class="survey-options-label">全民英檢</span><label><input type="radio" name="english_before"> 初級</label><label><input type="radio" name="english_before"> 中級</label><label><input type="radio" name="english_before"> 中高級</label><label><input type="radio" name="english_before"> 高級</label><label><input type="radio" name="english_before"> 優級</label></div>
                                <div class="survey-options"><span class="survey-options-label">托福</span><label><input type="radio" name="toefl_before"> ITP 390 以下</label><label><input type="radio" name="toefl_before"> ITP 401~457</label><label><input type="radio" name="toefl_before"> ITP 458~527</label><label><input type="radio" name="toefl_before"> ITP 528~560</label><label><input type="radio" name="toefl_before"> ITP 561~630</label><label><input type="radio" name="toefl_before"> iBT 42以下</label></div>
                                <div class="survey-options"><span class="survey-options-label">多益</span><label><input type="radio" name="toeic_before"> 225以下</label><label><input type="radio" name="toeic_before"> 226~550</label><label><input type="radio" name="toeic_before"> 551~785</label><label><input type="radio" name="toeic_before"> 786~945</label></div>
                                <label><input type="radio" name="english_before"> 無參加檢定</label>
                            </fieldset>
                            <fieldset class="survey-question">
                                <legend>7、請問您出國研修後英文檢定成績為 (單選個人最佳成績即可)：</legend>
                                <div class="survey-options"><span class="survey-options-label">全民英檢</span><label><input type="radio" name="english_after"> 初級</label><label><input type="radio" name="english_after"> 中級</label><label><input type="radio" name="english_after"> 中高級</label><label><input type="radio" name="english_after"> 高級</label><label><input type="radio" name="english_after"> 優級</label></div>
                                <div class="survey-options"><span class="survey-options-label">托福</span><label><input type="radio" name="toefl_after"> ITP 390 以下</label><label><input type="radio" name="toefl_after"> ITP 401~457</label><label><input type="radio" name="toefl_after"> ITP 458~527</label><label><input type="radio" name="toefl_after"> ITP 528~560</label><label><input type="radio" name="toefl_after"> ITP 561~630</label><label><input type="radio" name="toefl_after"> iBT 42以下</label></div>
                                <div class="survey-options"><span class="survey-options-label">多益</span><label><input type="radio" name="toeic_after"> 225以下</label><label><input type="radio" name="toeic_after"> 226~550</label><label><input type="radio" name="toeic_after"> 551~785</label><label><input type="radio" name="toeic_after"> 786~945</label></div>
                                <label><input type="radio" name="english_after"> 無參加檢定</label>
                            </fieldset>
                            <h4 class="survey-section-title">二、申請階段</h4>
                            <fieldset class="survey-question is-tinted"><legend>1、請問您如何得知學海飛颺/學海惜珠計畫(複選)：</legend><label><input type="checkbox"> 師長</label><label><input type="checkbox"> 同儕</label><label><input type="checkbox"> 新聞稿</label><label><input type="checkbox"> 學校說明會</label><label><input type="checkbox"> 民間留學代辦機構</label></fieldset>
                            <fieldset class="survey-question"><legend>2、請問貴校學校有無舉辦說明會協助您申請學海飛颺/學海惜珠計畫？</legend><label><input type="radio" name="briefing"> 有，且幫助很大</label><label><input type="radio" name="briefing"> 有，且有點幫助</label><label><input type="radio" name="briefing"> 有，但沒有幫助</label><label><input type="radio" name="briefing"> 無</label></fieldset>
                            <fieldset class="survey-question is-tinted"><legend>3、請問學校有無專責單位或承辦人員協助您申請學海飛颺/學海惜珠計畫？</legend><label><input type="radio" name="staff_help"> 有，且幫助很大</label><label><input type="radio" name="staff_help"> 有，且有點幫助</label><label><input type="radio" name="staff_help"> 有，但沒有幫助</label><label><input type="radio" name="staff_help"> 無</label></fieldset>
                            <fieldset class="survey-question"><legend>4、請問您申請學海飛颺/學海惜珠計畫之原因(複選)？</legend><label><input type="checkbox"> 擴展視野</label><label><input type="checkbox"> 強化知識</label><label><input type="checkbox"> 實現夢想</label><label><input type="checkbox"> 親友鼓勵</label><label><input type="checkbox"> 同學邀約</label><label><input type="checkbox"> 加強語文</label><label><input type="checkbox"> 學習獨立</label><label><input type="checkbox"> 幫助就業</label><label><input type="checkbox"> 學校推薦</label></fieldset>
                            <fieldset class="survey-question is-tinted"><legend>5、請問您申請學海飛颺/學海惜珠計畫曾經遭遇哪些困難(複選)？</legend><label><input type="checkbox"> 親友反對</label><label><input type="checkbox"> 外語障礙</label><label><input type="checkbox"> 不符所學</label><label><input type="checkbox"> 補助不足</label><label><input type="checkbox"> 名額太少</label><label><input type="checkbox"> 資訊不足</label><label><input type="checkbox"> 簽證取得不易</label></fieldset>
                        </section>

                        <section class="survey-pane" data-survey-pane hidden aria-labelledby="survey-preparation-title">
                            <h4 id="survey-preparation-title" class="survey-section-title">三、出國前準備</h4>
                            <fieldset class="survey-question"><legend>1、請問您是否為參與學海飛颺/學海惜珠計畫而貸款？</legend><label><input type="radio" name="loan_amount"> 是100,000元以下</label><label><input type="radio" name="loan_amount"> 是100,000~200,000元</label><label><input type="radio" name="loan_amount"> 是200,000~300,000元</label><label><input type="radio" name="loan_amount"> 是300,000~400,000元</label><label><input type="radio" name="loan_amount"> 是400,000~500,000元</label><label><input type="radio" name="loan_amount"> 是500,000元以上</label><label><input type="radio" name="loan_amount"> 否</label></fieldset>
                            <fieldset class="survey-question"><legend>2、請問貴選送學校有無提供您貸款上的協助？</legend><label><input type="radio" name="loan_help"> 有，且幫助很大</label><label><input type="radio" name="loan_help"> 有，且有點幫助</label><label><input type="radio" name="loan_help"> 有，但沒有幫助</label><label><input type="radio" name="loan_help"> 無</label></fieldset>
                            <fieldset class="survey-question"><legend>3、請問貴選送學校是否提供辦理出國手續之協助？</legend><label><input type="radio" name="departure_help"> 有，且幫助很大</label><label><input type="radio" name="departure_help"> 有，且有點幫助</label><label><input type="radio" name="departure_help"> 有，但沒有幫助</label><label><input type="radio" name="departure_help"> 無</label></fieldset>
                            <fieldset class="survey-question"><legend>4、請問貴選送學校是否追蹤您研修期間之學習狀況？</legend><label><input type="radio" name="study_followup"> 有，且非常關心</label><label><input type="radio" name="study_followup"> 有，且有關心</label><label><input type="radio" name="study_followup"> 有，但很少關心</label><label><input type="radio" name="study_followup"> 無</label></fieldset>
                            <fieldset class="survey-question"><legend>5、請問貴選送學校是否建立研修生之緊急聯絡管道？</legend><label><input type="radio" name="emergency_contact"> 有，且幫助很大</label><label><input type="radio" name="emergency_contact"> 有，且有點幫助</label><label><input type="radio" name="emergency_contact"> 有，但沒有幫助</label><label><input type="radio" name="emergency_contact"> 無</label></fieldset>
                            <fieldset class="survey-question"><legend>6、請問您是否因參加學海飛颺/學海惜珠計畫而額外花費？</legend><label><input type="radio" name="extra_expense"> 是，3萬以下</label><label><input type="radio" name="extra_expense"> 是，3~5萬</label><label><input type="radio" name="extra_expense"> 是，7~9萬</label><label><input type="radio" name="extra_expense"> 是，10萬以上</label><label><input type="radio" name="extra_expense"> 否</label></fieldset>
                            <fieldset class="survey-question"><legend>7、請問您沒有學海飛颺/學海惜珠計畫之補助，您是否有機會出國研修？</legend><label><input type="radio" name="study_without_subsidy"> 有</label><label><input type="radio" name="study_without_subsidy"> 無</label></fieldset>
                            <fieldset class="survey-question"><legend>8、請問您出國研修的經費來源？</legend><label><input type="checkbox"> 免簽證</label><label><input type="checkbox"> 學生貸款</label><label><input type="checkbox"> 工作兼職</label><label><input type="checkbox"> 觀光簽證</label><label><input type="checkbox"> 商務簽證</label></fieldset>

                            <h4 class="survey-section-title">四、國外生活期間</h4>
                            <fieldset class="survey-question"><legend>1、請問您如何獲得在海外的住所？</legend><label><input type="radio" name="housing_source"> 學校宿舍</label><label><input type="radio" name="housing_source"> 自行租屋</label><label><input type="radio" name="housing_source"> 住親友家</label><label><input type="radio" name="housing_source"> 寄宿家庭</label></fieldset>
                            <fieldset class="survey-question"><legend>2、請問海外研修學校之專責單位或承辦人員是否提供足夠的諮詢服務？</legend><label><input type="radio" name="overseas_support"> 有，且幫助很大</label><label><input type="radio" name="overseas_support"> 有，且有點幫助</label><label><input type="radio" name="overseas_support"> 有，但沒有幫助</label><label><input type="radio" name="overseas_support"> 無</label></fieldset>
                            <fieldset class="survey-question"><legend>3、請問您赴國外研修及生活共花費多少元？</legend><label><input type="radio" name="living_expense"> 100,000元以下</label><label><input type="radio" name="living_expense"> 100,000~200,000元</label><label><input type="radio" name="living_expense"> 200,000~300,000元</label><label><input type="radio" name="living_expense"> 300,000~400,000元</label><label><input type="radio" name="living_expense"> 400,000~500,000元</label><label><input type="radio" name="living_expense"> 500,000元以上</label></fieldset>
                            <fieldset class="survey-question"><legend>4、請問您在國外假日期間都從事哪些活動？（可複選）</legend><label><input type="checkbox"> 旅遊</label><label><input type="checkbox"> 研修</label><label><input type="checkbox"> 交友</label><label><input type="checkbox"> 上網</label><label><input type="checkbox"> 追劇</label><label><input type="checkbox"> 戶外活動</label><label><input type="checkbox"> 下廚</label><label><input type="checkbox"> 認識文化習俗</label><label><input type="checkbox"> 其他個人興趣</label></fieldset>
                        </section>

                        <section class="survey-pane" data-survey-pane hidden aria-labelledby="survey-return-title">
                            <h4 id="survey-return-title" class="survey-section-title">五、回國後階段</h4>
                            <fieldset class="survey-question"><legend>1、請問您在研修期間所交的外國友人回國後是否仍保持聯繫？</legend><label><input type="radio" name="foreign_friend_contact"> 是</label><label><input type="radio" name="foreign_friend_contact"> 否</label></fieldset>
                            <fieldset class="survey-question"><legend>2、請問參與學海飛颺/學海惜珠計畫對您有哪些幫助？（可複選）</legend><label><input type="checkbox"> 獨立生活</label><label><input type="checkbox"> 專業知識</label><label><input type="checkbox"> 進修機會</label><label><input type="checkbox"> 創助就業</label><label><input type="checkbox"> 外語能力</label><label><input type="checkbox"> 擴展人脈</label><label><input type="checkbox"> 國際視野</label><label><input type="checkbox"> 溝通能力</label></fieldset>
                            <fieldset class="survey-question"><legend>3、請問若能再次選擇，您是否會參加學海飛颺/學海惜珠計畫？</legend><label><input type="radio" name="join_again"> 是</label><label><input type="radio" name="join_again"> 否</label></fieldset>
                            <fieldset class="survey-question"><legend>4、請問您有無介紹同學或朋友參與學海飛颺/學海惜珠計畫？</legend><label><input type="radio" name="recommend_program"> 是</label><label><input type="radio" name="recommend_program"> 否，因為經費不足</label><label><input type="radio" name="recommend_program"> 否，無法適應國外生活</label><label><input type="radio" name="recommend_program"> 否，因計畫等級延畢</label></fieldset>
                            <fieldset class="survey-question"><legend>5、請問您預想第一份工作之起薪為多少元（新臺幣計價）？</legend><label><input type="radio" name="first_salary"> 32k以下</label><label><input type="radio" name="first_salary"> 32k~45k</label><label><input type="radio" name="first_salary"> 45k~52k</label><label><input type="radio" name="first_salary"> 52k~70k</label><label><input type="radio" name="first_salary"> 70k以上</label></fieldset>

                            <h4 class="survey-section-title">六、研修經驗</h4>
                            <fieldset class="survey-question"><legend>1、請問赴國外研修後，您的能力有否增進（可複選）</legend><label><input type="checkbox"> 外語能力提升</label><label><input type="checkbox"> 溝通能力增加</label><label><input type="checkbox"> 專業知識增加</label><label><input type="checkbox"> 畢業成績進步</label><label><input type="checkbox"> 創意能力增加</label><label><input type="checkbox"> 問題解決能力增加</label><label><input type="checkbox"> 學習適應能力增加</label><label><input type="checkbox"> 團隊合作技巧增加</label></fieldset>
                            <fieldset class="survey-question"><legend>2、請問赴國外研修後，您的收穫為何？（可複選）</legend><label><input type="checkbox"> 國際觀增加</label><label><input type="checkbox"> 對國際事務產生興趣</label><label><input type="checkbox"> 具備適應不同文化的能力</label><label><input type="checkbox"> 尊敬他國的文化及傳統</label><label><input type="checkbox"> 瞭解留學國社會的各面向</label><label><input type="checkbox"> 對其他文化能有同理心</label><label><input type="checkbox"> 增加未來在海外發展的意願</label><label><input type="checkbox"> 國外與生互動頻繁</label></fieldset>
                            <h4 class="survey-section-title">七、請問您對於學海飛颺/學海惜珠計畫有何建議？</h4>
                            <fieldset class="survey-question"><legend class="visually-hidden">請提供建議</legend><label><input type="radio" name="program_suggestion"> 無</label><label><input type="radio" name="program_suggestion"> 有（請填建議）</label><textarea class="form-control mt-2" rows="5" placeholder="請輸入您的建議"></textarea></fieldset>
                            <h4 class="survey-section-title">八、對學海飛颺/學海惜珠計畫的滿意度？</h4>
                            <fieldset class="survey-question"><legend class="visually-hidden">計畫滿意度</legend><label><input type="radio" name="program_satisfaction"> 5-非常滿意</label><label><input type="radio" name="program_satisfaction"> 4-滿意</label><label><input type="radio" name="program_satisfaction"> 3-普通</label><label><input type="radio" name="program_satisfaction"> 2-不滿意</label><label><input type="radio" name="program_satisfaction"> 1-非常不滿意</label></fieldset>
                        </section>

                        <section class="survey-pane" data-survey-pane hidden aria-labelledby="survey-upload-title">
                            <div class="survey-upload-head">
                                <span class="survey-upload-icon"><i class="fas fa-file-pdf"></i></span>
                                <div>
                                    <h4 id="survey-upload-title">上傳研修心得報告</h4>
                                    <p class="js-survey-upload-message">完成問卷後，請上傳您的研修心得 PDF 檔案。</p>
                                </div>
                            </div>
                            <div class="survey-dropzone js-survey-dropzone" role="button" tabindex="0" aria-label="選擇或拖曳 PDF 檔案上傳">
                                <input class="js-survey-file-input" type="file" accept="application/pdf,.pdf" hidden>
                                <div class="js-survey-upload-idle">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <p>拖曳 PDF 檔案至此，或 <button type="button" class="btn btn-outline-primary btn-sm js-survey-browse">選擇檔案</button></p>
                                    <span>僅限 PDF 格式，單一檔案最大 100 MB</span>
                                </div>
                                <div class="survey-upload-file js-survey-upload-file" hidden>
                                    <div class="survey-upload-file-info"><i class="fas fa-file-pdf text-danger"></i><div><strong class="js-survey-file-name"></strong><span class="js-survey-file-size"></span></div></div>
                                    <button type="button" class="btn btn-outline-danger btn-sm js-survey-remove"><i class="fas fa-trash-alt me-1"></i>刪除</button>
                                </div>
                            </div>
                            <div class="survey-pdf-preview js-survey-pdf-preview" hidden>
                                <div class="survey-pdf-toolbar"><span class="js-survey-pdf-name"></span><span class="badge text-bg-light">PDF 預覽</span></div>
                                <iframe class="js-survey-pdf-frame" title="研修心得 PDF 預覽"></iframe>
                            </div>
                            <div class="survey-submit-action js-survey-submit-action">
                                <button type="button" class="btn btn-primary js-survey-submit" disabled>送出<i class="fas fa-check ms-2"></i></button>
                            </div>
                        </section>
                    </div>
                    <div class="survey-controller">
                        <button type="button" class="btn btn-outline-secondary js-survey-prev" hidden><i class="fas fa-chevron-left me-2"></i>上一步</button>
                        <button type="button" class="btn btn-primary js-survey-next">下一步<i class="fas fa-chevron-right ms-2"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>
<script>
    (() => {
        const surveyContent = document.querySelector('.survey-content')
        const panes = Array.from(document.querySelectorAll('[data-survey-pane]'))
        const previousButton = document.querySelector('.js-survey-prev')
        const nextButton = document.querySelector('.js-survey-next')
        const step = document.querySelector('.js-survey-step')
        const surveyProgress = document.querySelector('.survey-progress')
        const progress = surveyProgress.querySelector('.progress')
        const progressBar = document.querySelector('.js-survey-progress-bar')
        const formStepCount = 3
        const dropZone = document.querySelector('.js-survey-dropzone')
        const fileInput = document.querySelector('.js-survey-file-input')
        const browseButton = document.querySelector('.js-survey-browse')
        const uploadIdle = document.querySelector('.js-survey-upload-idle')
        const uploadFile = document.querySelector('.js-survey-upload-file')
        const fileName = document.querySelector('.js-survey-file-name')
        const fileSize = document.querySelector('.js-survey-file-size')
        const removeButton = document.querySelector('.js-survey-remove')
        const pdfPreview = document.querySelector('.js-survey-pdf-preview')
        const pdfName = document.querySelector('.js-survey-pdf-name')
        const pdfFrame = document.querySelector('.js-survey-pdf-frame')
        const submitAction = document.querySelector('.js-survey-submit-action')
        const submitButton = document.querySelector('.js-survey-submit')
        const uploadMessage = document.querySelector('.js-survey-upload-message')
        let currentIndex = 0
        let isTransitioning = false
        let currentObjectUrl = null

        const updateControls = () => {
            const currentStep = Math.min(currentIndex + 1, formStepCount)
            step.textContent = currentStep
            const progressValue = (currentStep / formStepCount) * 100
            progress.setAttribute('aria-valuenow', currentStep)
            progressBar.style.width = `${progressValue}%`
            surveyProgress.hidden = currentIndex >= formStepCount
            previousButton.hidden = currentIndex === 0 || currentIndex >= formStepCount
            nextButton.hidden = currentIndex >= formStepCount
            nextButton.innerHTML = currentIndex === formStepCount - 1
                ? '確定送出<i class="fas fa-paper-plane ms-2"></i>'
                : '下一步<i class="fas fa-chevron-right ms-2"></i>'
        }

        const changePane = (nextIndex, direction) => {
            if (isTransitioning || nextIndex < 0 || nextIndex >= panes.length) return
            isTransitioning = true
            const currentPane = panes[currentIndex]
            const nextPane = panes[nextIndex]
            const outgoingClass = direction === 'next' ? 'is-leaving-left' : 'is-leaving-right'
            const incomingClass = direction === 'next' ? 'is-entering-right' : 'is-entering-left'

            nextPane.hidden = false
            nextPane.classList.add('is-active', incomingClass)
            requestAnimationFrame(() => {
                currentPane.classList.add(outgoingClass)
                nextPane.classList.remove(incomingClass)
            })
            window.setTimeout(() => {
                currentPane.hidden = true
                currentPane.classList.remove('is-active', outgoingClass)
                currentIndex = nextIndex
                updateControls()
                isTransitioning = false
            }, 280)
        }

        nextButton.addEventListener('click', () => {
            if (currentIndex >= formStepCount) return
            window.scrollTo({ top: window.scrollY + surveyContent.getBoundingClientRect().top - 24, behavior: 'smooth' })
            changePane(currentIndex + 1, 'next')
        })
        previousButton.addEventListener('click', () => changePane(currentIndex - 1, 'previous'))

        const formatSize = bytes => bytes >= 1024 * 1024
            ? `${(bytes / 1024 / 1024).toFixed(1)} MB`
            : `${Math.ceil(bytes / 1024)} KB`

        const clearFile = () => {
            if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl)
            currentObjectUrl = null
            fileInput.value = ''
            uploadIdle.hidden = false
            uploadFile.hidden = true
            pdfPreview.hidden = true
            pdfFrame.src = ''
            submitButton.disabled = true
        }

        const setFile = file => {
            if (!file) return
            if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
                alert('請上傳 PDF 格式的檔案。')
                return
            }
            if (file.size > 100 * 1024 * 1024) {
                alert('檔案大小超過 100 MB，請重新選擇。')
                return
            }
            if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl)
            currentObjectUrl = URL.createObjectURL(file)
            fileName.textContent = file.name
            fileSize.textContent = formatSize(file.size)
            pdfName.textContent = file.name
            pdfFrame.src = currentObjectUrl
            uploadIdle.hidden = true
            uploadFile.hidden = false
            pdfPreview.hidden = false
            submitButton.disabled = false
        }

        browseButton.addEventListener('click', event => { event.stopPropagation(); fileInput.click() })
        dropZone.addEventListener('click', () => fileInput.click())
        dropZone.addEventListener('keydown', event => { if (event.key === 'Enter' || event.key === ' ') fileInput.click() })
        fileInput.addEventListener('change', event => setFile(event.target.files[0]))
        removeButton.addEventListener('click', event => { event.stopPropagation(); clearFile() })
        ;['dragenter', 'dragover'].forEach(eventName => dropZone.addEventListener(eventName, event => { event.preventDefault(); dropZone.classList.add('is-dragover') }))
        ;['dragleave', 'drop'].forEach(eventName => dropZone.addEventListener(eventName, event => { event.preventDefault(); dropZone.classList.remove('is-dragover') }))
        dropZone.addEventListener('drop', event => setFile(event.dataTransfer.files[0]))
        submitButton.addEventListener('click', () => {
            if (!currentObjectUrl) return
            dropZone.hidden = true
            submitAction.hidden = true
            uploadMessage.textContent = '已成功上傳'
        })
        updateControls()
    })()
</script>
<% end %>

