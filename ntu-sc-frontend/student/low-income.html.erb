<!-- template: 學生 / 清寒低收入戶退費申請 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>清寒低收入戶退費申請</h3>
        </div>
        <div class="row g-5">
            <div class="col-lg-4">
                <ul class="menu-item">
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">姓名</span>
                        <span class="d-block fw-bold"><%= zh_lorem_name %></span>
                    </li>
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">信箱</span>
                        <span class="d-block fw-bold"><%= lorem_email %></span>
                    </li>
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">手機</span>
                        <span class="d-block fw-bold">0903514322</span>
                    </li>
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">電話</span>
                        <span class="d-block fw-bold">0223456789</span>
                    </li>
                </ul>
            </div>
            <div class="col-lg-8">
                <section>
                    <div class="section-title">
                        <h4>申請內容</h4>
                    </div>
                    <div class="form-group">
                        <label class="form-label">申請課程</label>
                        <div>115年 25N007 音樂與戲劇 (教師：OOO)</div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">總計可退金額</label>
                        <div>1400</div>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><span class="required">*</span> 申請項目</label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="option1" />
                                <label class="form-check-label" for="inlineRadio1">清寒</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="option2" />
                                <label class="form-check-label" for="inlineRadio2">低收入戶</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="formFile"><span class="required">*</span> 上傳證明</label>
                        <input class="form-control w-auto" type="file" id="formFile">
                    </div>
                </section>
                <div class="form-action">
                    <button type="submit" class="btn btn-lg btn-main">送出申請</button>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

