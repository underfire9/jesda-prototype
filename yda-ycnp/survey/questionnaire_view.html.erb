<!-- template: 問卷瀏覽 -->

<div class="container-lg">
    <div class="survey-wrapper">
        <aside class="survey-aside">
            <div class="account-info">
                <i class="far fa-user-circle"></i>
                <span class="user-name"><%= zh_lorem_name %></span>
            </div>
            <div class="account-info">
                <i class="far fa-envelope"></i>
                <span class="user-email"><%= lorem_email %></span>
            </div>
        </aside>
        <main class="survey-main">
            <h2 class="survey-title"><%= zh_lorem_words(8) %>問卷調查</h2>
            <div class="survey-notice">
                <p>親愛的同學你好</p>
                <p>恭喜你正式加入「青年生涯領航計畫」！本問卷旨在了解你在計畫初期的狀態、參與動機及對計畫的期望，作為後續輔導與成效評估的重要依據。你的回答僅供學術研究與政策優化參考，內容絕對保密，請依據個人真實感受放心填答。</p>
                <p class="text-end">教育部青年發展署</p>
            </div>
            <section class="survey-section">
                <div class="section-title">
                    <h3>基本資料與背景變項</h3>
                </div>
                <div class="questionnaire-list">
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_sentence %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_paragraph %></label>
                        <div class="output"><%= zh_lorem_paragraphs(2) %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_sentence %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_sentence %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_words(3) %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_sentence %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output">1</div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_sentence %></div>
                    </div>
                </div>
            </section>
            <section class="survey-section">
                <div class="section-title">
                    <h3>計畫申請時之支持系統、訊息管道、計畫認知、行政服務感受度</h3>
                </div>
                <div class="questionnaire-list">
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_sentence %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_paragraph %></label>
                        <div class="output"><%= zh_lorem_paragraphs(2) %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_sentence %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_sentence %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_words(3) %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_sentence %></div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output">1</div>
                    </div>
                    <div class="questionnaire-item">
                        <label class="form-label"><%= zh_lorem_sentence %></label>
                        <div class="output"><%= zh_lorem_sentence %></div>
                    </div>
                </div>
            </section>

            <div class="form-action noborder">
                送出時間：<%= Time.current.strftime("%Y-%m-%d %H:%M:%S") %>
            </div>
        </main>
    </div>
</div>



