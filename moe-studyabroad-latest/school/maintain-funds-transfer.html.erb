                                    </div>
                                </div>
                                <div class="row list-row">
                                    <% (1..2).map do |i| %>
                                    <div class="col-md-6">
                                        <div class="apply-card">
                                            <div class="card-bd">
                                                <div class="info-item">
                                                    <label class="info-item-label">計畫名稱</label>
                                                    <div class="control-output"><%= lorem_sentence %></div>
                                                </div>
                                                <div class="info-item">
                                                    <label class="info-item-label">計畫主持人</label>
                                                    <div class="control-output"><%= lorem_name %></div>
                                                </div>
                                                <div class="info-item">
