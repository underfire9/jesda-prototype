<!-- template: 文件上傳 (橫式) -->

<div class="container-lg">

    <!-- 上傳容器 -->
    <div class="upload-wrapper fluid-wrapper">
        <div class="upload-item">
            <h4>Head-shot Photo</h4>
            <p><%= lorem_paragraph %></p>
            <p><a href="#">範本下載</a></p>
            <div class="form-group">
                    <input class="form-control" type="file" id="photoFile">
            </div>
            <div class="ft-action">
                <span>
                    <div class="file-pill">
                        <a href="#" target="_blank" class="filename" title="避免檔名過長有限制最大寬度.jpg">避免檔名過長有限制最大寬度.jpg</a>
                        <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </span>
            </div>
        </div>
        <div class="upload-item">
            <h4>Student ID Card (Front)</h4>
            <p><%= lorem_sentence %></p>
            <p><a href="#">範本下載</a></p>
            <div class="form-group">
                    <input class="form-control" type="file" id="passportFile">
            </div>
            <div class="ft-action">
                <span>
                    <div class="file-pill">
                        <a href="#" target="_blank" class="filename" title="避免檔名過長有限制最大寬度.jpg">避免檔名過長有限制最大寬度.jpg</a>
                        <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </span>
            </div>
        </div>
    </div>

</div>


<% content_for :js do %>

<% end %>
