<% content_for :title do %>Club History<% end %>
<% content_for :alt_url do %>/history/index.html<% end %>
<% content_for :section do %>history<% end %>
<% content_for :data_js do %><script src="/javascripts/history-data.js"></script><% end %>

<header class="page-head">
  <div class="container page-head__inner">
    <div class="page-head__text">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/en/index.html">Home</a></li><li aria-current="page">Club History</li></ol></nav>
      <h1 class="page-title">Our Student Associations</h1>
      <p class="page-subtitle">Since 1928</p>
      <p class="lead">Since the first association was founded, seven overseas and mainland Chinese student associations have helped generations of students make NTU their home. Choose an association and follow the timeline through its founding, milestones and exchanges.</p>
    </div>
    <p class="page-head__deco" aria-hidden="true">1928</p>
  </div>
</header>

<nav class="club-tabs" aria-label="Choose an association">
  <div class="container">
    <ul class="chips chips--scroll" id="club-tabs"></ul>
  </div>
</nav>

<section class="club-head">
  <div class="container club-head__inner">
    <div>
      <p class="eyebrow" id="club-eyebrow"></p>
      <h2 class="club-head__title" id="club-title"></h2>
      <p class="club-head__sub" id="club-sub"></p>
    </div>
    <div class="type-filter" role="group" aria-labelledby="type-label">
      <span class="type-filter__label" id="type-label">Show</span>
      <ul class="chips" id="type-filter"></ul>
    </div>
  </div>
</section>

<div class="rail" id="rail">
  <div class="container">
    <ol class="rail__list" id="rail-list"></ol>
    <p class="rail__hint"><span class="dot"></span>Decades with records　Large dot = where you are　Tap a decade to jump there</p>
  </div>
</div>

<section class="timeline-section" aria-live="polite">
  <div class="container" id="timeline"></div>
  <p class="container note">(Years and events are placeholders for the prototype. Final content will be supplied by the organizing office.)</p>
</section>

<div class="lightbox lightbox--history" id="history-lb" role="dialog" aria-modal="true" aria-labelledby="hlb-title" hidden>
  <div class="lightbox__top">
    <p class="lightbox__count" id="hlb-count"></p>
    <button class="lightbox__close" type="button" id="hlb-close">Close<span aria-hidden="true" class="x"></span></button>
  </div>
  <button class="lightbox__nav lightbox__nav--prev" type="button" id="hlb-prev" aria-label="Previous record"></button>
  <div class="lightbox__card">
    <div class="lightbox__photo ph" id="hlb-photo" role="img" aria-label="Placeholder photo"></div>
    <div class="lightbox__info">
      <p class="lightbox__year" id="hlb-year"></p>
      <p class="event-card__labels" id="hlb-labels"></p>
      <h2 class="lightbox__title" id="hlb-title"></h2>
      <p class="lightbox__text" id="hlb-text"></p>
    </div>
  </div>
  <button class="lightbox__nav lightbox__nav--next" type="button" id="hlb-next" aria-label="Next record"></button>
</div>
