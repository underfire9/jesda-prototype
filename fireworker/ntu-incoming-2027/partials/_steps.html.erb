<!-- 目前步驟由 body[data-step] 決定；非中國大陸籍（body[data-prc] 不是 true）時步驟 2 顯示 Not required -->
<ol class="steps" aria-label="Application steps" data-i18n-attr="aria-label:steps.label">
  <li class="steps__item" data-step-item="1">
    <span class="steps__title" data-i18n="steps.form">Application Form</span>
  </li>
  <li class="steps__item" data-step-item="2">
    <span class="steps__title" data-i18n="steps.entryPermit">Entry Permit Information</span>
    <span class="steps__state" data-i18n="status.notRequired">Not required</span>
  </li>
  <li class="steps__item" data-step-item="3">
    <span class="steps__title" data-i18n="steps.upload">Upload Documents</span>
  </li>
  <li class="steps__item" data-step-item="4">
    <span class="steps__title" data-i18n="steps.payment">Payment</span>
  </li>
  <li class="steps__item" data-step-item="5">
    <span class="steps__title" data-i18n="steps.preview">Preview &amp; Submit</span>
  </li>
</ol>
<div class="steps-compact" aria-hidden="true">
  <div class="steps-compact__row">
    <b data-steps-current></b>
    <span data-steps-count></span>
  </div>
  <div class="steps-compact__bar">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
</div>
