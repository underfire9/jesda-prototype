<!-- template: 執行 - 專業認證獎金 (瀏覽) -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="wrapper-inner">
            
            <%= render :partial => "/partials/execution_sidenav" %>

            <main class="main">
                <div class="content-title">
                    <h3>專業認證獎金申請</h3>
                </div>
                <div class="notice-wrapper bonus-notice">
                    <% notice_list = [
                        "專業認證獎金申請表",
                        "專業認證獎金申請表應附上相關證明文件，包含但不限於：工作證明、薪資單、工作內容說明等。",
                        "申請人需確保所提供的資料真實且完整，若有任何虛假或不實資料，將可能導致申請被拒絕或追回已發放的獎金。",
                        "申請人需同意相關條款與規定，並遵守申請流程及截止日期。"
                    ] %>
                    <ul class="menu-item custom-list">
                        <% notice_list.each do |notice| %>
                            <li><%= notice %></li>
                        <% end %>
                    </ul>
                </div>
                <div class="experience-bonus-container">
                    <div class="inner-wrapper mb-0">
                        <h5 class="mb-4">證照資料</h5>
                        <div class="experience-bonus-list">
                            <div class="experience-bonus-item">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">證照/合格證明名稱</label>
                                            <div class="output"><%= lorem_words(5) %></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">證照核發日期</label>
                                            <div class="output"><%= Time.now.strftime("%Y-%m-%d") %></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">證明文件上傳</label>
                                            <div class="output"><a href="#" download><%= lorem_words(5) %>.pdf</a></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">學習歷程檔案證照系統截圖</label>
                                            <div class="output"><a href="#" download><%= lorem_words(5) %>.jpg</a></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="experience-bonus-item">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">證照/合格證明名稱</label>
                                            <div class="output"><%= lorem_words(5) %></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">證照核發日期</label>
                                            <div class="output"><%= Time.now.strftime("%Y-%m-%d") %></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">證明文件上傳</label>
                                            <div class="output"><a href="#" download><%= lorem_words(5) %>.pdf</a></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group form-group-output">
                                            <label class="form-label">學習歷程檔案證照系統截圖</label>
                                            <div class="output"><a href="#" download><%= lorem_words(5) %>.jpg</a></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="grand-total">
                            <span>您申請 <strong>2</strong> 張證照可領取金額 <strong>5000</strong> 元整</span>
                        </div>
                    </div>
                </div>
                <div class="form-action noborder mt-0">
                    <span class="backhome"><a href="home.html" class="btn btn-lg btn-back" title="回首頁"><i class="fas fa-long-arrow-alt-left"></i></a></span>
                </div>
            </main>
        </div>
    </div>
</div>



<% content_for :js do %>
<% end %>