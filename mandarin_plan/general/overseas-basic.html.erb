<!-- show/hide -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const listingSwitch = document.getElementById('listingChecked');
    const affirmativeGearing = document.querySelector('.affirmative-gearing');
    const negateGearing = document.querySelector('.negate-gearing');

    function toggleGearing() {
        if (listingSwitch.checked) {
            affirmativeGearing.style.display = '';
            negateGearing.style.display = 'none';
        } else {
            affirmativeGearing.style.display = 'none';
            negateGearing.style.display = '';
        }
    }

    listingSwitch.addEventListener('change', toggleGearing);
    toggleGearing();
});
</script>

<!-- multiple photo upload -->
<script>
window.addEventListener("DOMContentLoaded", function () {
    const inputFile = document.querySelector('.upload-photo-wrapper input[type="file"]');
    const container = document.getElementById("image-container");
    const MAX_IMAGES = 6;
    let selectedFiles = [];

    inputFile.addEventListener("change", function () {
        let files = Array.from(this.files);
        // 合併已選和新選的檔案
        let totalFiles = selectedFiles.concat(files);
        // 只取前六張
        if (totalFiles.length > MAX_IMAGES) {
            totalFiles = totalFiles.slice(0, MAX_IMAGES);
        }
        selectedFiles = totalFiles;
        renderImages();
        updateInputFiles();
        toggleInput();
        // 清空 input 以便可重複選同一檔案
        inputFile.value = "";
    });

    function renderImages() {
        container.innerHTML = "";
        selectedFiles.forEach((file, idx) => {
            const wrapper = document.createElement("div");
            wrapper.classList.add("image-wrapper");

            const img = document.createElement("img");
            img.classList.add("image-preview");
            img.src = URL.createObjectURL(file);
            img.onload = () => URL.revokeObjectURL(img.src);

            const btn = document.createElement("button");
            btn.type = "button";
            btn.classList.add("close-btn");
            btn.innerHTML = '<i class="fas fa-times"></i>';
            btn.addEventListener("click", function () {
                selectedFiles.splice(idx, 1);
                updateInputFiles();
                renderImages();
                toggleInput();
            });

            wrapper.appendChild(btn);
            wrapper.appendChild(img);
            container.appendChild(wrapper);
        });
    }

    function updateInputFiles() {
        const dt = new DataTransfer();
        selectedFiles.forEach(f => dt.items.add(f));
        inputFile.files = dt.files;
    }

    function toggleInput() {
        inputFile.disabled = selectedFiles.length >= MAX_IMAGES;
    }
});
</script>
<% end %>
