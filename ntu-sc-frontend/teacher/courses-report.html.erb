<!-- template: 教師 / 成果報告 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>成果報告</h3>
        </div>
        <div class="narrow-wrapper">
            <div class="row">
                <div class="col-md-12 col-lg-6">
                    <div class="form-group border-bottom py-2">
                        <label class="form-label fs-6 text-secondary">課程</label>
                        <div class="form-control-plaintext">25N002 - <%= zh_lorem_words(16) %></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="form-group border-bottom py-2">
                        <label class="form-label fs-6 text-secondary">授課教師</label>
                        <div class="form-control-plaintext"><%= zh_lorem_name %></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="form-group border-bottom py-2">
                        <label class="form-label fs-6 text-secondary">範本檔案下載</label>
                        <div class="form-control-plaintext">
                            <a href="#" class="text-primary">下載範本</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="border rounded-3 p-4 mt-4">
                <label for="fileUpload" class="form-label h5 mb-4">上傳報告</label>
                <input class="form-control" type="file" id="fileUpload">
                <div class="form-text">限 word，大小限 20MB 以下</div>
                <div class="border rounded-pill ps-2 pe-3 py-1 mt-4 w-auto d-inline-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-rounded btn-light fs-6" title="刪除檔案"><i class="fas fa-times"></i></button>
                    <a href="#" class="text-black" title="下載檔案" download><%= lorem_words(5) %>.docx</a>
                </div>
            </div>
            <div class="form-action border-0 mt-0">
                <span class="backhome">
                    <a href="#" class="btn btn-light"><i class="fas fa-long-arrow-alt-left"></i> 回列表</a>
                </span>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

