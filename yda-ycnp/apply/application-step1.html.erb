<!-- template: 申請 - 申請表填寫 (&補件) -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="application-process">
            <aside class="process-step">
                <div class="process-step-inner">
                    <ul class="process-step-list menu-item">
                        <li>
                            <!-- 當前頁面要給 .current -->
                            <button type="button" class="step-button btn current">填寫申請表</button>
                        </li>
                        <li>
                            <button type="button" class="step-button btn">企劃書撰寫</button>
                        </li>
                        <li>
                            <button type="button" class="step-button btn">上傳繳交文件</button>
                        </li>
                    </ul>
                    <div class="process-step-note">
                        所有資料欄位皆為必填除非另有標註
                    </div>

                    <!-- 所有步驟完成後拿掉 disabled -->
                    <button type="button" class="btn btn-rounded btn-block btn-lg btn-main" disabled>預覽後送出申請</button>
                </div>
            </aside>
            <main class="process-content">

                <!-- 補件 alert -->
                <!--div class="alert-supplement" role="alert">
                    <h5 class="fw-medium">補件原因</h5>
                    請依照補件通知內容，補齊相關資料後重新送出申請。<%= lorem_paragraph %>
                </div-->

                <div class="process-step-note mobile-only">
                    所有資料欄位皆為必填除非另有標註
                </div>
                <section class="process-section">
                    <h4 class="mb-4">註冊基本資料</h4>
                    <ul class="menu-item basic-info-list">
                        <li>
                            <span class="label">姓名</span>
                            <span class="output">陳曉明</span>
                        </li>
                        <li>
                            <span class="label">身分證字號</span>
                            <span class="output">S123456789</span>
                        </li>
                        <li>
                            <span class="label">出生日期</span>
                            <span class="output">2000 年 1 月 1 日</span>
                        </li>
                        <li>
                            <span class="label">性別</span>
                            <span class="output">男</span>
                        </li>
                        <li>
                            <span class="label">註冊帳號</span>
                            <span class="output">useraccount@example.com</span>
                        </li>
                        <li>
                            <span class="label">就讀學校</span>
                            <span class="output">建國高級中學</span>
                        </li>
                    </ul>
                </section>
                <section class="process-section">
                    <h4 class="mb-4">聯絡資訊</h4>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="contact_phone">手機</label>
                                <input type="text" class="form-control" id="contact_phone" placeholder="請輸入手機號碼">
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="contact_email">聯絡信箱</label>
                                <div class="d-inline-block ms-3">
                                    <div class="form-check text-secondary fs-6">
                                        <input class="form-check-input" type="checkbox" value="" id="checkDefault" />
                                        <label class="form-check-label fw-light" for="checkDefault">
                                            同註冊信箱
                                        </label>
                                    </div>
                                </div>
                                <div class="input-group">
                                    <input type="text" id="contact_email" class="form-control" placeholder="useraccount@example.com" aria-describedby="button-addon2" />
                                    <button class="btn btn-outline-dark fs-6" type="button" id="button-addon2">寄送認證信</button>
                                </div>
                                <div class="form-text fw-light">系統通知用，不可使用學校信箱</div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">戶籍地址</label>
                        <div class="row g-2">
                            <div class="col-sm-4 col-md-2">
                                <select class="form-select" aria-label="Default select example">
                                    <option selected>選擇縣市</option>
                                    <option value="1">選項一</option>
                                    <option value="2">選項二</option>
                                    <option value="3">選項三</option>
                                </select>
                            </div>
                            <div class="col-sm-4 col-md-2">
                                <select class="form-select" aria-label="Default select example">
                                    <option selected>鄉鎮市區</option>
                                    <option value="1">選項一</option>
                                    <option value="2">選項二</option>
                                    <option value="3">選項三</option>
                                </select>
                            </div>
                            <div class="col-sm-4 col-md-2">
                                <input type="text" class="form-control" placeholder="郵遞區號">
                            </div>
                            <div class="col-sm-12 col-md-6">
                                <input type="text" class="form-control" placeholder="地址">
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">通訊地址</label>
                        <div class="d-inline-block ms-3">
                            <div class="form-check text-secondary fs-6">
                                <input class="form-check-input" type="checkbox" value="" id="checkDefault02" />
                                <label class="form-check-label fw-light" for="checkDefault02">
                                    同戶籍
                                </label>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-sm-4 col-md-2">
                                <select class="form-select" aria-label="Default select example">
                                    <option selected>選擇縣市</option>
                                    <option value="1">選項一</option>
                                    <option value="2">選項二</option>
                                    <option value="3">選項三</option>
                                </select>
                            </div>
                            <div class="col-sm-4 col-md-2">
                                <select class="form-select" aria-label="Default select example">
                                    <option selected>鄉鎮市區</option>
                                    <option value="1">選項一</option>
                                    <option value="2">選項二</option>
                                    <option value="3">選項三</option>
                                </select>
                            </div>
                            <div class="col-sm-4 col-md-2">
                                <input type="text" class="form-control" placeholder="郵遞區號">
                            </div>
                            <div class="col-sm-12 col-md-6">
                                <input type="text" class="form-control" placeholder="地址">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="contact_line">Line ID</label>
                                <input type="text" class="form-control" id="contact_line">
                                <div class="form-text fw-light">非必填</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="contact_social">其他社群媒體帳號</label>
                                <input type="text" class="form-control" id="contact_social">
                                <div class="form-text fw-light">非必填</div>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="process-section">
                    <h4 class="mb-4">緊急聯絡人</h4>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="emergency_name">姓名</label>
                                <input type="text" class="form-control" id="emergency_name">
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="emergency_relation">關係</label>
                                <input type="text" class="form-control" id="emergency_relation">
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="emergency_phone">手機號碼</label>
                                <input type="text" class="form-control" id="emergency_phone">
                            </div>
                        </div>
                    </div>
                </section>
                <div class="form-action">
                    <button type="button" class="btn btn-lg btn-dark px-5">儲存</button>
                    <button type="button" class="btn btn-lg btn-step step-next"><span>下一步</span></button>
                </div>
            </main>
        </div>
    </div>
</div>

<% content_for :js do %>
<!-- Sticky Step -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    var nav = document.querySelector('.process-step-inner');
    var navOffset = nav.getBoundingClientRect().top + window.pageYOffset;

    function onScroll() {
        if (window.pageYOffset > navOffset) {
            nav.style.position = 'fixed';
            nav.style.top = '0';
            nav.style.zIndex = '1000';
            nav.style.width = nav.offsetWidth + 'px';
        } else {
            nav.style.position = '';
            nav.style.top = '';
            nav.style.zIndex = '';
            nav.style.width = '';
        }
    }

    window.addEventListener('scroll', onScroll);
});
</script>
<% end %>