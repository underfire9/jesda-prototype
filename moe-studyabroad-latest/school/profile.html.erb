<!-- template: 學校聯絡人 - 聯絡資料維護 -->
<% content_for :header_center do %>
    <span class="central-title">聯絡資料維護</span>
<% end %>

<div class="container">
    <div class="page-content">
        <div class="profile-container">
            <aside>
                <div class="form-group">
                    <label class="form-label">學校帳號</label>
                    <div class="profile-output">002000</div>
                </div>
                <div class="form-group">
                    <label class="form-label">學校</label>
                    <div class="profile-output">嘉藥學校財團法人嘉南藥理大學</div>
                </div>
                <div class="form-group">
                    <label class="form-label">登入帳號</label>
                    <div class="profile-output">002000</div>
                </div>
            </aside>
            <main>
                <div class="password-section">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="passwordCheckbox">
                                    <label class="form-check-label" for="passwordCheckbox">修改密碼</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 password-fields">
                            <div class="form-group">
                                <label class="form-label" for="password">密碼</label>
                                <input type="password" id="password" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-6 password-fields">
                            <div class="form-group">
                                <label class="form-label" for="password_confirmation">密碼確認</label>
                                <input type="password" id="password_confirmation" class="form-control">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="school_contact"><span class="required">*</span>校方聯絡人</label>
                            <input type="text" id="school_contact" class="form-control" value="<%= zh_lorem_name %>">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="service_unit"><span class="required">*</span>服務單位</label>
                            <input type="text" id="service_unit" class="form-control" value="國際處">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="contact_phone"><span class="required">*</span>聯絡電話</label>
                            <div class="d-flex gap-2">
                                <span class="flex-grow-1"><input type="text" id="contact_phone" class="form-control" value="+886-3-8905173"></span>
                                <span style="width: 128px;"><input type="text" id="contact_extension" class="form-control" placeholder="分機"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="fax">傳真</label>
                            <input type="text" id="fax" class="form-control" value="+886-3-8900170">
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label" for="address">通訊地址</label>
                            <input type="text" id="address" class="form-control" value="974 花蓮縣壽豐鄉志學村大學路二段一號">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="email"><span class="required">*</span>電子信箱</label>
                            <input type="email" id="email" class="form-control" value="issa@gms.ndhu.edu.tw">
                            <div class="form-text">請使用學校信箱註冊</div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="international_director"><span class="required">*</span>國際長姓名</label>
                            <input type="text" id="international_director" class="form-control" value="<%= zh_lorem_name %>">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="international_director_phone"><span class="required">*</span>國際長聯絡電話</label>
                            <div class="d-flex gap-2">
                                <span class="flex-grow-1"><input type="text" id="international_director_phone" class="form-control" value="+886-3-8905173"></span>
                                <span style="width: 128px;"><input type="text" id="international_director_extension" class="form-control" placeholder="分機"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="international_director_email"><span class="required">*</span>國際長電子信箱</label>
                            <input type="email" id="international_director_email" class="form-control" value="oia@gms.ndhu.edu.tw">
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="school_id">學校統一編號</label>
                            <input type="text" id="school_id" class="form-control" value="08153719">
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label">學校帳戶資訊</label>
                            <div class="row g-2">
                                <div class="col-lg-3 col-sm-6">
                                    <input type="text" id="" class="form-control" value="台灣銀行" placeholder="銀行名稱">
                                </div>
                                <div class="col-lg-2 col-sm-6">
                                    <input type="text" id="" class="form-control" value="花蓮分行" placeholder="分行">
                                </div>
                                <div class="col-lg-3 col-sm-6">
                                    <input type="text" id="" class="form-control" value="018036071124" placeholder="帳號">
                                </div>
                                <div class="col-lg-4 col-sm-6">
                                    <input type="text" id="" class="form-control" value="國立東華大學401專戶" placeholder="戶名">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label" for="remarks">備註</label>
                            <textarea id="remarks" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="form-action">
                    <span class="backhome">
                        <button type="button" class="btn btn-lg btn-light" onclick="window.history.back()" title="回上一頁"><i class="fas fa-long-arrow-alt-left"></i></button>
                    </span>
                    <button type="button" class="btn btn-lg btn-dark">儲存</button>
                </div>
            </main>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

