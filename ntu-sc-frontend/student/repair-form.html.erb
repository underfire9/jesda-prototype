<!-- template: 學生 / 停修申請單 -->

<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>停修申請單</h3>
        </div>
        <div class="row g-5">
            <div class="col-md-4">
                <ul class="menu-item">
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">姓名</span>
                        <span class="d-block fw-bold"><%= zh_lorem_name %></span>
                    </li>
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">信箱</span>
                        <span class="d-block fw-bold"><%= lorem_email %></span>
                    </li>
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">手機</span>
                        <span class="d-block fw-bold">0903514322</span>
                    </li>
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">電話</span>
                        <span class="d-block fw-bold">0223456789</span>
                    </li>
                </ul>
            </div>
            <div class="col-md-8">
                <div class="section-title">
                    <h4>申請停修課程</h4>
                </div>
                <div class="form-group">
                    <label class="form-label"><span class="required">*</span> 選擇停修課程</label>
                    <div class="row g-2">
                        <div class="col-sm-3">
                            <select class="form-select" aria-label="年度">
                                <option selected>115 年</option>
                                <option value="1">114 年</option>
                                <option value="2">113 年</option>
                                <option value="3">112 年</option>
                            </select>
                        </div>
                        <div class="col-sm-9">
                            <select class="form-select" aria-label="課程">
                                <option selected>請選擇課程</option>
                                <option value="1">音樂與戲劇</option>
                                <option value="2">數學基礎</option>
                                <option value="3">物理實驗</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="repair_reason"><span class="required">*</span> 停修原因</label>
                    <input type="text" id="repair_reason" class="form-control" placeholder="請輸入">
                </div>
                <div class="form-action">
                    <button type="button" class="btn btn-main btn-lg btn-save">送出申請</button>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

