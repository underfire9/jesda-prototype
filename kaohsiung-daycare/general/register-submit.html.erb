<!-- template: 登記報名 - 送出申請 -->

<%= render :partial => "/partials/breadcrumb" %>

<div class="container-lg">
    
    <!-- review 或補件時增加 .submit-content -->
	<div class="page-content submit-content d-block">
        
        <!--div class="page-title">
            <h3>送出申請</h3>
        </div-->
        
        <div class="step-wrapper">
            <div class="scrollbar-inner">
                <ul class="step-menu menu-item">
                    <li class="step-item done">
                        <span class="number">1</span>
                        <span class="description">申請表</span>
                    </li>
                    <li class="step-item done">
                        <span class="number">2</span>
                        <span class="description">選擇托育機構</span>
                    </li>
                    <li class="step-item done">
                        <span class="number">3</span>
                        <span class="description">選擇身分別</span>
                    </li>
                    <li class="step-item done">
                        <span class="number">4</span>
                        <span class="description">上傳佐證資料</span>
                    </li>
                    <li class="step-item current">
                        <span class="number">5</span>
                        <span class="description">送出申請</span>
                    </li>
                </ul>
            </div>
        </div>
        
        <section class="section">
            <div class="section-title">
                <h4>幼兒</h4>
            </div>
            
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">幼兒姓名</label>
                        <input type="text" class="form-control" value="<%= zh_lorem_name %>" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">身分證字號</label>
                        <input type="text" class="form-control" value="B123456789" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">生日</label>
                        <input type="text" class="form-control" value="2019-08-18" disabled readonly />
                    </div>
                </div>
            </div>
            
            <div class="form-group">
                <label class="form-label">幼兒於候補期間照顧情形 <span class="required">*</span></label>
                <div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="careSituation" id="careSituation1" checked disabled />
                        <label class="form-check-label" for="careSituation1">
                            父母或監護人自行照顧
                        </label>
                    </div>
                    <div class="check-situation">
                        <label class="form-label">是否育嬰留職停薪</label>
                        <div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="careSuspension" checked disabled />
                                <label class="form-check-label" for="careSuspensionYes">
                                    是
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="form-group">
                <label class="form-label">通訊地址 <span class="required">*</span></label>
                <div class="row">
                    <div class="col-sm-3">
                        <div class="mb-2">
                            <input type="text" class="form-control" value="高雄市" disabled readonly />
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <input type="text" class="form-control" value="鳳山區" disabled readonly />
                    </div>
                    <div class="col-sm-6">
                        <div class="mb-2">
                            <input type="text" class="form-control" value="文化路166號" disabled readonly />
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">住家電話 (連絡電話)</label>
                        <input type="text" class="form-control" value="0987654321" disabled readonly />
                    </div>
                </div>
            </div>
        </section>
        
        <section class="section">
            <div class="section-title">
                <h4>申請人</h4>
            </div>
            
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">姓名</label>
                        <input type="text" class="form-control" value="<%= zh_lorem_name %>" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">稱謂</label>
                        <input type="text" class="form-control" value="父女" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="" class="form-label">聯絡電話</label>
                        <input type="text" class="form-control" value="07-7418523" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">服務單位</label>
                        <input type="text" class="form-control" value="國家教育研究委員會" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">職稱</label>
                        <input type="text" class="form-control" value="董事長" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="" value="<%= lorem_email %>" disabled readonly />
                    </div>
                </div>
            </div>
        </section>
        
        <section class="section">
            <div class="section-title">
                <h4>第二位聯絡人</h4>
            </div>
            
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">姓名</label>
                        <input type="text" class="form-control" value="<%= zh_lorem_name %>" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">稱謂</label>
                        <input type="text" class="form-control" value="父女" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="" class="form-label">聯絡電話</label>
                        <input type="text" class="form-control" value="07-7418523" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">服務單位</label>
                        <input type="text" class="form-control" value="國家教育研究委員會" disabled readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="form-label">職稱</label>
                        <input type="text" class="form-control" value="董事長" disabled readonly />
                    </div>
                </div>
            </div>
        </section>
        
        <section class="section">
            <label class="form-label text-danger">本公托遵循個資保護法之相關條例，您的資料僅做為幼兒登記托育之使用，並依程序提報社會局做為比對依據</label>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="checkAgree" checked disabled />
                <label class="form-check-label" for="checkAgree">
                    我同意
                </label>
            </div>
        </section>
        
        <section class="section">
            <div class="section-title">
                <h4>佐證資料</h4>
            </div>
            <h5 class="mb-4 fw-bold h4">高雄市公設民營東區大致國小托嬰中心</h5>
            <div class="upload-wrapper register-upload">
                <div class="upload-item">
                    <div class="item-bd">
                        <h4>B-2. 弱勢家庭：中低收入戶</h4>
                        <div class="mb-1">
                            <a href="#" class="btn btn-lg btn-light"><i class="fas fa-file-download"></i> 檔案下載</a>
                        </div>
                    </div>
                </div>
                <div class="upload-item">
                    <div class="item-bd">
                        <h4>B-2. 弱勢家庭：中低收入戶</h4>
                        <div class="mb-1">
                            <a href="#" class="btn btn-lg btn-light"><i class="fas fa-file-download"></i> 檔案下載</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <section class="section">
            <div class="section-title">
                <h4>佐證資料</h4>
            </div>
            <h5 class="mb-4 fw-bold h4">高雄市公設鳳山區鳳山中山國中小托育中心</h5>
            <div class="upload-wrapper register-upload">
                <div class="upload-item">
                    <div class="item-bd">
                        <h4>B-3. 弱勢家庭：特殊境遇家庭</h4>
                        <div class="mb-1">
                            <a href="#" class="btn btn-lg btn-light"><i class="fas fa-file-download"></i> 檔案下載</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <div class="form-action">
            <button type="button" class="btn btn-lg btn-light">上一步</button>
            <button type="submit" class="btn btn-lg btn-primary">送出申請</button>
        </div>
        
	</div>
</div>

<!-- Modal -->
<div class="modal fade" id="attentionModal" tabindex="-1" aria-labelledby="attentionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="attentionModalLabel">注意事項</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><%= lorem_sentence %></p>
                <p><%= lorem_sentence %></p>
                <ol>
                    <% (1..6).map do |i| %>
                    <li><%= lorem_sentence %></li>
                    <% end %>
                </ol>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>

<!-- mobile 視窗指定卷軸位置 -->
<script>
$(document).ready(function() {
    // 判斷是否為小視窗
    if ($(window).width() <= 768) {
        // 設定橫向卷軸到指定的 .current 元素位置
        var currentItem = $('.step-item.current');
        if (currentItem.length) {
            var scrollPosition = currentItem.position().left;
            $('.scrollbar-inner').scrollLeft(scrollPosition);
        }
    }
});
</script>

<% end %>










