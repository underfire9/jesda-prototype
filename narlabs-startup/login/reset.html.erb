<!-- template: 密碼設定 -->

<div class="container-lg">
	<div class="login-wrapper">
		<div class="login-card">
		    <div class="card-hd">
			    <h3>密碼設定</h3>
			</div>
			<div class="card-bd">
                <div class="form-group">
                    <label for="exampleFormControlInput1" class="form-label">密碼</label>
                    <input type="password" class="form-control" id="exampleFormControlInput1" />
                    <div class="form-text">8 - 16個字。 密碼必須包含大、小寫英文字母、數字以及特殊符號</div>
                </div>
                <div class="form-group">
                    <label for="exampleFormControlInput2" class="form-label">再次輸入密碼</label>
                    <input type="password" class="form-control" id="exampleFormControlInput2" />
                </div>
			</div>
            <div class="d-grid mt-4">
                <button class="btn btn-lg btn-main" type="submit">確定</button>
            </div>
		</div>
	</div>
</div>



