<!-- template: 教師 / 課程管理 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title mobile-only">
            <h3>課程管理</h3>
        </div>
        <div class="d-flex gap-2 mb-4">
            <div>
                <select class="form-select w-auto" aria-label="選擇年度">
                    <option selected>115</option>
                    <option value="1">One</option>
                    <option value="2">Two</option>
                    <option value="3">Three</option>
                </select>
            </div>
            <div>
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="課程名稱、開課學校" aria-label="Recipient’s username" aria-describedby="button-addon2">
                    <button class="btn btn-outline-secondary" type="button" id="button-addon2"><i class="fas fa-search"></i></button>
                </div>
            </div>
        </div>
        <div class="row">
            <% (1..3).map do |i| %>
            <div class="col-lg-6">
                <div class="border rounded-3 p-4 mb-4">
                    <h4 class="mb-4">程式理解與軟體創作統合</h4>
                    <div class="border-bottom py-2">
                        <span class="d-block text-secondary fs-6">課程編號</span>
                        <span class="d-block">25N002</span>
                    </div>
                    <div class="border-bottom py-2">
                        <span class="d-block text-secondary fs-6">授課教師</span>
                        <span class="d-block has-multiple-values">
                            <span><%= zh_lorem_name %></span>
                            <span><%= zh_lorem_name %></span>
                            <span><%= zh_lorem_name %></span>
                        </span>
                    </div>
                    <div class="border-bottom py-2">
                        <span class="d-block text-secondary fs-6">開課學校</span>
                        <span class="d-block">國立臺灣海洋大學</span>
                    </div>
                    <div class="border-bottom py-2">
                        <span class="d-block text-secondary fs-6">上課地點</span>
                        <span class="d-block">國立臺灣師範大學 校本部校區 誠105</span>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">學分數</span>
                                <span class="d-block">2</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">招生人數上限</span>
                                <span class="d-block">70</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">1st 報名/錄取</span>
                                <span class="d-block">48 / 31</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">2nd報名/錄取</span>
                                <span class="d-block">24 / 41</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">總報名</span>
                                <span class="d-block">72</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">錄取</span>
                                <span class="d-block">72</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">上課</span>
                                <span class="d-block">43</span>
                            </div>
                        </div>
                    </div>
                    <div class="border-bottom py-2">
                        <span class="d-block text-secondary fs-6">課程領域</span>
                        <span class="d-block has-multiple-values">
                            <span>文學與藝術</span>
                            <span>歷史思維</span>
                            <span>哲學與道德思考</span>
                            <span>公民意識與社會分析</span>
                            <span>生命科學</span>
                        </span>
                    </div>
                    <div class="d-flex gap-2 flex-wrap justify-content-center mt-4">
                        <a href="#" class="btn btn-outline-secondary">
                            <span>課程瀏覽</span>
                        </a>
                        <a href="#" class="btn btn-outline-primary">
                            <span>學生名單</span>
                        </a>
                        <a href="#" class="btn btn-outline-primary">
                            <span>簽到表</span>
                        </a>
                    </div>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

