<% content_for :title do %>Enrollment Certificate<% end %>
<% content_for :title_key do %>enrollCert.title<% end %>
<% content_for :page do %>enrollCert<% end %>
<% content_for :app_status do %>enrolled<% end %>
<% content_for :portal_status do %>
<span class="chip chip--dot chip--ok" data-i18n="status.enrolled">Enrolled</span>
<p data-i18n="portal.visiting" data-i18n-vars='{"from":"2026-02-16","to":"2026-06-30"}'>Visiting 2026-02-16 – 2026-06-30</p>
<% end %>

<div class="container">
  <header class="masthead">
    <p class="eyebrow" data-bi-en="2025 Graduate Visiting Research" data-bi-zh="2025 來校訪問研究生">2025 Graduate Visiting Research</p>
    <h1 class="masthead__title" data-i18n="enrollCert.title">Enrollment Certificate</h1>
    <p class="masthead__lead" data-i18n="enrollCert.lead">Proof that you are currently a visiting research student at NTU.</p>
  </header>

  <div class="page-grid">
    <aside class="page-grid__aside">
      <%= render :partial => "/partials/portal_nav" %>
    </aside>

    <div class="page-grid__main">
      <section class="card" aria-labelledby="enroll-section-title">
        <div class="card__head">
          <h2 class="card__title" id="enroll-section-title" data-i18n="download.section">Documents</h2>
        </div>
        <!-- 證書版型不在切版範圍內，此處只提供下載列 -->
        <div class="download-list">
          <div class="download-row">
            <span class="download-row__type" aria-hidden="true">PDF</span>
            <div class="download-row__body">
              <p class="download-row__title" id="enroll-cert" data-i18n="enrollCert.item">Certificate of Enrollment</p>
              <p class="download-row__meta" data-i18n="enrollCert.meta">PDF · English and Chinese · Valid while you are enrolled</p>
            </div>
            <a class="btn" href="#" download aria-describedby="enroll-cert" data-i18n="common.download">Download</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
