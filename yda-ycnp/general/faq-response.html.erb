<!-- template: (X) 我要提問 - 回應 -->

<div class="container-lg">
    <div class="page-content">
        <div class="ask-wrapper response">
            <div class="wrap-start">
                <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
                <h3>我要提問</h3>
                <div class="form-group">
                    <label class="form-label">聯絡信箱</label>
                    <div>username@email.com</div>
                </div>
                <div class="form-group">
                    <label class="form-label">提問內容</label>
                    <div><%= lorem_sentences(2) %></div>
                </div>
                <div class="form-group">
                    <label class="form-label">附件</label>
                    <div><a href="#" class="attached-link" title="{filename}">filename.pdf</a></div>
                </div>
            </div>
            <div class="wrap-end">
                <h4 class="mb-4 text-secondary">回應</h4>
                <div class="response-content">
                    <p><%= lorem_paragraph %></p>
                    <p>基本資料：</p>
                    <ul>
                        <li>請登入計畫網站，填寫基本資訊，包括姓名、身份證字號、出生年月日、性別、聯絡方式（手機、電子郵件）、戶籍地址與通訊地址及就讀學校名稱。</li>
                        <li>身份證明文件：中華民國國民身份證正反面影本或戶籍謄本（申請日3個月內）掃描檔或照片檔。</li>
                        <li>學生證明文件：在學證明或學生證掃描檔或照片檔。</li>
                    </ul>
                    <p><%= lorem_paragraph %></p>
                    <div class="attached-ft">
                        <a href="#" class="attached-link" title="{filename}">filename.pdf</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

