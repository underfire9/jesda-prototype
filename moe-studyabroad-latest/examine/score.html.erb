<!-- template: 闈場審查系統 - 審查介面 -->

<% content_for :page_styles do %>
<style>
    .score-guide-popover {
        all: initial;
        box-sizing: border-box;
        display: block;
        position: fixed;
        z-index: 1000000000;
        min-width: 280px;
        max-width: 340px;
        padding: 1rem;
        border: 1px solid #d7e0e3;
        border-radius: .5rem;
        background: #fff;
        box-shadow: 0 12px 28px rgba(0, 0, 0, .2);
        color: #2f3b40;
        font-family: "Microsoft JhengHei", "Noto Sans TC", sans-serif;
        font-size: .9375rem;
        line-height: 1.6;
    }
    .score-guide-popover *,
    .score-guide-popover *::before,
    .score-guide-popover *::after {
        box-sizing: border-box;
    }
    .score-guide-popover .driver-popover-title {
        display: block;
        margin: 0;
        padding-right: 1.5rem;
        font-size: 1.125rem;
        font-weight: 700;
        line-height: 1.4;
        color: #244a52;
    }
    .score-guide-popover .driver-popover-description {
        display: block;
        margin: .5rem 0 0;
        color: #51626b;
    }
    .score-guide-popover .driver-popover-close-btn {
        position: absolute;
        top: .5rem;
        right: .5rem;
        border: 0;
        padding: .25rem .5rem;
        background: transparent;
        color: #738187;
        font-size: 1.25rem;
        line-height: 1;
        cursor: pointer;
    }
    .score-guide-popover .driver-popover-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        margin-top: 1rem;
        padding-top: .75rem;
        border-top: 1px solid #e4ebed;
    }
    .score-guide-popover .driver-popover-progress-text {
        color: #718087;
        font-size: .8125rem;
    }
    .score-guide-popover .driver-popover-navigation-btns {
        display: flex;
        gap: .375rem;
    }
    .score-guide-popover .driver-popover-footer-btn {
        border: 1px solid #cbd8db;
        border-radius: .25rem;
        padding: .375rem .625rem;
        background: #fff;
        color: #38545b;
        font-family: inherit;
        font-size: .8125rem;
        line-height: 1.25;
        cursor: pointer;
    }
    .score-guide-popover .driver-popover-next-btn {
        border-color: #3f8b9b;
        background: #3f8b9b;
        color: #fff;
    }
    .score-guide-popover .driver-popover-footer-btn:hover,
    .score-guide-popover .driver-popover-footer-btn:focus {
        border-color: #2f6f7c;
        background: #edf6f7;
        color: #244a52;
    }
    .score-guide-popover .driver-popover-next-btn:hover,
    .score-guide-popover .driver-popover-next-btn:focus {
        background: #2f6f7c;
        color: #fff;
    }
</style>
<% end %>

