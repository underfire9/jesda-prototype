<script>
(function () {
    // ----- 拖曳 / 點擊上傳 -----
    (function () {
        var $wrapper = $('#dragFileWrapper');
        var $dropZone = $('#dropZone');
        var $fileInput = $('#fileInput');
        var $fileList = $('#fileList');
        var files = [];

        function formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        function getFileIcon(name) {
            var ext = name.split('.').pop().toLowerCase();
            var map = {
                pdf: 'fa-file-pdf', doc: 'fa-file-word', docx: 'fa-file-word',
                xls: 'fa-file-excel', xlsx: 'fa-file-excel',
                ppt: 'fa-file-powerpoint', pptx: 'fa-file-powerpoint',
                png: 'fa-file-image', jpg: 'fa-file-image', jpeg: 'fa-file-image', gif: 'fa-file-image',
                zip: 'fa-file-archive', rar: 'fa-file-archive'
            };
            return 'far ' + (map[ext] || 'fa-file');
        }

        function renderFileList() {
            $fileList.empty();
            files.forEach(function (file, idx) {
                var $li = $('<li class="file-item"></li>');
                $li.append('<span class="file-icon"><i class="' + getFileIcon(file.name) + '"></i></span>');
                $li.append('<span class="file-name" title="' + $('<span>').text(file.name).html() + '">' + $('<span>').text(file.name).html() + '</span>');
                $li.append('<span class="file-size">' + formatSize(file.size) + '</span>');
                var $del = $('<button type="button" class="btn btn-sm btn-light file-delete" title="刪除"><i class="far fa-trash-alt"></i></button>');
                $del.on('click', function () {
                    files.splice(idx, 1);
                    renderFileList();
                });
                $li.append($del);
                $fileList.append($li);
            });
        }

        function addFiles(newFiles) {
            var rejected = [];
            Array.prototype.forEach.call(newFiles, function (f) {
                if (f.type !== 'application/pdf' && !f.name.toLowerCase().endsWith('.pdf')) {
                    rejected.push(f.name);
                    return;
                }
                if (!files.some(function (existing) { return existing.name === f.name && existing.size === f.size; })) {
                    files.push(f);
                }
            });
            if (rejected.length) {
                alert('以下檔案非 PDF，已略過：\n' + rejected.join('\n'));
            }
            renderFileList();
        }

        $dropZone.on('click', function () { $fileInput.trigger('click'); });

        $fileInput.on('change', function () {
            if (this.files && this.files.length) {
                addFiles(this.files);
                this.value = '';
            }
        });

        $dropZone.on('dragover dragenter', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dropZone.addClass('is-dragover');
        });

        $dropZone.on('dragleave dragend', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dropZone.removeClass('is-dragover');
        });

        $dropZone.on('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dropZone.removeClass('is-dragover');
            var dt = e.originalEvent.dataTransfer;
            if (dt && dt.files && dt.files.length) {
                addFiles(dt.files);
            }
        });
    })();

    // ----- 編號 -----
    function buildSerials(navId) {
        var topCounter = 0;
        $(navId + ' > .nav-item').each(function () {
            topCounter++;
            var $topSerial = $(this).children('.nav-link, div.nav-link').first().find('> .serial');
            $topSerial.text(topCounter);

            var $sub = $(this).children('.nav-sub');
            if ($sub.length) {
                var subCounter = 0;
                $sub.find('> .nav-item').each(function () {
                    subCounter++;
                    $(this).find('> button.nav-link > .serial, > .nav-link > .serial').first().text(topCounter + '.' + subCounter);
                });
            }
        });
    }
    buildSerials('#planTab');
    buildSerials('#previewPlanTab');
})();
</script>
<% end %>

