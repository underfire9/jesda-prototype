<!-- template: 聯絡我們 -->

<div class="container-lg">
    <div class="page-content">
        <div class="contact-container">
            <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
            <h3>聯絡我們</h3>
            <div class="mb-5">
                <h4>臺科大人力資源辦公室</h4>
                <p class="mb-1">電話：(02)2730-1290　傳真：(02)2730-1291　E-Mail信箱：<a href="mailto:tosf@mail.ntust.edu.tw">tosf@mail.ntust.edu.tw</a></p>
                <p>如有任何問題歡迎與我們聯絡</p>
            </div>
            <div class="contact-wrapper">
                <form>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="contactName" class="form-label">姓名</label>
                                <input type="text" class="form-control" id="contactName" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="contactPhone" class="form-label">聯絡電話</label>
                                <input type="text" class="form-control" id="contactPhone" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="contactEmail" class="form-label">聯絡信箱</label>
                                <input type="email" class="form-control" id="contactEmail" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="contactSubject" class="form-label">主題</label>
                                <input type="text" class="form-control" id="contactSubject" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="contactContent" class="form-label">內容</label>
                        <textarea class="form-control" id="contactContent" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="contactCaptcha" class="form-label">驗證碼</label>
                        <div class="d-flex align-items-center gap-1">
                            <input type="text" class="form-control w-captcha" id="contactCaptcha" placeholder="請輸入驗證碼" />
                            <span><img class="captcha" src="https://www.studyabroad.moe.gov.tw/new/common/captcha.image" alt="驗證碼圖片"></span>
                            <span>
                                <button type="button" class="btn btn-light captchaPlayAudio" title="播放語音驗證碼">
                                    <i class="fa fa-volume-up"></i><span class="sr-only">播放語音驗證碼</span>
                                </button>
                            </span>
                            <span>
                                <button class="btn btn-light captchaChange" type="button" title="更新驗證碼">
                                    <i class="fas fa-sync-alt"></i><span class="sr-only">更新驗證碼</span>
                                </button>
                            </span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-lg btn-block btn-primary">送出</button>
                </form>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

