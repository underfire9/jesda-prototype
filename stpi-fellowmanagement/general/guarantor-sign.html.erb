<!-- template: 連帶保證人簽章 -->

<div class="container-lg">
    <div class="section-title">
        <h4>計畫合約連帶保證人簽章</h4>
    </div>
    <div class="notice-wrapper">
        <p><%= zh_lorem_paragraph %></p>
        <p><%= zh_lorem_paragraph %></p>
    </div>

    <section class="section">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor1-name" class="form-label">保人姓名</label>
                    <input type="text" class="form-control" id="guarantor1-name" value="<%= zh_lorem_name %>" disabled readonly>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor1-email" class="form-label">電子信箱</label>
                    <input type="email" class="form-control" id="guarantor1-email" value="userid@email.com" disabled readonly>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor1-id" class="form-label">身份證字號</label>
                    <input type="text" class="form-control" id="guarantor1-id" value="A123456789" disabled readonly>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="trainee-name" class="form-label">學員姓名</label>
                    <input type="text" class="form-control" id="trainee-name" value="<%= zh_lorem_name %>" disabled readonly>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="trainee-enname" class="form-label">學員英文姓名</label>
                    <input type="text" class="form-control" id="trainee-enname" value="<%= lorem_name %>" disabled readonly>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="trainee-enname" class="form-label">學員計畫名稱</label>
                    <input type="text" class="form-control" id="trainee-enname" value="<%= lorem_sentence %>" disabled readonly>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="row">
            <div class="col-md-6 col-lg-4 mb-5">
                <h5>學員合約檔案</h5>
                <a href="#" class="btn btn-light btn-rounded"><i class="far fa-file-alt"></i> 檔案下載</a>
            </div>
            <div class="col-md-6 col-lg-4 mb-5">
                <h5>合約連帶保證人附件檔案</h5>
                <a href="#" class="btn btn-light btn-rounded"><i class="far fa-file-alt"></i> 檔案下載</a>
            </div>
            <div class="col-md-6 col-lg-4 mb-5">
                <h5>擔保類型</h5>
                <div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="option1" />
                        <label class="form-check-label" for="inlineRadio1">類型 1</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="option2" />
                        <label class="form-check-label" for="inlineRadio2">類型 2</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio3" value="option3" />
                        <label class="form-check-label" for="inlineRadio3">類型 3</label>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="upload-wrapper">
            <!-- 檔案上傳後多出 .file-pill，當再次上傳時則覆蓋上一筆，點選檔名另開視窗觀看文件 -->
            <div class="upload-item">
                <h5>財產證明文件</h5>
                <div class="form-group">
                    <input class="form-control" type="file" id="photoFile">
                </div>
                <div class="ft-action">
                    <span>
                        <div class="file-pill">
                            <!-- 避免檔名過長有限制最大寬度 256px，超出時會字元會省略 -->
                            <a href="#" target="_blank" class="filename"><%= lorem_sentence %>.pdf</a>
                            <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </span>
                </div>
            </div>
        </div>
    </section>

    <div class="form-action">
        <button type="submit" class="btn btn-lg btn-primary">送出並進行電子簽章</button>
    </div>

</div>



<% content_for :js do %>

<% end %>

