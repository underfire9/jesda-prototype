<!-- template: 登入 - 忘記密碼 -->

<div class="container-lg">
    <div class="page-content">
        <div class="login-container login-narrow">
            <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
            <h3 class="fw-semibold text-secondary">忘記密碼</h3>
            <p>系統會重新設定一組新的密碼並寄送到您註冊的 Email 信箱 </p>
            <div class="login-wrapper">
                <form>
                    <div class="form-group">
                        <label for="accountPerson" class="form-label">帳號</label>
                        <input type="text" class="form-control" id="accountPerson" placeholder="請輸入帳號" />
                    </div>
                    <div class="form-group">
                        <label for="captchaPerson" class="form-label">驗證碼</label>
                        <div class="d-flex align-items-center gap-1">
                            <input type="text" class="form-control w-captcha" id="captchaPerson" placeholder="請輸入驗證碼" />
                            <span><img class="captcha" src="https://www.studyabroad.moe.gov.tw/new/common/captcha.image" alt="驗證碼圖片"></span>
                            <span>
                                <button type="button" class="btn btn-light captchaPlayAudio" title="播放語音驗證碼">
                                    <i class="fa fa-volume-up"></i><span class="sr-only">播放語音驗證碼</span>
                                </button>
                            </span>
                            <span>
                                <button class="btn btn-light captchaChange" type="button" title="更新驗證碼">
                                    <i class="fas fa-sync-alt"></i><span class="sr-only">更新驗證碼</span>
                                </button>
                            </span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-lg btn-block btn-primary">寄送密碼</button>
                </form>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>
<script src="../javascripts/select2.min.js"></script>
<script>
$( '#studentSchool' ).select2( {
    theme: "bootstrap-5",
    width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
    placeholder: $( this ).data( 'placeholder' ),
} );
</script>
<% end %>

