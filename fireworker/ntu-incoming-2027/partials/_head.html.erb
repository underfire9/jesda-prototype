<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= content_for?(:title) ? yield(:title) : "NTU OIA" %> · NTU Incoming Visiting Research Student Online Application System</title>
<script>
  /* 在繪製前先決定語系，避免中文頁先閃一下英文字型：?lang= → 上次選擇 → en */
  (function () {
    try {
      var p = new URLSearchParams(location.search).get("lang");
      var l = p || localStorage.getItem("oia-lang");
      if (l && /^zh/i.test(l)) document.documentElement.lang = "zh-Hant";
    } catch (e) {}
  })();
</script>
