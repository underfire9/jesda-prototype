                    <div class="section-title">
                        <h4>申請停修課程</h4>
                    </div>
                    <div class="form-group">
                        <label class="form-label">選擇停修課程</label>
                        <div>
                            25N007 音樂與戲劇 (教師：<%= zh_lorem_name %>)
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">停修原因</label>
                        <div>
                            活動衝堂導致時間不足,成績考量，決定停修
                        </div>
                    </div>
                </section>
                <section>
                    <div class="section-title">
                        <h4>審查結果</h4>
                    </div>
                    <div class="table-responsive">
                        <table class="table text-nowrap">
                            <thead>
                                <tr>
                                    <th>審查關卡</th>
                                    <th>姓名</th>
                                    <th>審查時間</th>
                                    <th>審查結果</th>
