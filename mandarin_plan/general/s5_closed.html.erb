<!-- template: S5 計畫結案 -->

<div class="container-lg">
	<div class="page-content d-block">
        <div class="head-select">
            <select class="form-select form-select-lg customization-select">
                <option value="1" selected>114 年第一期</option>
                <option value="2">Two</option>
                <option value="3">Three</option>
            </select>
        </div>
        <div class="step-bar">
            <ul>
                <li class="done">
                    <span>
                        <a href="#" class="step">1</a>
                        <h4>計畫申請</h4>
                        <p class="brief">2025-06-12 14:31</p>
                    </span>
                </li>
                <li class="done">
                    <span>
                        <a href="#" class="step">2</a>
                        <h4>審查會議</h4>
                        <p class="brief">2025-06-16 10:00</p>
                    </span>
                </li>
                <li class="done">
                    <span>
                        <a href="#" class="step">3</a>
                        <h4>計畫核定</h4>
                        <p class="brief">2025-06-16 10:00</p>
                    </span>
                </li>
                <li class="done">
                    <span>
                        <a href="#" class="step">4</a>
                        <h4>學校回覆修正計畫書</h4>
                        <p class="brief">2025-06-16 10:00</p>
                    </span>
                </li>
                <li class="active">
                    <span>
                        <a href="#" class="step">5</a>
                        <h4>計畫結案</h4>
                    </span>
                </li>
            </ul>
        </div>

        <div class="alert alert-warning">計畫之結報，至遲應於計畫核定執行期滿屆滿後二個月內，檢附相關資料辦理。</div>

        <section class="section">
            <h4 class="mb-4">優華語計畫合作學校</h4>
            <div class="upload-wrapper fluid-wrapper">
                <div class="row">
                    <div class="col-6">
                        <div class="upload-item">
                            <h5><span class="required">*</span>執行情形報告</h5>
                            <div class="ft-action">
                                <div class="file-pill ms-0">
                                    <!-- 選擇檔案即上傳，省略點擊按鈕動作 -->
                                    <!-- 點擊 <a> 可預覽 -->
                                    <!-- 避免檔名過長有限制最大寬度 240px，超出時會字元會省略，切記標籤加上 title -->
                                    <a href="#" target="_blank" class="filename" title="避免檔名過長有限制最大寬度.jpg">避免檔名過長有限制最大寬度避免檔名過長有限制最大寬度.jpg</a>
                                    <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section">
            <h4 class="mb-4">海外華語教學中心</h4>
            <div class="upload-wrapper fluid-wrapper">
                <div class="row">
                    <div class="col-6">
                        <div class="upload-item">
                            <h5><span class="required">*</span>執行情形報告</h5>
                            <!-- input 選擇檔案後自動上傳 -->
                            <!-- 檔案上傳後隱藏 input，刪除檔案則恢復 input -->
                            <div class="form-group">
                                  <input class="form-control" type="file" id="photoFile">
                            </div>
                            <div class="ft-action">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
	</div>
</div>

<% content_for :js do %>

<% end %>
