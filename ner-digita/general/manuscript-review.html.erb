<!-- Cropper -->
<script src="../javascripts/cropper.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    // DOM 元素
    const imageInput = document.getElementById('image-input');
    const imagePreviewBox = document.getElementById('image-preview-box');
    const imagePreview = document.getElementById('image-preview');
    const deleteBtn = document.getElementById('delete-btn');
    const cropModalElement = document.getElementById('cropModal');
    const imageToCrop = document.getElementById('image-to-crop');
    const cropAndUploadBtn = document.getElementById('crop-and-upload-btn');

    // 初始化 Bootstrap Modal
    const cropModal = new bootstrap.Modal(cropModalElement);
    
    let cropper; // Cropper 實例
    let originalFileName = ''; // 保存原始檔名

    // 監聽文件選擇
    imageInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) {
            return;
        }
        
        // 記錄當前滾動位置
        const scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
        
        originalFileName = file.name; // 保存原始檔名

        // 設定當前處理的元素（原始的第一個項目）
        currentImagePreview = imagePreview;
        currentImagePreviewBox = imagePreviewBox;
        currentDeleteBtn = deleteBtn;
        currentImageInput = imageInput;

        // 使用 FileReader 讀取圖片
        const reader = new FileReader();
        reader.onload = (event) => {
            imageToCrop.src = event.target.result;
            
            // 顯示 Modal 前保存滾動位置
            cropModal.show();
            
            // 確保 modal 顯示後滾動位置不變
            setTimeout(() => {
                window.scrollTo(0, scrollPosition);
            }, 50);
        };
        reader.readAsDataURL(file);
    });
    
    // Modal 顯示時，初始化 Cropper
    cropModalElement.addEventListener('shown.bs.modal', () => {
        if (cropper) {
            cropper.destroy(); // 如果已有實例，先銷毀
        }
        cropper = new Cropper(imageToCrop, {
            aspectRatio: 3 / 2, // 設定裁切框的長寬比
            viewMode: 1,      // 限制裁切框不能超出圖片範圍
            background: false,
            autoCropArea: 0.8,
        });
    });

    // Modal 隱藏時，銷毀 Cropper 並清空 input
    cropModalElement.addEventListener('hidden.bs.modal', () => {
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
        // 清空 file input，這樣才能重新選擇同一張圖片
        imageInput.value = '';
        
        // 防止 modal 關閉後頁面跳到頂部
        setTimeout(() => {
            document.body.style.paddingRight = '';
            document.body.classList.remove('modal-open');
        }, 100);
    });

    // 點擊 "裁切並上傳" 按鈕
    cropAndUploadBtn.addEventListener('click', (e) => {
        e.preventDefault(); // 阻止預設行為
        e.stopPropagation(); // 阻止事件冒泡
        
        if (!cropper) {
            return;
        }
        
        // 記錄當前滾動位置
        const scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
        
        // 獲取裁切後的 Canvas
        const canvas = cropper.getCroppedCanvas({
            width: 1000, // 您可以指定輸出圖片的寬度
            // height 會根據 aspectRatio 自動計算
            fillColor: '#fff',
            imageSmoothingEnabled: true,
            imageSmoothingQuality: 'high',
        });

        // 將 Canvas 轉換為 Blob 物件 (類似於檔案)
        canvas.toBlob((blob) => {
            // 產生一個暫時的 URL 以供預覽
            const croppedImageUrl = URL.createObjectURL(blob);
            currentImagePreview.src = croppedImageUrl;
            
            // 更新 UI
            currentImagePreviewBox.classList.add('has-image');
            currentDeleteBtn.style.display = 'inline-block';
            
            // *** 模擬上傳到後端 ***
            // 這是您需要與後端 API 對接的地方
            const formData = new FormData();
            
            // 將 blob 附加到 formData，第三個參數是檔名
            formData.append('uploaded_image', blob, `cropped-${originalFileName}`);
            
            console.log('準備上傳的 FormData:', formData);
            // 您可以在這裡使用 fetch 或 axios 將 formData 送出
            // fetch('/your-upload-api-endpoint', {
            //     method: 'POST',
            //     body: formData,
            // })
            // .then(response => response.json())
            // .then(data => console.log('上傳成功:', data))
            // .catch(error => console.error('上傳失敗:', error));
            
            // ------------------------
            
            // 每次裁切上傳後都自動生成新的空白項目
            ensureEmptyUploadItem();

        }, 'image/jpeg', 0.9); // 指定輸出格式和品質

        cropModal.hide(); // 關閉 Modal
        
        // 在 modal 關閉後恢復滾動位置
        setTimeout(() => {
            window.scrollTo(0, scrollPosition);
        }, 100);
    });
    
    // 點擊 "刪除圖片" 按鈕
    deleteBtn.addEventListener('click', (e) => {
        e.preventDefault(); // 阻止預設行為
        e.stopPropagation(); // 阻止事件冒泡
        
        // 記錄當前滾動位置
        const scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
        
        // 檢查是否有其他項目
        const photoUploadRow = document.querySelector('.photo-upload-row');
        const uploadItems = photoUploadRow.querySelectorAll('.upload-item');
        
        if (uploadItems.length > 1) {
            // 如果有多個項目，移除第一個項目
            const firstUploadItem = imagePreview.closest('.upload-item');
            if (firstUploadItem) {
                firstUploadItem.remove();
            }
        } else {
            // 如果只有一個項目，清空內容但保留結構
            imagePreview.src = '';
            imagePreviewBox.classList.remove('has-image');
            imageInput.value = '';
            deleteBtn.style.display = 'none';
        }
        
        // 確保始終有一個空的上傳項目
        ensureEmptyUploadItem();
        
        console.log('圖片已刪除');
        
        // 確保滾動位置保持不變
        setTimeout(() => {
            window.scrollTo(0, scrollPosition);
        }, 50);
    });

    // 確保始終有一個空的上傳項目的函數
    function ensureEmptyUploadItem() {
        const photoUploadRow = document.querySelector('.photo-upload-row');
        if (!photoUploadRow) return;
        
        // 檢查是否已有空的上傳項目
        const uploadItems = photoUploadRow.querySelectorAll('.upload-item');
        let hasEmptyItem = false;
        
        uploadItems.forEach(item => {
            const imagePreviewBox = item.querySelector('.image-preview-box');
            if (imagePreviewBox && !imagePreviewBox.classList.contains('has-image')) {
                hasEmptyItem = true;
            }
        });
        
        // 如果沒有空的項目，新增一個
        if (!hasEmptyItem) {
            addNewUploadItem();
        }
    }

    // 新增上傳項目的函數
    function addNewUploadItem() {
        const photoUploadRow = document.querySelector('.photo-upload-row');
        if (!photoUploadRow) return;
        
        // 產生唯一的 ID
        const timestamp = Date.now();
        const newItemId = `upload-item-${timestamp}`;
        
        // 建立新的上傳項目 HTML
        const newUploadItem = document.createElement('div');
        newUploadItem.className = 'col-md-6 upload-item';
        newUploadItem.innerHTML = `
            <div class="form-group">
                <div class="upload-cropper-wrapper">
                    <div class="image-preview-box" id="image-preview-box-${timestamp}">
                        <span class="placeholder">圖片預覽區 (3:2)</span>
                        <img id="image-preview-${timestamp}" src="" alt="圖片說明">
                        <button id="delete-btn-${timestamp}" class="btn btn-danger btn-delete" title="刪除圖片"></button>
                        <div class="cover-check" title="設為封面">
                            <input class="form-check-input" type="radio" name="radioCover" id="radioCover${timestamp}">
                        </div>
                    </div>
                    <div class="button-group">
                        <label for="image-input-${timestamp}" class="btn btn-select-image" title="選擇圖片"><span>選擇圖片</span></label>
                        <input type="file" id="image-input-${timestamp}" accept="image/*" class="d-none">
                        <a href="../assets/fake/cut-01.jpg" target="_blank" title="下載" class="btn btn-download"></a>
                        <input type="text" class="form-control" id="imageDesc-${timestamp}" placeholder="請輸入圖片說明">
                    </div>
                </div>
            </div>
        `;
        
        // 將新項目添加到 photo-upload-row
        photoUploadRow.appendChild(newUploadItem);
        
        // 為新項目綁定事件
        bindUploadItemEvents(timestamp);
    }

    // 為新的上傳項目綁定事件的函數
    function bindUploadItemEvents(timestamp) {
        const newImageInput = document.getElementById(`image-input-${timestamp}`);
        const newImagePreviewBox = document.getElementById(`image-preview-box-${timestamp}`);
        const newImagePreview = document.getElementById(`image-preview-${timestamp}`);
        const newDeleteBtn = document.getElementById(`delete-btn-${timestamp}`);
        
        // 監聽新項目的文件選擇
        newImageInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            
            // 記錄當前滾動位置
            const scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
            originalFileName = file.name;

            const reader = new FileReader();
            reader.onload = (event) => {
                imageToCrop.src = event.target.result;
                
                // 設定當前處理的元素
                currentImagePreview = newImagePreview;
                currentImagePreviewBox = newImagePreviewBox;
                currentDeleteBtn = newDeleteBtn;
                currentImageInput = newImageInput;
                
                cropModal.show();
                
                setTimeout(() => {
                    window.scrollTo(0, scrollPosition);
                }, 50);
            };
            reader.readAsDataURL(file);
        });
        
        // 監聽新項目的刪除按鈕
        newDeleteBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            const scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
            
            // 移除整個 upload-item
            const uploadItem = newDeleteBtn.closest('.upload-item');
            if (uploadItem) {
                uploadItem.remove();
            }
            
            // 確保始終有一個空的上傳項目
            ensureEmptyUploadItem();
            
            setTimeout(() => {
                window.scrollTo(0, scrollPosition);
            }, 50);
        });
    }

    // 用於追蹤當前操作的元素
    let currentImagePreview = imagePreview;
    let currentImagePreviewBox = imagePreviewBox;
    let currentDeleteBtn = deleteBtn;
    let currentImageInput = imageInput;
});
</script>

