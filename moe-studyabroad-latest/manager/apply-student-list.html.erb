    function toggleAboriginalFields() {
        if (!aboriginalWrapper) return;
        aboriginalWrapper.style.display = aboriginalYes && aboriginalYes.checked ? 'block' : 'none';
    }

    if (aboriginalNo && aboriginalYes) {
