<!-- template: 執行 - 申請紀錄 -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="wrapper-inner">
            
            <%= render :partial => "/partials/execution_sidenav" %>

            <main class="main">
                <div class="content-title">
                    <h3>申請紀錄</h3>
                </div>
                <div class="application-record-container">
                    <ul class="record-list menu-item">

                        <!-- 列表 item 要給對應四種狀態的 classname -->
                        <li class="record-item item-under-review">
                            <h5>企劃諮詢輔導申請</h5>
                            <div class="record-date" title="申請日期">2026/06/01 11:00</div>
                            <div class="record-status" title="審查結果">審查中</div>
                            <a href="counseling-application.html" class="item-link">瀏覽</a>
                        </li>
                        <li class="record-item item-submit-additional">
                            <h5>申請保留學籍</h5>
                            <div class="record-date" title="申請日期">2026/06/01 11:00</div>
                            <div class="record-status" title="審查結果">補件</div>
                            <a href="leave-of-absence.html" class="item-link">瀏覽</a>
                        </li>
                        <li class="record-item item-not-approved">
                            <h5>申請重新檢核</h5>
                            <div class="record-date" title="申請日期">2026/06/01 11:00</div>
                            <div class="record-status" title="審查結果">不通過</div>
                            <a href="biweekly-recheck.html" class="item-link">瀏覽</a>
                        </li>
                        <li class="record-item item-approved">
                            <h5>退出計畫申請</h5>
                            <div class="record-date" title="申請日期">2026/06/01 11:00</div>
                            <div class="record-status" title="審查結果">通過</div>
                            <a href="withdrawal-application.html" class="item-link">瀏覽</a>
                        </li>
                        <li class="record-item item-approved">
                            <h5>實踐獎金申請</h5>
                            <div class="record-date" title="申請日期">2026/06/01 11:00</div>
                            <div class="record-status" title="審查結果">通過</div>
                            <a href="practical-bonus-application.html" class="item-link">瀏覽</a>
                        </li>
                        <li class="record-item item-approved">
                            <h5>職場歷練獎金申請</h5>
                            <div class="record-date" title="申請日期">2026/06/01 11:00</div>
                            <div class="record-status" title="審查結果">通過</div>
                            <a href="work-experience-bonus-application.html" class="item-link">瀏覽</a>
                        </li>
                        <li class="record-item item-approved">
                            <h5>專業認證獎金申請</h5>
                            <div class="record-date" title="申請日期">2026/06/01 11:00</div>
                            <div class="record-status" title="審查結果">通過</div>
                            <a href="professional-certification-bonus-application.html" class="item-link">瀏覽</a>
                        </li>
                    </ul>
                </div>
                <div class="form-action">
                    <span class="backhome"><a href="home.html" class="btn btn-lg btn-back" title="回首頁"><i class="fas fa-long-arrow-alt-left"></i></a></span>
                </div>
            </main>
        </div>
    </div>
</div>



