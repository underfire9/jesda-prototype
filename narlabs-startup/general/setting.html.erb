<!-- template: 基本資料設定 -->

<div class="container-lg">
    <div class="setting-wrapper matchmaking-container">
        <div class="page-title">
            <h2>基本資料設定</h2>
        </div>
        <div class="container-content">
            <div class="setting-section">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="fw-light">username@email.com</h5>
                    </div>
                </div>
            </div>

            <div class="setting-section">
                <div class="form-hd">
                    <div>
                        <div class="form-check form-switch switch-lg">
                            <input class="form-check-input" type="checkbox" role="switch" id="businessOwnerYes" checked>
                            <label class="form-check-label" for="businessOwnerYes">企業主身份啟用</label>
                        </div>
                    </div>
                </div>

                <div class="business-owner-form">
                    <div class="row">

                        <!-- 排版沒錯只有一個 col -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="exampleFormControlInput1" class="form-label">姓名</label>
                                <input type="text" class="form-control" id="exampleFormControlInput1">
                            </div>
                            <div class="form-group">
                                <label class="form-label">是否成立公司</label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="establishOptions" id="establishYes" value="option1" checked>
                                        <label class="form-check-label" for="establishYes">是</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="establishOptions" id="establishNo" value="option2" />
                                        <label class="form-check-label" for="establishNo">否</label>
                                    </div>
                                </div>
                                <div class="form-text mt-2">成立公司才可以提出技術媒合需求</div>
                            </div>
                        </div>
                    </div>

                    <div class="company-data-wrapper">
                        <div class="mb-3">
                            <button type="button" class="btn btn-rounded btn-outline-primary"><i class="fas fa-plus"></i> 新增公司資料</button>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle text-nowrap">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>公司名稱</th>
                                        <th>統編</th>
                                        <th>聯絡窗口姓名</th>
                                        <th>聯絡窗口 Email</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>隆順綠能科技股份有限公司</td>
                                        <td>0123456789</td>
                                        <td>王小明</td>
                                        <td>username@company.com</td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-round btn-outline-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">編輯</button>
                                            <button type="button" class="btn btn-sm btn-round btn-outline-danger">刪除</button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>Meet Tomorrow 股份有限公司</td>
                                        <td>0123456789</td>
                                        <td>蒲草田</td>
                                        <td>username@company.com</td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-round btn-outline-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">編輯</button>
                                            <button type="button" class="btn btn-sm btn-round btn-outline-danger">刪除</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="setting-section">
                <div class="form-hd">
                    <div>
                        <div class="form-check form-switch switch-lg">
                            <input class="form-check-input" type="checkbox" role="switch" id="expertsScholarsYes" checked>
                            <label class="form-check-label" for="expertsScholarsYes">專家學者身份啟用</label>
                        </div>
                    </div>
                </div>
                <div class="experts-scholars-form">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="exampleFormControlInput2" class="form-label">專家學者姓名</label>
                                <input type="text" class="form-control" id="exampleFormControlInput2">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="exampleFormControlInput3" class="form-label">職稱</label>
                                <input type="text" class="form-control" id="exampleFormControlInput3">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="exampleFormControlInput4" class="form-label">任職公司/學校</label>
                                <input type="text" class="form-control" id="exampleFormControlInput4">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="exampleFormControlInput5" class="form-label">任職部門/系所</label>
                                <input type="text" class="form-control" id="exampleFormControlInput5">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="exampleFormControlInput6" class="form-label">聯絡電話</label>
                                <input type="text" class="form-control" id="exampleFormControlInput6">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="setting-section">
                <div class="form-hd"><h5>變更密碼</h5></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="exampleFormControlInput10" class="form-label">密碼</label>
                            <input type="password" class="form-control" id="exampleFormControlInput10">
                            <div class="form-text">需要異動才填寫</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="exampleFormControlInput11" class="form-label">再次輸入密碼</label>
                            <input type="password" class="form-control" id="exampleFormControlInput11">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-action">
            <button type="button" class="btn btn-xl btn-main">確定</button>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">企業資料登錄</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="exampleFormControlInput20" class="form-label">公司名稱</label>
                            <input type="text" class="form-control" id="exampleFormControlInput20">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="exampleFormControlInput21" class="form-label">公司統編</label>
                            <input type="text" class="form-control" id="exampleFormControlInput21">
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label for="exampleFormControlInput22" class="form-label">公司簡介</label>
                            <textarea class="form-control" id="exampleFormControlInput22" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="formFile" class="form-label">Logo</label>
                            <input class="form-control" type="file" id="formFile">
                            <div class="form-text">圖檔格式限制 jpg, png</div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="exampleFormControlInput23" class="form-label">聯絡窗口姓名</label>
                            <input type="text" class="form-control" id="exampleFormControlInput23">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="exampleFormControlInput24" class="form-label">聯絡窗口職稱</label>
                            <input type="text" class="form-control" id="exampleFormControlInput24">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="exampleFormControlInput25" class="form-label">聯絡窗口電話</label>
                            <input type="text" class="form-control" id="exampleFormControlInput25">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="exampleFormControlInput26" class="form-label">聯絡窗口 Email</label>
                            <input type="text" class="form-control" id="exampleFormControlInput26">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="button" class="btn btn-primary">確定</button>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Toggle .business-owner-form visibility
        const businessOwnerSwitch = document.getElementById("businessOwnerYes");
        const businessOwnerForm = document.querySelector(".business-owner-form");
        businessOwnerSwitch.addEventListener("change", function () {
            businessOwnerForm.style.display = this.checked ? "block" : "none";
        });
        businessOwnerForm.style.display = businessOwnerSwitch.checked ? "block" : "none";

        // Toggle .experts-scholars-form visibility
        const expertsScholarsSwitch = document.getElementById("expertsScholarsYes");
        const expertsScholarsForm = document.querySelector(".experts-scholars-form");
        expertsScholarsSwitch.addEventListener("change", function () {
            expertsScholarsForm.style.display = this.checked ? "block" : "none";
        });
        expertsScholarsForm.style.display = expertsScholarsSwitch.checked ? "block" : "none";

        // Toggle .company-data-wrapper visibility
        const establishOptions = document.getElementsByName("establishOptions");
        const companyDataWrapper = document.querySelector(".company-data-wrapper");
        establishOptions.forEach(option => {
            option.addEventListener("change", function () {
                companyDataWrapper.style.display = document.getElementById("establishYes").checked ? "block" : "none";
            });
        });
        companyDataWrapper.style.display = document.getElementById("establishYes").checked ? "block" : "none";
    });
</script>
<% end %>

