<!-- 新增共同授課教師 Modal -->
<div class="modal fade" id="coworkerModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="coworkerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="coworkerModalLabel">新增共同授課教師</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="fg-padding-sm">
                    <div class="form-group">
                        <label for="coworkerEmail" class="form-label">授課教授電子信箱</label>
                        <input type="email" class="form-control" id="coworkerEmail">

                        <!-- 按鈕出現時機給工程師處理了 -->
                        <div class="mt-1">
                            <button type="button" class="btn btn-sm btn-dark fs-6">檢查信箱</button>
                            <button type="button" class="btn btn-sm btn-dark fs-6">信箱通知註冊</button>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="coworkerSchool" class="form-label">學校名稱</label>
                        <select class="form-select" id="single-select-field" data-placeholder="Choose one thing">
                            <option></option>
                            <option>Reactive</option>
                            <option>Solution</option>
                            <option>Conglomeration</option>
                            <option>Algoritm</option>
                            <option>Holistic</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="coworkerChineseName" class="form-label">授課教授中文姓名</label>
                        <input type="text" class="form-control" id="coworkerChineseName">
                    </div>
                    <div class="form-group">
                        <label for="coworkerDepartment" class="form-label">單位/系所</label>
                        <input type="text" class="form-control" id="coworkerDepartment">
                    </div>
                    <div class="form-group">
                        <label for="coworkerPhoneOffice" class="form-label">授課教授電話(公)</label>
                        <input type="text" class="form-control" id="coworkerPhoneOffice">
                    </div>
                    <div class="form-group">
                        <label for="coworkerPhoneHome" class="form-label">授課教授電話(宅/手機)</label>
                        <input type="text" class="form-control" id="coworkerPhoneHome">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-lg btn-light" data-bs-dismiss="modal">取消</button>
                <button type="submit" class="btn btn-lg btn-primary">儲存</button>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>

    <script src="../javascripts/select2.min.js"></script>
    <script>
        $( '#single-select-field' ).select2( {
            theme: "bootstrap-5",
            width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
            placeholder: $( this ).data( 'placeholder' ),
        } );
    </script>

<% end %>

