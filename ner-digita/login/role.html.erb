<!-- template: 選擇登入身分 -->
<!-- 登入時判斷該帳號有多角色時導進此頁面 -->

<div class="login-wrapper">
    <h1 class="h1-brands">
        <span class="brands-logo">國立教育廣播電臺</span>
        <span class="brands-system">新聞採編播數位化平台</span>
    </h1>
    <div class="login-card">
		<div class="card-hd">
			<h3>選擇登入身分</h3>
		</div>
        <form class="login-form" action="../general/index.html" method="post">
            <div class="card-bd">
                <div class="form-group">
                    <div class="form-check form-check-inline">
                        <!-- 預設勾選主管 -->
                        <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault1" checked />
                        <label class="form-check-label" for="radioDefault1">
                            主管
                        </label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault2" />
                        <label class="form-check-label" for="radioDefault2">
                            記者
                        </label>
                    </div>
                </div>
            </div>
            <div class="login-action d-grid">
                <button class="btn btn-lg btn-main" type="submit">送出</button>
            </div>
        </form>
    </div>
</div>



<% content_for :js do %>

<% end %>

