<!-- template: 常見問題 -->

<div class="container-lg">
    <div class="faq-wrapper">
        <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
        <div class="wrapper-inner">
            <aside class="filterbar">
                <div class="search-input">
                    <input type="text" name="search" class="form-control" placeholder="關鍵字檢索" aria-label="關鍵字檢索">
                </div>
                <div class="form-group">
                    <select id="category" class="form-select" aria-label="分類選擇">
                        <option value="">選擇分類</option>
                        <option value="1">申請</option>
                        <option value="2">核定</option>
                        <option value="3">出國</option>
                        <option value="4">變更</option>
                        <option value="5">結案</option>
                    </select>
                </div>
                <div class="filter-options">
                    <button type="button" class="btn btn-secondary">  
                        <i class="fas fa-search"></i>
                        <span>查詢</span>
                    </button>
                    <button type="button" class="btn btn-light">  
                        <span>清除</span>
                    </button>
                </div>
            </aside>
            <main class="faq-main">
                <div class="accordion" id="accordionFAQ">
                    <% (1..20).map do |i| %>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapse<%= i %>" aria-expanded="false" aria-controls="panelsStayOpen-collapse<%= i %>">
                                <span class="hd">
                                    <span class="badge">申請</span>
                                    <span class="date"><%= Time.now.strftime("%Y-%m-%d") %></span>
                                </span>
                                <span class="title"><%= zh_lorem_sentences(2) %></span>
                            </button>
                        </h2>
                        <div id="panelsStayOpen-collapse<%= i %>" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <%= zh_lorem_paragraphs(3) %>
                            </div>
                        </div>
                    </div>
                    <% end %>
                </div>
                <nav aria-label="頁面導航">
                    <ul class="pagination justify-content-end">
                        <li class="page-item disabled"><a href="#" class="page-link" title="上一頁"><i class="fas fa-angle-left"></i></a></li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#" aria-current="page">2</a>
                        </li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><a class="page-link" href="#" title="下一頁"><i class="fas fa-angle-right"></i></a></li>
                    </ul>
                </nav>
            </main>
        </div>
    </div>
</div>



<% content_for :js do %>
    <!-- GSAP -->
    <script src="../javascripts/gsap.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (window.gsap) {
                gsap.from(".accordion-item", {
                    opacity: 0,
                    y: -10,
                    duration: 0.4,
                    stagger: 0.1,
                    ease: "power1.out"
                });
            }
        });
    </script>
<% end %>

