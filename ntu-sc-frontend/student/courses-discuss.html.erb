                    <div class="btn-group mt-2">
                        <button class="btn btn-xs btn-outline-dark px-3">刪除</button>
                        <button class="btn btn-xs btn-dark px-3" data-bs-toggle="modal" data-bs-target="#discussModal">編輯</button>
