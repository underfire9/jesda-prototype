<div class="reply-container">
    <div class="container-lg">
        <section class="section">
            <div class="section-title">
                <h4>技術發明人基本資料</h4>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="exlInput1" class="form-label">姓名</label>
                        <input type="text" class="form-control" id="exlInput1" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="exlInput2" class="form-label">單位職稱</label>
                        <input type="text" class="form-control" id="exlInput2" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="exlInput3" class="form-label">聯絡電話</label>
                        <input type="text" class="form-control" id="exlInput3" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="exlInput4" class="form-label">E-mail</label>
                        <input type="email" class="form-control" id="exlInput4" />
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group">
                        <label for="exlInput5" class="form-label">研究專長領域</label>
                        <textarea class="form-control" id="exlInput5" rows="4"></textarea>
                    </div>
                </div>
            </div>
        </section>
        <section class="section">
            <div class="section-title">
                <h4>技術解題 問題痛點分析</h4>
            </div>
            <div class="row">
                <div class="col-lg-8">
                    <div class="form-group">
                        <label for="exlInput6" class="form-label">回應的企業問題</label>
                        <input type="text" class="form-control" id="exlInput6" />
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group">
                        <label for="exlInput7" class="form-label">問題分析</label>
                        <textarea class="form-control" id="exlInput7" rows="4"></textarea>
                    </div>
                </div>
            </div>
        </section>
        <section class="section">
            <div class="section-title">
                <h4>解決方案說明</h4>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="form-group">
                        <label for="exlInput8" class="form-label">技術解決方案</label>
                        <textarea class="form-control" id="exlInput8" rows="4"></textarea>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        <label for="exlInput9" class="form-label">目標或使用情境</label>
                        <input type="text" class="form-control" id="exlInput9" />
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        <label class="form-label">預計研發期程</label>
                        <div class="mt-2">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="option1" />
                                <label class="form-check-label" for="inlineRadio1">1-2 年</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="option2" />
                                <label class="form-check-label" for="inlineRadio2">3-5 年</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio3" value="option3" />
                                <label class="form-check-label" for="inlineRadio3">超過 5 年</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group">
                        <label for="exlInput10" class="form-label">解決方案創新性</label>
                        <textarea class="form-control" id="exlInput10" rows="4"></textarea>
                    </div>
                </div>
            </div>
        </section>
        <section class="section">
            <div class="section-title">
                <h4>技術相關專利與合作方式</h4>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        <label for="exlInput11" class="form-label">專利範圍</label>
                        <input type="text" class="form-control" id="exlInput11" />
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        <label for="exlInput12" class="form-label">專利狀態</label>
                        <input type="text" class="form-control" id="exlInput12" />
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        <label for="exlInput13" class="form-label">合作方式</label>
                        <input type="text" class="form-control" id="exlInput13" />
                    </div>
                </div>
            </div>
        </section>
        <section class="section">
            <div class="mb-5">
                <h3 class="section-heading"><span>補充資料</span></h3>
                <p class="text-danger">以下區塊欄位非必填，若無補充資料可跳過。</p>
            </div>
            <div class="section-title">
                <h4>技術發明人歷年研發成果</h4>
            </div>
            <div>
                <div class="form-group">
                    <label for="exlInput14" class="form-label">學術文獻</label>
                    <textarea class="form-control" id="exlInput14" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label for="exlInput15" class="form-label">研究成果及相關專利</label>
                    <textarea class="form-control" id="exlInput15" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label for="exlInput16" class="form-label">產學合作經驗</label>
                    <textarea class="form-control" id="exlInput16" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label for="exlInput17" class="form-label">獲獎事蹟</label>
                    <textarea class="form-control" id="exlInput17" rows="3"></textarea>
                </div>
            </div>
        </section>
        <section class="section">
            <div class="section-title">
                <h4>輔助證明資料</h4>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        <label for="formFile01" class="form-label">上傳文件</label>
                        <input class="form-control" type="file" id="formFile01">
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        <label for="formFile02" class="form-label">上傳圖片</label>
                        <input class="form-control" type="file" id="formFile02">
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group">
                        <label for="exlInput20" class="form-label">備註</label>
                        <textarea class="form-control" id="exlInput20" rows="4" placeholder="請依企業出題資料表中必要分析內容所載之項目，或有其他補充資料於此說明"></textarea>
                    </div>
                </div>
            </div>
        </section>
        <div class="form-action">
            <button type="submit" class="btn btn-lg btn-main px-5">送出</button>
        </div>
    </div>
</div>