<!-- template: 計畫合約連帶保證人 - 檢視 -->

<div class="container-lg">

    <div class="notice-wrapper">
        <p><%= zh_lorem_paragraph %></p>
        <p><%= zh_lorem_paragraph %></p>
    </div>

    <section class="section">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor1-name" class="form-label">姓名</label>
                    <input type="text" class="form-control" id="guarantor1-name" value="王小明" disabled readonly>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor1-email" class="form-label">電子信箱</label>
                    <input type="email" class="form-control" id="guarantor1-email" value="userid@email.com" disabled readonly>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor1-id" class="form-label">身份證字號</label>
                    <input type="text" class="form-control" id="guarantor1-id" value="A123456789" disabled readonly>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <hgroup class="mb-4">
            <h4>擔保類型</h4>
            <h6 class="fw-bold">類型1</h6>
        </hgroup>
        <div class="row">
            <div class="col-sm-6 col-lg-4 mb-5">
                <h5>合約連帶保證人附件檔案</h5>
                <div class="form-text mb-3">簽署上傳時間 : 2025-01-01 12:00:00 <%= zh_lorem_name %></div>
                <a href="#" class="btn btn-light btn-rounded"><%= lorem_words(4) %>.pdf</a>
            </div>
            <div class="col-sm-6 col-lg-4 mb-5">
                <h5>財力證明</h5>
                <div class="form-text mb-3">上傳時間 : 2025-01-01 12:00:00 <%= zh_lorem_name %></div>
                <a href="#" class="btn btn-light btn-rounded">財力證明檔案名稱.pdf</a>
            </div>
            <div class="col-sm-6 col-lg-4 mb-5">
                <h5>其他證明文件</h5>
                <div class="form-text mb-3">上傳時間 : 2025-01-01 12:00:00 <%= zh_lorem_name %></div>
                <a href="#" class="btn btn-light btn-rounded">其他證明文件檔案名稱.pdf</a>
            </div>
        </div>
    </section>

    <section class="section">
        <h4>目前狀態</h4>
        <h5 class="fw-bold">審查中</h5>
    </section>

    <div class="form-action">
        <span class="backhome">
            <a href="#" class="btn btn-lg btn-link"><i class="fas fa-long-arrow-alt-left"></i> 返回首頁</a>
        </span>
        <button type="submit" class="btn btn-lg btn-primary">更換保人</button>
    </div>

</div>



<% content_for :js do %>

<% end %>

