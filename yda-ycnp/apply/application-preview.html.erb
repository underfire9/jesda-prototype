<% content_for :js do %>
<!-- Sticky Step -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    var nav = document.querySelector('.process-step-inner');
    var navOffset = nav.getBoundingClientRect().top + window.pageYOffset;

    function onScroll() {
        if (window.pageYOffset > navOffset) {
            nav.style.position = 'fixed';
            nav.style.top = '0';
            nav.style.zIndex = '1000';
            nav.style.width = nav.offsetWidth + 'px';
        } else {
            nav.style.position = '';
            nav.style.top = '';
            nav.style.zIndex = '';
            nav.style.width = '';
        }
    }

    window.addEventListener('scroll', onScroll);
});
</script>
<% end %>