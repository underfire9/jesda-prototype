<!-- admin-page: Datatables -->
<% content_for :page_styles do %>
    <link href="../stylesheets/dt-page.css" rel="stylesheet">
    <link href="../stylesheets/datatables.min.css" rel="stylesheet">
<% end %>

<main class="main">
    <!-- 滿版拿掉 .medium-container -->
    <!-- 窄版使用 .narrow-container -->
    <div class="medium-container">
        <div class="page-header">
            <div class="header-start">
                <h2 class="page-title">聯絡人清單</h2>
                <div class="page-describe">此行放頁面功能簡短描述，注意必須簡短，避免右方有統計區塊時擠壓換行。</div>
            </div>
            <div class="header-end">
                <div class="header-statistics">
                    <div class="statistics-card text-end">
                        <span class="statistic-number">128</span>
                        <span class="statistic-label">全部聯絡人</span>
                    </div>
                    <div class="statistics-card text-end">
                        <span class="statistic-number">116</span>
                        <span class="statistic-label">在職聯絡人</span>
                    </div>
                    <div class="statistics-card text-end">
                        <span class="statistic-number">82</span>
                        <span class="statistic-label">帳號已啟用</span>
                    </div>
                    <div class="statistics-card text-end">
                        <span class="statistic-number">12</span>
                        <span class="statistic-label">離職／停用</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="datatables-wrapper">
            <div class="datatables-toolbar">
                <div class="toolbar-inner">
                    <div class="toolbar-inner-start">
                        <div class="btn-group">
                            <button class="btn btn-outline-secondary">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="全選"><i class="bi bi-app"></i></span>
                            </button>
                            <button class="btn btn-outline-secondary">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="刪除"><i class="bi bi-trash3"></i></span>
                            </button>
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#modalEmail">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="批次寄送"><i class="bi bi-envelope"></i></span>
                            </button>
                            <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#multiSortModal">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="多重排序"><i class="bi bi-sort-down"></i></span>
                            </button>
                            <button type="button" class="btn btn-secondary btn-field-setting" id="toggleFieldSettingPanel" aria-expanded="false" aria-controls="fieldSettingPanel">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="設定欄位"><i class="bi bi-table"></i></span>
                            </button>
                            <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#outboundModal">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="匯出 Excel"><i class="bi bi-file-earmark-excel"></i></span>
                            </button>
                        </div>
                        <div>
                            <button type="button" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="新增聯絡人">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                下拉 Dropdown
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Action</a></li>
                                <li><a class="dropdown-item" href="#">Another action</a></li>
                                <li><a class="dropdown-item" href="#">Something else here</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="#">分隔連結</a></li>
                            </ul>
                        </div>
                        <div>
                            <select class="form-select" aria-label="Default select example">
                                <option selected>Select</option>
                                <option value="1">One</option>
                                <option value="2">Two</option>
                                <option value="3">Three</option>
                            </select>
                        </div>
                    </div>
                    <div class="toolbar-inner-end">
                        <div class="toolbar-search"></div>
                        <div>
                            <button type="button" class="btn btn-secondary btn-adsearch" data-bs-toggle="collapse" data-bs-target="#adSearch" aria-expanded="false" aria-controls="adSearch">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="進階搜尋">
                                    進階 <i class="bi bi-search"></i>
                                </span>
                            </button>
                        </div>
                        <div>
                            <button type="button" class="btn btn-secondary btn-adsearch btn-filter" data-bs-toggle="collapse" data-bs-target="#filterBarPanel" aria-expanded="false" aria-controls="filterBarPanel">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="篩選">
                                    <i class="bi bi-funnel"></i>
                                </span>
                            </button>
                        </div>
                        <div>
                            <button class="btn btn-transparent btn-icon" data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="重新整理">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                        <div>
                            <div class="form-check form-switch mb-0" data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="切換表格尺寸">
                                <input class="form-check-input" type="checkbox" role="switch" id="switchTableSize">
                                <label class="form-check-label" for="switchTableSize"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="field-setting-panel" id="fieldSettingPanel" aria-hidden="true">
                    <div class="panel-head">
                        <h6 class="panel-title">列表顯示欄位</h6>
                        <div class="setting-action">
                            <button type="button" class="btn btn-sm btn-white" id="fieldSelectAllBtn">
                                全選
                            </button>
                            <button type="button" class="btn btn-sm btn-white" id="fieldResetBtn">
                                還原預設
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="fieldApplyBtn">
                                套用
                            </button>
                        </div>
                    </div>
                    <div class="field-order-list" id="fieldOrderList">
                        <!-- 可拖曳排序、勾選的欄位列表 -->
                    </div>
                </div>
                <div class="collapse dttoolbar-collapse" id="filterBarPanel">
                    <div class="datatables-filter-bar">
                        <div class="bar-criteria">
                            <!-- clip 容器自動適應寬度 -->
                            <div class="bar-clip">
                                <select class="form-select" aria-label="Default select example">
                                    <option selected>選擇篩選條件</option>
                                    <option value="1">One</option>
                                    <option value="2">Two</option>
                                    <option value="3">Three</option>
                                </select>
                            </div>
                            <div class="bar-clip">
                                <select class="form-select" aria-label="Default select example">
                                    <option selected><%= lorem_sentence %></option>
                                    <option value="1">One</option>
                                    <option value="2">Two</option>
                                    <option value="3">Three</option>
                                </select>
                            </div>
                            <div class="bar-clip">
                                <select class="form-select" aria-label="Default select example">
                                    <option selected>選擇篩選條件</option>
                                    <option value="1">One</option>
                                    <option value="2">Two</option>
                                    <option value="3">Three</option>
                                </select>
                            </div>
                            <div class="bar-clip">
                                <select class="form-select" aria-label="Default select example">
                                    <option selected>選擇篩選條件</option>
                                    <option value="1">One</option>
                                    <option value="2"><%= lorem_sentence %></option>
                                    <option value="3"><%= lorem_sentence %></option>
                                </select>
                            </div>
                            <div class="bar-clip">
                                <select class="form-select" aria-label="Default select example">
                                    <option selected>選擇篩選條件</option>
                                    <option value="1">One</option>
                                    <option value="2">Two</option>
                                    <option value="3">Three</option>
                                </select>
                            </div>
                        </div>
                        <div class="bar-action">
                            <button class="btn btn-transparent" data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="確定">
                                <i class="bi bi-check2"></i>
                            </button>
                            <button class="btn btn-transparent" data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="重置">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <%= render :partial => "/partials/advanced_search" %>
            </div>
            <div class="datatables-content">
                <% customers = ["教育部", "內政部", "衛生福利部", "臺北市政府", "國立臺灣大學", "國立政治大學", "國立清華大學", "國立陽明交通大學", "國立成功大學", "國立中興大學"] %>
                <% units = ["招生組", "註冊組", "教務處", "人事室", "資訊中心", "國際事務處", "學務處", "總務處", "秘書室", "研究發展處"] %>
                <% titles = ["專員", "組員", "副組長", "組長", "資深工程師", "行政助理", "計畫助理", "助理管理師"] %>
                <% statuses = ["升遷", "在職", "離職", "通緝"] %>
                <% account_states = ["已啟用", "已認證", "未啟用", "已刪除"] %>
                <table id="staffTable" class="table table-hover align-middle w-100">
                    <thead class="bg-info-subtle">
                        <tr>
                            <th width="44">
                                <input type="checkbox" class="form-check-input" id="selectAllRows" title="全選">
                            </th>
                            <th>姓名</th>
                            <th>客戶 / 所屬單位</th>
                            <th>職稱</th>
                            <th>email</th>
                            <th>電話 / 手機</th>
                            <th>Line ID</th>
                            <th>狀態</th>
                            <th>帳號</th>
                            <th width="96">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (1..128).map do |i| %>
                            <% name_zh  = zh_lorem_name %>
                            <% name_en  = lorem_name %>
                            <% customer = customers[(i - 1) % customers.length] %>
                            <% unit     = units[(i - 1) % units.length] %>
                            <% title    = titles[(i - 1) % titles.length] %>
                            <% status   = statuses[(i - 1) % statuses.length] %>
                            <% account  = account_states[(i - 1) % account_states.length] %>
                            <% status_class = {
                                "升遷" => "status-primary",
                                "在職" => "status-success",
                                "離職" => "status-warning",
                                "通緝" => "status-danger"
                            }[status] %>
                            <% account_class = {
                                "已啟用" => "pill-primary",
                                "已認證" => "pill-success",
                                "未啟用" => "pill-warning",
                                "已刪除" => "pill-danger"
                            }[account] %>
                            <tr>
                                <td><input type="checkbox" class="form-check-input row-check" title="勾選本列"></td>
                                <td data-order="<%= name_zh %>">
                                    <div class="fw-medium"><%= name_zh %></div>
                                    <div class="fs-8 text-secondary"><%= name_en %></div>
                                </td>
                                <td data-order="<%= customer %>">
                                    <div class="fw-medium"><%= customer %></div>
                                    <div class="fs-8 text-secondary"><%= unit %></div>
                                </td>
                                <td><%= title %></td>
                                <td>user<%= i %>@example.org.tw</td>
                                <td>
                                    <div class="fs-7 fw-medium">02-2<%= format('%07d', i) %></div>
                                    <div class="fs-7 text-secondary">09<%= format('%08d', 10000000 + i) %></div>
                                </td>
                                <td>line_<%= format('%04d', i) %></td>
                                <td data-order="<%= status %>">
                                    <div class="status-inline <%= status_class %>"><%= status %></div>
                                </td>
                                <td>
                                    <div class="pill-inline <%= account_class %>"><%= account %></div>
                                </td>
                                <td>
                                    <div class="action-group">
                                        <a href="page.html" class="btn btn-sm btn-transparent" title="編輯">
                                            <i class="bi bi-pen"></i>
                                        </a>
                                        <div class="dropdown">
                                            <button type="button" class="btn btn-sm btn-transparent dropdown-toggle no-after" data-bs-toggle="dropdown" aria-expanded="false" title="更多操作">
                                                <i class="bi bi-three-dots"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><button type="button" class="dropdown-item" title="檢視"><i class="bi bi-eye me-2"></i>檢視</button></li>
                                                <li><button type="button" class="dropdown-item" title="停用帳號"><i class="bi bi-person-x me-2"></i>停用帳號</button></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><button type="button" class="dropdown-item text-danger" title="刪除"><i class="bi bi-trash me-2"></i>刪除</button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
            <div class="datatables-footer">
                <div class="ft-start"></div>
                <div class="ft-end"></div>
            </div>
        </div>

        <!-- RWD Card -->
        <div class="datatables-wrapper datatables-card-wrapper">
            <div class="datatables-toolbar">
                <div class="toolbar-inner">
                    <div class="toolbar-inner-start">
                        <div class="btn-group">
                            <button class="btn btn-outline-secondary">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="全選"><i class="bi bi-app"></i></span>
                            </button>
                            <button class="btn btn-outline-secondary">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="刪除"><i class="bi bi-trash3"></i></span>
                            </button>
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-secondary">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="批次寄送"><i class="bi bi-envelope"></i></span>
                            </button>
                            <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#outboundModal">
                                <span data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="匯出 Excel"><i class="bi bi-file-earmark-excel"></i></span>
                            </button>
                        </div>
                        <div>
                            <button type="button" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="新增聯絡人">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="toolbar-search">
                            <input type="text" class="form-control" placeholder="關鍵字搜尋">
                        </div>
                    </div>
                    <div class="toolbar-inner-end">
                        <div>
                            <button class="btn btn-transparent btn-icon" data-bs-toggle="tooltip" data-bs-custom-class="custom-tooltip" data-bs-placement="top" data-bs-title="重新整理">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="datatables-card-list">
                <% (1..12).map do |i| %>
                    <% name_zh  = zh_lorem_name %>
                    <% name_en  = lorem_name %>
                    <% customer = customers[(i - 1) % customers.length] %>
                    <% unit     = units[(i - 1) % units.length] %>
                    <% title    = titles[(i - 1) % titles.length] %>
                    <% email    = "user#{i}@example.org.tw" %>
                    <% status   = statuses[(i - 1) % statuses.length] %>
                    <% account  = account_states[(i - 1) % account_states.length] %>
                    <% status_class = {
                        "升遷" => "status-primary",
                        "在職" => "status-success",
                        "離職" => "status-warning",
                        "通緝" => "status-danger"
                    }[status] %>
                    <% account_class = {
                        "已啟用" => "pill-primary",
                        "已認證" => "pill-success",
                        "未啟用" => "pill-warning",
                        "已刪除" => "pill-danger"
                    }[account] %>
                    <div class="datatables-card">
                        <div class="card-hd">
                            <div class="hd-start">
                                <div class="h5"><%= name_zh %></div>
                                <div class="fs-7 text-secondary">
                                    <span><%= title %></span> |
                                    <span><%= unit %></span>
                                </div>
                            </div>
                            <div class="hd-end">
                                <div class="status-inline <%= status_class %>"><%= status %></div>
                            </div>
                        </div>
                        <div class="card-bd">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="data-clip">
                                        <span class="item-label">客戶</span>
                                        <span class="item-value"><%= customer %></span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="data-clip">
                                        <span class="item-label">Email</span>
                                        <span class="item-value"><%= email %></span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="data-clip">
                                        <span class="item-label">Email</span>
                                        <span class="item-value"><%= email %></span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="data-clip">
                                        <span class="item-label">電話</span>
                                        <span class="item-value">02-2<%= format('%07d', i) %></span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="data-clip">
                                        <span class="item-label">手機</span>
                                        <span class="item-value">09<%= format('%08d', 10000000 + i) %></span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="data-clip">
                                        <span class="item-label">Line ID</span>
                                        <span class="item-value">line_<%= format('%04d', i) %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-ft">
                            <div class="ft-start">
                                <div class="pill-inline <%= account_class %>"><%= account %></div>
                            </div>
                            <div class="ft-end">
                               <a href="page.html" class="btn btn-sm btn-transparent" title="編輯">
                                    <i class="bi bi-pen"></i>
                                </a>
                                <div class="dropdown">
                                    <button type="button" class="btn btn-sm btn-transparent" title="更多操作" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><button type="button" class="dropdown-item" title="檢視"><i class="bi bi-eye me-2"></i>檢視</button></li>
                                        <li><button type="button" class="dropdown-item" title="停用帳號"><i class="bi bi-person-x me-2"></i>停用帳號</button></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><button type="button" class="dropdown-item text-danger" title="刪除"><i class="bi bi-trash me-2"></i>刪除</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                <% end %>
            </div>
            <div class="datatables-footer">

            <!-- 卡片時每頁規則改成 12, 24, 48 (每列 2 或 3 個才能整除) -->
            <div class="ft-start">
                <div class="dt-length">
                    <label for="dt-length-0"
                        ><span>每頁</span>
                        <select aria-controls="staffTable" class="form-select" id="dt-length-0">
                            <option value="12">12</option>
                            <option value="24">24</option>
                            <option value="48">48</option>
                        </select>
                        <span>筆</span></label
                    >
                </div>
                <div class="dt-info" aria-live="polite" id="staffTable_info" role="status">顯示 1 - 12，共 128 筆</div>
            </div>

            <div class="ft-end">
                <div class="dt-paging">
                    <nav aria-label="pagination">
                        <ul class="pagination">
                            <li class="dt-paging-button page-item disabled">
                                <button
                                    class="page-link previous"
                                    role="link"
                                    type="button"
                                    aria-controls="staffTable"
                                    aria-disabled="true"
                                    aria-label="Previous"
                                    data-dt-idx="previous"
                                    tabindex="-1"
                                >
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>
                            <li class="dt-paging-button page-item active">
                                <button
                                    class="page-link"
                                    role="link"
                                    type="button"
                                    aria-controls="staffTable"
                                    aria-current="page"
                                    data-dt-idx="0"
                                >
                                    1
                                </button>
                            </li>
                            <li class="dt-paging-button page-item">
                                <button class="page-link" role="link" type="button" aria-controls="staffTable" data-dt-idx="1">
                                    2
                                </button>
                            </li>
                            <li class="dt-paging-button page-item">
                                <button class="page-link" role="link" type="button" aria-controls="staffTable" data-dt-idx="2">
                                    3
                                </button>
                            </li>
                            <li class="dt-paging-button page-item">
                                <button class="page-link" role="link" type="button" aria-controls="staffTable" data-dt-idx="3">
                                    4
                                </button>
                            </li>
                            <li class="dt-paging-button page-item">
                                <button class="page-link" role="link" type="button" aria-controls="staffTable" data-dt-idx="4">
                                    5
                                </button>
                            </li>
                            <li class="dt-paging-button page-item">
                                <button
                                    class="page-link ellipsis"
                                    role="link"
                                    type="button"
                                    aria-controls="staffTable"
                                    data-dt-idx="ellipsis"
                                >
                                    …
                                </button>
                            </li>
                            <li class="dt-paging-button page-item">
                                <button class="page-link" role="link" type="button" aria-controls="staffTable" data-dt-idx="8">
                                    9
                                </button>
                            </li>
                            <li class="dt-paging-button page-item">
                                <button
