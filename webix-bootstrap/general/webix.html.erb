<!-- template: Webix -->

<div class="container-lg">
    <div class="page-content">
        <div class="py-5">
            <h2 class="mb-4">Webix DatePicker</h2>
            <div id="datepicker"></div>
        </div>
    </div>
</div>



<% content_for :js do %>
<script>
// 建立 Webix DatePicker
webix.ui({
    container: "datepicker",
    view: "datepicker",
    label: "選擇日期",
    value: new Date(),
    format: "%Y-%m-%d"
});
</script>
<% end %>


