<header class="header" id="pagetop">
    <div class="header-wrap">
        <div class="header-start header-part">
            <div class="brands-link">
                <img class="h1-logo" src="../assets/logo-moe.svg">
                <h1 class="h1-title">
                    <span>教育部學海計畫</span>
                    <span>闈場審查系統</span>
                </h1>
            </div>
        </div>
        <div class="header-center header-part">
            <%= content_for(:header_center) if content_for?(:header_center) %>
        </div>
        <div class="header-end header-part">
            <% if content_for?(:header_dropdown) %>
                <%= content_for(:header_dropdown) %>
            <% else %>
                <div class="dropdown">
                    <button type="button" class="btn btn-account dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <span>嘉藥學校財團法人嘉南藥理大學</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-info dropdown-info-sm">102500</span></li>
                        <li><a class="dropdown-item" href="../school/profile.html">帳號資訊維護</a></li>
                        <li><a class="dropdown-item" href="#">操作手冊</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#">登出</a></li>
                    </ul>
                </div>
            <% end %>
        </div>
    </div>
</header>
