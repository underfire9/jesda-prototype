<!-- Modal Hoisting -->
<script>
    (function () {
        function hoistModalsToBody() {
            var modals = document.querySelectorAll('.content-wrapper .modal');
            Array.prototype.forEach.call(modals, function (modalEl) {
                if (modalEl.parentNode !== document.body) {
                    document.body.appendChild(modalEl);
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', hoistModalsToBody);
        } else {
            hoistModalsToBody();
        }
    }());
</script>

<!-- DataTables -->
<script>
    (function () {
        if (window.__staffTableBooted) {
            return;
        }
        window.__staffTableBooted = true;

        function ensureDataTables(done) {
            var hasJqDt = !!(window.jQuery && jQuery.fn && jQuery.fn.DataTable);
            var hasDt2 = typeof DataTable !== 'undefined';
            if (hasJqDt || hasDt2) {
                done();
                return;
            }

            var script = document.createElement('script');
            script.src = 'https://cdn.datatables.net/v/bs5/dt-2.3.8/datatables.min.js';
            script.onload = function () {
                done();
            };
            script.onerror = function () {};
            document.head.appendChild(script);
        }

        function initStaffTable() {
            var tableEl = document.getElementById('staffTable');
            if (!tableEl) {
                return;
            }

            var options = {
                pageLength: 15,
                lengthMenu: [10, 15, 30, 50, 100],
                order: [[1, 'asc']],
                columnDefs: [
                    { targets: [0, 3, 4, 5, 6, 8, 9], orderable: false }
                ],
                language: {
                    search: '搜尋：',
                    lengthMenu: '<span>每頁</span> _MENU_ <span>筆</span>',
                    info: '顯示 _START_ - _END_，共 _TOTAL_ 筆',
                    infoEmpty: '顯示 0 - 0，共 0 筆',
                    paginate: {
                        previous: '上一頁',
                        next: '下一頁'
                    }
                },
                layout: {
                    topStart: 'search',
                    topEnd: null,
                    bottomStart: ['pageLength', 'info'],
                    bottomEnd: 'paging'
                }
            };

            var dt;
            if (window.jQuery && jQuery.fn && jQuery.fn.DataTable) {
                dt = jQuery('#staffTable').DataTable(options);
            } else if (typeof DataTable !== 'undefined') {
                dt = new DataTable('#staffTable', options);
            } else {
                return;
            }

            var wrapper = dt.table ? dt.table().container() : tableEl.closest('.dataTables_wrapper, .dt-container');
            var toolbar = document.querySelector('.datatables-toolbar');
            var ftStart = document.querySelector('.datatables-footer .ft-start');
            var ftEnd = document.querySelector('.datatables-footer .ft-end');

            function cleanupEmptyDtLayout(container) {
                if (!container) return;

                var shells = container.querySelectorAll('.dt-layout-start, .dt-layout-end');
                Array.prototype.forEach.call(shells, function (shell) {
                    if (!shell.children.length && !shell.textContent.trim()) {
                        shell.remove();
                    }
                });

                var rows = container.querySelectorAll('.dt-layout-row, .row.mt-2.justify-content-between');
                Array.prototype.forEach.call(rows, function (row) {
                    if (!row.children.length && !row.textContent.trim()) {
                        row.remove();
                    }
                });
            }

            if (wrapper && toolbar) {
                var search = wrapper.querySelector('.dt-search, .dataTables_filter');
                var toolbarSearch = toolbar.querySelector('.toolbar-search');
                if (search && toolbarSearch) {
                    toolbarSearch.appendChild(search);
                } else if (search) {
                    toolbar.appendChild(search);
                }

                var searchInput = search ? search.querySelector('input[type="search"], input') : null;
                if (searchInput) {
                    searchInput.setAttribute('placeholder', '關鍵字搜尋');
                }
            }
            if (wrapper && ftStart) {
                var length = wrapper.querySelector('.dt-length, .dataTables_length');
                var info = wrapper.querySelector('.dt-info, .dataTables_info');
                if (length) ftStart.appendChild(length);
                if (info) ftStart.appendChild(info);
            }
            if (wrapper && ftEnd) {
                var paging = wrapper.querySelector('.dt-paging, .dataTables_paginate');
                if (paging) {
                    ftEnd.appendChild(paging);
                }
            }

            function getPageInfo() {
                if (dt && typeof dt.page === 'function' && typeof dt.page.info === 'function') {
                    return dt.page.info();
                }
                return null;
            }

            function ensurePageInputNavigation() {
                if (!ftEnd) return;

                var exists = ftEnd.querySelector('.dt-page-nav');
                if (exists) return;

                var nav = document.createElement('div');
                nav.className = 'dt-page-nav';
                nav.innerHTML = '' +
                    '<input type="text" class="form-control dt-page-input" inputmode="numeric" placeholder="前往" aria-label="頁碼輸入">' +
                    '<span class="dt-page-unit">頁</span>';

                ftEnd.appendChild(nav);

                var pageInput = nav.querySelector('.dt-page-input');

                function syncPageInputNavigation() {
                    var info = getPageInfo();
                    var totalPages = info && info.pages ? info.pages : 1;
                    pageInput.dataset.maxPage = String(totalPages);
                }

                function jumpToPage() {
                    var info = getPageInfo();
                    if (!info || !info.pages) return;
                    var target = parseInt(pageInput.value, 10);
                    if (isNaN(target)) return;

                    target = Math.max(1, Math.min(info.pages, target));
                    pageInput.value = String(target);
                    dt.page(target - 1).draw('page');
                }

                pageInput.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        jumpToPage();
                    }
                });

                pageInput.addEventListener('blur', function () {
                    if (!pageInput.value.trim()) {
                        syncPageInputNavigation();
                    }
                });

                syncPageInputNavigation();
            }

            function applyPaginationSizeClass() {
                var pagerList = ftEnd ? ftEnd.querySelector('ul.pagination') : null;
                var sizeSwitch = document.getElementById('switchTableSize');
                if (!pagerList) return;
                pagerList.classList.toggle('pagination-sm', !!(sizeSwitch && sizeSwitch.checked));
            }

            function applyLengthSelectSizeClass() {
                var sizeSwitch = document.getElementById('switchTableSize');
                var lengthSelect = ftStart
                    ? ftStart.querySelector('select#dt-length-0, .dt-length select, .dataTables_length select')
                    : null;
                if (!lengthSelect) return;
                lengthSelect.classList.toggle('form-select-sm', !!(sizeSwitch && sizeSwitch.checked));
            }

            function applyPageInputSizeClass() {
                var sizeSwitch = document.getElementById('switchTableSize');
                var pageInput = ftEnd ? ftEnd.querySelector('.dt-page-input') : null;
                if (!pageInput) return;
                pageInput.classList.toggle('form-control-sm', !!(sizeSwitch && sizeSwitch.checked));
            }

            ensurePageInputNavigation();
            applyPaginationSizeClass();
            applyLengthSelectSizeClass();
            applyPageInputSizeClass();

            cleanupEmptyDtLayout(wrapper);

            var headerCheck = document.getElementById('selectAllRows');
            function visibleChecks() {
                return Array.prototype.slice.call(tableEl.querySelectorAll('tbody .row-check'));
            }
            function syncHeaderCheckbox() {
                if (!headerCheck) return;
                var checks = visibleChecks();
                var total = checks.length;
                var checked = checks.filter(function (el) { return el.checked; }).length;
                headerCheck.checked = total > 0 && checked === total;
                headerCheck.indeterminate = checked > 0 && checked < total;
            }

            if (headerCheck) {
                headerCheck.addEventListener('change', function () {
                    visibleChecks().forEach(function (el) { el.checked = headerCheck.checked; });
                });
            }

            tableEl.addEventListener('change', function (event) {
                if (event.target.classList.contains('row-check')) {
                    syncHeaderCheckbox();
                }
            });

            if (dt.on) {
                dt.on('draw', function () {
                    syncHeaderCheckbox();
                    ensurePageInputNavigation();
                    applyPaginationSizeClass();
                    applyLengthSelectSizeClass();
                    applyPageInputSizeClass();
                });
            } else if (window.jQuery) {
                jQuery('#staffTable').on('draw.dt', function () {
                    syncHeaderCheckbox();
                    ensurePageInputNavigation();
                    applyPaginationSizeClass();
                    applyLengthSelectSizeClass();
                    applyPageInputSizeClass();
                });
            }

            var tableSizeSwitch = document.getElementById('switchTableSize');
            function applyTableSizeClass() {
                if (!tableSizeSwitch) return;
                tableEl.classList.toggle('table-sm', !!tableSizeSwitch.checked);
                applyPaginationSizeClass();
                applyLengthSelectSizeClass();
                applyPageInputSizeClass();
            }
            if (tableSizeSwitch) {
                tableSizeSwitch.addEventListener('change', applyTableSizeClass);
                applyTableSizeClass();
            }

            syncHeaderCheckbox();
        }

        function boot() {
            ensureDataTables(initStaffTable);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
        } else {
            boot();
        }
    }());
</script>

<% content_for :js do %>
<!-- Bootstrap Tooltips -->
<script>
    (function () {
        var openModalCount = 0;

        function setToolbarTooltipsEnabled(enabled) {
            if (!window.bootstrap || !bootstrap.Tooltip) {
                return;
            }

            var toolbarTriggers = document.querySelectorAll('.datatables-toolbar [data-bs-toggle="tooltip"]');
            Array.prototype.forEach.call(toolbarTriggers, function (triggerEl) {
                var instance = bootstrap.Tooltip.getInstance(triggerEl);
                if (!instance) {
                    return;
                }

                if (enabled) {
                    instance.enable();
                    return;
                }

                instance.hide();
                instance.disable();
            });
        }

        function hideAllTooltips() {
            if (!window.bootstrap || !bootstrap.Tooltip) {
                return;
            }

            var activeTooltipTriggers = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            Array.prototype.forEach.call(activeTooltipTriggers, function (triggerEl) {
                var instance = bootstrap.Tooltip.getInstance(triggerEl);
                if (instance) {
                    instance.hide();
                }
            });
        }

        function initTooltips() {
            if (!window.bootstrap || !bootstrap.Tooltip) {
                return;
            }

            var tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            Array.prototype.forEach.call(tooltipTriggerList, function (triggerEl) {
                var tooltipContainer = triggerEl.closest('.modal') || document.body;
                bootstrap.Tooltip.getOrCreateInstance(triggerEl, {
                    container: tooltipContainer
                });
            });

            var modalList = document.querySelectorAll('.modal');
            Array.prototype.forEach.call(modalList, function (modalEl) {
                modalEl.addEventListener('show.bs.modal', function () {
                    openModalCount += 1;
                    hideAllTooltips();
                    setToolbarTooltipsEnabled(false);
                });

                modalEl.addEventListener('hidden.bs.modal', function () {
                    openModalCount = Math.max(0, openModalCount - 1);
                    hideAllTooltips();

                    if (openModalCount === 0) {
                        setToolbarTooltipsEnabled(true);
                    }
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTooltips);
        } else {
            initTooltips();
        }
    }());
</script>
<% end %>
