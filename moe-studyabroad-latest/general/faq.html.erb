<!-- template: 常見問題 -->

<div class="container-lg">
    <div class="faq-wrapper">
        <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
        <aside class="faqfilter">
            <div class="input-group search-wrap">
                <input type="text" name="search" class="form-control" placeholder="關鍵字檢索" aria-label="關鍵字檢索">
                <button type="submit" class="btn btn-outline-secondary">  
                    <i class="fas fa-search"></i>
                    <span>搜尋</span>
                </button>
            </div>
        </aside>
        <main class="faq-main">
            <div class="accordion" id="accordionFAQ">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="true" aria-controls="panelsStayOpen-collapseOne">
                            如何提出申請？
                        </button>
                    </h2>
                    <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show">
                        <div class="accordion-body">
                            <ol>
                                <li>申請期間：每年11月1日至次年2月28日止，逾期恕不受理。</li>
                                <li>申請方式：於申請期間內，加入計畫網站會員並登入，於網站填寫並提交申請資料。申請者可於截止日前隨時登入網站進行修改，最終版本以申請截止當日所提交之資料為準。</li>
                            </ol>
                            <p>基本資料：</p>
                            <ul>
                                <li>請登入計畫網站，填寫基本資訊，包括姓名、身份證字號、出生年月日、性別、聯絡方式（手機、電子郵件）、戶籍地址與通訊地址及就讀學校名稱。</li>
                                <li>身份證明文件：中華民國國民身份證正反面影本或戶籍謄本（申請日3個月內）掃描檔或照片檔。</li>
                                <li>學生證明文件：在學證明或學生證掃描檔或照片檔。</li>
                            </ul>
                            <div class="attached-ft">
                                <a href="#" class="attached-link" title="{filename}">filename.pdf</a>
                                <a href="#" class="attached-link" title="{filename}"><%= lorem_words(4) %>.pdf</a>
                                <a href="#" class="attached-link" title="{filename}"><%= lorem_words(4) %>.pdf</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseTwo" aria-expanded="false" aria-controls="panelsStayOpen-collapseTwo">
                            網站填寫並提交申請資料申請者可於截止日前隨時登入網站進行修改
                        </button>
                    </h2>
                    <div id="panelsStayOpen-collapseTwo" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <strong>This is the second item’s accordion body.</strong> It is hidden by default, until the collapse plugin adds the appropriate classes that we use to style each element. These classes control the overall appearance, as
                            well as the showing and hiding via CSS transitions. You can modify any of this with custom CSS or overriding our default variables. It’s also worth noting that just about any HTML can go within the
                            <code>.accordion-body</code>, though the transition does limit overflow.
                            <div class="attached-ft">
                                <a href="#" class="attached-link" title="{filename}">filename.pdf</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseThree" aria-expanded="false" aria-controls="panelsStayOpen-collapseThree">
                            <%= lorem_paragraph %>
                        </button>
                    </h2>
                    <div id="panelsStayOpen-collapseThree" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <strong>This is the third item’s accordion body.</strong> It is hidden by default, until the collapse plugin adds the appropriate classes that we use to style each element. These classes control the overall appearance, as
                            well as the showing and hiding via CSS transitions. You can modify any of this with custom CSS or overriding our default variables. It’s also worth noting that just about any HTML can go within the
                            <code>.accordion-body</code>, though the transition does limit overflow.
                        </div>
                    </div>
                </div>
                <% (1..9).map do |i| %>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseFour" aria-expanded="false" aria-controls="panelsStayOpen-collapseFour">
                            <%= lorem_sentence %>
                        </button>
                    </h2>
                    <div id="panelsStayOpen-collapseFour" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <%= lorem_paragraphs(3) %>
                        </div>
                    </div>
                </div>
                <% end %>
            </div>
        </main>
    </div>
</div>



<% content_for :js do %>

<% end %>

