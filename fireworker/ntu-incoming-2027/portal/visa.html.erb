<% content_for :title do %>Visa Documents<% end %>
<% content_for :title_key do %>visa.title<% end %>
<% content_for :page do %>visa<% end %>
<% content_for :app_status do %>approved<% end %>
<% content_for :portal_status do %>
<span class="chip chip--dot chip--ok" data-i18n="status.approved">Approved</span>
<p data-i18n="portal.resultIssued" data-i18n-vars='{"date":"2025-11-20"}'>Result issued 2025-11-20</p>
<% end %>

<div class="container">
  <header class="masthead">
    <p class="eyebrow" data-bi-en="2025 Graduate Visiting Research" data-bi-zh="2025 來校訪問研究生">2025 Graduate Visiting Research</p>
    <h1 class="masthead__title" data-i18n="visa.title">Visa Documents</h1>
    <p class="masthead__lead" data-i18n="visa.lead">Download these documents to apply for your visa or entry permit.</p>
  </header>

  <div class="page-grid">
    <aside class="page-grid__aside">
      <%= render :partial => "/partials/portal_nav" %>
    </aside>

    <div class="page-grid__main">
      <div class="notice notice--ok">
        <div class="notice__body">
          <p class="notice__title" data-i18n="visa.banner">Congratulations, your application has been approved</p>
          <p class="notice__text" data-i18n="visa.bannerSub">Your documents are ready. Bring printed copies to your visa appointment.</p>
        </div>
      </div>

      <section class="card" aria-labelledby="visa-docs-title">
        <div class="card__head">
          <h2 class="card__title" id="visa-docs-title" data-i18n="visa.section">Download documents</h2>
        </div>

        <div class="download-list">
          <div class="download-row">
            <span class="download-row__type" aria-hidden="true">PDF</span>
            <div class="download-row__body">
              <p class="download-row__title" id="visa-admission" data-i18n="visa.admissionLetter">Admission letter</p>
              <p class="download-row__meta">PDF · 320 KB · <span data-i18n="visa.issued" data-i18n-vars='{"date":"2025-11-20"}'>Issued 2025-11-20</span></p>
            </div>
            <a class="btn" href="#" download aria-describedby="visa-admission" data-i18n="common.download">Download</a>
          </div>
          <div class="download-row">
            <span class="download-row__type" aria-hidden="true">PDF</span>
            <div class="download-row__body">
              <p class="download-row__title" id="visa-invitation" data-i18n="visa.invitationLetter">Invitation letter</p>
              <p class="download-row__meta">PDF · 180 KB · <span data-i18n="visa.issued" data-i18n-vars='{"date":"2025-11-20"}'>Issued 2025-11-20</span></p>
            </div>
            <a class="btn" href="#" download aria-describedby="visa-invitation" data-i18n="common.download">Download</a>
          </div>
          <div class="download-row">
            <span class="download-row__type" aria-hidden="true">PDF</span>
            <div class="download-row__body">
              <p class="download-row__title" id="visa-official" data-i18n="visa.officialLetter">Official letter from NTU</p>
              <p class="download-row__meta">PDF · 240 KB · <span data-i18n="visa.issued" data-i18n-vars='{"date":"2025-11-20"}'>Issued 2025-11-20</span></p>
            </div>
            <a class="btn" href="#" download aria-describedby="visa-official" data-i18n="common.download">Download</a>
          </div>
          <div class="download-row">
            <span class="download-row__type" aria-hidden="true">PDF</span>
            <div class="download-row__body">
              <p class="download-row__title" id="visa-list" data-i18n="visa.programmeList">Programme list</p>
              <p class="download-row__meta">PDF · 96 KB · <span data-i18n="visa.programmeListMeta">For programme students only</span></p>
            </div>
            <a class="btn" href="#" download aria-describedby="visa-list" data-i18n="common.download">Download</a>
          </div>
          <!-- 入臺證：只有中國大陸籍申請人會看到；OIA 上傳後才出現下載鈕 -->
          <div class="download-row download-row--pending">
            <div class="download-row__body">
              <p class="download-row__title" data-i18n="visa.entryPermit">Entry permit</p>
              <p class="download-row__meta" data-i18n="visa.entryPermitMeta">Shown only to applicants of PRC nationality. It appears here once OIA has uploaded it.</p>
            </div>
            <span class="chip chip--dot chip--muted" data-i18n="status.notYetAvailable">Not yet available</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
