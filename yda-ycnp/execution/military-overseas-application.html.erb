<!-- template: 執行 - 役男出國申請 -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="wrapper-inner">

            <%= render :partial => "/partials/execution_sidenav" %>

            <main class="main">
                <div class="content-title">
                    <h3>役男出國申請</h3>
                </div>
                <div class="alert alert-danger mb-4" role="alert">
                    退件原因說明 <%= lorem_sentence %>
                </div>
                <div class="notice-wrapper important-notice mb-5">
                    <ul class="mb-0">
                        <li>役男出國未達4個月者無須申請</li>
                        <li>在本系統申請完後，出國前 (7天前至30天前) 需至內政部役政司役男短期出境線上申請作業系統申請 <a href="https://service.dca.moi.gov.tw/departure/app/Departure/main" target="_blank" class="d-inline-block">請點此連結 <i class="fas fa-external-link-alt"></i></a></li>
                    </ul>
                </div>
                <h4 class="mb-4 fw-semibold">役男出國 4 個月以上申請</h4>
                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group">
                            <label>出國期間</label>

                            <!-- 需要民國年還沒改 -->
                            <div class="total-group">
                                <div class="input-group">
                                    <input type="date" class="form-control" name="military-overseas_start_date">
                                    <span class="input-group-text">~</span>
                                    <input type="date" class="form-control" name="military-overseas_end_date">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="military-overseas_country">國家</label>
                            <select class="form-select" id="military-overseas_country" data-placeholder="請選擇國家">
                                <option></option>
                                <option>阿爾巴尼亞</option>
                                <option>阿爾及利亞</option>
                                <option>安哥拉</option>
                                <option>阿根廷</option>
                                <option>委內瑞拉玻利瓦爾共和國</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label for="military-overseas_note">備註說明</label>
                            <textarea class="form-control" id="military-overseas_note" name="military-overseas_note" rows="5"></textarea>
                        </div>
                    </div>
                </div>
                <div class="form-action">
                    <button type="submit" class="btn btn-lg btn-rounded btn-main px-5">送出申請</button>
                </div>
            </main>
        </div>
    </div>
</div>

<% content_for :js do %>
    <script src="../javascripts/select2.min.js"></script>
    <script>
        $( '#military-overseas_country' ).select2( {
            theme: "bootstrap-5",
            width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
            placeholder: $( this ).data( 'placeholder' ),
        } );
    </script>
<% end %>
