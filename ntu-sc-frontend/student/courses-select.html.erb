                            </div>
                            <div class="cs-filter-foot">
                                <button type="button" class="btn btn-link cs-clear"><i class="fas fa-undo-alt me-1"></i>清除條件</button>
                            </div>
                        </div>
                    </div>
                </section>

                <%# 結果列 %>
                <div class="cs-resultbar">
                    <div class="cs-count">共找到 <strong>34</strong> 門課程</div>
                    <div class="cs-resultbar-tools">
                    <button type="button" class="cs-expand-all" aria-pressed="false" data-expand-all>
                        <i class="fas fa-angle-double-down"></i><span data-expand-label>全部展開</span>
                    </button>
                    <div class="cs-sortby">
                        <label for="csSortBy">排序：</label>
                        <select class="form-select form-select-sm" id="csSortBy">
                            <option selected>開課時間（由近到遠）</option>
                            <option>開課時間（由遠到近）</option>
                            <option>課號</option>
                            <option>餘額（由多到少）</option>
                        </select>
                    </div>
                    </div>
                </div>

                <%# 課程表格：桌機為表格、手機轉為卡片 %>
                <table class="cs-table cs-course-table">
                    <thead>
                        <tr>
                            <th class="c-no">#</th>
                            <th class="c-name">課號／課程名稱</th>
                            <th class="c-teacher">教師</th>
                            <th class="c-place">上課地點</th>
                            <th class="c-range">上課起訖</th>
                            <th class="c-credit">認抵學分</th>
                            <th class="c-field">認抵領域</th>
                            <th class="c-quota">餘額／上限</th>
                            <th class="c-more"><span class="visually-hidden">more</span></th>
                            <th class="c-action">操作</th>
                        </tr>
                    </thead>
                    <% cs_courses.each_with_index do |c, i| %>
                    <% full = c[:left] == 0 %>
                    <tbody class="cs-course<%= ' is-added' if c[:added] %><%= ' is-full' if full %>"
                        data-id="<%= c[:id] %>" data-name="<%= c[:name] %>" data-teacher="<%= c[:teacher] %>"
                        data-type="<%= c[:type] %>" data-place="<%= c[:place] %>" data-range="<%= c[:range] %>">
                        <tr class="cs-row">
                            <td class="c-no"><%= i + 1 %></td>
                            <td class="c-name"><span class="cs-code"><%= c[:id] %></span><a href="#" class="cs-name" title="開啟課程資訊"><%= c[:name] %></a></td>
                            <td class="c-teacher" data-label="教師"><%= c[:teacher] %></td>
                            <td class="c-place" data-label="上課地點"><%= c[:place] %></td>
                            <td class="c-range" data-label="上課起訖"><% r = c[:range].split(' ~ ') %><span class="text-nowrap"><%= r[0] %></span><span class="cs-sep">~</span><span class="text-nowrap"><%= r[1] %></span></td>
                            <td class="c-credit" data-label="認抵學分"><%= c[:credit] %></td>
                            <td class="c-field" data-label="認抵領域"><span class="cs-field-tag"><%= c[:field] %></span></td>
                            <td class="c-quota" data-label="餘額／上限">
                                <span class="cs-quota<%= ' is-low' if !full && c[:left].to_f / c[:cap] <= 0.2 %><%= ' is-empty' if full %>"><b><%= c[:left] %></b>/<%= c[:cap] %></span>
                            </td>
                            <td class="c-more">
                                <button type="button" class="cs-more-btn" aria-expanded="false" aria-controls="csMore<%= i %>">
                                    <span>more</span><i class="fas fa-chevron-down"></i>
                                </button>
                            </td>
                            <td class="c-action">
                                <% if full %>
                                <button type="button" class="btn btn-sm btn-light cs-act" disabled>額滿</button>
                                <% else %>
                                <button type="button" class="btn btn-sm cs-act <%= c[:added] ? 'btn-outline-secondary' : 'btn-primary' %>" data-act><%= c[:added] ? '取消' : '加入' %></button>
                                <% end %>
                            </td>
                        </tr>
                        <tr class="cs-more-row" id="csMore<%= i %>" hidden>
                            <td colspan="10">
                                <dl class="cs-more-list">
                                    <div><dt>授課方式</dt><dd><%= c[:mode] %></dd></div>
                                    <div><dt>課程類別</dt><dd><%= c[:type] %></dd></div>
                                    <div><dt>上課日期與時間</dt><dd><%= c[:range] %>　<%= c[:time] %></dd></div>
                                    <div><dt>金額</dt><dd><%= c[:fee] %></dd></div>
                                </dl>
                            </td>
                        </tr>
                    </tbody>
                    <% end %>
                </table>

                <div class="cs-listfoot">
                    <p class="cs-footnote">※ 課程資訊以實際公告為準，如有異動，將另行公告。</p>
                    <nav aria-label="課程分頁">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#" aria-label="上一頁">&laquo;</a></li>
                            <li class="page-item active" aria-current="page"><a class="page-link" href="#">1</a></li>
                            <li class="page-item disabled"><a class="page-link" href="#" aria-label="下一頁">&raquo;</a></li>
                        </ul>
                    </nav>
                    <select class="form-select form-select-sm cs-perpage" aria-label="每頁筆數">
                        <option>20 筆/頁</option>
                        <option selected>50 筆/頁</option>
                        <option>100 筆/頁</option>
                    </select>
                </div>
            </div>

            <%# 桌機側欄：已加入的課程（第一階段） %>
            <aside class="cs-aside" data-phase-only="1">
                <div class="cs-cart">
                    <h3 class="cs-cart-title">已加入的課程 <span class="cs-cart-count">(<b data-cart-count>3</b>/不限)</span></h3>
                    <ul class="cs-cart-list" data-cart-list></ul>
                    <p class="cs-cart-empty" data-cart-empty hidden>尚未加入課程</p>
                    <button type="button" class="btn btn-primary btn-lg w-100 cs-go-sort" data-go-step="2">
                        前往排列志願序 <i class="fas fa-arrow-right ms-1"></i>
                    </button>
                </div>
            </aside>
        </div>

        <%# ---------- STEP 2：排列志願序 ---------- %>
        <section class="cs-sort" data-step-panel="2" hidden>
            <div class="cs-sort-head">
                <button type="button" class="btn btn-link cs-back" data-go-step="1"><i class="fas fa-arrow-left me-1"></i> 加入課程</button>
                <h3 class="cs-sort-title">第一階段｜優先序排列</h3>
                <p class="cs-sort-desc">請將已加入的課程拖曳排列優先順序，分發時將依此順序進行。</p>
            </div>
            <div class="cs-sort-tip">
                <i class="fas fa-info-circle"></i>
                <div>
                    <strong>排序方式：</strong>
                    <span class="cs-tip-desktop">請以拖曳方式調整順序，</span><span class="cs-tip-mobile">請以上移、下移調整順序，</span>數字越前面代表越高優先序。
                </div>
            </div>
            <ol class="cs-sort-list" data-sort-list></ol>
            <p class="cs-cart-empty" data-sort-empty hidden>尚未加入課程</p>
            <div class="cs-sort-actions">
                <button type="button" class="btn btn-outline-secondary btn-lg" data-go-step="1">繼續加入課程</button>
                <button type="button" class="btn btn-primary btn-lg">儲存優先序</button>
            </div>
        </section>

        <%# 手機 / 平板固定入口：前往排列志願序 %>
        <div class="cs-dock" data-phase-only="1">
            <div class="cs-dock-inner">
                <div class="cs-dock-info">已加入的課程<b data-cart-count>3</b><span>/不限</span></div>
                <button type="button" class="btn btn-primary cs-go-sort" data-go-step="2">前往排列志願序 <i class="fas fa-arrow-right ms-1"></i></button>
            </div>
        </div>

    </div>
</div>



<% content_for :js do %>
<script>
/* 我要選課：階段切換、加入 / 取消、志願序排列（桌機拖曳、手機上移下移） */
(function () {
    var page = document.getElementById("csSelect");
    if (!page) return;

    var sortList = page.querySelector("[data-sort-list]");
    var cartList = page.querySelector("[data-cart-list]");
    var order = []; // 志願序（課號）

    function course(id) { return page.querySelector('.cs-course[data-id="' + id + '"]'); }
    function esc(s) { var d = document.createElement("div"); d.textContent = s; return d.innerHTML; }

    // 初始：已加入的課程依表格順序
    page.querySelectorAll(".cs-course.is-added").forEach(function (el) { order.push(el.dataset.id); });

    function render() {
        // 計數
        page.querySelectorAll("[data-cart-count]").forEach(function (el) { el.textContent = order.length; });
        page.querySelectorAll("[data-cart-empty]").forEach(function (el) { el.hidden = order.length > 0; });
        page.querySelector("[data-sort-empty]").hidden = order.length > 0;
        page.querySelectorAll(".cs-go-sort").forEach(function (b) { b.disabled = order.length === 0; });

        // 側欄：課號、課程名稱、教師
        cartList.innerHTML = order.map(function (id, i) {
            var c = course(id).dataset;
            return '<li class="cs-cart-item">' +
                '<span class="cs-rank">' + (i + 1) + '</span>' +
                '<div class="cs-cart-body"><span class="cs-cart-name">' + esc(c.name) + '</span>' +
                '<span class="cs-cart-meta">' + esc(id) + '<i></i>' + esc(c.teacher) + '</span></div>' +
                '<button type="button" class="cs-icon-btn" data-remove="' + id + '" aria-label="移除 ' + esc(c.name) + '"><i class="fas fa-times"></i></button>' +
                '</li>';
        }).join("");

        // 排序清單：課號、課程名稱、課程類別、教師、上課地點、課程起訖日
        sortList.innerHTML = order.map(function (id, i) {
            var c = course(id).dataset;
            return '<li class="cs-sort-item" draggable="true" data-id="' + id + '">' +
                '<span class="cs-handle" aria-hidden="true"><i class="fas fa-grip-vertical"></i></span>' +
                '<span class="cs-rank cs-rank-lg">' + (i + 1) + '</span>' +
                '<div class="cs-sort-body">' +
                    '<div class="cs-sort-name"><span class="cs-code">' + esc(id) + '</span><a href="#" class="cs-name">' + esc(c.name) + '</a><span class="cs-type">' + esc(c.type) + '</span></div>' +
                    '<dl class="cs-sort-meta">' +
                        '<div><dt>教師</dt><dd>' + esc(c.teacher) + '</dd></div>' +
                        '<div><dt>上課地點</dt><dd>' + esc(c.place) + '</dd></div>' +
                        '<div><dt>課程起訖日</dt><dd>' + esc(c.range) + '</dd></div>' +
                    '</dl>' +
                '</div>' +
                '<div class="cs-sort-ctrl">' +
                    '<button type="button" class="cs-icon-btn" data-move="-1" aria-label="上移"' + (i === 0 ? " disabled" : "") + '><i class="fas fa-chevron-up"></i></button>' +
                    '<button type="button" class="cs-icon-btn" data-move="1" aria-label="下移"' + (i === order.length - 1 ? " disabled" : "") + '><i class="fas fa-chevron-down"></i></button>' +
                    '<button type="button" class="cs-icon-btn is-danger" data-remove="' + id + '" aria-label="移除"><i class="fas fa-times"></i></button>' +
                '</div>' +
                '</li>';
        }).join("");

        // 表格按鈕狀態
        var phase = page.dataset.phase;
        page.querySelectorAll(".cs-course").forEach(function (el) {
            var btn = el.querySelector("[data-act]");
            if (!btn) return;
            var added = phase === "1" && order.indexOf(el.dataset.id) > -1;
            el.classList.toggle("is-added", added);
            btn.className = "btn btn-sm cs-act " + (added ? "btn-outline-secondary" : "btn-primary");
            btn.textContent = phase === "2" ? "選課" : (added ? "取消" : "加入");
        });
    }

    // more：單筆展開 / 全部展開
    var expandAll = page.querySelector("[data-expand-all]");
    function setMore(btn, open) {
        btn.setAttribute("aria-expanded", open);
        document.getElementById(btn.getAttribute("aria-controls")).hidden = !open;
        btn.closest(".cs-course").classList.toggle("is-open", open);
    }
    function syncExpandAll() {
        var btns = page.querySelectorAll(".cs-more-btn");
        var allOpen = btns.length > 0 && Array.prototype.every.call(btns, function (b) { return b.getAttribute("aria-expanded") === "true"; });
        expandAll.setAttribute("aria-pressed", allOpen);
        expandAll.querySelector("[data-expand-label]").textContent = allOpen ? "全部收合" : "全部展開";
    }

    function remove(id) { order = order.filter(function (x) { return x !== id; }); render(); }

    function setStep(step) {
        page.dataset.step = step;
        page.querySelectorAll("[data-step-panel]").forEach(function (el) { el.hidden = el.dataset.stepPanel !== String(step); });
        page.querySelectorAll("[data-step-ind]").forEach(function (el) {
            el.classList.toggle("is-current", el.dataset.stepInd === String(step));
            el.classList.toggle("is-done", +el.dataset.stepInd < +step);
        });
        page.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function setPhase(phase) {
        page.dataset.phase = phase;
        page.querySelectorAll("[data-phase-target]").forEach(function (b) {
            var on = b.dataset.phaseTarget === phase;
            b.classList.toggle("is-active", on);
            b.setAttribute("aria-selected", on);
        });
        if (phase === "2") setStep(1);
        render();
    }

    page.addEventListener("click", function (e) {
        var t;
        if ((t = e.target.closest("[data-phase-target]"))) return setPhase(t.dataset.phaseTarget);
        if ((t = e.target.closest("[data-go-step]"))) return setStep(+t.dataset.goStep);
        if ((t = e.target.closest("[data-remove]"))) return remove(t.dataset.remove);
        if ((t = e.target.closest("[data-move]"))) {
            var id = t.closest(".cs-sort-item").dataset.id, i = order.indexOf(id), j = i + (+t.dataset.move);
            if (j < 0 || j >= order.length) return;
            order.splice(i, 1); order.splice(j, 0, id); render();
            var moved = sortList.querySelector('[data-id="' + id + '"]');
            moved.classList.add("is-moved");
            var focusBtn = moved.querySelector('[data-move="' + t.dataset.move + '"]');
            (focusBtn && !focusBtn.disabled ? focusBtn : moved.querySelector("[data-move]:not([disabled])")).focus();
            return;
        }
        if ((t = e.target.closest("[data-act]"))) {
            if (page.dataset.phase === "2") return;
            var cid = t.closest(".cs-course").dataset.id;
            if (order.indexOf(cid) > -1) remove(cid); else { order.push(cid); render(); }
            return;
        }
        if ((t = e.target.closest("[data-expand-all]"))) {
            var all = t.getAttribute("aria-pressed") !== "true";
            page.querySelectorAll(".cs-more-btn").forEach(function (b) { setMore(b, all); });
            syncExpandAll();
            return;
        }
        if ((t = e.target.closest(".cs-more-btn"))) {
            setMore(t, t.getAttribute("aria-expanded") !== "true");
            syncExpandAll();
        }
        if ((t = e.target.closest(".cs-clear"))) {
            page.querySelectorAll(".cs-filter select").forEach(function (s) { s.selectedIndex = 0; });
            page.querySelectorAll(".cs-filter input[type=date], .cs-filter input[type=text]").forEach(function (s) { s.value = ""; });
            page.querySelectorAll(".cs-weekdays input").forEach(function (c) { c.checked = c.id === "csWdAll"; });
        }
    });

    // 上課時間：「全部」與個別星期互斥
    page.querySelectorAll(".cs-weekdays input").forEach(function (cb) {
        cb.addEventListener("change", function () {
            var all = document.getElementById("csWdAll");
            var days = page.querySelectorAll(".cs-weekdays input:not(#csWdAll)");
            if (cb === all && all.checked) days.forEach(function (d) { d.checked = false; });
            else if (cb !== all) all.checked = !Array.prototype.some.call(days, function (d) { return d.checked; });
        });
    });

    // 桌機拖曳排序
    var dragId = null;
    sortList.addEventListener("dragstart", function (e) {
        var item = e.target.closest(".cs-sort-item");
        if (!item) return;
        dragId = item.dataset.id;
        item.classList.add("is-dragging");
        e.dataTransfer.effectAllowed = "move";
        e.dataTransfer.setData("text/plain", dragId);
    });
    sortList.addEventListener("dragover", function (e) {
        if (!dragId) return;
        e.preventDefault();
        var over = e.target.closest(".cs-sort-item");
        var dragging = sortList.querySelector(".is-dragging");
        if (!over || over === dragging) return;
        var rect = over.getBoundingClientRect();
        var after = e.clientY > rect.top + rect.height / 2;
        sortList.insertBefore(dragging, after ? over.nextSibling : over);
    });
    sortList.addEventListener("dragend", function () {
        order = Array.prototype.map.call(sortList.querySelectorAll(".cs-sort-item"), function (li) { return li.dataset.id; });
        dragId = null;
        render();
    });

    render();
})();
</script>
<% end %>
