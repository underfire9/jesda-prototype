<!-- template: 學生 / 評鑑 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>老師{助教}評鑑</h3>
        </div>
        <div class="row g-5">
            <div class="col-lg-4">
                <ul class="menu-item">
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">姓名</span>
                        <span class="d-block fw-bold"><%= zh_lorem_name %></span>
                    </li>
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">信箱</span>
                        <span class="d-block fw-bold"><%= lorem_email %></span>
                    </li>
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">手機</span>
                        <span class="d-block fw-bold">0903514322</span>
                    </li>
                    <li class="border-bottom py-2">
                        <span class="d-block mb-1 fs-6 text-muted">電話</span>
                        <span class="d-block fw-bold">0223456789</span>
                    </li>
                </ul>
            </div>
            <div class="col-lg-8">
                <section>
                    <div class="section-title">
                        <h4>問卷內容</h4>
                    </div>

                    <!-- demo only -->
                    <div style="height: 600px; background-color: #fafafa; display: flex; align-items: center; justify-content: center; color: #888;">
                        依照該年度指定之老師問卷顯示題目內容
                    </div>
                    
                </section>
                <div class="form-action">
                    <button type="submit" class="btn btn-lg btn-main">送出</button>
                </div>
            </div>
        </div>
    </div>
</div>



