<!-- template: 個人資料 -->

<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>個人資料</h3>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="nameForm" class="form-label">姓名</label>
                    <input type="text" class="form-control" id="nameForm" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="phoneForm" class="form-label">聯絡電話</label>
                    <input type="text" class="form-control" id="phoneForm" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">任職單位</label>
                    <select class="form-select" aria-label="Default select example">
                        <option selected>請選擇</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="emailForm" class="form-label">電子郵件</label>
                    <input type="email" class="form-control" id="emailForm" value="name@example.com" disabled />
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <label for="iframeForm" class="form-label">google 日曆 iframe 程式碼</label>
                    <input type="text" class="form-control" id="iframeForm" />
                </div>
            </div>
        </div>

        <!-- 不用放變更密碼按鈕 -->
        <div class="form-action border-0 pt-0">
            <button type="button" class="btn btn-lg btn-main">儲存</button>
        </div>

        <!-- 尚未授權 -->
        <div class="authorization-wrapper">
            <div><button type="button" class="btn btn-outline-dark">Google 日曆授權存取</button></div>
            <div class="authorization-already">已授權</div>
        </div>

        <!-- 授權後給 .authorization-done 並給 button disabled -->
        <!--div class="authorization-wrapper authorization-done">
            <div><button type="button" class="btn btn-outline-dark" disabled>Google 日曆授權存取</button></div>
            <div class="authorization-already">已授權</div>
        </div-->
    </div>
</div>


<% content_for :js do %>
<% end %>

