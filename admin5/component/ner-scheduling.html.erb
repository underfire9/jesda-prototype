<!-- admin-page: NER 新聞排播 -->

<%= render :partial => "/partials/admin_breadcrumb" %>

<main class="main">
    <div class="news-scheduling--container">
        <div class="d-flex align-items-end gap-2 mb-4">
            <div>
                <label class="form-label">播報日期時間</label>
                <div class="d-flex gap-2">
                    <input type="date" id="news-scheduling-date" class="form-control" />
                    <input type="time" id="news-scheduling-time" class="form-control" />
                </div>
            </div>
            <div>
                <label class="form-label" for="news-scheduling-reporter">播報人員</label>
                <input type="text" class="form-control" id="news-scheduling-reporter">
            </div>
            <div>
                <button type="button" class="btn btn-primary">儲存</button>
            </div>
            <div class="pb-2 ms-4 text-muted">2025-12-12 12:00:00 <%= zh_lorem_name %></div>
        </div>

        <div class="news-scheduling--wrapper flexible-wrapper">
            <div class="form-check wrapper-control-check">
                <input class="form-check-input" type="checkbox" id="wrapperControl">
                <label class="form-check-label" for="wrapperControl">
                    <span class="label-collapsed"></span>
                </label>
            </div>
            
            
            <div class="flexible-wrapper-start">
                <div class="scrollbar-inner">
                    <div class="wrapper-inner">
                        <h4 class="mb-3">新聞稿件</h4>
                        <div class="d-flex align-items-end gap-2 mb-4">
                            <div class="flex-grow-1">
                                <input type="date" id="news-scheduling-date" class="form-control" />
                            </div>
                            <div>
                                <select class="form-select" aria-label="Default select example">
                                    <option selected>Open this select menu</option>
                                    <option value="1">One</option>
                                    <option value="2">Two</option>
                                    <option value="3">Three</option>
                                </select>
                            </div>
                            <div>
                                <select class="form-select" aria-label="Default select example">
                                    <option selected>Open this select menu</option>
                                    <option value="1">One</option>
                                    <option value="2">Two</option>
                                    <option value="3">Three</option>
                                </select>
                            </div>
                        </div>
                        <div class="scheduling-manuscript-list">
                            <div class="manuscript-card">
                                <div class="card-hd">
                                    <h5 class="card-title"><%= zh_lorem_words(20) %></h5>
                                    <span class="news-category badge bg-secondary">話帶</span>
                                </div>
                                <div class="card-bd">

                                    <!-- 改為只顯示單行文字，超過寬度出現省略符，要抓多少字數或整串丟進來找 SA 決定 -->
                                    <p class="manuscript-introduction text-ellipsis"><%= zh_lorem_words(60) %></p>

                                    <audio id="manuscriptAudio" controls class="manuscript-audio mt-2">
                                        <source id="audioSource" src="" type="audio/mpeg">
                                        您使用的瀏覽器不支援音檔撥放
                                    </audio>
                                </div>
                                <div class="card-ft">
                                    <div class="ft-start">
                                        <span class="label">排播紀錄</span>
                                        <span class="broadcast">
                                            <span>08點</span>
                                            <span>10點</span>
                                            <span>12點</span>
                                            <span>14點</span>
                                            <span>08點</span>
                                        </span>
                                    </div>
                                    <div class="ft-end">
                                        <button type="button" class="btn btn-white btn-sm" data-bs-toggle="modal" data-bs-target="#manuscriptViewModal" title="檢視內文"><i class="fas fa-eye"></i></button>
                                        <button type="button" class="btn btn-primary btn-sm" title="加入排程表"><i class="fas fa-plus"></i></button>
                                    </div>
                                </div>
                            </div>
                            <% (1..70).map do |i| %>
                            <div class="manuscript-card">
                                <div class="card-hd">
                                    <h5 class="card-title"><%= i %><%= zh_lorem_words(20) %></h5>
                                    <span class="news-category badge bg-secondary">主播乾稿</span>
                                </div>
                                <div class="card-bd">
                                    <!-- 改為只顯示單行文字，超過寬度出現省略符，要抓多少字數或整串丟進來找 SA 決定 -->
                                    <p class="manuscript-introduction text-ellipsis"><%= zh_lorem_words(60) %></p>
                                </div>
                                <div class="card-ft">
                                    <div class="ft-start">
                                        <span class="label">排播紀錄</span>
                                        <span class="broadcast">
                                            <span>08點</span>
                                            <span>10點</span>
                                            <span>12點</span>
                                            <span>14點</span>
                                        </span>
                                    </div>
                                    <div class="ft-end">
                                        <button type="button" class="btn btn-white btn-sm" data-bs-toggle="modal" data-bs-target="#manuscriptViewModal" title="檢視內文"><i class="fas fa-eye"></i></button>
                                        <button type="button" class="btn btn-primary btn-sm" title="加入排程表"><i class="fas fa-plus"></i></button>
                                    </div>
                                </div>
                            </div>
                            <% end %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flexible-wrapper-end">
                <div class="scrollbar-inner">
                    <div class="content-start-head d-flex justify-content-between align-items-center">
                        <div class="head-left flex-grow-1">
                            <h4 class="mb-3">當時段排程表</h4>
                            <div class="d-flex align-items-end gap-2">
                                <button type="button" class="btn btn-outline-dark">下載全部 Word</button>
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addDryModal">新增乾稿</button>
                            </div>
                        </div>
                        <div class="head-right d-flex flex-column align-items-end ps-4">
                            <span class="item-total" title="目前音檔總時數">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-play-circle" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                <path d="M6.271 5.055a.5.5 0 0 1 .52.038l3.5 2.5a.5.5 0 0 1 0 .814l-3.5 2.5A.5.5 0 0 1 6 10.5v-5a.5.5 0 0 1 .271-.445"/>
                                </svg>
                                <strong>1"20</strong>
                            </span>
                            <span class="item-total" title="目前文字換算總時數">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-fonts" viewBox="0 0 16 16">
                                <path d="M12.258 3h-8.51l-.083 2.46h.479c.26-1.544.758-1.783 2.693-1.845l.424-.013v7.827c0 .663-.144.82-1.3.923v.52h4.082v-.52c-1.162-.103-1.306-.26-1.306-.923V3.602l.431.013c1.934.062 2.434.301 2.693 1.846h.479z"/>
                                </svg>
                                <strong>120"60</strong>
                            </span>
                        </div>
                    </div>
                    <div class="scheduling-manuscript-list">
                        <div class="manuscript-card">
                            <div class="card-hd">
                                <h5 class="card-title"><%= zh_lorem_words(20) %></h5>
                                <span class="news-category badge bg-secondary">話帶</span>
                            </div>
                            <div class="card-bd">
                                <p class="manuscript-introduction"><%= zh_lorem_words(120) %></p>

                                <audio id="manuscriptAudio" controls class="manuscript-audio mt-2">
                                    <source id="audioSource" src="" type="audio/mpeg">
                                    您使用的瀏覽器不支援音檔撥放
                                </audio>
                            </div>
                            <div class="card-ft">
                                <div class="cancel-scheduling">
                                    <button type="button" class="btn btn-sm" title="取消排程"><i class="fas fa-times"></i></button>
                                </div>
                                <div class="drag-area"></div>
                                <div class="card-control ft-end">
                                    <button type="button" class="btn btn-dark btn-sm" data-bs-toggle="modal" data-bs-target="#newsContentModal" title="新聞內文">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-text" viewBox="0 0 16 16">
                                        <path d="M5.5 7a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zM5 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5"/>
                                        <path d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5zm0 1v2A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <% (1..12).map do |i| %>
                        <div class="manuscript-card">
                            <div class="card-hd">
                                <h5 class="card-title"><%= zh_lorem_words(20) %></h5>
                                <span class="news-category badge bg-secondary">乾稿</span>
                            </div>
                            <div class="card-bd">
                                <p class="manuscript-introduction"><%= zh_lorem_words(80) %></p>
                            </div>
                            <div class="card-ft">
                                <div class="cancel-scheduling">
                                    <button type="button" class="btn btn-sm" title="取消排程"><i class="fas fa-times"></i></button>
                                </div>
                                <div class="drag-area"></div>
                                <div class="card-control ft-end">
                                    <button type="button" class="btn btn-dark btn-sm" data-bs-toggle="modal" data-bs-target="#newsContentModal" title="新聞內文">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-text" viewBox="0 0 16 16">
                                        <path d="M5.5 7a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zM5 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5"/>
                                        <path d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5zm0 1v2A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <% end %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- 檢視內文 Modal -->
<div class="modal fade" id="manuscriptViewModal" tabindex="-1" aria-labelledby="manuscriptViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="manuscriptViewModalLabel">新聞稿件</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="" class="form-label">標題</label>
                    <input type="text" class="form-control" id="" value="這是一個新聞標題範例" disabled>
                </div>
                <div class="form-group">
                    <label for="" class="form-label">導言</label>
                    <textarea class="form-control" id="" rows="3" disabled><%= zh_lorem_words(80) %></textarea>
                </div>
                <div class="form-group">
                    <label for="" class="form-label">內文</label>
                    <textarea class="form-control" id="" rows="18" disabled><%= zh_lorem_words(1000) %></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- 新增乾稿 Modal -->
<div class="modal fade" id="addDryModal" tabindex="-1" aria-labelledby="addDryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white" data-bs-theme="dark">
                <h1 class="modal-title fs-5" id="addDryModalLabel">新增乾稿</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="" class="form-label">標題</label>
                    <input type="text" class="form-control" id="">
                </div>
                <div class="form-group">
                    <label for="" class="form-label">導言</label>
                    <textarea class="form-control" id="" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label for="" class="form-label">內文</label>
                    <textarea class="form-control" id="" rows="18"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="submit" class="btn btn-primary">送出</button>
            </div>
        </div>
    </div>
</div>

<!-- 新聞內文 Modal -->
<div class="modal fade" id="newsContentModal" tabindex="-1" aria-labelledby="newsContentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white" data-bs-theme="dark">
                <h1 class="modal-title fs-5" id="newsContentModalLabel">新聞內文</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center pt-3 pb-4">
                    <h4 class="mb-0">這是一個新聞標題範例</h4>
                    <span class="badge bg-secondary me-2">話帶</span>
                </div>
                <div class="form-group">
                    <label for="" class="form-label">導言</label>
                    <textarea class="form-control" id="" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label for="" class="form-label">內文</label>
                    <textarea class="form-control" id="" rows="18"></textarea>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <audio id="manuscriptAudio" controls class="manuscript-audio mt-2">
                            <source id="audioSource" src="" type="audio/mpeg">
                            您使用的瀏覽器不支援音檔撥放
                        </audio>
                    </div>
                    <div class="text-end">
                        <div>2022-12-12</div>
                        <div>來源：總台記者 <%= zh_lorem_name %></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="submit" class="btn btn-primary">儲存</button>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>

<% end %>

