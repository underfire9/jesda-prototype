<div class="form-section">
    <div class="form-section-title">
        <h4>基本資料</h4>
    </div>
    <div class="row">
        <div class="col-4">
            <div class="form-group">
                <label class="form-label">姓名</label>
                <input type="text" class="form-control" value="<%= zh_lorem_name %>" disabled readonly>
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <label class="form-label">職稱</label>
                <input type="text" class="form-control" value="系統分析師" disabled readonly>
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <label class="form-label">任職單位</label>
                <input type="text" class="form-control" value="捷思達數位開發" disabled readonly>
            </div>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">
        <h4>技術內容</h4>
    </div>
    <div class="row">
        <div class="col-6">
            <div class="form-group">
                <label class="form-label">技術名稱</label>
                <input type="text" class="form-control" value="<%= lorem_words(5) %>" disabled readonly>
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                <label class="form-label">技術摘要</label>
                <textarea class="form-control" rows="3" disabled readonly><%= lorem_sentences(5) %></textarea>
            </div>
        </div>
        <div class="col-6">
            <div class="form-group">
                <label class="form-label">技術關鍵字</label>
                <input type="text" class="form-control" value="<%= lorem_words(5) %>" disabled readonly>
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                <label class="form-label">技術創新性</label>
                <textarea class="form-control" rows="3" disabled readonly><%= lorem_sentences(10) %></textarea>
            </div>
        </div>
        <div class="col-6">
            <div class="form-group">
                <label class="form-label">技術領域</label>
                <input type="text" class="form-control" value="<%= lorem_words(5) %>" disabled readonly>
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                <label class="form-label">技術相關專利</label>
                <textarea class="form-control" rows="3" disabled readonly><%= lorem_sentences(5) %></textarea>
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                <label class="form-label">其他</label>
                <textarea class="form-control" rows="3" disabled readonly><%= lorem_sentences(5) %></textarea>
            </div>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">
        <h4>商化模式區塊</h4>
    </div>
    <div class="form-group">
        <label class="form-label">預計商化模式 (排序選1-3)</label>
        <div class="sort-model-item">
            <div class="d-flex align-items-center">
                <span>排序 1</span>
                <div>
                    <select class="form-select" disabled readonly>
                        <option value="1">技術授權</option>
                        <option value="2" selected>技術轉移</option>
                        <option value="3">技術合作</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="sort-model-item">
            <div class="d-flex align-items-center">
                <span>排序 2</span>
                <div>
                    <select class="form-select" disabled readonly>
                        <option value="1" selected>技術授權</option>
                        <option value="2">技術轉移</option>
                        <option value="3">技術合作</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="sort-model-item">
            <div class="d-flex align-items-center">
                <span>排序 3</span>
                <div>
                    <select class="form-select" disabled readonly>
                        <option value="1">技術授權</option>
                        <option value="2">技術轉移</option>
                        <option value="3" selected>技術合作</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label class="form-label">擬合作之對象</label>
        <textarea class="form-control" rows="3" disabled readonly><%= lorem_sentences(5) %></textarea>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">
        <h4>參考文件</h4>
    </div>
    <div>
        <a href="#" class="upload-document-link" title="下載參考文件">
            <i class="fas fa-cloud-download-alt me-2"></i>
            <span>filename.pdf</span>
        </a>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">
        <h4>參考圖片</h4>
    </div>
    <div class="lightbox-row">
        <% (1..5).map do |i| %>
        <a href="../assets/fake/carousel-<%= i %>.jpg" data-toggle="lightbox" data-gallery="example-gallery" data-size="fullscreen" class="lightbox-item">
            <img src="../assets/fake/carousel-<%= i %>.jpg">
        </a>
        <% end %>
    </div>
</div>