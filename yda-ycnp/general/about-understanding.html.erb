// Sticky Navigation
<script>
document.addEventListener('DOMContentLoaded', function() {
    var nav = document.querySelector('.about-nav');
    var navOffset = nav.getBoundingClientRect().top + window.pageYOffset;

    function onScroll() {
        if (window.pageYOffset > navOffset) {
            nav.style.position = 'fixed';
            nav.style.top = '0';
            nav.style.zIndex = '1000';
            nav.style.width = nav.offsetWidth + 'px';
        } else {
            nav.style.position = '';
            nav.style.top = '';
            nav.style.zIndex = '';
            nav.style.width = '';
        }
    }

    window.addEventListener('scroll', onScroll);
});
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    var banner = document.querySelector('.about-banner');
    var copywrite = document.querySelector('.copywrite');
    var hero = document.querySelector('.banner-hero');

    if (banner && copywrite && hero) {
        banner.addEventListener('mousemove', function(e) {
            var rect = banner.getBoundingClientRect();
            var x = e.clientX - rect.left;
            var y = e.clientY - rect.top;
            var xPercent = (x / rect.width - 0.5) * 2; // -1 ~ 1
            var yPercent = (y / rect.height - 0.5) * 2;

            // 2D movement
            gsap.to(copywrite, {
                x: xPercent * 15,
                y: yPercent * 5,
                duration: 0.4,
                ease: "power2.out"
            });
            gsap.to(hero, {
                x: xPercent * 10,
                y: yPercent * 3,
                duration: 0.4,
                ease: "power2.out"
            });

            // 3D effect for banner-hero
            gsap.to(hero, {
                rotateY: xPercent * 10,
                rotateX: -yPercent * 5,
                transformPerspective: 1000,
                duration: 0.4,
                ease: "power2.out"
            });
        });

        banner.addEventListener('mouseleave', function() {
            gsap.to(copywrite, { x: 0, y: 0, duration: 0.5, ease: "power2.out" });
            gsap.to(hero, { x: 0, y: 0, rotateY: 0, rotateX: 0, duration: 0.5, ease: "power2.out" });
        });
    }
});
</script>
<% end %>

