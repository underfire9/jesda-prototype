<!-- template: 執行 - 企劃修正申請 (瀏覽) -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="wrapper-inner">
            
            <%= render :partial => "/partials/execution_sidenav" %>

            <main class="main">
                <div class="content-title">
                    <h3>企劃修正申請</h3>
                </div>
                <div class="form-container">
                    <section class="plan-section execution-section mb-0">
                        <div class="plan-header">
                            <h4>企劃主題與執行</h4>
                        </div>
                        <div class="plan-editor" style="min-height: 320px;">
                            <!-- 只是說明，套版時請拿掉 -->
                            <span class="d-block text-secondary p-4">編輯器區塊高度是 inline css 可自行修改設定或拿掉，如套用的編輯器有框線樣式請拿掉或呼叫 fire 調整樣式</span>
                        </div>

                        <!-- 沒有增建資料前 .plan-table 不要出現 -->
                        <div class="plan-table">
                            <div class="plan-table-header">
                                <div class="plan-table-row">
                                    <div class="plan-table-cell w-sm">日期</div>
                                    <div class="plan-table-cell w-sm">體驗類型</div>
                                    <div class="plan-table-cell">執行主題</div>
                                    <div class="plan-table-cell w-sm">地點</div>
                                    <div class="plan-table-cell">單位名稱</div>
                                    <div class="plan-table-cell w-lg">備註</div>
                                </div>
                            </div>
                            <div class="plan-table-body">
                                <div class="plan-table-row">
                                    <div class="plan-table-cell w-sm" data-label="日期"><span class="rwd-th">日期</span>2024-06</div>
                                    <div class="plan-table-cell w-sm" data-label="體驗類型"><span class="rwd-th">體驗類型</span>職場體驗</div>
                                    <div class="plan-table-cell" data-label="執行主題"><span class="rwd-th">執行主題</span>科技公司任職專案助理</div>
                                    <div class="plan-table-cell w-sm" data-label="地點"><span class="rwd-th">地點</span>台北</div>
                                    <div class="plan-table-cell" data-label="單位名稱"><span class="rwd-th">單位名稱</span>帕蘭泰爾技術公司</div>
                                    <div class="plan-table-cell w-lg" data-label="備註"><span class="rwd-th">備註</span>職業探索，並賺取至英國旅費。已通知面試</div>
                                </div>
                                <div class="plan-table-row">
                                    <div class="plan-table-cell w-sm" data-label="日期"><span class="rwd-th">日期</span>2024-07</div>
                                    <div class="plan-table-cell w-sm" data-label="體驗類型"><span class="rwd-th">體驗類型</span>志願服務</div>
                                    <div class="plan-table-cell" data-label="執行主題"><span class="rwd-th">執行主題</span>主題B</div>
                                    <div class="plan-table-cell w-sm" data-label="地點"><span class="rwd-th">地點</span>新竹</div>
                                    <div class="plan-table-cell" data-label="單位名稱"><span class="rwd-th">單位名稱</span>甲骨文公司</div>
                                    <div class="plan-table-cell w-lg" data-label="備註"><span class="rwd-th">備註</span><%= lorem_sentence %></div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="form-action noborder mt-0">
                        <span class="backhome"><a href="home.html" class="btn btn-lg btn-back" title="回首頁"><i class="fas fa-long-arrow-alt-left"></i></a></span>
                    </div>
                </form>
            </main>
        </div>
    </div>
</div>

<% content_for :js do %>

<% end %>