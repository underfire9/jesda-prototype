<!-- template: 計畫主持人 - 計畫申請/實習計畫基本資料 -->
<% content_for :header_center do %>
    <span class="central-title manager-central-title">實習計畫基本資料</span>
<% end %>

<% content_for :header_dropdown do %>
    <%= render :partial => "/partials/manager_dropdown" %>
<% end %>

<div class="container">
    <div class="page-content width-middle mx-auto">
        <div class="row general-info">
            <div class="col-12">
                <div class="form-group">
                    <label class="form-label" for="plan_name"><span class="required">*</span> 實習計畫名稱</label>
                    <input type="text" class="form-control" id="plan_name" placeholder="請輸入實習計畫名稱">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">計畫主持人</label>
                    <div class="info-value"><%= lorem_name %></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">實習國別</label>
                    <div class="info-value">美國</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">實習機構</label>
                    <div class="info-value"><%= lorem_words(4) %></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">實習領域</label>
                    <div class="info-value">語文、教育</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">出返國日期</label>
                    <div class="info-value">
                        <span class="clip">2026 年 07 月 01 日</span> 至
                        <span class="clip">2027 年 02 月 18 日</span>
                        <span class="clip">共 233 日</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">預計實習日期</label>
                    <div class="info-value">
                        <span class="clip">2026 年 07 月 01 日</span> 至
                        <span class="clip">2027 年 02 月 18 日</span>
                        <span class="clip">共 233 日</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-action">
            <span class="backhome">
                <a href="apply.html" class="btn btn-lg btn-light">
                    <i class="fas fa-long-arrow-alt-left"></i>
                    <span class="md-none">回上一頁</span>
                </a>
            </span>
            <button type="submit" class="btn btn-lg btn-rounded btn-primary px-5">儲存</button>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

