<!-- template: 計畫主持人 - 維護/機構機票證明文件上傳 -->
<% content_for :header_center do %>
    <span class="central-title manager-central-title">機構機票證明文件上傳</span>
<% end %>

<% content_for :header_dropdown do %>
    <%= render :partial => "/partials/manager_dropdown" %>
<% end %>

<div class="container">
    <div class="page-content width-small mx-auto">
        <div class="airfare-upload-wrapper">
            <% (1..2).map do |i| %>
            <div class="airfare-upload-item">
                <div class="status-value">未上傳</div>
                <div class="row general-info">
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">機構名稱</label>
                            <div class="info-value org-name"><%= lorem_words(10) %></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">實習國別</label>
                            <div class="info-value">美國</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">前往區域</label>
                            <div class="info-value">加利福尼亞州(南部)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">產業別</label>
                            <div class="info-value">運輸物流</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">實習領域別</label>
                            <div class="info-value">語文、教育</div>
                        </div>
                    </div>
                </div>
                <div class="upload-container">
                    <div class="drag-and-drop" id="dropZone">
                        <input type="file" id="fileInput" accept="application/pdf" hidden>
                        <div class="dnd-idle" id="dndIdle">
                            <i class="fas fa-file-pdf dnd-icon"></i>
                            <span class="title">請將 PDF 檔案拖曳至此，或<button type="button" class="btn btn-outline-dark mx-2" id="browseBtn">點擊選擇檔案</button></span>
                        </div>
                        <div class="dnd-preview" id="dndPreview" hidden>
                            <div class="dnd-preview-info">
                                <i class="fas fa-file-pdf dnd-icon text-danger"></i>
                                <div class="dnd-file-meta">
                                    <span class="dnd-filename" id="dndFilename"></span>
                                    <span class="dnd-filesize" id="dndFilesize"></span>
                                </div>
                            </div>
                            <div class="dnd-preview-actions">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="viewNewTabBtn" title="開啟新視窗">
                                    <i class="fas fa-external-link-alt"></i> 新視窗
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm" id="removeFileBtn" title="刪除檔案">
                                    <i class="fas fa-trash-alt"></i> 刪除
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Inline PDF preview -->
                    <div class="pdf-inline-preview" id="pdfInlinePreview" hidden>
                        <div class="pdf-inline-toolbar">
                            <span id="pdfInlineFilename"></span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="closePdfPreview"><i class="fas fa-times"></i> 關閉預覽</button>
                        </div>
                        <iframe id="pdfIframe" title="PDF 預覽" frameborder="0"></iframe>
                    </div>
                </div>
            </div>
            <% end %>
        </div>
        <div class="form-action">
            <span class="backhome">
                <a href="apply.html" class="btn btn-lg btn-light">
                    <i class="fas fa-long-arrow-alt-left"></i>
                    <span class="md-none">回上一頁</span>
                </a>
            </span>
            <button type="submit" class="btn btn-lg btn-rounded btn-primary px-5">儲存</button>
        </div>
    </div>
</div>



<% content_for :js do %>
<script>
(function () {
    const uploadItems = document.querySelectorAll('.airfare-upload-item');

    function formatSize(bytes) {
        if (bytes >= 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB';
        return (bytes / 1024).toFixed(0) + ' KB';
    }

    uploadItems.forEach((item) => {
        const statusValue = item.querySelector('.status-value');
        const orgName = item.querySelector('.org-name');
        const dropZone = item.querySelector('#dropZone');
        const fileInput = item.querySelector('#fileInput');
        const browseBtn = item.querySelector('#browseBtn');
        const dndIdle = item.querySelector('#dndIdle');
        const dndPreview = item.querySelector('#dndPreview');
        const dndFilename = item.querySelector('#dndFilename');
        const dndFilesize = item.querySelector('#dndFilesize');
        const removeBtn = item.querySelector('#removeFileBtn');
        const viewNewTab = item.querySelector('#viewNewTabBtn');
        const pdfPreview = item.querySelector('#pdfInlinePreview');
        const pdfIframe = item.querySelector('#pdfIframe');
        const pdfLabel = item.querySelector('#pdfInlineFilename');
        const closePrev = item.querySelector('#closePdfPreview');

        if (!dropZone || !fileInput || !browseBtn || !dndIdle || !dndPreview || !dndFilename || !dndFilesize || !removeBtn || !viewNewTab || !pdfPreview || !pdfIframe || !pdfLabel || !closePrev) {
            return;
        }

        let currentObjectUrl = null;

        function hidePdfPreview() {
            pdfPreview.hidden = true;
            pdfIframe.src = '';
        }

        function setFile(file) {
            if (!file) return;
            if (file.type !== 'application/pdf') {
                alert('請上傳 PDF 格式的檔案。');
                return;
            }

            if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
            currentObjectUrl = URL.createObjectURL(file);
            dndFilename.textContent = file.name;
            dndFilesize.textContent = formatSize(file.size);
            dndIdle.hidden = true;
            dndPreview.hidden = false;
            pdfIframe.src = currentObjectUrl;
            pdfLabel.textContent = file.name;
            pdfPreview.hidden = false;
            if (statusValue) statusValue.hidden = true;
            if (orgName) orgName.classList.add('pe-0');
        }

        function clearFile() {
            if (currentObjectUrl) {
                URL.revokeObjectURL(currentObjectUrl);
                currentObjectUrl = null;
            }
            fileInput.value = '';
            dndIdle.hidden = false;
            dndPreview.hidden = true;
            hidePdfPreview();
            if (statusValue) statusValue.hidden = false;
            if (orgName) orgName.classList.remove('pe-0');
        }

        browseBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            fileInput.click();
        });

        dropZone.addEventListener('click', (e) => {
            if (e.target === dropZone || dndIdle.contains(e.target)) {
                fileInput.click();
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files[0]) setFile(fileInput.files[0]);
        });

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('dnd-hover');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('dnd-hover');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('dnd-hover');
            const file = e.dataTransfer.files[0];
            if (file) setFile(file);
        });

        removeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            clearFile();
        });

        viewNewTab.addEventListener('click', (e) => {
            e.stopPropagation();
            if (currentObjectUrl) window.open(currentObjectUrl, '_blank');
        });

        closePrev.addEventListener('click', hidePdfPreview);

        window.addEventListener('beforeunload', () => {
            if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
        });
    });
})();
</script>
<% end %>

