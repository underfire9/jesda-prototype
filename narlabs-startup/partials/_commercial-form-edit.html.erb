<div class="form-section">
    <div class="form-section-title">
        <h4>基本資料</h4>
    </div>
    <div class="row">
        <div class="col-4">
            <div class="form-group">
                <label class="form-label">姓名</label>
                <input type="text" class="form-control">
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <label class="form-label">職稱</label>
                <input type="text" class="form-control">
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <label class="form-label">任職單位</label>
                <input type="text" class="form-control">
            </div>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">
        <h4>技術內容</h4>
    </div>
    <div class="row">
        <div class="col-6">
            <div class="form-group">
                <label class="form-label">技術名稱</label>
                <input type="text" class="form-control">
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                <label class="form-label">技術摘要</label>
                <textarea class="form-control" rows="3"></textarea>
            </div>
        </div>
        <div class="col-6">
            <div class="form-group">
                <label class="form-label">技術關鍵字</label>
                <input type="text" class="form-control">
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                <label class="form-label">技術創新性</label>
                <textarea class="form-control" rows="3"></textarea>
            </div>
        </div>
        <div class="col-6">
            <div class="form-group">
                <label class="form-label">技術領域</label>
                <input type="text" class="form-control">
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                <label class="form-label">技術相關專利</label>
                <textarea class="form-control" rows="3"></textarea>
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                <label class="form-label">其他</label>
                <textarea class="form-control" rows="3"></textarea>
            </div>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">
        <h4>商化模式區塊</h4>
    </div>
    <div class="form-group">
        <label class="form-label">預計商化模式 (排序選1-3)</label>
        <div class="sort-model-item">
            <div class="d-flex align-items-center">
                <span>排序 1</span>
                <div>
                    <select class="form-select">
                        <option selected>請選擇</option>
                        <option value="1">技術授權</option>
                        <option value="2">技術轉移</option>
                        <option value="3">技術合作</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="sort-model-item">
            <div class="d-flex align-items-center">
                <span>排序 2</span>
                <div>
                    <select class="form-select">
                        <option selected>請選擇</option>
                        <option value="1">技術授權</option>
                        <option value="2">技術轉移</option>
                        <option value="3">技術合作</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="sort-model-item">
            <div class="d-flex align-items-center">
                <span>排序 3</span>
                <div>
                    <select class="form-select">
                        <option selected>請選擇</option>
                        <option value="1">技術授權</option>
                        <option value="2">技術轉移</option>
                        <option value="3">技術合作</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label class="form-label">擬合作之對象</label>
        <textarea class="form-control" rows="3"></textarea>
    </div>
</div>

<div class="mb-4">
    說明文案 <%= lorem_paragraph %>
</div>

<div class="form-section">
    <div class="form-section-title">
        <h4>參考文件</h4>
    </div>
    <div class="row">
        <div class="col-4">
            <div class="mb-4">
                <input class="form-control" type="file" id="">
            </div>

            <!-- 未上傳前不會出現此區塊 -->
            <div class="upload-document-item">
                <span>filename.pdf</span>
                <button type="button" class="btn btn-delete text-danger" title="刪除">
                    <i class="fas fa-times"></i>
                </button>
            </div>

        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">
        <h4>參考圖片</h4>
    </div>
    <div class="row">
        <div class="mb-4">上限六張</div>
        <div class="col-4">

            <!-- 可多選 -->
            <input class="form-control" type="file" id="" multiple>
        </div>

        <!-- 未上傳前不會出現此區塊 -->
        <div class="col-8">
            <div class="row ps-4">
                <% (1..5).map do |i| %>
                <div class="col-4">
                    <div class="refer-img">
                        <button type="button" class="btn" title="刪除">
                            <i class="fas fa-times"></i>
                        </button>
                        <img src="https://picsum.photos/8<%= i %>0/6<%= i %>0">
                    </div>
                </div>
                <% end %>
            </div>
        </div>

    </div>
</div>