<!-- template: 執行 - 下載系統資源 -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="wrapper-inner">
            
            <%= render :partial => "/partials/execution_sidenav" %>

            <main class="main">
                <div class="content-title">
                    <h3>下載系統資源</h3>
                </div>
                <div class="dl-resource-container">
                    <div class="resource-group">
                        <h4 class="group-title">網站連結</h4>
                        <div class="sub-resource-group">
                            <h5 class="sub-group-title">志願服務</h5>
                            <ul class="resource-list menu-item">
                                <% (1..2).map do |i| %>
                                <li class="resource-item">

                                    <!-- 只給標題不用重複再給分類 -->
                                    <h6><%= zh_lorem_words(8) %></h6>
                                    <div class="resource-ft">
                                        <a href="#" class="btn btn-download resource-link">
                                            <span></span>連結
                                        </a>
                                    </div>
                                </li>
                                <% end %>
                            </ul>
                        </div>
                        <div class="sub-resource-group">
                            <h5 class="sub-group-title">創業見習</h5>
                            <ul class="resource-list menu-item">
                                <% (1..4).map do |i| %>
                                <li class="resource-item">

                                    <!-- 只給標題不用重複再給分類 -->
                                    <h6><%= zh_lorem_words(8) %></h6>
                                    <div class="resource-ft">
                                        <a href="#" class="btn btn-download resource-link">
                                            <span></span>連結
                                        </a>
                                    </div>
                                </li>
                                <% end %>
                            </ul>
                        </div>
                        <div class="sub-resource-group">
                            <h5 class="sub-group-title">相關資源</h5>
                            <ul class="resource-list menu-item">
                                <% (1..9).map do |i| %>
                                <li class="resource-item">

                                    <!-- 只給標題不用重複再給分類 -->
                                    <h6><%= zh_lorem_words(8) %></h6>
                                    <div class="resource-ft">
                                        <a href="#" class="btn btn-download resource-link">
                                            <span></span>連結
                                        </a>
                                    </div>
                                </li>
                                <% end %>
                            </ul>
                        </div>
                    </div>
                    <div class="resource-group">
                        <h4 class="group-title">檔案下載</h4>
                        <div class="sub-resource-group">
                            <h5 class="sub-group-title">社區見習</h5>
                            <ul class="resource-list menu-item">
                                <% (1..5).map do |i| %>
                                <li class="resource-item">

                                    <!-- 只給標題不用重複再給分類 -->
                                    <h6><%= zh_lorem_words(8) %></h6>
                                    <div class="resource-ft">
                                        <a href="#" class="btn btn-download" download>
                                            <span></span>下載
                                        </a>
                                    </div>
                                </li>
                                <% end %>
                            </ul>
                        </div>
                    </div>
                    <div class="form-action">
                        <span class="backhome"><a href="home.html" class="btn btn-lg btn-back" title="回首頁"><i class="fas fa-long-arrow-alt-left"></i></a></span>
                    </div>
                </div>
            </main>
        </div>
    </div>
</div>



