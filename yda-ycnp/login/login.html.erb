<!-- template: 申請 - 登入 -->

<div class="container-lg">
	<div class="login-wrapper">
		<div class="login-card">
		    <div class="card-hd">
			    <h2>登入</h2>
			</div>
			<div class="card-bd">
                <div class="form-group">
                    <label for="exampleFormControlInput1" class="form-label">帳號</label>
                    <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="email@example.com" />
                </div>
                <div class="form-group">
                    <label for="exampleFormControlInput2" class="form-label">密碼</label>
                    <input type="password" class="form-control" id="exampleFormControlInput2" />
                    <div class="form-text text-end mt-2"><a href="#">忘記密碼?</a></div>
                </div>
                <div class="form-group">
                    <label for="loginInput4" class="form-label">驗證碼</label>
                    <div class="d-flex align-items-center">
                        <span class="me-1"><input type="text" class="form-control" id="loginInput4" /></span>
                        <span class="me-1"><img class="captcha" src="http://nfu-map.dev.com.tw/common/captcha.image" /></span>
                        <span>
                            <button class="btn btn-outline-primary" type="button"><i class="fas fa-sync-alt"></i></button>
                        </span>
                    </div>
                </div>
			</div>
            <div class="d-grid mt-4">
                <button class="btn btn-lg btn-main" type="submit">送出</button>
            </div>
            <p class="text-center mt-5">尚無帳號? <a href="#">註冊</p>
		</div>
	</div>
</div>



<% content_for :js do %>

<% end %>

