<!-- template: 學生 / 身分開通申請 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>114年度身分開通申請</h3>
        </div>
        <div class="activation-apply-wrapper">
            <div class="apply-aside">
                <h4><%= zh_lorem_name %></h4>
                <ul class="menu-item basic-info-list">
                    <li>
                        <span class="label">電子信箱</span>
                        <span class="value"><%= lorem_email %></span>
                    </li>
                    <li>
                        <span class="label">身份證字號</span>
                        <span class="value">A131884519</span>
                    </li>
                    <li>
                        <span class="label">生日</span>
                        <span class="value">2005-04-26</span>
                    </li>
                    <li>
                        <span class="label">電話</span>
                        <span class="value">0903514322</span>
                    </li>
                    <li>
                        <span class="label">手機</span>
                        <span class="value">0903514322</span>
                    </li>
                    <li>
                        <span class="label">通訊地址</span>
                        <span class="value">10404臺北市中山區明水路397巷11號9樓</span>
                    </li>
                </ul>
                <div class="basic-info-note">
                    <p class="mb-0">基本資料若有錯誤請先前往 <a href="../general/account.html" class="link-maintain">維護資料</a> 正確後再申請</p>
                </div>
            </div>
            <div class="apply-content">
                <section class="section">
                    <div class="section-title">
                        <h4>身分資訊</h4>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="applyNumber">報名序號</label>
                                <input type="text" class="form-control" id="applyNumber" value="11300001" disabled>
                            </div>
                        </div>
                        <div class="w-100"></div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="attendSchool">就讀學校</label>
                                <select class="form-select" id="attendSchool" data-placeholder="請選擇學校">
                                    <option></option>
                                    <option>Reactive</option>
                                    <option>Solution</option>
                                    <option>Conglomeration</option>
                                    <option>Algoritm</option>
                                    <option>Holistic</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="attendDepartment">就讀學系</label>
                                <input type="text" class="form-control" id="attendDepartment">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="studentType">身份別</label>
                                <select class="form-select" id="studentType">
                                    <option selected>請選擇</option>
                                    <option value="general">一般生</option>
                                    <option value="special">特殊生</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="studentNumber">學號或准考證號</label>
                                <input type="text" class="form-control" id="studentNumber">
                            </div>
                        </div>
                    </div>
                </section>
                <section class="section">
                    <div class="section-title">
                        <h4>繳交文件</h4>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="studentCardFront">學生證正面</label>
                                <input type="file" class="form-control" id="studentCardFront">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="studentCardBack">學生證反面</label>
                                <input type="file" class="form-control" id="studentCardBack">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="enrollmentProof">在學證明</label>
                                <input type="file" class="form-control" id="enrollmentProof">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="scheduleOrAdmissionNotice">該學期課表/大學錄取通知書</label>
                                <input type="file" class="form-control" id="scheduleOrAdmissionNotice">
                            </div>
                        </div>
                    </div>
                    <div class="notice-wrapper form-text">
                        <p>檔案類型 jpg、png、jpeg，大小上限 5 MB</p>
                        <ul>
                            <li>請上傳學生證正反面/在學證明/該學期修課記錄。(至少上傳一個，若上傳學生證，正面與反面都要上傳)</li>
                            <li>若貴校學生證正反面皆無註冊章，請務必提供本學期的在學證明文件或包含姓名之選課畫面</li>
                            <li>準大一新生，請務必上傳錄取大學之證明文件</li>
                        </ul>
                    </div>
                </section>
                <div class="form-action">
                    <span class="backhome">
                        <a href="activation-apply.html" class="btn btn-white btn-lg"><i class="fas fa-long-arrow-alt-left fs-6 me-2"></i> 回列表</a>
                    </span>
                    <button type="button" class="btn btn-main btn-lg">送出申請</button>
                </div>
            </div>
        </div>
    </div>
</div>
    


<% content_for :js do %>
    <script src="../javascripts/select2.min.js"></script>
    <script>
        $( '#attendSchool' ).select2( {
            theme: "bootstrap-5",
            width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
            placeholder: $( this ).data( 'placeholder' ),
        } );
    </script>
<% end %>

