<!-- template: 審查委員 - 變更密碼/初次登入 -->
<!-- 跟學員端一樣 -->
<div class="container-lg">
	<div class="login-wrapper">
		<div class="login-card">
		    <div class="card-hd">
			    <h3>變更密碼</h3>
			</div>
			<div class="card-bd">
                <div class="mb-4 fw-bold">
                    abcd1234@gmail.com
                </div>
                <div class="form-group">
                    <label for="exampleFormControlInput2" class="form-label">輸入密碼</label>
                    <input type="password" class="form-control" id="exampleFormControlInput2" />
                </div>
                <div class="form-group">
                    <label for="exampleFormControlInput8" class="form-label">再次輸入密碼</label>
                    <input type="password" class="form-control" id="exampleFormControlInput8" />
                </div>
                <div class="form-group">
                    <label for="loginInput4" class="form-label">圖形驗證碼</label>
                    <div class="d-flex align-items-center">
                        <span class="me-1"><input type="text" class="form-control" id="loginInput4" /></span>
                        <span class="me-1"><img class="captcha" src="http://nfu-map.dev.com.tw/common/captcha.image" /></span>
                        <span>
                            <button class="btn btn-xs btn-outline-primary" type="button"><i class="fas fa-sync-alt"></i></button>
                        </span>
                    </div>
                </div>
                <!-- 非初次登入變更密碼不用個資同意函 -->
                <div class="form-group">
                    <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
                        請先閱讀個資同意函
                    </button>
                </div>
			</div>

            <div class="d-grid mt-4">

                <!-- 完成個資同意函拿掉 disabled -->
                <button class="btn btn-lg btn-primary" type="button" disabled>送出</button>
            </div>
            <div class="up-solid"><a href="#"><i class="fas fa-long-arrow-alt-left"></i> 返回登入</a></div>
		</div>
	</div>
</div>

<!-- Modal -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-consent modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">個資同意函</h1>
            </div>
            <div class="modal-body">
                <div class="modal-consent-block scrollbar-inner">
                    <p><%= lorem_paragraphs(2) %></p>
                    <p><%= lorem_paragraphs(2) %></p>
                    <p><%= lorem_paragraphs(3) %></p>
                    <p><%= lorem_paragraphs(2) %></p>
                    <p><%= lorem_paragraphs(2) %></p>
                </div>
                <div class="form-check mt-4 mb-2">
                    <input class="form-check-input" type="checkbox" value="" id="agreeConsent" disabled/>
                    <label class="form-check-label" for="agreeConsent">
                        我已詳細閱讀個資同意函並同意
                    </label>
                </div>
                <p>請閱讀全文，<span id="" class="sec-countdown text-danger">5</span> 秒後方可勾選</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-consent btn-primary" data-bs-dismiss="modal" disabled>確認</button>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>
<!-- sidenav scrollbar -->
<script src="../javascripts/jquery.scrollbar.min.js"></script>
<script>
jQuery(document).ready(function(){
    jQuery('.scrollbar-inner').scrollbar();

    var countdownTimer = null;
    var countdownSeconds = 5;
    var countdownStarted = false;

    // 當 modal 開啟時重設倒數狀態
    jQuery('#staticBackdrop').on('shown.bs.modal', function () {
        countdownStarted = false;
        jQuery('.sec-countdown').text(countdownSeconds);
        jQuery('#agreeConsent').prop('disabled', true).prop('checked', false);
        jQuery('.btn-consent').prop('disabled', true);
        if (countdownTimer) {
            clearInterval(countdownTimer);
            countdownTimer = null;
        }
    });

    // 監聽捲動事件
    jQuery('.scrollbar-inner').on('scroll', function() {
        var $this = jQuery(this);
        var scrollTop = $this.scrollTop();
        var innerHeight = $this.innerHeight();
        var scrollHeight = $this[0].scrollHeight;
        // 只有內容超過容器且有捲動才判斷
        if (scrollHeight > innerHeight && scrollTop > 0 && scrollTop + innerHeight >= scrollHeight - 1) {
            if (!countdownStarted) {
                countdownStarted = true;
                var $secCountdown = jQuery('.sec-countdown');
                var seconds = countdownSeconds;
                $secCountdown.text(seconds);
                countdownTimer = setInterval(function() {
                    seconds--;
                    $secCountdown.text(seconds);
                    if (seconds <= 0) {
                        clearInterval(countdownTimer);
                        jQuery('#agreeConsent').prop('disabled', false);
                    }
                }, 1000);
            }
        }
    });

    // 監聽同意函 checkbox
    jQuery('#agreeConsent').on('change', function() {
        if (jQuery(this).is(':checked')) {
            jQuery('.btn-consent').prop('disabled', false);
        } else {
            jQuery('.btn-consent').prop('disabled', true);
        }
    });
});
</script>
<% end %>

