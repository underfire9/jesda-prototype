<script>
document.addEventListener('DOMContentLoaded', function() {
    const audio = document.getElementById('manuscriptAudio');
    const fileInput = document.getElementById('mp3File');
    const audioSource = document.getElementById('audioSource');
    const deleteBtn = document.getElementById('button-mp3-delete');

    // 監聽檔案選擇
    fileInput.addEventListener('change', function(event) {
        const file = event.target.files[0];
        if (file) {
            // 檢查檔案是否為MP3格式
            if (file.type === 'audio/mpeg' || file.type === 'audio/mp3' || file.name.toLowerCase().endsWith('.mp3')) {
                const objectURL = URL.createObjectURL(file);
                audioSource.src = objectURL;
                audio.load();
                
                // 顯示音檔播放器和刪除按鈕
                audio.classList.remove('d-none');
                deleteBtn.classList.remove('d-none');
                
                // 不自動播放，只是載入
                console.log('MP3 檔案已載入');
            } else {
                // 如果不是MP3檔案，顯示錯誤訊息並清除選擇
                alert('請選擇MP3格式的音檔');
                fileInput.value = '';
            }
        }
    });

    // 監聽刪除按鈕
    deleteBtn.addEventListener('click', function() {
        // 清除檔案選擇
        fileInput.value = '';
        
        // 清除音源
        audioSource.src = '';
        audio.load();
        
        // 隱藏音檔播放器和刪除按鈕
        audio.classList.add('d-none');
        deleteBtn.classList.add('d-none');
        
        console.log('MP3 檔案已清除');
    });
});
</script>

