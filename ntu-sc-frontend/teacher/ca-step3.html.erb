<% content_for :js do %>

    <!-- 控制遠距課程檔案上傳區域顯示隱藏 -->
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const remoteRadio = document.getElementById('teachingRemote');
        const entityRadio = document.getElementById('teachingEntity');
        const uploadWrapper = document.querySelector('.upload-remote-wrapper');
        
        // 預設隱藏上傳區域
        if (uploadWrapper) {
            uploadWrapper.style.display = 'none';
        }
        
        // 監聽授課方式選項變化
        if (remoteRadio && entityRadio && uploadWrapper) {
            remoteRadio.addEventListener('change', function() {
                if (this.checked) {
                    uploadWrapper.style.display = 'block';
                }
            });
            
            entityRadio.addEventListener('change', function() {
                if (this.checked) {
                    uploadWrapper.style.display = 'none';
                }
            });
        }
    });
    </script>

    <!-- 控制教室名稱輸入區域顯示隱藏 -->
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const classroomUndetermined = document.getElementById('classroom_undetermined');
        const classroomDetermined = document.getElementById('classroom_determined');
        const classroomInout = document.querySelector('.classroom-inout');
        
        // 預設隱藏教室名稱輸入區域
        if (classroomInout) {
            classroomInout.style.display = 'none';
        }
        
        // 監聽上課教室選項變化
        if (classroomUndetermined && classroomDetermined && classroomInout) {
            classroomDetermined.addEventListener('change', function() {
                if (this.checked) {
                    classroomInout.style.display = 'inline-block';
                }
            });
            
            classroomUndetermined.addEventListener('change', function() {
                if (this.checked) {
                    classroomInout.style.display = 'none';
                }
            });
        }
    });
    </script>

    <!-- 儲存後開啟下一步 -->
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Get the save and next buttons
        const saveBtn = document.querySelector('.btn-save');
        const nextBtn = document.querySelector('.btn-next');
        
        console.log('Save button:', saveBtn);
        console.log('Next button:', nextBtn);
        
        if (saveBtn && nextBtn) {
            // Add click event listener to save button
            saveBtn.addEventListener('click', function () {
                console.log('Save button clicked');
                
                // 模擬儲存過程 (可以在這裡加入實際的儲存邏輯)
                // 顯示儲存中的狀態
                saveBtn.textContent = '儲存中...';
                saveBtn.disabled = true;
                
                // 模擬 API 呼叫延遲
                setTimeout(function() {
                    // 恢復按鈕狀態
                    saveBtn.textContent = '儲存';
                    saveBtn.disabled = false;
                    
                    // 啟用下一步按鈕
                    nextBtn.classList.remove('disabled');
                    nextBtn.style.pointerEvents = 'auto';
                    nextBtn.style.opacity = '1';
                    
                    console.log('Next button enabled');
                    
                    // 可選：顯示成功訊息
                    // alert('資料已儲存！');
                }, 1000); // 1秒後啟用下一步按鈕
            });
            
            // 防止在禁用狀態下點擊下一步按鈕
            nextBtn.addEventListener('click', function(e) {
                if (nextBtn.classList.contains('disabled')) {
                    e.preventDefault();
                    alert('請先點擊儲存按鈕儲存資料！');
                    return false;
                }
            });
        } else {
            console.error('Save or Next button not found');
        }
    });
    </script>

    <!-- Select2 -->
    <script src="../javascripts/select2.min.js"></script>
    <script>
    $( '#multiple-select-field' ).select2( {
        theme: "bootstrap-5",
        width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
        placeholder: $( this ).data( 'placeholder' ),
        closeOnSelect: false,
    } );
    $( '#school-select-field' ).select2( {
        theme: "bootstrap-5",
        width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
        placeholder: $( this ).data( 'placeholder' ),
    } );
    </script>

<% end %>

