<!-- template: 抽籤作業 - 統計人數 -->

<div class="container-lg">
    
    <div class="content-head">
        <h1>
            高雄市公設民營東區大智國小托嬰中心
            <span>抽籤作業</span>
        </h1>
    </div>
    
    <div class="content-body">
        <ul class="menu-item menu-date">
            <li>
                <span class="label">總報名人數</span>
                <span class="output">10 人</span>
            </li>
            <li>
                <span class="label">資格審核通過人數</span>
                <span class="output">10 人</span>
            </li>
            <li>
                <span class="label">總名額</span>
                <span class="output">100 人</span>
            </li>
        </ul>
        
        <h3 class="drawlots-h3">各身分別人數統計</h3>
        <h4 class="drawlots-h4">第一順位 : 保留名額 10 人</h4>
        <ul class="menu-item menu-date">
            <li>
                <span class="label">
                    優先序 1
                    <small>低收入戶、中低收入戶、本局服務中之脆弱家庭、兒童保護個案、特殊境遇家庭</small>
                </span>
                <span class="output">1 人</span>
            </li>
            <li>
                <span class="label">
                    優先序 2
                    <small>發展遲緩兒童、持有身心障礙證明之兒童</small>
                </span>
                <span class="output">1 人</span>
            </li>
            <li>
                <span class="label">
                    優先序 3
                    <small>單親家庭、未成年父母家庭</small>
                </span>
                <span class="output">1 人</span>
            </li>
            <li>
                <span class="label">
                    優先序 4
                    <small>家庭失功能之弱勢隔代教養家庭</small>
                </span>
                <span class="output">1 人</span>
            </li>
            <li>
                <span class="label">
                    優先序 5
                    <small>身心障礙者家庭</small>
                </span>
                <span class="output">1 人</span>
            </li>
            <li>
                <span class="label">
                    優先序 6
                    <small>原住民兒童、新住民家庭</small>
                </span>
                <span class="output">1 人</span>
            </li>
        </ul>

        <h4 class="drawlots-h4">第二順位 : 名額限制 10 人</h4>
        <ul class="menu-item menu-date">
            <li>
                <span class="label">
                    優先序 7
                    <small>提供辦理機構場地之學校或辦公大樓員工子女、社會住宅或機構建物所在之社區住戶子女及機構員工子女</small>
                </span>
                <span class="output">10 人</span>
            </li>
        </ul>

        <h4 class="drawlots-h4">第三順位 : 多胞胎名額限制 10 人</h4>
        <ul class="menu-item menu-date">
            <li>
                <span class="label">
                    優先序 8
                    <small>雙、多胞胎或家庭有兩名以上兄弟姐妹之兒童</small>
                </span>
                <span class="output">10 人</span>
            </li>
            <li>
                <span class="label">
                    優先序 9
                    <small>學區兒童</small>
                </span>
                <span class="output">10 人</span>
            </li>
            <li>
                <span class="label">
                    優先序 10
                    <small>本市兒童、一般家庭</small>
                </span>
                <span class="output">10 人</span>
            </li>
        </ul>
        <p class="form-text text-center mb-4">註 : 因身分別可複選，因此各身分別人數加總不等於資格審核通過人數</p>
        
        <button type="button" class="btn btn-xl btn-primary btn-start">開始抽籤</button>
    </div>
    
</div>



<% content_for :js do %>

<% end %>

