    <script>
    // 輪撥背景圖
    document.addEventListener("DOMContentLoaded", function () {
        function updateCarouselBackground() {
            document.querySelectorAll("#carouselHome .carousel-item").forEach(item => {
                let webImg = item.querySelector(".web-image");
                let mobileImg = item.querySelector(".mobile-image");
                let imgSrc = window.innerWidth > 1024 ? webImg.getAttribute("src") : mobileImg.getAttribute("src");
                
                if (imgSrc) {
                    item.style.backgroundImage = `url('${imgSrc}')`;
                    item.style.backgroundSize = "cover";
                    item.style.backgroundPosition = "center bottom";
                    webImg.style.display = "none";
                    mobileImg.style.display = "none";
                }
            });
        }
        
        updateCarouselBackground();
        window.addEventListener("resize", updateCarouselBackground);
    });    
    </script>

    <script>
    // 資源地圖
      document.addEventListener('DOMContentLoaded', function() {
                const mapLinks = document.querySelectorAll('.map-link');
        const testLink = document.querySelector('.test-link');
        const smElement = document.querySelector('.sm');
        const mlElement = document.querySelector('.ml');
        const carouselIndicators = document.querySelectorAll('#carouselRoadMap .carousel-indicators button');
        const rocket = document.querySelector('.rocket');
        const carouselItems = document.querySelectorAll('#carouselRoadMap .carousel-item');
        const mapItemLinks = document.querySelectorAll('.map-item-link');
        
        // 預先加入 .showup 類別
        const firstCarouselItem = document.querySelector('#carouselRoadMap .carousel-item.active');
        if (firstCarouselItem) {
          const mapItems = firstCarouselItem.querySelectorAll('.map-item li');
          mapItems.forEach(mapItem => {
            mapItem.classList.add('showup');
          });
        }

        mapLinks.forEach(link => {
          link.addEventListener('mouseover', function() {
            const span = this.querySelector('span');
            span.classList.add('link-blink');
          });
    
          link.addEventListener('mouseout', function() {
            const span = this.querySelector('span');
            span.classList.remove('link-blink');
          });
        });

        if (testLink) {
          testLink.addEventListener('mouseover', function() {
            if (smElement) smElement.classList.add('active');
            if (mlElement) mlElement.classList.add('active');
          });

          testLink.addEventListener('mouseout', function() {
            if (smElement) smElement.classList.remove('active');
            if (mlElement) mlElement.classList.remove('active');
          });
        }

        carouselIndicators.forEach(button => {
          button.addEventListener('click', function() {
            if (rocket) rocket.classList.add('launch');
            setTimeout(() => {
              if (rocket) rocket.classList.remove('launch');
            }, 1000);

            carouselItems.forEach(item => {
              const itemContent = item.querySelector('.item-content');
              if (itemContent) {
                itemContent.style.display = 'none';
                setTimeout(() => {
                  itemContent.style.display = 'block';
                  const mapItems = itemContent.querySelectorAll('.map-item li');
                  mapItems.forEach((mapItem, index) => {
                    mapItem.classList.remove('showup');
                    setTimeout(() => {
                      mapItem.classList.add('showup');
                    }, index * 50);
                  });
                }, 600);
              }
            });
          });
        });

        // 新增 hover 事件處理函式
        mapItemLinks.forEach(link => {
          link.addEventListener('mouseover', function() {
            this.classList.add('cyberpunk');
          });

          link.addEventListener('mouseout', function() {
            this.classList.remove('cyberpunk');
          });
        });
      });
    </script>

