<% content_for :title do %>Set your password<% end %>
<% content_for :title_key do %>setPassword.title<% end %>
<% content_for :page do %>setPassword<% end %>

<div class="container auth">
  <!-- 從信中連結進入；連結失效時（示範：?expired=1）顯示下方 expired 區塊 -->
  <section class="auth__card" aria-labelledby="page-title" data-link-valid>
    <div class="auth__head">
      <h1 class="auth__title" id="page-title" data-i18n="setPassword.title">Set your password</h1>
      <p class="auth__lead" data-i18n="setPassword.lead">Your email is verified. Choose a password to finish creating your account.</p>
    </div>

    <form class="auth__form" data-validate data-next="/account/declaration.html">
      <div class="field">
        <label class="field__label" for="set-email" data-i18n="common.email">Email</label>
        <input class="input" type="email" id="set-email" value="angela.winson@uw.edu" readonly>
      </div>

      <div class="field">
        <label class="field__label" for="set-new"><span data-i18n="password.new">New password</span><span class="field__req" aria-hidden="true">*</span></label>
        <input class="input" type="password" id="set-new" autocomplete="new-password" required data-password-new aria-describedby="set-rules">
      </div>

      <div class="field">
        <label class="field__label" for="set-confirm"><span data-i18n="password.confirm">Confirm new password</span><span class="field__req" aria-hidden="true">*</span></label>
        <input class="input" type="password" id="set-confirm" autocomplete="new-password" required data-matches="set-new">
      </div>

      <ul class="pw-rules" id="set-rules" data-pw-rules="set-new" aria-label="Password requirements" data-i18n-attr="aria-label:password.rulesLabel">
        <li data-rule="length" data-i18n="password.rule.length">At least 8 characters</li>
        <li data-rule="case" data-i18n="password.rule.case">Upper- and lowercase letters</li>
        <li data-rule="number" data-i18n="password.rule.number">At least one number</li>
        <li data-rule="special" data-i18n="password.rule.special">At least one special character (e.g. ! @ # $)</li>
      </ul>

      <button type="submit" class="btn btn--primary btn--block" data-i18n="setPassword.submit">Set password</button>
    </form>
  </section>

  <section class="auth__card" aria-labelledby="expired-title" data-link-expired hidden>
    <div class="auth__head">
      <h1 class="auth__title" id="expired-title" data-i18n="setPassword.expiredTitle">This link has expired</h1>
      <p class="auth__lead" data-i18n="setPassword.expiredBody">Each link can be used once and expires after 24 hours. Request a new one to continue.</p>
    </div>
    <a class="btn btn--primary btn--block" href="/account/register.html" data-i18n="setPassword.requestNew">Send a new link</a>
    <p class="auth__center">
      <a class="link" href="/account/login.html" data-i18n="common.backLogin">Back to log in</a>
    </p>
  </section>
</div>
