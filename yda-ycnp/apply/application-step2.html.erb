<!-- Sticky Step -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    var nav = document.querySelector('.process-step-inner');
    var navOffset = nav.getBoundingClientRect().top + window.pageYOffset;

    function onScroll() {
        if (window.pageYOffset > navOffset) {
            nav.style.position = 'fixed';
            nav.style.top = '0';
            nav.style.zIndex = '1000';
            nav.style.width = nav.offsetWidth + 'px';
        } else {
            nav.style.position = '';
            nav.style.top = '';
            nav.style.zIndex = '';
            nav.style.width = '';
        }
    }

    window.addEventListener('scroll', onScroll);
});
</script>

<!-- 選擇日期 flatpickr + monthSelect -->
<script src="../javascripts/flatpickr.js"></script>
<script src="../javascripts/monthselect.js"></script>
<script>
['#rocMonthStart', '#rocMonthEnd'].forEach(function(selector) {
    flatpickr(selector, {
        plugins: [
            new monthSelectPlugin({
                shorthand: true,
                dateFormat: "Y-m", // 儲存的值
                altFormat: "Y 年 m 月", // 顯示的值
                monthNames: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"],
            }),
        ],
        locale: {
            ...flatpickr.l10ns.zh,
            months: {
                shorthand: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"],
                longhand: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"]
            }
        },
        onChange: function (selectedDates, dateStr, instance) {
            const [y, m] = dateStr.split("-");
            instance.input.value = `${y} 年 ${parseInt(m)} 月`;
        },
    });
});
</script>

<!-- 經費項目 select2 -->
<script src="../javascripts/select2.min.js"></script>
<script>
$('#funding-select').select2({
    theme: "bootstrap-5",
    width: $(this).data('width') ? $(this).data('width') : $(this).hasClass('w-100') ? '100%' : 'style',
    placeholder: $(this).data('placeholder'),
    minimumResultsForSearch: Infinity // 隱藏搜尋框
});
</script>

<!-- 經費設定選擇其他秀 input -->
<script>
$(document).ready(function() {
    $('#funding-select').on('change', function() {
        if ($(this).val() === 'other') {
            $('.other-budget').show();
        } else {
            $('.other-budget').hide();
        }
    });
});
</script>
