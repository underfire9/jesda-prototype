        }
    })
</script>

<!-- PDF Viewer demo -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
    const pdfViewer = document.querySelector('.js-pdf-viewer')
    const pdfCanvasArea = pdfViewer.querySelector('.pdf-canvas-area')
    const pdfThumbnails = pdfViewer.querySelector('.pdf-thumbnails')
    const pdfPageInput = pdfViewer.querySelector('.js-pdf-page')
    const pdfPageCount = pdfViewer.querySelector('.js-pdf-page-count')
    const pdfPreviousButton = pdfViewer.querySelector('.js-pdf-previous')
    const pdfNextButton = pdfViewer.querySelector('.js-pdf-next')
    const pdfZoomValue = pdfViewer.querySelector('.js-pdf-zoom')
    let pdfDocument
    let currentPdfPage = 1
    let pdfZoom = 1
    let pdfRotation = 0

    const updatePdfControls = () => {
        pdfPageInput.value = currentPdfPage
        pdfPreviousButton.disabled = currentPdfPage === 1
        pdfNextButton.disabled = currentPdfPage === pdfDocument.numPages
        pdfZoomValue.textContent = `${Math.round(pdfZoom * 100)}%`
        pdfThumbnails.querySelectorAll('.pdf-thumbnail').forEach(thumbnail => {
            thumbnail.classList.toggle('is-active', Number(thumbnail.dataset.page) === currentPdfPage)
        })
    }

    const renderPdfPage = async pageNumber => {
        const page = await pdfDocument.getPage(pageNumber)
        const viewport = page.getViewport({ scale: pdfZoom, rotation: pdfRotation })
        const canvas = document.createElement('canvas')
        const context = canvas.getContext('2d')
        canvas.width = viewport.width
        canvas.height = viewport.height
        canvas.setAttribute('aria-label', `第 ${pageNumber} 頁`)
        await page.render({ canvasContext: context, viewport }).promise
        pdfCanvasArea.replaceChildren(canvas)
    }

    const showPdfPage = async pageNumber => {
        currentPdfPage = Math.min(Math.max(pageNumber, 1), pdfDocument.numPages)
        await renderPdfPage(currentPdfPage)
        updatePdfControls()
        pdfThumbnails.querySelector(`[data-page="${currentPdfPage}"]`).scrollIntoView({ block: 'nearest' })
    }

    const fitPdfWidth = async () => {
        const page = await pdfDocument.getPage(currentPdfPage)
        const unscaledViewport = page.getViewport({ scale: 1, rotation: pdfRotation })
        pdfZoom = Math.max(.5, (pdfCanvasArea.clientWidth - 64) / unscaledViewport.width)
        await showPdfPage(currentPdfPage)
    }

    const renderPdfThumbnails = async () => {
        const thumbnails = await Promise.all([...Array(pdfDocument.numPages)].map(async (_, index) => {
            const pageNumber = index + 1
            const page = await pdfDocument.getPage(pageNumber)
            const viewport = page.getViewport({ scale: .18 })
            const canvas = document.createElement('canvas')
            const context = canvas.getContext('2d')
            canvas.width = viewport.width
            canvas.height = viewport.height
            await page.render({ canvasContext: context, viewport }).promise
            const thumbnail = document.createElement('button')
            thumbnail.type = 'button'
            thumbnail.className = 'pdf-thumbnail'
            thumbnail.dataset.page = pageNumber
            thumbnail.setAttribute('aria-label', `前往第 ${pageNumber} 頁`)
            thumbnail.append(canvas, Object.assign(document.createElement('span'), { textContent: pageNumber }))
            thumbnail.addEventListener('click', () => showPdfPage(pageNumber))
            return thumbnail
        }))
        pdfThumbnails.replaceChildren(...thumbnails)
    }

    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js'
    pdfjsLib.getDocument(pdfViewer.dataset.pdfUrl).promise.then(async document => {
        pdfDocument = document
        pdfPageCount.textContent = document.numPages
        pdfPageInput.max = document.numPages
        pdfViewer.querySelector('.js-pdf-download').href = pdfViewer.dataset.pdfUrl
        await Promise.all([renderPdfThumbnails(), fitPdfWidth()])
    }).catch(() => {
        pdfCanvasArea.textContent = '無法載入 PDF 文件。'
        pdfThumbnails.textContent = '無可用縮圖。'
    })

    pdfPreviousButton.addEventListener('click', () => showPdfPage(currentPdfPage - 1))
    pdfNextButton.addEventListener('click', () => showPdfPage(currentPdfPage + 1))
    pdfPageInput.addEventListener('change', () => showPdfPage(Number(pdfPageInput.value)))
    pdfViewer.querySelector('.js-pdf-zoom-out').addEventListener('click', () => { pdfZoom = Math.max(.5, pdfZoom - .1); showPdfPage(currentPdfPage) })
    pdfViewer.querySelector('.js-pdf-zoom-in').addEventListener('click', () => { pdfZoom = Math.min(2.5, pdfZoom + .1); showPdfPage(currentPdfPage) })
    pdfViewer.querySelector('.js-pdf-fit').addEventListener('click', fitPdfWidth)
    pdfViewer.querySelector('.js-pdf-rotate').addEventListener('click', () => { pdfRotation = (pdfRotation + 90) % 360; showPdfPage(currentPdfPage) })
    pdfViewer.querySelector('.js-pdf-fullscreen').addEventListener('click', () => pdfViewer.requestFullscreen?.())
    pdfCanvasArea.addEventListener('keydown', event => {
        if (event.key === 'ArrowLeft') showPdfPage(currentPdfPage - 1)
        if (event.key === 'ArrowRight') showPdfPage(currentPdfPage + 1)
    })
</script>

<!-- 迴避時儲存按鈕 disabled -->
<script>
    const avoidSwitch = document.querySelector('#switchCheckavoid1')
    const saveButton = document.querySelector('#saveButton')

    const toggleSaveButton = () => {
        saveButton.disabled = avoidSwitch.checked
    }

    avoidSwitch.addEventListener('change', toggleSaveButton)
    toggleSaveButton()
</script>

<!-- is-invalid demo -->
<!-- 不確定要不要保留的功能 -->
<script>
    const validateRequiredControl = control => {
        const isScoreInput = control.matches('.score-group input[type="number"]')
        const isInvalid = !control.value.trim() || (isScoreInput && Number(control.value) === 0)
        control.classList.toggle('is-invalid', isInvalid)
    }

    document.querySelector('#saveButton').addEventListener('click', () => {
        document.querySelectorAll('.form-control[required]').forEach(control => {
            validateRequiredControl(control)
        })
    })

    document.querySelectorAll('.form-control[required]').forEach(control => {
        control.addEventListener('input', () => validateRequiredControl(control))
    })
</script>

<!-- Note inner 展開/收合 -->
<!-- 不確定要不要保留的功能 -->
<script>
    const itemNoteLimit = 128

    document.querySelectorAll('.note-inner').forEach(note => {
        const content = document.createElement('span')
        content.className = 'item-note-content'
        content.replaceChildren(...note.childNodes)

        const fullHtml = content.innerHTML
        const fullText = content.textContent.trim()
        const characters = Array.from(fullText)

        if (characters.length <= itemNoteLimit) {
            note.appendChild(content)
            return
        }

        const toggleButton = document.createElement('button')
        toggleButton.type = 'button'
        toggleButton.className = 'item-note-toggle'
        toggleButton.setAttribute('aria-label', '收合說明')
        toggleButton.title = '收合'
        toggleButton.setAttribute('aria-expanded', 'true')
        toggleButton.innerHTML = '<i class="fas fa-angle-up" aria-hidden="true"></i>'
        note.append(content, toggleButton)

        toggleButton.addEventListener('click', () => {
            const isCollapsed = note.classList.toggle('is-collapsed')
            if (isCollapsed) {
                content.textContent = `${characters.slice(0, itemNoteLimit).join('')}...`
            } else {
                content.innerHTML = fullHtml
            }
            toggleButton.setAttribute('aria-label', isCollapsed ? '展開完整說明' : '收合說明')
            toggleButton.title = isCollapsed ? '展開' : '收合'
            toggleButton.setAttribute('aria-expanded', String(!isCollapsed))
        })
    })
</script>

