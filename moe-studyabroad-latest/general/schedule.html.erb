<!-- template: 日程表 -->

<div class="container-lg">
    <div class="annual-content">
        <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
        <%= render :partial => "/partials/annual-aside" %>
        <main class="annual-main pt-0">
