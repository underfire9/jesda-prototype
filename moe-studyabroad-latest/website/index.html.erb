<!-- template: 首頁 (最新消息列表) -->

<div class="container-lg">
    <div class="annual-content">
        <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
        <%= render :partial => "/partials/annual-aside" %>
        <main class="annual-main">
            <h4 class="mb-4">歡迎來到國內大學校院自行選送人才出國研修服務網</h4>
            <div class="notice-wrapper">
                <h5>貼心叮嚀</h5>
                <ul>
                    <li>詐騙手法日新月異，請大家留意各種手法，本部統整了各國案例、處理方法(<a href="#">海外反詐騙宣導簡報</a>)，提醒大家，遇到請謹慎查證，保護自身安全。</li>
                    <li>為確實掌握選送生國外動向及安全，並給予適當協助，請各承辦人員及計畫主持人務必於出國前兩週依照學生實際出返國情形進行資料維護。</li>
                    <li>學生入境前請務必參考<a href="#">外交部領務局相關入境及簽證規定</a> (首頁>簽證>國人申請外國簽證>各國暨各地區簽證、旅遊及消費者保護資訊)。</li>
                    <li>各項計畫結餘款繳回支票受款人請填入：<span class="h4">國立臺灣科技大學403專戶</span></li>
                </ul>
            </div>
            <section class="section">
                <div class="section-title">
                    <h4>最新消息</h4>
                </div>
                <ul class="news-list menu-item">
                    <li class="news-item">
                        <a href="news-single.html" class="news-link">
                            <div class="news-date">
                                <span class="day">19</span>
                                <span class="inner-wrap">
                                    <span class="month">3月</span>
                                    <span class="year">2025</span>
                                </span>
                            </div>
                            <div class="news-minutiae">
                                <h4>教育部公布 114 年第 2 梯次學海計畫審查結果</h4>
                            </div>
                        </a>
                    </li>
                    <li class="news-item">
                        <a href="news-single.html" class="news-link">
                            <div class="news-date">
                                <span class="day">05</span>
                                <span class="inner-wrap">
                                    <span class="month">2月</span>
                                    <span class="year">2025</span>
                                </span>
                            </div>
                            <div class="news-minutiae">
                                <h4>115 年教育部學海計畫-要點說明簡報及系統操作說明簡報</h4>
                            </div>
                        </a>
                    </li>
                    <% (1..9).map do |i| %>
                    <li class="news-item">
                        <a href="news-single.html" class="news-link">
                            <div class="news-date">
                                <span class="day">2<%= i %></span>
                                <span class="inner-wrap">
                                    <span class="month"><%= i %>月</span>
                                    <span class="year">2025</span>
                                </span>
                            </div>
                            <div class="news-minutiae">
                                <h4><%= lorem_sentence %></h4>
                            </div>
                        </a>
                    </li>
                    <% end %>
                </ul>
            </section>
        </main>
    </div>
</div>

<% content_for :js do %>
    <!-- 根據螢幕寬度決定是否加入 offcanvas 類別 -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const updateOffcanvasClass = () => {
                const el = document.querySelector("#offcanvasAnnual");
                if (el) {
                    if (window.innerWidth < 992) {
                        el.classList.add("offcanvas");
                    } else {
                        el.classList.remove("offcanvas");
                    }
                }
            };

            updateOffcanvasClass();
            window.addEventListener("resize", updateOffcanvasClass);
        });
    </script>
<% end %>

