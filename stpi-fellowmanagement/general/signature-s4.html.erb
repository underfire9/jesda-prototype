                <button type="submit" class="btn btn-lg btn-primary">確認送出</button>
            </div>
        </div>
        <div class="qrcode-wrapper">
            <p>掃描 QR CODE 使用手機簽名</p>
            <div class="qrcode-image">
                <img src="../assets/fake/qrcode.svg">
            </div>
        </div>
