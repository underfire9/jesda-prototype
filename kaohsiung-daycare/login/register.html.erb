<!-- template: 註冊 -->

<div class="container-lg">
	<div class="login-wrapper">
		<div class="login-card">
		    <div class="card-hd">
			    <h3>註冊</h3>
			</div>
			<div class="card-bd">
                <div class="form-group">
                    <label for="exampleFormControlInput1" class="form-label">信箱</label>
                    <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="name@example.com" />
                </div>
                <div class="form-group">
                    <label for="exampleFormControlInput2" class="form-label">密碼</label>
                    <input type="password" class="form-control" id="exampleFormControlInput2" />
                </div>
                <div class="form-group">
                    <label for="exampleFormControlInput3" class="form-label">再次輸入密碼</label>
                    <input type="password" class="form-control" id="exampleFormControlInput3" />
                </div>
                <div class="form-group">
                    <label for="loginInput4" class="form-label">驗證碼</label>
                    <div class="d-flex align-items-center">
                        <span class="me-1"><input type="text" class="form-control" id="loginInput4" /></span>
                        <span class="me-1"><img class="captcha" src="http://nfu-map.dev.com.tw/common/captcha.image" /></span>
                        <span>
                            <button class="btn btn-xs btn-outline-primary" type="button"><i class="fas fa-sync-alt"></i></button>
                        </span>
                    </div>
                </div>
			</div>
            <div class="d-grid my-4">
                <button class="btn btn-lg btn-primary" type="submit">送出</button>
            </div>
            <p class="register-line"><a href="#" title="返回登入">返回登入</a></p>
            <p class="forget-line">未收到驗證信 ? <a href="#" title="未收到驗證信">請按此</a></p>
		</div>
	</div>
</div>



