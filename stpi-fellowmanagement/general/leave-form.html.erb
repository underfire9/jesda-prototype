<!-- template: 請假申請 -->

<div class="container-lg">
    <div class="leave-container-head">
        <h2 class="mb-0 fw-light">請假作業</h2>
    </div>
    <div class="request-form-wrapper">
        <div class="notice-wrapper">
            <p><%= zh_lorem_paragraph %></p>
        </div>
        <form action="#" method="post">
            <div class="form-group">
                <label class="form-label"><span class="required">*</span> 請假日期</label>
                <div class="range-wrap">
                    <div class="date-inner"><input type="date" id="leaveDateStart" name="leaveDateStart" class="form-control"></div>
                    <div class="text-center">至</div>
                    <div class="date-inner"><input type="date" id="leaveDateEnd" name="leaveDateEnd" class="form-control"></div>
                </div>
                <div class="d-flex gap-3 form-text mt-2">
                    <span>共計：<strong>1</strong> 天</span>
                    <span>剩餘免扣款請假天數：<strong>3</strong> 天</span>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label"><span class="required">*</span> 請假類型</label>
                <div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="leaveType" id="leaveTypeReturn" value="return" checked>
                        <label class="form-check-label" for="leaveTypeReturn">返回我國</label>
                        <div class="form-text">返回我國說明文字說明文字說明文字說明文字說明文字</div>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="leaveType" id="leaveTypeThird" value="third_country">
                        <label class="form-check-label" for="leaveTypeThird">前往第三國</label>
                        <div class="form-text">前往第三國說明文字說明文字說明文字說明文字說明文字</div>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="leaveType" id="leaveTypeCustom" value="custom">
                        <label class="form-check-label" for="leaveTypeCustom">自定義請假類型</label>
                        <div class="form-text">自定義請假類型說明文字說明文字說明文字說明文字說明文字</div>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label for="leaveCountry" class="form-label">前往國家</label>
                <select id="leaveCountry" name="leaveCountry" class="form-select">
                    <option value="taiwan">台灣</option>
                    <option value="japan">日本</option>
                    <option value="usa">美國</option>
                </select>
            </div>
            <div class="form-group">
                <label for="leaveReason" class="form-label"><span class="required">*</span> 請假原因</label>
                <textarea id="leaveReason" name="leaveReason" class="form-control" rows="3"></textarea>
            </div>
            <div class="upload-wrapper fluid-wrapper">
                <!-- 檔案上傳後多出 .file-pill，當再次上傳時則覆蓋上一筆，點選檔名另開視窗觀看文件 -->
                <div class="upload-item border-0 p-0">
                    <div class="mb-3">
                        <label for="SupportingFile" class="form-label">相關證明文件</label>
                        <input class="form-control" type="file" id="SupportingFile">
                        <div class="form-text">檔案格式限制 : pdf、jpg、png、gif，檔案大小限制 : 10MB</div>
                    </div>
                    <div class="ft-action">
                        <span>
                            <div class="file-pill">
                                <!-- 避免檔名過長有限制最大寬度 256px，超出時會字元會省略 -->
                                <a href="#" target="_blank" class="filename"><%= lorem_sentence %>.pdf</a>
                                <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-action">
                <button type="button" class="btn btn-lg btn-outline-primary">暫存</button>
                <button type="submit" class="btn btn-lg btn-primary">送出申請</button>
            </div>
        </form>
    </div>
</div>



<% content_for :js do %>

<% end %>

