<!-- template: 學生 / 課程討論 -->
<div class="alert alert-primary alert-dismissible fade show portal-alert" role="alert">
    <div class="container-lg">
        開放討論時間： 2025-06-01 (日) 12:00 ~ 2025-11-29 (六) 23:55
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
</div>
<div class="page-content">
    <div class="container-lg">
        <div class="page-title mobile-only">
            <h3>課程討論</h3>
        </div>
        <div class="row">
            <div class="col-lg-3">
                <div class="mb-3">
                    <select class="form-select w-auto" aria-label="選擇年度">
                        <option selected>115</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
                <div class="mb-3">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="課程名稱、開課學校" aria-label="Recipient’s username" aria-describedby="button-addon2">
                        <button class="btn btn-outline-secondary" type="button" id="button-addon2"><i class="fas fa-search"></i></button>
                    </div>
                </div>
                <div class="mb-3">blah blah <%= lorem_sentence %></div>
            </div>
            <div class="col-lg-9">
                <div class="row">
                    <% (1..3).map do |i| %>
                    <div class="col-md-6">
                        <div class="border rounded-3 p-4 mb-4">
                            <h4 class="mb-4">程式理解與軟體創作統合</h4>
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">課程編號</span>
                                <span class="d-block">25N002</span>
                            </div>
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">授課教師</span>
                                <span class="d-block has-multiple-values">
                                    <span><%= zh_lorem_name %></span>
                                    <span><%= zh_lorem_name %></span>
                                    <span><%= zh_lorem_name %></span>
                                </span>
                            </div>
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">助教</span>
                                <span class="d-block">
                                    <span class="d-inline-block me-1"><%= zh_lorem_name %></span>
                                    <span class="d-inline-block me-1">, <%= zh_lorem_name %></span>
                                </span>
                            </div>
                            <div class="border-bottom py-2">
                                <span class="d-block text-secondary fs-6">課程類別</span>
                                <span class="d-block">C類一般類</span>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <div class="border-bottom py-2">
                                        <span class="d-block text-secondary fs-6">上課人數</span>
                                        <span class="d-block">43</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border-bottom py-2">
                                        <span class="d-block text-secondary fs-6">討論筆數</span>
                                        <span class="d-block">12</span>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex gap-2 flex-wrap justify-content-center mt-4">
                                <a href="#" class="btn btn-sm btn-outline-primary">
                                    <span>大綱</span>
                                </a>
                                <a href="#" class="btn btn-sm btn-outline-primary">
                                    <span>公告</span>
                                </a>
                                <a href="#" class="btn btn-sm btn-outline-primary">
                                    <span>講義下載</span>
                                </a>
                                <a href="#" class="btn btn-sm btn-outline-primary">
                                    <span>上傳作業</span>
                                </a>
                                <a href="#" class="btn btn-sm btn-outline-primary">
                                    <span>討論</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

