                                    <button type="button" class="btn btn-warning btn-add-video" title="新增一筆"><i class="fas fa-plus"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div-->
                <div class="form-group">
                    <label for="additional_info" class="form-label">其他補充資料</label>
                    <textarea class="form-control" id="additional_info" rows="3"></textarea>
                    <div class="form-text text-muted">資料若無法寫入本欄位，得於本欄位列出資料名稱後獨立檢附</div>
                </div>
                <div class="form-action">
                    <a href="ca-step3.html" class="btn btn-outline-dark btn-lg btn-prev"><i class="fas fa-long-arrow-alt-left fs-6 me-1"></i> 上一步</a>
                    <!-- 儲存後判斷欄位沒問題拿掉下一步按鈕的 disabled，下方 js 須加入判斷邏輯 -->
                    <!-- 回上一步頁面中的下一步就不需要再給 disabled，相關判斷 js 麻煩前端處理 -->
                    <button type="button" class="btn btn-main btn-lg btn-save">儲存</button>
                    <a href="ca-step5.html" class="btn btn-primary btn-lg btn-next disabled">下一步 <i class="fas fa-long-arrow-alt-right fs-6 ms-1"></i></a>
                </div>
            </main>
        </div>
    </div>
</div>

<% content_for :js do %>

    <!-- 勾選開啟隱藏 input -->
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const suggestionRadio = document.getElementById('suggestion');
        const noRequirementRadio = document.getElementById('no_requirement');
        const suggestionWrapper = document.querySelector('.suggestion-input-wrapper');
        
        if (suggestionRadio && suggestionWrapper) {
            suggestionRadio.addEventListener('change', function() {
                if (this.checked) {
                    suggestionWrapper.style.display = 'block';
                }
            });
            
            noRequirementRadio.addEventListener('change', function() {
                if (this.checked) {
                    suggestionWrapper.style.display = 'none';
                }
            });
        }
    });
    </script>

    <!-- 儲存後開啟下一步 -->
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Get the save and next buttons
        const saveBtn = document.querySelector('.btn-save');
        const nextBtn = document.querySelector('.btn-next');
        
        console.log('Save button:', saveBtn);
        console.log('Next button:', nextBtn);
        
        if (saveBtn && nextBtn) {
            // Add click event listener to save button
            saveBtn.addEventListener('click', function () {
                console.log('Save button clicked');
                
                // 模擬儲存過程 (可以在這裡加入實際的儲存邏輯)
                // 顯示儲存中的狀態
                saveBtn.textContent = '儲存中...';
                saveBtn.disabled = true;
                
                // 模擬 API 呼叫延遲
                setTimeout(function() {
                    // 恢復按鈕狀態
                    saveBtn.textContent = '儲存';
                    saveBtn.disabled = false;
                    
                    // 啟用下一步按鈕
                    nextBtn.classList.remove('disabled');
                    nextBtn.style.pointerEvents = 'auto';
                    nextBtn.style.opacity = '1';
                    
                    console.log('Next button enabled');
                    
                    // 可選：顯示成功訊息
                    // alert('資料已儲存！');
                }, 1000); // 1秒後啟用下一步按鈕
            });
            
            // 防止在禁用狀態下點擊下一步按鈕
            nextBtn.addEventListener('click', function(e) {
                if (nextBtn.classList.contains('disabled')) {
                    e.preventDefault();
                    alert('請先點擊儲存按鈕儲存資料！');
                    return false;
                }
            });
        } else {
            console.error('Save or Next button not found');
        }
    });
    </script>

<% end %>

