<!-- template: 學校聯絡人 - 計畫申請/近三年內薦送學校計畫執行情形 -->
<% content_for :header_center do %>
    <span class="central-title">近三年內薦送學校計畫執行情形</span>
<% end %>

<div class="container">
    <div class="page-content">
        <div class="detail-sync-wrapper">
            <div class="detail-section">
                <label class="detail-sync-label">近三年內薦送學校獲學海築夢計畫獎助及執行情形</label>
                <div>
                    <% (1..5).map do |i| %>
                    <div class="detail-card">
                        <div class="card-hd"><span>115</span></div>
                        <div class="card-bd">
                            <div class="original-pane bd-pane">
                                <div class="pane-hd">原計畫</div>
                                <div class="pane-bd">
                                    <div class="item-info">
                                        <div class="item-value">
                                            <div class="plan-name">深度學習於MRI高場影像應用發展實習計畫</div>
                                            <div class="plan-leader" title="主持人"><i class="fas fa-microphone me-2"></i> <%= zh_lorem_name %></div>
                                        </div>
                                    </div>
                                    <div class="item-info">
                                        <span class="item-label">選送人數(師/生)</span>
                                        <div class="item-value">
                                            <div class="output">老師 1 名</div>
                                            <div class="output">
                                                學生 5 名
                                                <small>包括原住民生<strong>1</strong>名、新住民生<strong>1</strong>名</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="item-info">
                                        <span class="item-label">實習機構</span>
                                        <div class="item-value">日本自然科學研究機構生理學研究所(National Institute of Physiological Sciences, National Institutes of Natural Sciences, Japan)</div>
                                    </div>
                                    <div class="item-info">
                                        <span class="item-label">實習期程</span>
                                        <div class="item-value">2025-05-31 ~ 2026-04-01</div>
                                    </div>
                                </div>
                            </div>
                            <div class="actual-pane bd-pane">
                                <div class="pane-hd">實際執行</div>
                                <div class="pane-bd">
                                    <div class="item-info">
                                        <div class="item-value">
                                            <div class="plan-name">深度學習於MRI高場影像應用發展實習計畫</div>
                                            <div class="plan-leader" title="主持人"><i class="fas fa-microphone me-2"></i> <%= zh_lorem_name %></div>
                                        </div>
                                    </div>
                                    <div class="item-info">
                                        <span class="item-label">選送人數(師/生)</span>
                                        <div class="item-value">
                                            <div class="output">老師 1 名</div>
                                            <div class="output">
                                                學生 5 名
                                                <small>包括原住民生<strong>1</strong>名、新住民生<strong>1</strong>名</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="item-info">
                                        <span class="item-label">實習機構</span>
                                        <div class="item-value">日本自然科學研究機構生理學研究所(National Institute of Physiological Sciences, National Institutes of Natural Sciences, Japan)</div>
                                    </div>
                                    <div class="item-info">
                                        <span class="item-label">實習期程</span>
                                        <div class="item-value">2025-05-31 ~ 2026-04-01</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-ft">
                            <div class="item-info">
                                <span class="item-label">教育部核定補助金額</span>
                                <div class="item-value"><strong>2,240,000</strong></div>
                            </div>
                            <div class="item-info">
                                <span class="item-label">實際支用金額</span>
                                <div class="item-value">
                                    <div class="amount">教育部: <strong>227,303</strong> 元</div>
                                    <div class="amount">學校與其他: <strong>45,460</strong> 元</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% end %>
                </div>
            </div>
            <div class="detail-section">
                <label class="detail-sync-label" for="domestic-international-linkage"><span class="required">*</span>國內學校與國外實習機構後續連結效益、對學生未來發展性等實際成效</label>
                <textarea id="domestic-international-linkage" class="form-control" rows="5" placeholder="請填寫內容"></textarea>
                <div class="form-text">若無資料請填「無」</div>
            </div>
            <div class="detail-section">
                <label class="detail-sync-label" for="plan-change-difference"><span class="required">*</span>變更各計畫所提預定實習人數或機構之次數、原申請書填報之實習機構與實際實習機構之差異</label>
                <textarea id="plan-change-difference" class="form-control" rows="5" placeholder="請填寫內容"></textarea>
                <div class="form-text">若無資料請填「無」</div>
            </div>
        </div>
        <div class="form-action">
            <span class="backhome">
                <a href="apply.html" class="btn btn-lg btn-light">
                    <i class="fas fa-long-arrow-alt-left"></i>
                    <span class="md-none">回上一頁</span>
                </a>
            </span>
            <button type="button" class="btn btn-lg btn-primary px-4">儲存</button>
        </div>
    </div>
</div>

<% content_for :js do %>
<% end %>

