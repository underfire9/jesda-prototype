<!-- template: 審查委員 - 審查列表 -->

<div class="container-lg">
	<div class="committee-review-container">
        <div class="review-list-wrapper">
            <div class="wrapper-aside">
                <h3 class="aside-title fw-light"><strong class="fw-bold">期中</strong>報告審查</h3>
                <div class="nav nav-review flex-column" id="v-review-tab" role="tablist" aria-orientation="vertical">
                    <button class="nav-link active" id="reviewPendingTab" data-bs-toggle="pill" data-bs-target="#reviewPending" type="button" role="tab" aria-controls="reviewPending" aria-selected="true">待審查清單</button>

                    <button class="nav-link" id="reviewHistoryTab" data-bs-toggle="pill" data-bs-target="#reviewHistory" type="button" role="tab" aria-controls="reviewHistory" aria-selected="false">歷史紀錄</button>
                </div>
                <div class="aside-search">
                    <div class="input-group">
                        <input type="text" class="form-control" id="reviewSearchInput" placeholder="搜尋" />
                        <button class="btn btn-outline-secondary" type="button" id="button-review-search"><i class="fas fa-search"></i></button>
                    </div>
                </div>
                <div class="aside-web-only">
                    <a href="#" class="btn btn-lg btn-link go-home"><i class="fas fa-long-arrow-alt-left me-2"></i> 返回</a>
                </div>
            </div>
            <div class="wrapper-main">
                <div class="tab-content" id="v-review-tabContent">
                    <div class="tab-pane fade show active" id="reviewPending" role="tabpanel" aria-labelledby="reviewPendingTab" tabindex="0">
                        <ul class="menu-item review-list">
                            <% (1..8).map do |i| %>
                            <li class="review-list-item">
                                <a href="#" class="review-item-link">
                                    <span class="item-status">初審</span>
                                    <div class="item-hd">
                                        <h4 class="item-title"><%= lorem_sentence %></h4>
                                    </div>
                                    <div class="item-bd">
                                        <span class="tiered"><span>第一梯次</span></span>
                                        <span class="applicant"><%= zh_lorem_name %></span>
                                        <span class="sent-time">2025-12-12 12:00</span>
                                    </div>
                                </a>
                            </li>
                            <% end %>
                        </ul>
                        <div class="link-mobile-only">
                            <a href="#" class="btn btn-lg btn-link go-home"><i class="fas fa-long-arrow-alt-left me-2"></i> 返回</a>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="reviewHistory" role="tabpanel" aria-labelledby="reviewHistoryTab" tabindex="0">
                        <ul class="menu-item review-list">
                            <% (1..6).map do |i| %>
                            <li class="review-list-item">
                                <a href="#" class="review-item-link">
                                    <span class="item-status">通過</span>
                                    <div class="item-hd">
                                        <h4 class="item-title"><%= lorem_sentence %></h4>
                                    </div>
                                    <div class="item-bd">
                                        <span class="tiered"><span>第一梯次</span></span>
                                        <span class="applicant"><%= zh_lorem_name %></span>
                                        <span class="sent-time">2025-12-12 12:00</span>
                                    </div>
                                </a>
                            </li>
                            <% end %>
                        </ul>
                        <div class="link-mobile-only">
                            <a href="#" class="btn btn-lg btn-link go-home"><i class="fas fa-long-arrow-alt-left me-2"></i> 返回</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
	</div>
</div>

<% content_for :js do %>

<% end %>

