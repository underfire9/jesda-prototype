<!-- template: 新聞稿件 - 審查 -->
<div class="page-content">
    <div class="container-lg">

        <div class="manuscript-content-container new-manuscript-container">

            <aide class="manuscript-aide-content">
                <div class="page-title">
                    <h3>審查稿件</h3>
                </div>
                <div class="form-review-group">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reviewStatus" id="reviewStatus1" checked />
                        <label class="form-check-label" for="reviewStatus1">
                            審查中
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reviewStatus" id="reviewStatus2" />
                        <label class="form-check-label" for="reviewStatus2">
                            通過
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reviewStatus" id="reviewStatus3" />
                        <label class="form-check-label" for="reviewStatus3">
                            通過並由主管複審
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reviewStatus" id="reviewStatus4" />
                        <label class="form-check-label" for="reviewStatus4">
                            退回
                        </label>
                    </div>
                </div>
                <div class="review-timing">
                    <span class="review-timing-label" title="審查時間"></span>
                    <span class="review-timing-value"><span class="review-timing-value-sec"></span> 秒</span>
                </div>
                <div class="btn-wrap review-btn-wrap">
                    <a href="manuscript-review.html" class="btn btn-lg btn-main btn-review-submit disabled">送出</a>
                    <button type="button" class="btn btn-white btn-word-download" title="轉存 Word"></button>
                    <button type="button" class="btn btn-lg btn-white btn-backward" title="審查歷程" data-bs-toggle="modal" data-bs-target="#historyModal"></button>
                </div>
            </aide>

            <div class="manuscript-content">
                <form action="manuscript-view.html" method="post">
                    <div class="row">
                        <div class="col-md-10">
                            <div class="form-group">
                                <label class="form-label" for="manuscript_title">標題 <span class="required">*</span></label>
                                <input type="text" class="form-control" id="manuscript_title" placeholder="稿件標題">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-2">
                            <div class="form-group">
                                <label class="form-label" for="manuscript_reporter">記者</label>
                                <select class="form-select" id="manuscript_reporter" disabled>
                                    <option>請選擇</option>
                                    <option value="1" selected>陳曉明</option>
                                    <option value="2">Two</option>
                                    <option value="3">Three</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="manuscriptDate">新聞日期 <span class="required">*</span></label>
                                <div id="manuscriptDate"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">稿件類型 <span class="required">*</span></label>
                                <div class="pt-2">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="manuscriptTypeOptions" id="manuscriptTypeDry" value="option1" />
                                        <label class="form-check-label" for="manuscriptTypeDry">乾稿 (無音檔)</label>
                                    </div>

                                    <!-- 勾選話帶下方的音檔上傳會出現必填星號，調整 id 時務必修改 js -->
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="manuscriptTypeOptions" id="manuscriptTypeTape" value="option2" />
                                        <label class="form-check-label" for="manuscriptTypeTape">話帶 (有音檔)</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="manuscriptTypeOptions" id="manuscriptTypeAnchor" value="option3" />
                                        <label class="form-check-label" for="manuscriptTypeAnchor">主播乾稿</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">

                            <!-- 勾選否，下方來源、分類、發布時間的星號會拿掉，調整 id 時務必修改 js -->
                            <div class="form-group">
                                <label class="form-label">是否上傳官網 <span class="required">*</span></label>
                                <div class="pt-2">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="uploadOfficial" id="uploadOfficialYes" value="option1" checked />
                                        <label class="form-check-label" for="uploadOfficialYes">是</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="uploadOfficial" id="uploadOfficialNo" value="option2" />
                                        <label class="form-check-label" for="uploadOfficialNo">否</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label">審查設定 <span class="required">*</span></label>
                                <div class="pt-2">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="inlineRadioOptions3" id="inlineRadio6" value="option1" disabled />
                                        <label class="form-check-label" for="inlineRadio6">無需審查</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="inlineRadioOptions3" id="inlineRadio7" value="option2" checked disabled />
                                        <label class="form-check-label" for="inlineRadio7">需審查</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="hr-content" />
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="manuscript_resource">來源 <span class="required">*</span></label>
                                <select class="form-select" id="manuscript_resource">
                                    <option>請選擇</option>
                                    <option value="1" selected>我自己</option>
                                    <option value="2">網路抄來的</option>
                                    <option value="3">其他</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="manuscript_category">分類 <span class="required">*</span></label>
                                <select class="form-select" id="manuscript_category">
                                    <option selected>請選擇</option>
                                    <option value="1">A</option>
                                    <option value="2">B</option>
                                    <option value="3">C</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-label" for="manuscript_tags">新聞標籤</label>
                                <select class="form-select" id="manuscript_tags" data-placeholder="選擇標籤" multiple>
                                    <optgroup label="2025 川普關稅政策">
                                        <option>2025 南喬治亞島和南桑威奇群島</option>
                                        <option>南蘇丹</option>
                                        <option>牙買加</option>
                                        <option>肯尼亞</option>
                                        <option>法屬圭亞那</option>
                                        <option>馬約特</option>
                                    </optgroup>
                                    <optgroup label="花蓮馬太鞍溪堰塞湖">
                                        <option>列支敦士登</option>
                                        <option>丹麥</option>
                                        <option>厄利垂亞</option>
                                        <option>直布羅陀</option>
                                        <option>聖赫勒拿、亞森松和特里斯坦-達庫尼亞</option>
                                        <option>海地</option>
                                        <option>納米比亞</option>
                                    </optgroup>
                                    <optgroup label="教育改革">
                                        <option>南喬治亞島和南桑威奇群島</option>
                                        <option>越南</option>
                                        <option>也門</option>
                                        <option>菲律賓</option>
                                        <option>貝南</option>
                                        <option>捷克共和國</option>
                                        <option>俄羅斯</option>
                                    </optgroup>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="manuscript_Release">官網發佈時間 <span class="required">*</span></label>
                                <div id="manuscript_Release"></div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" value="" id="checkReviewRelease" />
                                    <label class="form-check-label fw-light" for="checkReviewRelease">
                                        以最後審查通過時間為發佈時間
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="hr-content" />
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-label" for="manuscript_intro">導言 <span class="required">*</span></label>
                                <textarea class="form-control" id="manuscript_intro" rows="4"></textarea>
                                <div class="form-text">常用標點符號 : 《》「」〈〉，。</div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-label" for="manuscript_content">內文 <span class="required">*</span></label>
                                <textarea class="form-control" id="manuscript_content" rows="12"></textarea>
                                <div class="form-text">常用標點符號 : 《》「」〈〉，。</div>
                            </div>
                        </div>
                    </div>
                    <hr class="hr-content" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group form-group-mp3">
                                <label for="mp3File" class="form-label">音檔上傳 <small class="text-secondary">mp3 only</small> <span class="required d-none">*</span></label>
                                <div class="input-group">
                                    <input class="form-control" type="file" id="mp3File" aria-describedby="button-mp3-delete"/>
                                    <button class="btn btn-delete d-none" type="button" id="button-mp3-delete" title="清除檔案"></button>
                                </div>
                                <audio id="manuscriptAudio" controls class="manuscript-audio d-none">
                                    <source id="audioSource" src="" type="audio/mpeg">
                                    您使用的瀏覽器不支援音檔撥放
                                </audio>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="manuscript_video">Youtube 影片</label>
                                <input type="text" class="form-control" id="manuscript_video" placeholder="影片連結">
                            </div>
                        </div>
                    </div>
                    <hr class="hr-content" />

                    <!-- 圖片輸出解析度必須符合官網 1200x800 -->
                    <div>
                        <label class="form-label" for="manuscript_image">圖片上傳</label>
                        <div class="row photo-upload-row">
                            <div class="col-md-6 upload-item">
                                <div class="form-group">
                                    <div class="upload-cropper-wrapper">
                                        <div class="image-preview-box" id="image-preview-box">
                                            <span class="placeholder">圖片預覽區 (3:2)</span>
                                            <img id="image-preview" src="" alt="圖片說明">
                                            <button id="delete-btn" class="btn btn-danger btn-delete" title="刪除圖片"></button>
                                            <div class="cover-check" title="設為封面">
                                                <input class="form-check-input" type="radio" name="radioCover" id="radioCover1">
                                            </div>
                                        </div>
                                        <div class="button-group">
                                            <label for="image-input" class="btn btn-select-image" title="選擇圖片"><span>選擇圖片</span></label>
                                            <input type="file" id="image-input" accept="image/*" class="d-none">
                                            <a href="../assets/fake/cut-01.jpg" target="_blank" title="下載" class="btn btn-download"></a>
                                            <input type="text" class="form-control" id="imageDesc" placeholder="請輸入圖片說明">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

        </div>

    </div>
</div>

