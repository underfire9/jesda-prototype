            { stage: 2, id: "26D045", name: "哲學與公共事務",   type: "A類", mode: "實體課程", school: "國立臺灣大學", teacher: "劉俊義",
              range: "2026/07/13 ~ 2026/08/17", time: "週一 10:10-12:00（共6次）", place: "臺大 社科院 302教室",
              credit: 2, fee: "NT1,400", status: :gaveup,  label: "已放棄錄取", note: "放棄日期：2026/05/19" },
            { stage: 2, id: "26N019", name: "語言與人生",       type: "C類", mode: "同步遠距", school: "國立臺灣大學", teacher: "林怡安",
              range: "2026/07/06 ~ 2026/07/31", time: "週一、三、五 13:20-16:20（共9次）", place: "線上（同步遠距）",
              credit: 3, fee: "NT2,100", status: :overdue, label: "逾期未繳費", note: "繳費期限：2026/05/20 23:59", note2: "（已取消錄取資格）" },
        ]
        csr_icons = { paid: "fa-check-circle", pending: "fa-exclamation-circle", gaveup: "fa-minus-circle", overdue: "fa-times-circle" }

        csr_stage1 = [
            { rank: 1, id: "26M038", name: "探索星空",           teacher: "黃星明",         ok: true },
            { rank: 2, id: "26N057", name: "永續發展與國際貿易", teacher: "陳明哲、吳佩珊", ok: false },
            { rank: 3, id: "26N010", name: "多元文化與社會正義", teacher: "張書瑜",         ok: false },
