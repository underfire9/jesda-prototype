<!-- template: playground Two -->

<div class="playground-container">
    <div class="playground play-two"></div>
</div>


<% content_for :js do %>

<script src="https://cdn.jsdelivr.net/npm/three@0.154.0/build/three.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    var container = document.querySelector('.play-two');
    if (!container) return;
    // 建立 threejs canvas
    var threeCanvas = document.createElement('div');
    threeCanvas.id = 'threejs-canvas';
    threeCanvas.style.position = 'absolute';
    threeCanvas.style.left = '0';
    threeCanvas.style.top = '0';
    threeCanvas.style.width = '100%';
    threeCanvas.style.height = '100%';
    container.appendChild(threeCanvas);
    var width = container.offsetWidth;
    var height = container.offsetHeight;
    var renderer = new THREE.WebGLRenderer({ alpha: true });
    renderer.setSize(width, height);
    threeCanvas.appendChild(renderer.domElement);

    var scene = new THREE.Scene();
    var camera = new THREE.OrthographicCamera(0, width, height, 0, 1, 1000);
    camera.position.z = 10;

    var circleCount = 6;
    var minRadiusRatio = .75, maxRadiusRatio = 1;
    var minDuration = 20, maxDuration = 40;
    var minScale = 0.75, maxScale = 1.5;
    var colors = [
        '#FF6B6B', '#FFD93D', '#6BCB77', '#4D96FF', '#FF6F91',
        '#845EC2', '#FFC75F', '#F9F871', '#0081CF', '#B39CD0'
    ];

    function hexToRgb(hex) {
        var c = hex.replace('#','');
        if (c.length === 3) c = c[0]+c[0]+c[1]+c[1]+c[2]+c[2];
        var r = parseInt(c.substring(0,2),16);
        var g = parseInt(c.substring(2,4),16);
        var b = parseInt(c.substring(4,6),16);
        return [r,g,b];
    }

    // 取不重複顏色
    var usedColors = colors.slice(0);
    var circles = [];
    for (var i = 0; i < circleCount; i++) {
        var radius = (minRadiusRatio + Math.random() * (maxRadiusRatio-minRadiusRatio)) * Math.min(width, height) / 2;
        var colorIdx = Math.floor(Math.random() * usedColors.length);
        var color = usedColors.splice(colorIdx, 1)[0];
        var duration = (minDuration + Math.random() * (maxDuration-minDuration)) * 1000;
        var centerAlpha = 0.4 + Math.random() * 0.3; // 中心透明度可調
        var pathType = Math.random() > 0.5 ? 'circle' : 'lissajous';
        var startAngle = Math.random() * Math.PI * 2;
        var maxPathRadius = Math.min(
          width/2 - radius,
          height/2 - radius
        );
        var pathParams;
        if (pathType === 'circle') {
            // 圓形路徑，中心點與半徑都要保證圓不超出區塊
            var cx = radius + Math.random() * (width - 2*radius);
            var cy = radius + Math.random() * (height - 2*radius);
            var r = Math.min(maxPathRadius, Math.random() * (maxPathRadius*0.8) + maxPathRadius*0.2);
            pathParams = {
                cx: cx,
                cy: cy,
                r: r,
                startAngle: startAngle
            };
        } else {
            // Lissajous 路徑，中心點與半徑都要保證圓不超出區塊
            var a = Math.floor(Math.random()*2)+1;
            var b = Math.floor(Math.random()*2)+1;
            var cx = radius + Math.random() * (width - 2*radius);
            var cy = radius + Math.random() * (height - 2*radius);
            var r = Math.min(maxPathRadius, Math.random() * (maxPathRadius*0.8) + maxPathRadius*0.2);
            pathParams = {
                cx: cx,
                cy: cy,
                r: r,
                a: a,
                b: b,
                delta: startAngle
            };
        }
        // 建立漸層 canvas texture
        var canvas = document.createElement('canvas');
        canvas.width = 256; canvas.height = 256;
        var ctx = canvas.getContext('2d');
        var grad = ctx.createRadialGradient(128,128,0,128,128,128);
        var rgb = hexToRgb(color);
        grad.addColorStop(0, 'rgba('+rgb[0]+','+rgb[1]+','+rgb[2]+','+centerAlpha+')');
        grad.addColorStop(0.5, 'rgba('+rgb[0]+','+rgb[1]+','+rgb[2]+',0)');
        grad.addColorStop(1, 'rgba('+rgb[0]+','+rgb[1]+','+rgb[2]+',0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(128,128,128,0,Math.PI*2);
        ctx.fill();
        var texture = new THREE.CanvasTexture(canvas);
        var geometry = new THREE.CircleGeometry(radius, 64);
        var material = new THREE.MeshBasicMaterial({
            map: texture,
            transparent: true,
            opacity: 1,
            depthWrite: false
        });
        var mesh = new THREE.Mesh(geometry, material);
        mesh.position.z = 0;
        scene.add(mesh);
        circles.push({
            mesh, radius, color, duration, centerAlpha, pathType, pathParams,
            scale: minScale + Math.random() * (maxScale-minScale),
            scaleDir: Math.random() > 0.5 ? 1 : -1,
            scaleSpeed: (0.5 + Math.random()) / duration * 10000,
            start: performance.now(),
            startAngle: startAngle
        });
    }

    function animate(now) {
        for (var i = 0; i < circles.length; i++) {
            var circle = circles[i];
            var t = ((now - circle.start) % circle.duration) / circle.duration;
            var angle = t * Math.PI * 2 + circle.startAngle;
            var x, y;
            if (circle.pathType === 'circle') {
                x = circle.pathParams.cx + circle.pathParams.r * Math.cos(angle);
                y = circle.pathParams.cy + circle.pathParams.r * Math.sin(angle);
            } else {
                x = circle.pathParams.cx + circle.pathParams.r * Math.sin(circle.pathParams.a * angle + circle.pathParams.delta);
                y = circle.pathParams.cy + circle.pathParams.r * Math.sin(circle.pathParams.b * angle);
            }
            var scale = circle.scale + circle.scaleDir * Math.sin(angle) * (maxScale-minScale)/2;
            scale = Math.max(minScale, Math.min(maxScale, scale));
            circle.mesh.position.x = x;
            circle.mesh.position.y = height-y;
            circle.mesh.scale.set(scale, scale, 1);
        }
        renderer.render(scene, camera);
        requestAnimationFrame(animate);
    }
    animate(performance.now());
    window.addEventListener('resize', function() {
        var width = container.offsetWidth;
        var height = container.offsetHeight;
        renderer.setSize(width, height);
        camera.right = width;
        camera.top = height;
        camera.updateProjectionMatrix();
    });
});
</script>

<% end %>

