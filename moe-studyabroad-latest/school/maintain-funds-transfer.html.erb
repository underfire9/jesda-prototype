<!-- Bootstrap tooltip -->
<script>
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
</script>

<!-- Execution status behavior -->
<script>
    const confirmModalEl = document.getElementById('executionStatusConfirmModal')
    const nextApplicationModalEl = document.getElementById('fundsApplyModal')
    const confirmModal = confirmModalEl ? new bootstrap.Modal(confirmModalEl) : null
    const nextApplicationModal = nextApplicationModalEl ? new bootstrap.Modal(nextApplicationModalEl) : null
    const confirmBtn = document.getElementById('executionStatusConfirmBtn')
    let pendingChange = null
    let lastConfirmedCard = null

    const getCurrentStatus = (card) => {
        const checked = card.querySelector('input[type="radio"][name^="executionStatus"]:checked')
        return checked ? checked.value : null
    }

    const setCardStatus = (card, value) => {
        const target = card.querySelector(`input[type="radio"][name^="executionStatus"][value="${value}"]`)
        if (target) {
            target.checked = true
        }
    }

    const setLastStatus = (card, value) => {
        if (value) {
            card.dataset.lastStatus = value
        } else {
            delete card.dataset.lastStatus
        }
    }

    const updateInfoGroupVisibility = (card) => {
        const infoGroup = card.querySelector('.info-group')
        const notExecuted = card.querySelector('input[type="radio"][value="option2"]')
        if (!infoGroup || !notExecuted) {
            return
        }
        infoGroup.style.display = notExecuted.checked ? 'none' : ''
    }

    const initializeInfoGroupVisibility = () => {
        document.querySelectorAll('.funds-transfer-list .item-card').forEach((card) => {
            setLastStatus(card, getCurrentStatus(card))
            updateInfoGroupVisibility(card)
        })
    }

    const handleStatusChange = (event) => {
        const radio = event.target
        if (!radio.matches('input[type="radio"][name^="executionStatus"]')) {
            return
        }
        const card = radio.closest('.item-card')
        if (!card) {
            return
        }

        const previousStatus = card.dataset.lastStatus
        const nextStatus = radio.value

        if (nextStatus === 'option2' && previousStatus === 'option1') {
            pendingChange = { card, previousStatus, nextStatus }
            if (confirmModal) {
                confirmModal.show()
            }
            return
        }

        updateInfoGroupVisibility(card)
        setLastStatus(card, nextStatus)
    }

    if (confirmBtn) {
        confirmBtn.addEventListener('click', () => {
            if (!pendingChange) {
                return
            }
            updateInfoGroupVisibility(pendingChange.card)
            setLastStatus(pendingChange.card, pendingChange.nextStatus)
            lastConfirmedCard = pendingChange.card
            pendingChange = null
            if (confirmModal) {
                confirmModal.hide()
            }
            if (nextApplicationModal) {
                nextApplicationModal.show()
            }
        })
    }

    if (confirmModalEl) {
        confirmModalEl.addEventListener('hidden.bs.modal', () => {
            if (!pendingChange) {
                return
            }
            setCardStatus(pendingChange.card, pendingChange.previousStatus)
            updateInfoGroupVisibility(pendingChange.card)
            setLastStatus(pendingChange.card, pendingChange.previousStatus)
            pendingChange = null
        })
    }

    if (nextApplicationModalEl) {
        nextApplicationModalEl.addEventListener('hidden.bs.modal', () => {
            if (!lastConfirmedCard) {
                return
            }
            setCardStatus(lastConfirmedCard, 'option1')
            updateInfoGroupVisibility(lastConfirmedCard)
            setLastStatus(lastConfirmedCard, 'option1')
            lastConfirmedCard = null
        })
    }

    initializeInfoGroupVisibility()
    document.addEventListener('change', handleStatusChange)
</script>

<!-- PDF upload behavior -->
<script>
(function () {
    const MAX_SIZE = 100 * 1024 * 1024; // 100 MB
    const dropZone    = document.getElementById('dropZone');
    const fileInput   = document.getElementById('fileInput');
    const browseBtn   = document.getElementById('browseBtn');
    const dndIdle     = document.getElementById('dndIdle');
    const dndPreview  = document.getElementById('dndPreview');
    const dndFilename = document.getElementById('dndFilename');
    const dndFilesize = document.getElementById('dndFilesize');
    const removeBtn   = document.getElementById('removeFileBtn');
    const viewInline  = document.getElementById('viewInlineBtn');
    const viewNewTab  = document.getElementById('viewNewTabBtn');
    const pdfPreview  = document.getElementById('pdfInlinePreview');
    const pdfIframe   = document.getElementById('pdfIframe');
    const pdfLabel    = document.getElementById('pdfInlineFilename');
    const closePrev   = document.getElementById('closePdfPreview');

    let currentObjectUrl = null;

    if (!dropZone || !fileInput) {
        return;
    }

    function formatSize(bytes) {
        if (bytes >= 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB';
        return (bytes / 1024).toFixed(0) + ' KB';
    }

    function setFile(file) {
        if (!file) return;
        if (file.type !== 'application/pdf') {
            alert('請上傳 PDF 格式的檔案。');
            return;
        }
        if (file.size > MAX_SIZE) {
            alert('檔案大小超過 100 MB，請重新選擇。');
            return;
        }
        if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
        currentObjectUrl = URL.createObjectURL(file);
        dndFilename.textContent = file.name;
        dndFilesize.textContent = formatSize(file.size);
        dndIdle.hidden    = true;
        dndPreview.hidden = false;
        // Close inline preview when new file is selected
        hidePdfPreview();
    }

    function clearFile() {
        if (currentObjectUrl) {
            URL.revokeObjectURL(currentObjectUrl);
            currentObjectUrl = null;
        }
        fileInput.value = '';
        dndIdle.hidden    = false;
        dndPreview.hidden = true;
        hidePdfPreview();
    }

    function hidePdfPreview() {
        pdfPreview.hidden = true;
        pdfIframe.src = '';
    }

    // Click to browse
    browseBtn.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('click', (e) => {
        if (e.target === dropZone || e.target === dndIdle) fileInput.click();
    });

    fileInput.addEventListener('change', () => {
        if (fileInput.files[0]) setFile(fileInput.files[0]);
    });

    // Drag & Drop
    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('dnd-hover');
    });
    dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('dnd-hover');
    });
    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dnd-hover');
        const file = e.dataTransfer.files[0];
        if (file) setFile(file);
    });

    // Actions
    removeBtn.addEventListener('click', clearFile);

    viewInline.addEventListener('click', () => {
        if (!currentObjectUrl) return;
        pdfIframe.src = currentObjectUrl;
        pdfLabel.textContent = dndFilename.textContent;
        pdfPreview.hidden = false;
        pdfPreview.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    viewNewTab.addEventListener('click', () => {
        if (currentObjectUrl) window.open(currentObjectUrl, '_blank');
    });

    closePrev.addEventListener('click', hidePdfPreview);
})();
</script>

<% end %>

