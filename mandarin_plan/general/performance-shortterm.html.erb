<!-- template: 績效 - 短期華語文研習團 -->

<div class="container-lg">
    <div class="project-title performance-title">
        <h3><span>年度 112，第 2 季績效回報</span></h3>
        <div class="university">
            <span class="ch">加州大學爾灣分校</span>
            <span class="en">University of California, Irvine</span>
        </div>
    </div>
</div>

<div class="container-lg">
	<div class="page-content performance-content">
	    <aside class="aside">
			<div class="scrollbar-inner">
		        <div class="sidenav">
                    <ul class="side-navigation menu-item">
                        <li>
							<a class="nav-item" href="#">
							    <span class="link-inner">績效基本資料</span>
							</a>
						</li>
						<li>
							<a class="nav-item" href="#">
								<span class="link-inner">選任華語教學赴任情形</span>
							</a>
						</li>
						<li>
							<a class="nav-item" href="#">
								<span class="link-inner">獎學金生研習情形</span>
							</a>
						</li>
                        <li>
							<a class="nav-item current" href="#">
								<span class="link-inner">短期華語文研習團</span>
							</a>
						</li>
						<li>
							<a class="nav-item" href="#">
								<span class="link-inner">大手攜小手辦理情形</span>
							</a>
						</li>
						<li>
							<a class="nav-item" href="#">
								<span class="link-inner">其他必辦項目辦理情形</a></span>
							</a>
						</li>
                    </ul>
				</div>
			</div>
            <div class="procedures_nav-ft">
                <a href="" class="btn btn-lg btn-block btn-primary">送出本季績效回報</a>
            </div>
		</aside>
		<main class="main">
            <div class="mb-8">
                <div class="section-title">
                    <h4>前一季短期華語文研習團</h4>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover text-nowrap text-center align-middle">
                        <thead>
                            <tr>
                                <th>編號</th>
                                <th>人數</th>
                                <th>人員明細</th>
                                <th>來臺日期</th>
                                <th>離臺日期</th>
                                <th>來台週數</th>
                                <th class="text-start">課堂使用教材</th>
                                <th class="text-start">說明</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (1..4).map do |i| %>
                            <tr>
                                <td><%= i %></td>
                                <td><%= i %>0</td>
                                <td><a href="#" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#studentListModal">瀏覽</a></td>
                                <td>2024-06-04</td>
                                <td>2024-06-18</td>
                                <td>2</td>
                                <td class="text-start">當代中文課程/教師講義</td>
                                <td class="text-start text-wrap" style="min-width:200px;"><%= lorem_words(4) %></td>
                            </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mb-8">
                <div class="section-title">
                    <h4>本季新增短期華語文研習團</h4>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover text-center text-nowrap align-middle">
                        <thead>
                            <tr>
                                <th></th>
                                <th>編號</th>
                                <th>人數</th>
                                <th>來臺日期</th>
                                <th>離臺日期</th>
                                <th>來臺週數</th>
                                <th class="text-start">課堂使用教材</th>
                                <th class="text-start">說明</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (1..4).map do |i| %>
                            <tr>
                                <td>
                                    <a href="#" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#shortTermListModal">編輯</a>
                                    <a href="#" class="btn btn-sm btn-outline-danger">刪除</a>
                                </td>
                                <td><%= i %></td>
                                <td>100</td>
                                <td>2024-06-04</td>
                                <td>2024-08-04</td>
                                <td>2</td>
                                <td class="text-start">當代中文課程、教師講義</td>
                                <td class="text-start text-wrap" style="min-width:200px;"><%= lorem_sentence %></td>
                            </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
                <div class="text-start">
                    <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#shortTermListModal"><i class="fas fa-plus"></i> 新增一筆人員</button>
                </div>
            </div>

            <div class="mb-8">
                <div class="section-title">
                    <h4>本季新增短期華語文研習團成員名單</h4>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover text-nowrap align-middle">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="text-center">所屬團別</th>
                                <th>身分別</th>
                                <th>姓名</th>
                                <th>社會性別</th>
                                <th>國籍</th>
                                <th>就讀科系</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (1..4).map do |i| %>
                            <tr>
                                <td>
                                    <a href="#" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#shortTermMemberModal">編輯</a>
                                    <a href="#" class="btn btn-sm btn-outline-danger">刪除</a>
                                </td>
                                <td class="text-center"><%= i %></td>
                                <td>資深研究生</td>
                                <td><%= lorem_name %></td>
                                <td>女性</td>
                                <td>阿爾巴尼亞</td>
                                <td><%= lorem_sentence %></td>
                            </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
                <div class="text-start">
                    <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#shortTermMemberModal"><i class="fas fa-plus"></i> 新增一筆人員</button>
                </div>
            </div>
		</main>
	</div>
</div>

<!-- 學生名單 Modal -->
<div class="modal fade" id="studentListModal" tabindex="-1" aria-labelledby="studentListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="studentListModalLabel">學生名單</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-hover text-nowrap align-middle">
                        <thead>
                            <tr>
                                <th class="text-center">序號</th>
                                <th class="text-center">編號</th>
                                <th>身分別</th>
                                <th>姓名</th>
                                <th>社會性別</th>
                                <th>國籍</th>
                                <th>就讀科系</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (1..40).map do |i| %>
                            <tr>
                                <td class="text-center"><%= i %></td>
                                <td class="text-center">0<%= i %></td>
                                <td>研究生</td>
                                <td><%= zh_lorem_name %></td>
                                <td>男性</td>
                                <td>波士尼亞與赫塞哥維納</td>
                                <td>中文系</td>
                            </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- 短期華語文研習團 Modal -->
<div class="modal fade" id="shortTermListModal" tabindex="-1" aria-labelledby="shortTermListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="shortTermListModalLabel">短期華語文研習團</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row"> 
                    <div class="col-6">
                        <div class="mb-4">
                            <label for="shortTermListForm1" class="form-label"><span class="required">*</span>編號</label>
                            <input type="text" class="form-control" id="shortTermListForm1" />
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-6">
                        <div class="mb-4">
                            <label class="form-label"><span class="required">*</span>來臺日期</label>
                            <input type="date" class="form-control" id="performanceBasic5" name="" min="2025-06-01" max="2025-12-31">
                        </div>
                    </div>
                    
                    <div class="col-6">
                        <div class="mb-4">
                            <label class="form-label"><span class="required">*</span>離臺日期</label>
                            <input type="date" class="form-control" id="performanceBasic5" name="" min="2025-06-01" max="2025-12-31">
                            <span class="form-text">若尚未確認離臺日期，請以預估日期填寫</span>
                        </div>
                    </div>
                    
                    <div class="col-12">
                        <div class="mb-4">
                            <label class="form-label" for="shortTermListForm2"><span class="required">*</span>課堂使用教材</label>
                            <input type="text" class="form-control" id="shortTermListForm2" />
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="mb-4">
                            <label for="takeOfficeForm3" class="form-label">說明</label>
                            <input type="text" class="form-control" id="takeOfficeForm3" placeholder="未達 10 人原因說明" />
                            <div class="form-text">有填寫才允許新增人數小於 10</div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="button" class="btn btn-primary">儲存</button>
            </div>
        </div>
    </div>
</div>

<!-- 短期華語文研習團成員名單 Modal -->
<div class="modal fade" id="shortTermMemberModal" tabindex="-1" aria-labelledby="shortTermMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="shortTermMemberModalLabel">短期華語文研習團人員名單</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row"> 
                    <div class="col-6">
                        <div class="mb-4">
                            <label class="form-label"><span class="required">*</span>所屬團別</label>
                            <select class="form-select" aria-label="Default select example">
                                <option selected>Open this select menu</option>
                                <option value="1">One</option>
                                <option value="2">Two</option>
                                <option value="3">Three</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="mb-4">
                            <label class="form-label"><span class="required">*</span>身分別</label>
                            <div class="pt-2">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="positionOptions" id="positionRadio1" value="option1" />
                                    <label class="form-check-label" for="positionRadio1">學生</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="positionOptions" id="positionRadio2" value="option2" />
                                    <label class="form-check-label" for="positionRadio2">老師</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="mb-4">
                            <label class="form-label" for="shortTermListForm2"><span class="required">*</span>姓名</label>
                            <input type="text" class="form-control" id="shortTermListForm2" />
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="mb-4">
                            <label class="form-label"><span class="required">*</span>社會性別</label>
                            <div class="pt-2">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="genderOptions" id="genderRadio1" value="option1" />
                                    <label class="form-check-label" for="genderRadio1">男性</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="genderOptions" id="genderRadio2" value="option2" />
                                    <label class="form-check-label" for="genderRadio2">女性</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="genderOptions" id="genderRadio3" value="option3" />
                                    <label class="form-check-label" for="genderRadio3">其他</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="mb-4">
                            <label class="form-label" for="shortTermListForm3"><span class="required">*</span>國籍</label>
                            <input type="text" class="form-control" id="shortTermListForm3" />
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="mb-4">
                            <label class="form-label" for="shortTermListForm4"><span class="required">*</span>就讀科系</label>
                            <input type="text" class="form-control" id="shortTermListForm4" />
                        </div>
                    </div>
                </div>
                
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="button" class="btn btn-primary">儲存</button>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>

<% end %>
