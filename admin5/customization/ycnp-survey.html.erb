<% content_for :js do %>

    <script>
        function updateGroupBdState(groupBd) {
            const hasItems = groupBd.querySelector('.item-question') !== null;
            groupBd.classList.toggle('has-items', hasItems);
        }

        function updateHdEndVisibility() {
            const wrapper = document.querySelector('.questionnaire-wrapper');
            if (!wrapper) return;
            const groups = wrapper.querySelectorAll('.questionnaire-group');
            const isSingle = groups.length === 1;
            groups.forEach(function (group) {
                const hdEnd = group.querySelector('.hd-end');
                if (hdEnd) hdEnd.style.display = isSingle ? 'none' : '';
            });
        }

        function initGroupBdDragSort(groupBd) {
            let dragItem = null;
            let fromHandle = false;

            groupBd.querySelectorAll('.item-question').forEach(function (item) {
                item.draggable = true;
            });

            groupBd.addEventListener('mousedown', function (e) {
                fromHandle = !!e.target.closest('.drag-area');
            });

            groupBd.addEventListener('dragstart', function (e) {
                const item = e.target.closest('.item-question');
                if (!item || !fromHandle) { e.preventDefault(); return; }
                dragItem = item;
                e.dataTransfer.effectAllowed = 'move';
                setTimeout(function () { dragItem.classList.add('is-dragging'); }, 0);
            });

            groupBd.addEventListener('dragend', function () {
                if (dragItem) dragItem.classList.remove('is-dragging');
                dragItem = null;
                fromHandle = false;
            });

            groupBd.addEventListener('dragover', function (e) {
                e.preventDefault();
                if (!dragItem) return;
                const target = e.target.closest('.item-question');
                if (!target || target === dragItem) return;
                const rect = target.getBoundingClientRect();
                const insertBefore = e.clientY < rect.top + rect.height / 2;
                groupBd.insertBefore(dragItem, insertBefore ? target : target.nextElementSibling);
            });
        }

        document.querySelectorAll('.questionnaire-group-bd').forEach(function (groupBd) {
            updateGroupBdState(groupBd);
            initGroupBdDragSort(groupBd);

            const observer = new MutationObserver(function () {
                updateGroupBdState(groupBd);
            });
            observer.observe(groupBd, { childList: true, subtree: true });
        });

        const wrapperInner = document.querySelector('.questionnaire-wrapper-inner');
        if (wrapperInner) {
            updateHdEndVisibility();
            const wrapperObserver = new MutationObserver(updateHdEndVisibility);
            wrapperObserver.observe(wrapperInner, { childList: true });

            wrapperInner.addEventListener('click', function (e) {
                const btnUp = e.target.closest('.btn-up');
                const btnDown = e.target.closest('.btn-down');
                if (!btnUp && !btnDown) return;

                const group = e.target.closest('.questionnaire-group');
                if (!group) return;

                if (btnUp) {
                    const prev = group.previousElementSibling;
                    if (prev && prev.classList.contains('questionnaire-group')) {
                        wrapperInner.insertBefore(group, prev);
                    }
                } else {
                    const next = group.nextElementSibling;
                    if (next && next.classList.contains('questionnaire-group')) {
                        wrapperInner.insertBefore(next, group);
                    }
                }
            });
        }
    </script>
<% end %>

