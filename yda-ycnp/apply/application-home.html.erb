<!-- template: 申請 - 申請首頁 -->

<div class="container-lg">
    <div class="application-wrapper">
        <h2 class="head-title">114 申請階段</h2>
        <div class="home-container">
            <div class="container-start">
                <div class="application-info">
                    <h4>申請作業</h4>
                    <ul class="menu-item info-list">
                        <li>
                            <span class="label">開放申請時間</span>

                            <!-- 數字與文字之間請留空格 -->
                            <span class="output">2025 年 11 月 1 日 ~ 2026 年 2 月 28 日</span>
                        </li>
                        <li>
                            <span class="label">送出時間</span>
                            <span class="output">2025 / 12 / 28 12:32</span>
                        </li>
                        <li>
                            <span class="label">申請結果公告日期</span>
                            <span class="output">2026 / 03 / 15 18:00</span>
                        </li>
                        <li>
                            <span class="label">目前狀態</span>
                            <span class="output status h4">

                                <!-- 初審中、審查通過、初審不通過、已取消 -->
                                <!-- 只有申請人修正才須給錨點連結 -->
                                <a class="anchor-supplement" href="#application-supplement">補件</a>
                            </span>
                        </li>
                    </ul>
                    <div class="info-action">
                        <span>
                            <button class="btn btn-lg btn-outline-main px-4">瀏覽</button>
                        </span>
                        <button class="btn btn-lg btn-cancel">取消申請</button>
                    </div>
                </div>

                <!-- mt-5 demo 用，要拿掉 -->
                <div class="application-info mt-5">
                    <h4>申請作業</h4>
                    <ul class="menu-item info-list">
                        <li>
                            <span class="label">開放申請時間</span>

                            <!-- 數字與文字之間請留空格 -->
                            <span class="output">2025 年 11 月 1 日 ~ 2026 年 2 月 28 日</span>
                        </li>
                        <li>
                            <span class="label">送出時間</span>
                            <span class="output">2025 / 12 / 28 12:32</span>
                        </li>
                        <li>
                            <span class="label">申請結果公告日期</span>
                            <span class="output">2026 / 03 / 15 18:00</span>
                        </li>
                        <li>
                            <span class="label">目前狀態</span>
                            <span class="output">
                                <span class="d-inline-block badge text-bg-success fs-6">已送件</span>
                                <span class="d-inline-block badge text-bg-warning fs-6">電子簽章未完成</span>
                            </span>
                        </li>
                    </ul>
                    <div class="info-action">
                        <span>
                            <button class="btn btn-lg btn-outline-main px-4">瀏覽</button>
                            <button class="btn btn-lg btn-outline-primary px-4">前往電子簽章</button>
                        </span>
                        <button class="btn btn-lg btn-cancel">取消申請</button>
                    </div>
                </div>

                <div id="application-supplement" class="application-info supplement">
                    <h4>補件作業</h4>
                    <ul class="menu-item info-list">
                        <li class="border-0">
                            <span class="label">補件截止時間</span>
                            <span class="output fw-medium">2026 / 04 / 30</span>
                        </li>
                    </ul>
                    <button class="btn btn-lg btn-dark px-5 btn-supplement">補件</button>
                </div>
            </div>
            <div class="container-end">
                <div class="application-info consult">
                    <h5 class="fw-medium mb-4 text-dark-emphasis">諮詢輔導申請</h5>
                    <p>開放申請日期  2025 年 11 月 1 ~ 2026 年 6 月 10 日，每人可以申請次數上限 2 次</p>
                    <ul class="menu-item consult-list">
                        <li>
                            <span class="label">第 1 次申請</span>
                            <a href="#" class="output fw-medium">2025 / 12 / 28 12:32</a>
                        </li>
                    </ul>

                    <!-- 申請兩次時隱藏 -->
                    <div class="consult-action">
                        <a href="#" class="btn btn-lg">申請 <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>
<script>
document.addEventListener('DOMContentLoaded', function() {
    var anchor = document.querySelector('.anchor-supplement');
    var btnSupplement = document.querySelector('.btn-supplement');
    if (anchor && btnSupplement) {
        anchor.addEventListener('click', function(e) {
            e.preventDefault();
            // 滾動到補件區塊
            var target = document.getElementById('application-supplement');
            if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            // 補件按鈕動畫
            btnSupplement.classList.add('playing');
            setTimeout(function() {
                btnSupplement.classList.remove('playing');
            }, 2000);
        });
    }
});
</script>
<% end %>