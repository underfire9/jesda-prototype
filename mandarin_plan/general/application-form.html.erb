<!-- template: 申請 - 優華語計畫申請表 -->

<div class="container-lg">
	<div class="page-content d-block">
        <div class="project-title">
            <h3><span>115年第5-2期 教育部補助大學校院推動臺灣優華語計畫申請表</span></h3>
        </div>
        <div class="mb-8">
            <div class="row">
                <div class="col-6">
                    <div class="form-group">
                        <label for="formControlInput1" class="form-label">申請學校</label>
                        <input type="text" class="form-control" id="formControlInput1" value="國立成功大學" disabled readonly>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="formControlInput2" class="form-label"><span class="required">*</span>計畫名稱</label>
                        <input type="text" class="form-control" id="formControlInput2" value="115年優華語計畫" disabled readonly>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="formControlInput3" class="form-label"><span class="required">*</span>聯絡人(計畫主持人)姓名</label>
                        <input type="text" class="form-control" id="formControlInput3" value="依貳參" disabled readonly>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="formControlInput8" class="form-label">職稱</label>
                        <input type="email" class="form-control" id="formControlInput8" value="service@npm.gov.tw" disabled readonly>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="formControlInput4" class="form-label"><span class="required">*</span>電子郵件</label>
                        <input type="text" class="form-control" id="formControlInput4" value="123456789" disabled readonly>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="formControlInput5" class="form-label">聯絡電話(公務)</label>
                        <input type="text" class="form-control" id="formControlInput5" value="123456789" disabled readonly>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="formControlInput6" class="form-label">聯絡電話(手機)</label>
                        <input type="text" class="form-control" id="formControlInput6" value="國立成功大學" disabled readonly>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label class="form-label"><span class="required">*</span>學校</label>
                        <div>
                            <select class="js-basic-single select2bootstrap" name="university">
                                <option value="">0001 國立政治大學</option>
                                <option value="">0002 國立清華大學</option>
                                <option value="">0003 國立臺灣大學</option>
                                <option value="">0004 國立臺灣師範大學</option>
                                <option value="">0005 國立陽明交通大學</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="formControlInput8" class="form-label">科系</label>
                        <input type="text" class="form-control" id="formControlInput8">
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mb-8">
            <div class="section-title">
                <h4>國外合作大學</h4>
            </div>
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th class="text-center" scope="col">期程年度</th>
                        <th class="text-center" scope="col">案號</th>
                        <th scope="col">國外合作大學</th>
                        <th class="text-center" scope="col">所在國家</th>
                        <th scope="col">所在州別/地區</th>
                        <th scope="col">教育部駐境外機構</th>

                        <th class="text-center" scope="col">計畫工作項目 (必辦/選辦)</th>
                        <th class="text-center" scope="col">是否簽訂優華語計畫 MOU 或 MOA</th>
                    </tr>
                </thead>
                <tbody>
                    <% (1..3).map do |i| %>
                    <tr>
                        <th class="text-center" scope="row">5-2</th>
                        <td class="text-center">0<%= i %></td>
                        <td>
                            <span class="d-block">路易斯安那傑為大學</span>
                            <span class="d-block">Xavier University of Louisiana (XULA)</span>
                        </td>
                        <td class="text-center">美國</td>
                        <td>路易斯安那州</td>
                        <td>台北經濟文化代表處</td>
                        <td class="text-center">
                            4/1 <a href="#" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#workitemsModal">選擇工作項目</a>
                        </td>
                        <td class="text-center">
                            <div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="option1" />
                                    <label class="form-check-label" for="inlineRadio1">是</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="option2" />
                                    <label class="form-check-label" for="inlineRadio2">否</label>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <% end %>
                </tbody>
            </table>
            <div class="text-start">
                <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#schoolModal"><i class="fas fa-plus"></i> 新增一所合作學校</button>
            </div>
        </div>
        
        <div class="mb-8">
            <div class="section-title">
                <h4>海外華語教學中心申請</h4>
            </div>
            <div class="row">
                <div class="col-6">

                    <!-- 與後面欄位連動有勞工程師處理 -->
                    <div class="form-group">
                        <label class="form-label">是否申請設海外華語教學中心</label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="option1" />
                                <label class="form-check-label" for="inlineRadio1">是</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="option2" />
                                <label class="form-check-label" for="inlineRadio2">否</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label class="form-label">所屬合作學校</label>
                        <div>
                            <select class="form-select" aria-label="Default select example">
                                <option selected>Open this select menu</option>
                                <option value="1">One</option>
                                <option value="2">Two</option>
                                <option value="3">Three</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-start">
                <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#schoolModal"><i class="fas fa-plus"></i> 新增一所合作學校</button>
            </div>
        </div>
        
        <div class="form-action">
            <button type="button" class="btn btn-lg btn-primary">儲存</button>
            <button type="button" class="btn btn-lg btn-primary">完成註記並往下一作業 <i class="fas fa-long-arrow-alt-right"></i></button>
            <span class="backhome"><a href="#" class="btn btn-lg btn-link"><i class="fas fa-long-arrow-alt-left"></i> 回申請首頁</a></span>
        </div>
        
	</div>
</div>

<!-- Work items Modal -->
<div class="modal fade" id="workitemsModal" tabindex="-1" aria-labelledby="workitemsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="workitemsModalLabel">選擇工作項目</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h5>必辦項目(至少選4項)</h5>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 60px;">編號</th>
                            <th>必辦項目(至少選4項)</th>
                            <th class="text-center" style="width: 80px;">勾選</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% [
                            "由我國大學選送華語教學人員赴外國合作大學任教",
                            "設置「臺灣優華語獎學金」，鼓勵外國合作大學學業成績優良之在校學生來臺進行華語文研習",
                            "積極開設線上華語文課程，推廣華語文教材，並爭取外國合作大學相關學分採認",
                            "推廣及辦理我國華語文能力測驗(以下簡稱華測)或華測快篩測驗",
                            "選送華語文領域學者專家赴國外合作大學講學"
                        ].each_with_index do |item, idx| %>
                            <tr>
                                <td class="text-center"><%= ('A'.ord + idx).chr %></td>
                                <td><%= item %></td>
                                <td class="text-center">
                                    <input type="checkbox" name="workitems[]" value="<%= ('A'.ord + idx).chr %>">
                                </td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
                <h5>選辦項目</h5>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 60px;">編號</th>
                            <th>選辦項目</th>
                            <th class="text-center" style="width: 80px;">勾選</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% [
                            "優華語獎學金生在臺深度文化參訪活動",
                            "籌組外國合作大學來臺短期華語文研習團",
                            "線上學伴交流",
                            "交換華語及外語教學助理半年至1年(實體)",
                            "其他與臺灣優華語計畫相關之特色項目"
                        ].each_with_index do |item, idx| %>
                            <tr>
                                <td class="text-center"><%= ('A'.ord + idx).chr %></td>
                                <td><%= item %></td>
                                <td class="text-center">
                                    <input type="checkbox" name="workitems[]" value="<%= ('A'.ord + idx).chr %>">
                                </td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="button" class="btn btn-primary">儲存</button>
            </div>
        </div>
    </div>
</div>


<!-- School Modal -->
<div class="modal fade" id="schoolModal" tabindex="-1" aria-labelledby="schoolModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="schoolModalLabel">新增合作學校</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h4>112 年第 3 期合作學校</h4>
                <div class="form-group">
                    <label for="modalSchoolForm1" class="form-label"><span class="required">*</span>合作外國大學</label>
                    <input type="text" class="form-control" id="modalSchoolForm1" />
                    <span class="form-text">中文名稱</span>
                </div>
                <div class="form-group">
                    <label for="modalSchoolForm2" class="form-label"><span class="required">*</span>公司英文合作外國大學代表名稱</label>
                    <input type="text" class="form-control" id="modalSchoolForm2" />
                    <span class="form-text">英文名稱</span>
                </div>
                <div class="form-group">
                    <label for="modalSchoolForm3" class="form-label"><span class="required">*</span>學校網址</label>
                    <input type="text" class="form-control" id="modalSchoolForm3" />
                </div>
                <div class="form-group">
                    <label for="" class="form-label"><span class="required">*</span>合作外國大學所在國家</label>
                    <select class="form-select" aria-label="Default select example">
                        <option selected>Open this select menu</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="" class="form-label">合作外國大學所在州別/地區</label>
                    <select class="form-select" aria-label="Default select example">
                        <option selected>Open this select menu</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="" class="form-label">教育部駐境外機構/地區</label>
                    <select class="form-select" aria-label="Default select example">
                        <option selected>Open this select menu</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="button" class="btn btn-primary">儲存</button>
            </div>
        </div>
    </div>
</div>


<% content_for :js do %>
<script src="../javascripts/select2.min.js"></script>
<script>
$(document).ready(function() {
    $('.js-basic-single').select2();
});
</script>
<% end %>
