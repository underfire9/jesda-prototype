<% content_for :title do %>Change password<% end %>
<% content_for :title_key do %>changePassword.title<% end %>
<% content_for :page do %>changePassword<% end %>

<div class="container auth">
  <section class="auth__card" aria-labelledby="page-title">
    <div class="auth__head">
      <h1 class="auth__title" id="page-title" data-i18n="changePassword.title">Change password</h1>
      <p class="auth__lead" data-i18n="changePassword.lead">You will stay logged in on this device after the change.</p>
    </div>

    <form class="auth__form" data-validate data-toast="changePassword.done" data-next="/applications/index.html">
      <div class="field">
        <label class="field__label" for="change-current"><span data-i18n="password.current">Current password</span><span class="field__req" aria-hidden="true">*</span></label>
        <input class="input" type="password" id="change-current" autocomplete="current-password" required>
      </div>

      <div class="field">
        <label class="field__label" for="change-new"><span data-i18n="password.new">New password</span><span class="field__req" aria-hidden="true">*</span></label>
        <input class="input" type="password" id="change-new" autocomplete="new-password" required data-password-new aria-describedby="change-rules">
      </div>

      <div class="field">
        <label class="field__label" for="change-confirm"><span data-i18n="password.confirm">Confirm new password</span><span class="field__req" aria-hidden="true">*</span></label>
        <input class="input" type="password" id="change-confirm" autocomplete="new-password" required data-matches="change-new">
      </div>

      <ul class="pw-rules" id="change-rules" data-pw-rules="change-new" aria-label="Password requirements" data-i18n-attr="aria-label:password.rulesLabel">
        <li data-rule="length" data-i18n="password.rule.length">At least 8 characters</li>
        <li data-rule="case" data-i18n="password.rule.case">Upper- and lowercase letters</li>
        <li data-rule="number" data-i18n="password.rule.number">At least one number</li>
        <li data-rule="special" data-i18n="password.rule.special">At least one special character (e.g. ! @ # $)</li>
      </ul>

      <button type="submit" class="btn btn--primary btn--block" data-i18n="changePassword.submit">Update password</button>
    </form>

    <hr class="auth__divider">

    <p class="auth__center">
      <a class="link" href="/applications/index.html" data-i18n="common.cancel">Cancel</a>
    </p>
  </section>
</div>
