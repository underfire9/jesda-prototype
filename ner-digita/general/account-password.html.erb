<!-- template: 變更密碼 -->

<div class="page-content">
    <div class="login-card">
		<div class="card-hd">
			<h3>變更密碼</h3>
		</div>
        <div class="card-bd">
            <div class="form-group">
                <label for="exampleFormControlInput1" class="form-label">新密碼</label>
                <input type="password" class="form-control" id="exampleFormControlInput1" />
            </div>
            <div class="form-group">
                <label for="exampleFormControlInput2" class="form-label">確認密碼</label>
                <input type="password" class="form-control" id="exampleFormControlInput2" />
            </div>
            <div class="form-group">
                <label for="loginInput4" class="form-label">驗證碼</label>
                <div class="d-flex align-items-center">
                    <span class="me-1" style="width: 160px;"><input type="text" class="form-control" id="loginInput4" /></span>
                    <span class="me-1"><img class="captcha" src="http://nfu-map.dev.com.tw/common/captcha.image" /></span>
                    <span>
                        <button class="btn btn-outline-dark" type="button"><i class="fas fa-sync-alt"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="login-action d-grid">
            <button class="btn btn-lg btn-main btn-submit" type="button">送出</button>
        </div>
        <div class="bottom-link reloign-wrap" style="display: none;"><a href="#">使用新密碼登入</a></div>
    </div>
</div>


<% content_for :js do %>
<!--  變更密碼 -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnSubmit = document.querySelector('.btn-submit');
    const reloignWrap = document.querySelector('.reloign-wrap');
    
    btnSubmit.addEventListener('click', function() {
        reloignWrap.style.display = 'block';
    });
});
</script>
<% end %>

