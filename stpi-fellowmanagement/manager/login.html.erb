<!-- template: 主管考核 - 登入 -->

<div class="container-lg">
	<div class="login-wrapper manager-login">
		<div class="login-card">
		    <div class="card-hd">
			    <h3>主管考核登入</h3>
			</div>
            <p>請填寫圖形驗證碼後接收一次性驗證碼</p>
			<div class="card-bd">
                <div class="form-group">
                    <label class="form-label">您的姓名</label>
                    <!-- 去識別 -->
                    <div class="output to-identify">
                        王曉明
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">您的電子信箱</label>
                    <div class="output">
                        wangxiaoming@example.com
                    </div>
                </div>
                <div class="form-group">
                    <label for="loginInput4" class="form-label">圖形驗證碼</label>
                    <div class="d-flex align-items-center">
                        <span class="me-1"><input type="text" class="form-control" id="loginInput4" /></span>
                        <span class="me-1"><img class="captcha" src="http://nfu-map.dev.com.tw/common/captcha.image" /></span>
                        <span class="me-1">
                            <button class="btn btn-xs btn-outline-secondary" type="button"><i class="fas fa-microphone"></i></button>
                        </span>
                        <span>
                            <button class="btn btn-xs btn-outline-secondary" type="button"><i class="fas fa-sync-alt"></i></button>
                        </span>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-dark btn-otp-sent" type="button">發送一次性驗證碼</button>
                    </div>
                </div>
                <div class="form-group otp-login-wrapper" style="display: none;">
                    <label class="form-label">驗證碼</label>
                    <div class="d-flex align-items-center">
                        <span class="me-3"><input type="text" class="form-control" id="loginInput4" placeholder="請輸入 6 位數驗證碼" /></span>
                        <span class="countdown">剩餘時間<strong class="countdown-strong d-inline-block px-2 text-danger fw-bold">300</strong>秒</span>
                    </div>
                    <div class="d-grid mt-4">
                        <button class="btn btn-lg btn-primary" type="button">送出</button>
                    </div>
                </div>
			</div>
		</div>
	</div>
</div>

<% content_for :js do %>
<!-- 去識別 & 按鈕字串 & 倒數 -->
<script>
$(document).ready(function() {
    $('.to-identify').each(function() {
        var text = $(this).text().trim();
        var maskedText = '';
        
        if (text.length === 2) {
            maskedText = text.charAt(0) + '*';
        } else if (text.length >= 3) {
            maskedText = text.charAt(0) + '*'.repeat(text.length - 2) + text.charAt(text.length - 1);
        } else {
            maskedText = text;
        }
        
        $(this).text(maskedText);
    });

    var countdownTimer = null;

    // OTP 發送按鈕點擊事件
    $('.btn-otp-sent').on('click', function() {
        var $btn = $(this);
        
        // 清除之前的計時器（如果存在）
        if (countdownTimer) {
            clearInterval(countdownTimer);
            countdownTimer = null;
        }
        
        // 改變按鈕文字為"發送中..."
        $btn.text('發送中...');
        $btn.prop('disabled', true);
        
        // 模擬 API 呼叫延遲 (2秒)
        setTimeout(function() {
            // 改變按鈕文字和樣式
            $btn.text('重新發送一次性驗證碼');
            $btn.removeClass('btn-dark').addClass('btn-outline-dark');
            $btn.prop('disabled', false);
            
            // 顯示 OTP 輸入區塊
            $('.otp-login-wrapper').show();
            
            // 開始倒數計時
            startCountdown(300);
        }, 2000);
    });

    // 倒數計時函數
    function startCountdown(seconds) {
        var remainingSec = seconds;
        $('.countdown-strong').text(remainingSec);
        
        countdownTimer = setInterval(function() {
            remainingSec--;
            if (remainingSec <= 0) {
                clearInterval(countdownTimer);
                countdownTimer = null;
                $('.countdown-strong').text('0');
                return;
            }
            $('.countdown-strong').text(remainingSec);
        }, 1000);
    }
});
</script>

<% end %>

