<!-- template: 各項工作報告 - 主管考核 -->

<div class="container-lg">
    <div class="leave-container-head">
        <h2 class="mb-0 fw-light">期中報告 <span class="fw-bold">主管考核</span></h2>
    </div>
    <div class="request-form-wrapper assessment-form-wrapper">
        <div class="notice-wrapper">
            <p><%= zh_lorem_paragraphs(3) %></p>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="managerCompanyName" class="form-label fw-bold">公司名稱</label>
                    <input type="text" id="managerCompanyName" class="form-control" pleceholder="請輸入">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="managerDepartment" class="form-label fw-bold">部門</label>
                    <input type="text" id="managerDepartment" class="form-control" pleceholder="請輸入">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="managerName" class="form-label fw-bold">姓名</label>
                    <input type="text" id="managerName" class="form-control" pleceholder="請輸入">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="managerTitle" class="form-label fw-bold">職稱</label>
                    <input type="text" id="managerTitle" class="form-control" pleceholder="請輸入">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="managerEmail" class="form-label fw-bold">電子信箱</label>
                    <input type="email" id="managerEmail" class="form-control" pleceholder="example@example.com">
                </div>
            </div>
        </div>
    </div>
    <div class="form-action border-0 mt-0">
        <span class="backhome">
            <a href="#" class="btn btn-lg btn-light"><i class="fas fa-long-arrow-alt-left"></i> 返回</a>
        </span>
        <button type="button" class="btn btn-lg btn-outline-primary">暫存</button>
        <button type="submit" class="btn btn-lg btn-primary">送出</button>
    </div>
</div>



<% content_for :js do %>

<% end %>

