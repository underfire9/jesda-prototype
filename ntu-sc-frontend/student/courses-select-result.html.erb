    %>
    <div class="container-lg cs-page cs-result">

        <header class="cs-head cs-head-split">
            <div>
                <h2 class="cs-title">選課結果</h2>
                <p class="cs-subtitle">查看已選課程、繳費狀態與退選申請</p>
            </div>
            <select class="form-select w-auto" aria-label="選擇年度">
                <option selected>115</option>
                <option>114</option>
                <option>113</option>
            </select>
        </header>

        <div class="csr-layout">

            <%# 選課結果總覽 %>
            <aside class="csr-summary">
                <div class="csr-total">
                    <span class="csr-total-icon"><i class="fas fa-clipboard-check"></i></span>
                    <div>
                        <span class="csr-total-label">已選課程</span>
                        <span class="csr-total-num">2 <small>門</small></span>
                        <span class="csr-total-cap">（上限 3 門）</span>
                    </div>
                </div>
                <ul class="csr-stats">
                    <li class="is-paid"><span>已繳費課程</span><b>1 門</b></li>
                    <li class="is-pending"><span>待繳費課程</span><b>1 門</b></li>
                    <li class="is-gaveup"><span>已放棄錄取</span><b>1 門</b></li>
                    <li class="is-overdue"><span>逾期未繳費</span><b>1 門</b></li>
                </ul>
                <a href="#" class="btn csr-rule-btn">選課規則說明 <i class="fas fa-external-link-alt ms-1"></i></a>
            </aside>

            <div class="csr-main">
                <%# 全階段選課紀錄 %>
                <table class="cs-table csr-table">
                    <thead>
                        <tr>
                            <th class="c-no">#</th>
                            <th class="c-stage">階段</th>
                            <th class="c-info">課程資訊</th>
                            <th class="c-time">上課時間／地點</th>
                            <th class="c-fee">學分／費用</th>
                            <th class="c-status">繳費狀態</th>
                            <th class="c-ops">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% csr_rows.each_with_index do |r, i| %>
                        <tr class="csr-row is-<%= r[:status] %>">
                            <td class="c-no"><%= i + 1 %></td>
                            <td class="c-stage"><span class="csr-stage is-s<%= r[:stage] %>"><%= r[:stage] == 1 ? "第一階段" : "第二階段" %></span></td>
                            <td class="c-info">
                                <div class="csr-tags">
                                    <span class="cs-code"><%= r[:id] %></span>
                                    <span class="cs-type"><%= r[:type] %></span>
                                    <span class="cs-mode is-<%= r[:mode] == "實體課程" ? "onsite" : "online" %>"><%= r[:mode] %></span>
                                </div>
                                <a href="#" class="cs-name"><%= r[:name] %></a>
                                <span class="csr-sub"><%= r[:school] %><i></i><%= r[:teacher] %></span>
                            </td>
                            <td class="c-time">
                                <span class="d-block"><%= r[:range] %></span>
                                <span class="d-block"><%= r[:time] %></span>
                                <span class="d-block csr-place"><i class="fas fa-map-marker-alt"></i><%= r[:place] %></span>
                            </td>
                            <td class="c-fee">
                                <span class="d-block"><%= r[:credit] %> 學分</span>
                                <b class="d-block"><%= r[:fee] %></b>
                            </td>
                            <td class="c-status">
                                <span class="csr-status is-<%= r[:status] %>"><i class="fas <%= csr_icons[r[:status]] %>"></i><%= r[:label] %></span>
                                <span class="csr-note"><%= r[:note] %></span>
                                <% if r[:note2] %><span class="csr-note"><%= r[:note2] %></span><% end %>
                            </td>
                            <td class="c-ops">
                                <div class="csr-ops">
                                <% case r[:status] when :paid %>
                                    <button type="button" class="btn btn-sm btn-outline-danger">線上退選</button>
                                <% when :pending %>
                                    <a href="#" class="btn btn-sm btn-primary">線上繳費</a>
                                    <button type="button" class="btn btn-sm btn-outline-primary">繳費單列印</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary">放棄錄取</button>
                                <% else %>
                                    <span class="csr-none">-</span>
                                <% end %>
                                </div>
                            </td>
                        </tr>
                        <% end %>
                    </tbody>
                </table>

                <%# 第一階段登記紀錄（分發後可展開） %>
                <section class="csr-record">
                    <button class="csr-record-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csrRecord" aria-expanded="false" aria-controls="csrRecord">
                        <span class="csr-record-title"><i class="fas fa-list-ol"></i>第一階段登記紀錄</span>
                        <span class="csr-record-meta">登記 <b>3</b> 門<i></i>錄取 <b>1</b> 門</span>
                        <i class="fas fa-chevron-down cs-caret"></i>
                    </button>
                    <div class="collapse" id="csrRecord">
                        <table class="cs-table csr-record-table">
                            <thead>
                                <tr>
                                    <th class="c-rank">志願序</th>
                                    <th class="c-code">課號</th>
                                    <th class="c-name">課程名稱</th>
                                    <th class="c-teacher">教師</th>
                                    <th class="c-result">分發結果</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% csr_stage1.each do |r| %>
                                <tr>
                                    <td class="c-rank"><span class="cs-rank"><%= r[:rank] %></span></td>
                                    <td class="c-code"><span class="cs-code"><%= r[:id] %></span></td>
                                    <td class="c-name"><a href="#" class="cs-name"><%= r[:name] %></a></td>
                                    <td class="c-teacher"><%= r[:teacher] %></td>
                                    <td class="c-result"><span class="csr-result <%= r[:ok] ? 'is-ok' : 'is-no' %>"><%= r[:ok] ? "錄取" : "未錄取" %></span></td>
                                </tr>
                                <% end %>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>

        <%# 提醒事項 %>
        <section class="csr-reminder">
            <h4 class="csr-reminder-title"><i class="fas fa-exclamation-circle"></i>提醒事項</h4>
            <ol>
                <li>第二階段選課為先選先得，選課後即錄取，請於期限內完成繳費，逾期未繳費者，將自動取消錄取資格，並釋出名額。</li>
                <li>若不修習已錄取之課程，請於繳費期限內辦理放棄錄取，逾期未繳費者將影響後續選課權益。</li>
                <li>已繳費課程如需退選，請依本學院退選規定辦理（退費情形請詳閱選課規則）。</li>
                <li>如有任何問題，請聯絡全國夏季學院辦公室。</li>
            </ol>
        </section>

    </div>
</div>



