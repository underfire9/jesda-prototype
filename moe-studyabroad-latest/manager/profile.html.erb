<!-- template: 計畫主持人 - 聯絡資料維護 -->
<% content_for :header_center do %>
    <span class="central-title manager-central-title">聯絡資料維護</span>
<% end %>

<% content_for :header_dropdown do %>
    <%= render :partial => "/partials/manager_dropdown" %>
<% end %>

<div class="container">
    <div class="page-content">
        <div class="profile-container">
            <aside>
                <div class="form-group">
                    <label class="form-label">登入信箱</label>
                    <div class="profile-output">useraccount@email.com</div>
                </div>
                <div class="form-group">
                    <label class="form-label">中文姓名</label>
                    <div class="profile-output"><%= zh_lorem_name %></div>
                </div>
                <div class="form-group">
                    <label class="form-label">學校名稱</label>
                    <div class="profile-output">南臺學校財團法人南臺科技大學</div>
                </div>
            </aside>
            <main>
                <div class="password-section">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="passwordCheckbox">
                                    <label class="form-check-label" for="passwordCheckbox">修改密碼</label>
                                </div>
                            </div>
                        </div>
                        <div class="password-fields form-text mb-3">長度至少8碼，須包含下列四種半形字元中的 3 種：英文大寫字元 (A 到 Z)、英文小寫字元 (a 到 z)、10 進位數字 (0 到 9)、非英文字母字元「~!@#$%^&*()_+|`-={}[]:";'<>?,./」</div>
                        <div class="col-md-6 password-fields">
                            <div class="form-group">
                                <label class="form-label" for="password">密碼</label>
                                <input type="password" id="password" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-6 password-fields">
                            <div class="form-group">
                                <label class="form-label" for="password_confirmation">密碼確認</label>
                                <input type="password" id="password_confirmation" class="form-control">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="contact_phone"><span class="required">*</span>聯絡電話</label>
                            <input type="text" id="contact_phone" class="form-control" value="+886-3-8900170">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="login_account"><span class="required">*</span>登入信箱</label>
                            <input type="text" id="login_account" class="form-control" value="useraccount@email.com">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="mobile"><span class="required">*</span>手機</label>
                            <input type="text" id="mobile" class="form-control" value="0933-123456">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="department">系所</label>
                            <input type="text" id="department" class="form-control" value="資訊工程學系">
                        </div>
                    </div>
                </div>

                <div class="form-action">
                    <span class="backhome">
                        <button type="button" class="btn btn-lg btn-light" onclick="window.history.back()" title="回上一頁">
                            <i class="fas fa-long-arrow-alt-left"></i>
                            <span class="md-none">回上一頁</span>
                        </button>
                    </span>
                    <button type="button" class="btn btn-lg btn-dark">儲存</button>
                </div>
            </main>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

