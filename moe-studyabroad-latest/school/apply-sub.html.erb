<!-- template: 學校聯絡人 - 計畫申請/子計畫申請管理 -->
<% content_for :header_center do %>
    <span class="central-title">子計畫申請管理</span>
<% end %>

<div class="container">
    <div class="page-content">
        <div class="subplan-list-wrapper">
            <% (1..5).map do |i| %>
            <div class="subplan-card">
                <div class="card-bd">
                    <div class="item-info">
                        <span class="item-label">計畫名稱</span>
                        <span class="item-value"><%= zh_lorem_sentence %></span>
                    </div>
                    <div class="item-info">
                        <span class="item-label">計畫主持人</span>
                        <span class="item-value"><%= zh_lorem_name %></span>
                    </div>
                    <div class="item-info">
                        <span class="item-label">主持人填寫狀態</span>
                        <span class="item-value">未送出</span>
                    </div>
                    <div class="item-info">
                        <span class="item-label">預計選送學生人數</span>
                        <span class="item-value">999</span>
                    </div>
                    <div class="item-info">
                        <span class="item-label">申請補助經費</span>
                        <span class="item-value">999,999</span>
                    </div>
                    <div class="item-info">
                        <span class="item-label">學校配合款</span>
                        <span class="item-value">999,999</span>
                    </div>
                </div>
                <div class="card-ft">
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-secondary btn-sm">刪除</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#subplanModal">編輯</button>
                    </div>
                </div>
            </div>
            <% end %>
        </div>
        <div class="form-action no-border">
            <span class="backhome">
                <a href="apply.html" class="btn btn-lg btn-light">
                    <i class="fas fa-long-arrow-alt-left"></i>
                    <span class="md-none">回上一頁</span>
                </a>
            </span>
            <button type="button" class="btn btn-lg btn-primary px-4" data-bs-toggle="modal" data-bs-target="#subplanModal">
                <i class="fas fa-plus me-1"></i> 新增
            </button>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="subplanModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="subplanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="subplanModalLabel">新增{編輯}子計畫</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="subplanSerial" class="form-label">計畫代號</label>
                    <div class="d-flex align-items-center gap-2">
                        <span>115999999</span>
                        <span><input type="text" class="form-control" id="subplanSerial" style="width: 64px;"></span>
                    </div>
                </div>
                <div class="form-group mt-3">
                    <label for="subplanManager" class="form-label">計畫主持人</label>
                    <select class="form-select" id="subplanManager">
                        <option value="">請選擇</option>
                        <option value="1">王小明</option>
                        <option value="2">陳大華</option>
                        <option value="3">李小美</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="button" class="btn btn-primary">儲存</button>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>
<script>
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
</script>
<% end %>

