<!-- template: Webix -->

<div class="container-lg">
    <div class="page-content">
        <div class="py-5">
            <ul>
                <li>
                    <h5>資料元件</h5>
                    <ol>
                        <li>datatable - 資料表格</li>
                        <li>treetable - 樹狀表格</li>
                        <li>list - 列表</li>
                        <li>grouplist - 分組列表</li>
                        <li>tree - 樹狀結構</li>
                    </ol>
                </li>
                <li>
                    <h5>表單元件</h5>
                    <ol>
                        <li>datepicker - 日期選擇器</li>
                        <li>daterangepicker - 日期範圍選擇器</li>
                    </ol>
                </li>
            </ul>
        </div>
        
        <!-- 資料元件範例 -->
        <section class="mb-5">
            <h2 class="mb-4">資料元件 (Data Components)</h2>
            
            <!-- 1. DataTable - 資料表格 -->
            <div class="mb-5">
                <h4 class="mb-3">1. DataTable - 資料表格</h4>
                <div id="datatable1" class="webix-bootstrap-table"></div>
            </div>
            
            <!-- 2. TreeTable - 樹狀表格 -->
            <div class="mb-5">
                <h4 class="mb-3">2. TreeTable - 樹狀表格</h4>
                <div id="treetable1" class="webix-bootstrap-table"></div>
            </div>
            
            <!-- 3. List - 列表 -->
            <div class="mb-5">
                <h4 class="mb-3">3. List - 列表</h4>
                <div id="list1" class="webix-bootstrap-list"></div>
            </div>
            
            <!-- 4. GroupList - 分組列表 -->
            <div class="mb-5">
                <h4 class="mb-3">4. GroupList - 分組列表</h4>
                <div id="grouplist1" class="webix-bootstrap-list"></div>
            </div>
            
            <!-- 5. Tree - 樹狀結構 -->
            <div class="mb-5">
                <h4 class="mb-3">5. Tree - 樹狀結構</h4>
                <div id="tree1" class="webix-bootstrap-tree"></div>
            </div>
        </section>
        
        <!-- 表單元件範例 -->
        <section class="mb-5">
            <h2 class="mb-4">表單元件 (Form Components)</h2>
            
            <!-- 1. DatePicker - 日期選擇器 -->
            <div class="mb-5">
                <h4 class="mb-3">1. DatePicker - 日期選擇器</h4>
                <div id="datepicker1" class="webix-bootstrap-form"></div>
            </div>
            
            <!-- 2. DateRangePicker - 日期範圍選擇器 -->
            <div class="mb-5">
                <h4 class="mb-3">2. DateRangePicker - 日期範圍選擇器</h4>
                <div id="daterangepicker1" class="webix-bootstrap-form"></div>
            </div>
        </section>
        
    </div>
</div>



<% content_for :js do %>
<script>
// ========================================
// RWD 輔助函數
// ========================================
function isMobile() {
    return window.innerWidth < 768;
}

function isTablet() {
    return window.innerWidth >= 768 && window.innerWidth < 1024;
}

function isDesktop() {
    return window.innerWidth >= 1024;
}

// ========================================
// 資料元件範例
// ========================================

// 1. DataTable - 資料表格
var dt1 = webix.ui({
    container: "datatable1",
    view: "datatable",
    type: "bootstrap-table",
    autoheight: true,
    autowidth: true,
    resizeColumn: true,
    columns: [
        { id: "id", header: "ID", width: 60 },
        { id: "name", header: "姓名", fillspace: 1, minWidth: 100 },
        { id: "position", header: "職位", fillspace: 2, minWidth: 120 },
        { id: "department", header: "部門", width: 100 },
        { id: "salary", header: "薪資", width: 100, format: webix.i18n.priceFormat }
    ],
    data: [
        { id: 1, name: "張小明", position: "專案經理", department: "技術部", salary: 80000 },
        { id: 2, name: "李小華", position: "開發工程師", department: "技術部", salary: 65000 },
        { id: 3, name: "王大同", position: "UI設計師", department: "設計部", salary: 60000 },
        { id: 4, name: "陳美玲", position: "產品經理", department: "產品部", salary: 75000 },
        { id: 5, name: "林志明", position: "技術總監", department: "技術部", salary: 120000 },
        { id: 6, name: "黃小芬", position: "人資專員", department: "人資部", salary: 50000 }
    ],
    select: "row"
});
console.log('DataTable created:', dt1);

// 2. TreeTable - 樹狀表格
webix.ui({
    container: "treetable1",
    view: "treetable",
    type: "bootstrap-table",
    autoheight: true,
    autowidth: true,
    resizeColumn: true,
    columns: [
        { id: "name", header: "專案名稱", template: "{common.treetable()} #name#", fillspace: 2, minWidth: 200 },
        { id: "status", header: "狀態", width: 100 },
        { id: "progress", header: "進度", width: 80 },
        { id: "owner", header: "負責人", fillspace: 1, minWidth: 100 }
    ],
    data: [
        { id: "1", name: "網站重構專案", status: "進行中", progress: "65%", owner: "張小明", open: true, data: [
            { id: "1.1", name: "前端開發", status: "進行中", progress: "80%", owner: "李小華" },
            { id: "1.2", name: "後端API", status: "進行中", progress: "60%", owner: "王大同" },
            { id: "1.3", name: "UI設計", status: "完成", progress: "100%", owner: "陳美玲" }
        ]},
        { id: "2", name: "行動應用開發", status: "規劃中", progress: "20%", owner: "林志明", open: true, data: [
            { id: "2.1", name: "需求分析", status: "完成", progress: "100%", owner: "黃小芬" },
            { id: "2.2", name: "原型設計", status: "進行中", progress: "40%", owner: "陳美玲" }
        ]}
    ]
});

// 3. List - 列表
webix.ui({
    container: "list1",
    view: "list",
    type: "bootstrap-list",
    autoheight: true,
    template: function(obj) {
        return "<div style='padding: 10px; font-size: " + (isMobile() ? "14px" : "16px") + ";'>" +
               "<strong>" + obj.name + "</strong><br/>" +
               "<small style='color: #6c757d;'>" + obj.email + "</small>" +
               "</div>";
    },
    type: {
        height: isMobile() ? 60 : 70
    },
    data: [
        { id: 1, name: "張小明", email: "zhang@company.com" },
        { id: 2, name: "李小華", email: "li@company.com" },
        { id: 3, name: "王大同", email: "wang@company.com" },
        { id: 4, name: "陳美玲", email: "chen@company.com" },
        { id: 5, name: "林志明", email: "lin@company.com" }
    ],
    select: true
});

// 4. GroupList - 分組列表
webix.ui({
    container: "grouplist1",
    view: "grouplist",
    type: "bootstrap-list",
    autoheight: true,
    template: function(obj) {
        return "<div style='padding: 10px; font-size: " + (isMobile() ? "14px" : "16px") + ";'>" +
               obj.name + " - " + obj.position +
               "</div>";
    },
    type: {
        height: isMobile() ? 50 : 60
    },
    data: [
        { id: 1, name: "張小明", position: "專案經理", department: "技術部" },
        { id: 2, name: "李小華", position: "開發工程師", department: "技術部" },
        { id: 3, name: "王大同", position: "UI設計師", department: "設計部" },
        { id: 4, name: "陳美玲", position: "產品經理", department: "產品部" },
        { id: 5, name: "林志明", position: "技術總監", department: "技術部" },
        { id: 6, name: "黃小芬", position: "人資專員", department: "人資部" },
        { id: 7, name: "周大明", position: "視覺設計師", department: "設計部" },
        { id: 8, name: "吳小莉", position: "產品助理", department: "產品部" }
    ],
    scheme: {
        $group: function(obj) {
            return obj.department;
        }
    }
});

// 5. Tree - 樹狀結構
webix.ui({
    container: "tree1",
    view: "tree",
    type: "bootstrap-tree",
    autoheight: true,
    select: true,
    type: {
        height: isMobile() ? 35 : 40
    },
    data: [
        { id: "1", value: "公司組織架構", open: true, data: [
            { id: "1.1", value: "管理部門", open: true, data: [
                { id: "1.1.1", value: "總經理室" },
                { id: "1.1.2", value: "人力資源部" },
                { id: "1.1.3", value: "財務部" }
            ]},
            { id: "1.2", value: "技術部門", open: true, data: [
                { id: "1.2.1", value: "研發部" },
                { id: "1.2.2", value: "IT部" },
                { id: "1.2.3", value: "測試部" }
            ]},
            { id: "1.3", value: "業務部門", data: [
                { id: "1.3.1", value: "銷售部" },
                { id: "1.3.2", value: "市場部" },
                { id: "1.3.3", value: "客服部" }
            ]}
        ]}
    ]
});

// ========================================
// 表單元件範例
// ========================================

// 1. DatePicker - 日期選擇器
var dp1 = webix.ui({
    container: "datepicker1",
    view: "datepicker",
    label: "選擇日期",
    value: new Date(),
    labelWidth: isMobile() ? 80 : 120,
    format: "%Y-%m-%d",
    editable: true,
    suggest: {
        type: "calendar",
        body: {
            icons: true,
            weekHeader: true
        }
    }
});
console.log('DatePicker created:', dp1);

// 2. DateRangePicker - 日期範圍選擇器
var drp1 = webix.ui({
    container: "daterangepicker1",
    view: "daterangepicker",
    label: "選擇日期範圍",
    value: {
        start: new Date(),
        end: webix.Date.add(new Date(), 7, "day")
    },
    labelWidth: isMobile() ? 80 : 120,
    format: "%Y-%m-%d",
    editable: true
});
console.log('DateRangePicker created:', drp1);

// ========================================
// RWD 視窗大小變更處理
// ========================================
var resizeTimer;
window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
        // 重新取得所有 Webix 元件並調整
        webix.ui.each(function(view) {
            if (view.adjust) {
                view.adjust();
            }
        });
    }, 300);
});
</script>
<% end %>


