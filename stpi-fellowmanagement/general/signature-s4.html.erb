<!-- template: 電子簽章 - 電子簽名 -->

<div class="container-lg">

        <ul class="step-menu six-step menu-item">
            <li class="step-item done">
                <span class="number">1</span>
                <span class="description">個資聲明與使用條款</span>
            </li>
            <li class="step-item done">
                <span class="number">2</span>
                <span class="description">OTP身分驗證</span>
            </li>
            <li class="step-item done">
                <span class="number">3</span>
                <span class="description">檢視簽署文件</span>
            </li>
            <li class="step-item current">
                <span class="number">4</span>
                <span class="description">電子簽名</span>
            </li>
            <li class="step-item">
                <span class="number">5</span>
                <span class="description">憑證簽署</span>
            </li>
            <li class="step-item">
                <span class="number">6</span>
                <span class="description">簽署完成</span>
            </li>
        </ul>

    <div class="notice-wrapper">
        <p><%= zh_lorem_paragraph %></p>
        <p><%= zh_lorem_paragraph %></p>
    </div>

    
    <div class="sign-container">
        <div class="sign-wrapper">
            <p>請在下方方框空白處以滑鼠簽名</p>
            <div class="sign-board">
                <canvas id="canvas" class="signature-pad"></canvas>
                <div class="sign-actions">
                    <button id="clear" class="btn btn-sm btn-rounded btn-warning">清除</button>
                    <button id="undo" class="btn btn-sm btn-rounded btn-secondary">復原</button>
                    <button id="load" class="btn btn-sm btn-rounded btn-dark">載入</button>
                </div>
            </div>
            <div class="mt-3 text-center">
                <button type="submit" class="btn btn-lg btn-primary">確認送出</button>
            </div>
        </div>
        <div class="qrcode-wrapper">
            <p>掃描 QR CODE 使用手機簽名</p>
            <div class="qrcode-image">
                <img src="../assets/fake/qrcode.svg">
            </div>
        </div>
    </div>
    

</div>



<% content_for :js do %>

<% end %>

