<!-- template: 教師 / 討論主題 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>討論主題</h3>
        </div>
        <div class="narrow-wrapper">
            <div class="form-group">
                <label class="form-label"><span class="required">*</span> 發布日期</label>
                <div class="d-flex gap-1">
                    <div>
                        <input type="date" class="form-control">
                    </div>
                    <div>
                        <select class="form-select">
                            <option>01</option>
                            <option>09</option>
                            <option>10</option>
                            <option>11</option>
                            <option>12</option>
                            <option>13</option>
                            <option>14</option>
                            <option>15</option>
                            <option>16</option>
                            <option>17</option>
                        </select>
                    </div>
                    <div>
                        <select class="form-select">
                            <option>00</option>
                            <option>10</option>
                            <option>20</option>
                            <option>30</option>
                            <option>40</option>
                            <option>50</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label for="assignmentTitleCh" class="form-label"><span class="required">*</span> 主題名稱(中文)</label>
                <input type="text" class="form-control" id="assignmentTitleCh" />
            </div>
            <div class="form-group">
                <label for="assignmentTitleEn" class="form-label"><span class="required">*</span> 主題名稱(英文)</label>
                <input type="text" class="form-control" id="assignmentTitleEn" />
            </div>
            <div class="form-group">
                <label for="assignmentDescriptionCh" class="form-label"><span class="required">*</span> 討論內容(中文)</label>
                <!-- 編輯器 -->
                <textarea class="form-control" id="assignmentDescriptionCh" rows="8"></textarea>
            </div>
            <div class="form-group">
                <label for="assignmentDescriptionEn" class="form-label"><span class="required">*</span> 討論內容(英文)</label>
                <!-- 編輯器 -->
                <textarea class="form-control" id="assignmentDescriptionEn" rows="8"></textarea>
            </div>
            <div class="form-action">
                <span class="backhome">
                    <a href="#" class="btn btn-lg btn-light px-3" title="回列表"><i class="fas fa-long-arrow-alt-left"></i></a>
                </span>
                <button type="submit" class="btn btn-lg btn-main px-4">儲存</button>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

