<!-- template: 產學媒合首頁 -->

<div class="matchmaking-slogan">
    <div class="container-lg">
        <div class="slogan">產學媒合搭建產業界與學術界的橋樑</div>
    </div>
    <div class="jumbo"></div>
</div>

<div class="matchmaking-container">
    <div class="container-lg">

        <div class="home-section">
            <div class="matchmaking-route">
                <div class="section-route">
                    <div>
                        <h3>技術需求找專家</h3>
                        <p>運用資料庫結合AI技術，將您的技術需求，精準媒合專家學者，為您找到最適合的解決方案。</p>
                    </div>
                    <span><a href="#" class="btn btn-main btn-outline">我要提出技術需求</a></span>
                </div>
                <div class="section-route">
                    <div>
                        <h3>技術成果找合作</h3>
                        <p>為您的技術找到最適合的合作夥伴，幫助研究成果創造最大價值，帶動產業革新。</p>
                    </div>
                    <span><a href="#" class="btn btn-main btn-outline">我要提出商化技術</a></span>
                </div>
            </div>
            <div class="form-text text-center pt-1 mobile-only">為避免操作錯誤，媒合功能將不提供行動裝置介面</div>
        </div>

        <div class="home-section">
            <div class="home-section-title">
                <h4>最新技術需求</h4>
            </div>

            <div class="table-responsive">
                <table class="table align-middle text-nowrap demand-table">
                    <thead>
                        <tr>
                            <th>姓名</th>
                            <th>職稱</th>
                            <th>任職單位</th>
                            <th>技術名稱</th>
                            <th>預期商化模式</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (1..6).map do |i| %>
                        <tr>
                            <td><%= zh_lorem_name %></td>
                            <td>教授</td>
                            <td>英屬維京群島商國富綠景創業投資有限公司</td>
                            <td>技術授權</td>
                            <td><a href="#" class="btn btn-sm btn-outline-primary btn-rounded">檢視</a></td>
                        </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="home-section">
            <div class="home-section-title">
                <h4>媒合功能亮點成果(TBD)</h4>
            </div>
            <div class="achievements-wrapper">
                <div class="wrap-card">
                    <h6>促進媒合家數</h6>
                    <p>167,889 件</p>
                </div>
                <div class="wrap-card">
                    <h6>簽署產學 MOU</h6>
                    <p>167,889 件</p>
                </div>
                <div class="wrap-card">
                    <h6>帶動技術商化</h6>
                    <p>167,889 件</p>
                </div>
            </div>
        </div>
        
    </div>
</div>



<% content_for :js do %>
<script>

</script>
<% end %>

