<!-- admin-page: Tabs -->

<main class="main">
    <div class="page-header">
        <div class="header-start">
            <h2 class="page-title">114-臺大教務處-D003 招生系統增修暨維護合約</h2>
            <div class="page-describe">此行放頁面功能簡短描述，注意必須簡短，避免右方有統計區塊時擠壓換行</div>
        </div>
        <div class="header-end">
            <div class="header-statistics">
                <div class="statistics-card text-end">
                    <span class="statistic-number text-success">2/4</span>
                    <span class="statistic-label">交付進度</span>
                </div>
                <div class="statistics-card text-end">
                    <span class="statistic-number text-dark">116</span>
                    <span class="statistic-label">待客戶確認</span>
                </div>
                <div class="statistics-card text-end">
                    <span class="statistic-number">640K</span>
                    <span class="statistic-label">可請款</span>
                </div>
                <div class="statistics-card text-end">
                    <span class="statistic-number text-danger">12</span>
                    <span class="statistic-label">異常提醒</span>
                </div>
            </div>
        </div>
    </div>
    <div class="solid-tabs-bar">
        <div class="previous-clip">
            <button class="btn btn-previous" type="button" onclick="history.back()" title="回上一頁">
                <i class="bi bi-chevron-left"></i>
            </button>
        </div>
        <ul class="nav nav-pills" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link active"
                    id="overview-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#overview-tab-pane"
                    type="button"
                    role="tab"
                    aria-controls="overview-tab-pane"
                    aria-selected="true"
                >
                    總覽
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link"
                    id="delivery-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#delivery-tab-pane"
                    type="button"
                    role="tab"
                    aria-controls="delivery-tab-pane"
                    aria-selected="false"
                >
                    交付期程
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link"
                    id="proposal-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#proposal-tab-pane"
                    type="button"
                    role="tab"
                    aria-controls="proposal-tab-pane"
                    aria-selected="false"
                >
                    企劃書
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link"
                    id="related-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#related-tab-pane"
                    type="button"
                    role="tab"
                    aria-controls="related-tab-pane"
                    aria-selected="false"
                >
                    關聯專案
                </button>
            </li>
        </ul>
    </div>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="overview-tab-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
            <div class="row">
                <div class="col-md-6 col-lg-8">
                    <div class="col-block">
                        <div class="block-hd">
                            <h5 class="block-title">區塊標題</h5>
                        </div>
                        <div class="block-bd">
                            <p><%= lorem_paragraph %></p>
                        </div>
                        <div class="block-ft fs-7">本合約包含需求確認、系統開發、測試驗收、上線支援與保固維護，需求項目須維持 RTM 追溯關係。</div>
                    </div>
                    <div class="col-block">
                        <div class="block-hd">
                            <h5 class="block-title">區塊標題</h5>
                            <div class="hd-end">
                                <a href="#" class="btn btn-sm btn-action" title="選取"><i class="bi bi-person-plus"></i></a>
                            </div>
                        </div>
                        <div class="block-bd">
                            <p><%= lorem_paragraph %></p>
                        </div>
                        <div class="block-ft">區塊底部 block footer</div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="col-block h-100">
                        <div class="block-hd">
                            <h5 class="block-title">區塊標題</h5>
                            <div class="hd-end">
                                <a href="#" class="btn btn-sm btn-action" title="編輯"><i class="bi bi-pen"></i></a>
                            </div>
                        </div>
                        <div class="block-bd">
                            <p><%= lorem_paragraph %></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-block mt-4">
                <div class="block-hd">
                    <h5 class="block-title">區塊標題</h5>
                </div>
                <div class="block-bd">
                    <p><%= lorem_paragraph %></p>
                </div>
                <div class="block-ft">block footer</div>
            </div>
        </div>
        <div class="tab-pane fade" id="delivery-tab-pane" role="tabpanel" aria-labelledby="delivery-tab" tabindex="0">
            <% (1..6).map do |i| %>
            <p><%= lorem_paragraph %></p>
            <% end %>
        </div>
        <div class="tab-pane fade" id="proposal-tab-pane" role="tabpanel" aria-labelledby="proposal-tab" tabindex="0">
            <% (1..6).map do |i| %>
            <p><%= lorem_paragraph %></p>
            <% end %>
        </div>
        <div class="tab-pane fade" id="related-tab-pane" role="tabpanel" aria-labelledby="related-tab" tabindex="0">
            <% (1..6).map do |i| %>
            <p><%= lorem_paragraph %></p>
            <% end %>
        </div>
    </div>
</main>

<% content_for :js do %>

<% end %>