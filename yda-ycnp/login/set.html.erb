<!-- template: 申請 - 設定密碼 -->

<div class="container-lg">
	<div class="login-wrapper">
		<div class="login-card">
		    <div class="card-hd">
			    <h2>設定密碼</h2>
			</div>
			<div class="card-bd">
                <div class="form-group">
                    <label for="exampleFormControlInput0" class="form-label">請輸入密碼</label>
                    <input type="password" class="form-control" id="exampleFormControlInput0" />
                    <div class="form-text">密碼長度最少12碼，須包含大小寫英文字母、數字及特殊符號</div>
                </div>
                <div class="form-group">
                    <label for="exampleFormControlInput1" class="form-label">請再次輸入密碼</label>
                    <input type="password" class="form-control" id="exampleFormControlInput1" />
                </div>
			</div>
            <div class="d-grid mt-4">
                <button class="btn btn-lg btn-main" type="submit">送出</button>
            </div>
		</div>
	</div>
</div>



