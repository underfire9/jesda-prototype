<!-- template: 學生 / 課程作業 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>作業</h3>
        </div>
        <article class="narrow-wrapper">
            <h6 class="text-muted">作業內容</h6>
            <h3 class="mb-4"><%= zh_lorem_words(16) %></h3>
            <div class="mb-4">
                <p><%= zh_lorem_paragraphs(2) %></p>
                <ul>
                    <% (1..5).map do |i| %>
                    <li><%= zh_lorem_paragraph %></li>
                    <% end %>
                </ul>
                <p><%= zh_lorem_paragraphs(1) %></p>
            </div>
            <div class="mb-5 pt-3">
                <span class="d-block fs-6 text-muted">繳交期限</span>
                <span class="d-inline-block fw-bold fs-4 text-danger pb-2 border-bottom border-dark-subtle">2026-07-23 12:00</span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="pt-4">
                        <label for="fileUpload" class="form-label fw-bold h5">上傳作業</label>
                        <input class="form-control" type="file" id="fileUpload" />
                        <div class="form-text">若有多檔案請壓縮後上傳</div>
                        <div class="border rounded-pill ps-2 pe-3 py-1 mt-3 w-auto d-inline-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-rounded btn-light fs-6" title="刪除檔案"><i class="fas fa-times"></i></button>
                            <a href="#" class="text-black" title="下載檔案">檔案名稱忠孝仁愛.zip</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-action">
                <span class="backhome">
                    <a href="#" class="btn btn-light"><i class="fas fa-long-arrow-alt-left"></i> 回列表</a>
                </span>
            </div>
        </article>
    </div>
</div>



<% content_for :js do %>

<% end %>

