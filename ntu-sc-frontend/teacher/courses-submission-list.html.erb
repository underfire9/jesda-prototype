<!-- template: 教師 / 課程作業繳交紀錄 -->

<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>作業繳交紀錄</h3>
        </div>
        <div class="row g-5">
            <div class="col-lg-4">
                <div>
                    <div class="input-group mb-4">
                        <input type="text" class="form-control" placeholder="搜尋作業名稱">
                        <button class="btn btn-outline-secondary" type="button"><i class="fas fa-search"></i></button>
                    </div>
                    <div class="courses-instructions mb-4 pb-4 border-bottom">
                        <p><%= zh_lorem_sentences(7) %></p>
                        <ul>
                            <li><%= zh_lorem_sentence %></li>
                            <li><%= zh_lorem_sentence %></li>
                            <li><%= zh_lorem_sentence %></li>
                        </ul>
                        <p><%= zh_lorem_sentences(3) %></p>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a href="#" class="btn btn-light px-3" title="回列表"><i class="fas fa-long-arrow-alt-left"></i></a>
                        <a href="#" class="btn btn-dark">打包下載</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <p>rwd datatables</p>
                <div class="table-responsive text-nowrap">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="text-center" style="width: 60px;">#</th>
                                <th scope="col">報名序號</th>
                                <th scope="col">學生姓名</th>
                                <th scope="col">作業上傳時間</th>
                                <th scope="col" class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (1..42).map do |i| %>
                            <tr>
                                <th scope="row" class="text-center" ><%= i %></th>
                                <td>109123456</td>
                                <td><%= zh_lorem_name %></td>
                                <td>2026-05-01 14:30</td>
                                <td class="text-end">
                                    <a href="#" class="btn btn-sm btn-link">下載</a>
                                </td>
                            </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>
    <!-- 課程說明 more/less -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const instructionsElement = document.querySelector('.courses-instructions');
        
        if (instructionsElement) {
            const fullText = instructionsElement.innerHTML;
            const textContent = instructionsElement.textContent || instructionsElement.innerText;
            
            if (textContent.length > 160) {
                // 建立截斷的內容
                let truncatedHTML = '';
                let charCount = 0;
                let tempDiv = document.createElement('div');
                tempDiv.innerHTML = fullText;
                
                function truncateNode(node) {
                    if (charCount >= 160) return '';
                    
                    if (node.nodeType === Node.TEXT_NODE) {
                        const remainingChars = 160 - charCount;
                        const text = node.textContent;
                        if (text.length <= remainingChars) {
                            charCount += text.length;
                            return text;
                        } else {
                            charCount = 160;
                            return text.substring(0, remainingChars) + '...';
                        }
                    } else if (node.nodeType === Node.ELEMENT_NODE) {
                        let result = '<' + node.nodeName.toLowerCase();
                        for (let attr of node.attributes) {
                            result += ' ' + attr.name + '="' + attr.value + '"';
                        }
                        result += '>';
                        
                        for (let child of node.childNodes) {
                            if (charCount >= 160) break;
                            result += truncateNode(child);
                        }
                        
                        result += '</' + node.nodeName.toLowerCase() + '>';
                        return result;
                    }
                    return '';
                }
                
                for (let child of tempDiv.childNodes) {
                    if (charCount >= 160) break;
                    truncatedHTML += truncateNode(child);
                }
                
                // 建立容器
                instructionsElement.innerHTML = `
                    <div class="instructions-short">${truncatedHTML}</div>
                    <div class="instructions-full" style="display: none;">${fullText}</div>
                    <div class="text-end"><a href="#" class="instructions-toggle fw-bold">more</a></div>
                `;
                
                // 綁定切換事件
                const toggleLink = instructionsElement.querySelector('.instructions-toggle');
                const shortContent = instructionsElement.querySelector('.instructions-short');
                const fullContent = instructionsElement.querySelector('.instructions-full');
                
                toggleLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    if (fullContent.style.display === 'none') {
                        shortContent.style.display = 'none';
                        fullContent.style.display = 'block';
                        this.textContent = 'less';
                    } else {
                        shortContent.style.display = 'block';
                        fullContent.style.display = 'none';
                        this.textContent = 'more';
                    }
                });
            }
        }
    });
    </script>
<% end %>

