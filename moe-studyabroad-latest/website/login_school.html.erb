<!-- template: 登入 - 學校聯絡人 -->

<div class="container-lg">
    <div class="page-content">
        <a href="#C" title="中央內容區塊" id="AC" accesskey="C" name="C" style="">:::</a>
        <div class="login-container">
            <h3 class="fw-semibold text-secondary">登入 <span class="fw-light">學校聯絡人</span></h3>

            <div class="container-inner">
                <div class="login-notice">
                    <ol class="notice-list menu-item">
                        <li>帳號註冊：請聯繫計畫辦公室取得帳號並註冊聯絡人資料取得密碼登入系統。</li>
                        <li>忘記密碼：使用忘記密碼系統將發送密碼至貴校承辦人信箱，如有問題請洽計畫辦公室。</li>
                        <li>
                            提醒各校學海計畫承辦窗口：<br>
                            <strong>學生上傳心得報告前，請務必先行檢視內容，例如語句順暢性、內容正確性、圖片來源、是否符合補助要點規定或遵守學術誠信等。</strong><br>
                            如有任何問題，請隨時聯絡學海計畫辦公室，謝謝。
                        </li>
                        <li>各校請於規定時間內完成各項申辦作業,欲知本年度期程請參考 {<a href="schedule.html" class="fw-semibold">日程表</a>}</li>
                        <li>
                            各項計畫結餘款繳回支票受款人請填入<br>
                            <span class="text-danger fs-4">國立臺灣科技大學403專戶</span>
                        </li>
                    </ol>
                </div>
                <div class="login-wrapper">
                    <form action="../school/privacy.html">
                        <div class="form-group">
                            <label for="accountSchool" class="form-label">帳號</label>
                            <input type="text" class="form-control" id="accountSchool" placeholder="請輸入帳號" />
                        </div>
                        <div class="form-group">
                            <label for="passwordSchool" class="form-label">密碼</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="passwordSchool" placeholder="請輸入密碼" />
                                <button
                                    type="button"
                                    class="btn js-toggle-password"
                                    data-target="passwordSchool"
                                    aria-label="顯示密碼"
                                    aria-controls="passwordSchool"
                                    aria-pressed="false"
                                >
                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                    <span class="sr-only">顯示密碼</span>
                                </button>
                            </div>
                            <div class="text-end form-text">
                                <a href="forget_password.html" class="forgot-password-link">忘記密碼?</a>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="captchaSchool" class="form-label">驗證碼</label>
                            <div class="d-flex align-items-center gap-1">
                                <input type="text" class="form-control w-captcha" id="captchaSchool" placeholder="請輸入驗證碼" />
                                <span><img class="captcha" src="https://www.studyabroad.moe.gov.tw/new/common/captcha.image" alt="驗證碼圖片"></span>
                                <span>
                                    <button type="button" class="btn btn-light captchaPlayAudio" title="播放語音驗證碼">
                                        <i class="fa fa-volume-up"></i><span class="sr-only">播放語音驗證碼</span>
                                    </button>
                                </span>
                                <span>
                                    <button class="btn btn-light captchaChange" type="button" title="更新驗證碼">
                                        <i class="fas fa-sync-alt"></i><span class="sr-only">更新驗證碼</span>
                                    </button>
                                </span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-lg btn-block btn-primary">登入</button>
                        <div class="text-center mt-4"><a href="login_register.html" class="btn btn-link">註冊帳號</a></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>
<script>
    (function() {
        var toggleButtons = document.querySelectorAll('.js-toggle-password');

        toggleButtons.forEach(function(button) {
            button.addEventListener('click', function() {
                var targetId = button.getAttribute('data-target');
                var input = document.getElementById(targetId);

                if (!input) return;

                var isPassword = input.getAttribute('type') === 'password';
                var icon = button.querySelector('i');
                var srText = button.querySelector('.sr-only');

                input.setAttribute('type', isPassword ? 'text' : 'password');
                button.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
                button.setAttribute('aria-label', isPassword ? '隱藏密碼' : '顯示密碼');

                if (icon) {
                    icon.classList.toggle('fa-eye', !isPassword);
                    icon.classList.toggle('fa-eye-slash', isPassword);
                }

                if (srText) {
                    srText.textContent = isPassword ? '隱藏密碼' : '顯示密碼';
                }
            });
        });
    })();
</script>
<% end %>

