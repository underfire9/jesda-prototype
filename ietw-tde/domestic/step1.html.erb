                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label" for="domestic_emergency_relationship">緊急連絡人與本人關係</label>
                            <input type="text" id="domestic_emergency_relationship" name="emergency_relationship" class="form-control">
                        </div>
                    </div>
                </div>
            </section>
            <section class="section">
                <div class="section-title">
                    <h4>緊急聯絡人聯絡電話</h4>
                </div>
                <div class="row">
                    <div class="col-4">
                        <div class="form-group">
                            <label class="form-label" for="domestic_emergency_contact_phone">手機</label>
                            <input type="text" id="domestic_emergency_contact_phone" name="emergency_contact_phone" class="form-control">
