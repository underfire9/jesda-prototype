                        <p><%= lorem_sentence %></p>
                        <p><%= lorem_paragraph %></p>
                    </div>
                    <a href="#" class="more-link" title="閱讀更多"><span>閱讀更多</span></a>
                </div>
            </li>
            <% end %>
        </ul>
        <div class="paper-wrapper">
            <div class="section-title">
                <h4>紙本資料</h4>
            </div>

            <!-- 紙本資料圖片不需要裁切 -->
            <ul class="paper-list menu-item">
