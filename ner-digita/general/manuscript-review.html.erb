                    icons: true,
                    buttons: ["today"],
                    timepicker: true
                }
            }
        });

        // 初始化官網發佈時間選擇器
        var manuscriptReleasePicker = webix.ui({
            container: "manuscript_Release",
            view: "datepicker",
            css: "webix_view_sm",
            format: "%Y-%m-%d %H:%i",
            timepicker: true,
            suggest: {
                type: "calendar",
                body: {
                    view: "calendar",
                    css: "webix_view_sm",
                    weekHeader: true,
                    events: webix.Date.isHoliday,
                    icons: true,
                    buttons: ["today"],
                    timepicker: true
                }
            }
        });

        // 隱藏清除按鈕和添加 form-control 類別
        function hideWebixClearButton() {
            // 隱藏清除按鈕
            var clearIcons = document.querySelectorAll('.webix_cal_icon_clear');
            clearIcons.forEach(function(icon) {
                icon.style.display = 'none !important';
            });

            // 為 input 添加 form-control 類別
            var dateInput = document.querySelector('#manuscriptDate input');
            var releaseInput = document.querySelector('#manuscript_Release input');
            
            if (dateInput) {
                dateInput.classList.add('form-control');
            }
            
            if (releaseInput) {
                releaseInput.classList.add('form-control');
            }
        }

        // 初始化後隱藏清除按鈕
        setTimeout(hideWebixClearButton, 100);
        
        // 監聽事件，持續隱藏清除按鈕
        manuscriptDatePicker.attachEvent("onShow", hideWebixClearButton);
        manuscriptDatePicker.attachEvent("onAfterRender", hideWebixClearButton);
        manuscriptReleasePicker.attachEvent("onShow", hideWebixClearButton);
        manuscriptReleasePicker.attachEvent("onAfterRender", hideWebixClearButton);

        // 監聽審查通過時間複選框
        var checkReviewRelease = document.getElementById('checkReviewRelease');
        if (checkReviewRelease) {
            checkReviewRelease.addEventListener('change', function() {
                if (this.checked) {
                    // 勾選時禁用 manuscriptRelease DateTimePicker
                    manuscriptReleasePicker.disable();
                } else {
                    // 取消勾選時啟用 manuscriptRelease DateTimePicker
                    manuscriptReleasePicker.enable();
                }
            });
        }

        // 監聽視窗大小變化
        window.addEventListener('resize', function() {
            setTimeout(hideWebixClearButton, 100);
        });

        // 使用 MutationObserver 持續監控並隱藏清除按鈕
        var observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.type === 'childList') {
                    mutation.addedNodes.forEach(function(node) {
                        if (node.nodeType === 1) {
                            // 隱藏新添加的清除按鈕
                            if (node.classList && node.classList.contains('webix_cal_icon_clear')) {
                                node.style.display = 'none !important';
                            }
                            
                            // 檢查子元素中的清除按鈕
                            var clearIcons = node.querySelectorAll ? node.querySelectorAll('.webix_cal_icon_clear') : [];
                            clearIcons.forEach(function(icon) {
                                icon.style.display = 'none !important';
                            });
                        }
                    });
                }
            });
        });

        // 監控整個 document
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    });
</script>

