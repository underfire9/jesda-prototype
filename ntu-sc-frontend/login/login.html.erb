<!-- template: 登入 -->

<div class="workspace" canvas="container">
    <h1 class="h1-brands">
        <span class="brands-logo">臺大夏季學院</span>
    </h1>
    <div class="language-switcher">
        <a href="?lang=en" title="English"><span>EN</span></a>
    </div>
    <div class="login-page">
        <div class="login-container">
            <div class="login-card">
                <form class="login-form" action="role.html" method="post">
                    <div class="card-bd">
                        <div class="form-group">
                            <label for="exampleFormControlInput1" class="form-label">帳號</label>
                            <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="name@example.com" />
                        </div>
                        <div class="form-group">
                            <label for="exampleFormControlInput2" class="form-label">密碼</label>
                            <input type="password" class="form-control" id="exampleFormControlInput2" />
                            <div class="form-text text-end"><a href="forget-password.html" class="forget-link">忘記密碼？</a></div>
                        </div>
                        <div class="form-group">
                            <label for="loginInput4" class="form-label">驗證碼</label>
                            <div class="d-flex align-items-center">
                                <span class="me-1" style="width: 160px;"><input type="text" class="form-control" id="loginInput4" /></span>
                                <span class="me-1"><img class="captcha" src="http://nfu-map.dev.com.tw/common/captcha.image" /></span>
                                <span>
                                    <button class="btn btn-outline-dark" type="button"><i class="fas fa-sync-alt"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="login-action d-grid">
                        <button class="btn btn-lg btn-main" type="submit">登入</button>
                    </div>
                </form>
            </div>
            <div class="register-card">
                <h6>還沒有帳號？</h6>
                <div class="flex-wrap">
                    <a href="#" class="btn-affidavit"">學生註冊</a>
                    <a href="#" class="btn-affidavit"">教師註冊</a>
                </div>
            </div>
        </div>
    </div>

</div>



<% content_for :js do %>
<script>
function showAffidavit(event) {
    event.preventDefault();
    document.querySelector('.workspace').className = 'workspace show-affidavit';
}

function showRegister(event) {
    event.preventDefault();
    document.querySelector('.workspace').className = 'workspace show-register';
    // 重置註冊頁面狀態
    document.querySelector('.btn-register').style.display = 'block';
    document.querySelector('.btn-register-done').style.display = 'none';
    document.querySelector('.register-back-wrap').style.display = 'block';
}

function showLogin(event) {
    event.preventDefault();
    document.querySelector('.workspace').className = 'workspace';
}

function handleRegister(event) {
    event.preventDefault();
    // 隱藏註冊按鈕
    event.target.style.display = 'none';
    // 顯示前往登入按鈕
    document.querySelector('.btn-register-done').style.display = 'block';
    // 隱藏返回登入連結
    document.querySelector('.register-back-wrap').style.display = 'none';
}
</script>
<% end %>

