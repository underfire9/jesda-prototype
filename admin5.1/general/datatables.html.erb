<!-- Modal Hoisting -->
<script>
    (function () {
        function hoistModalsToBody() {
            var modals = document.querySelectorAll('.content-wrapper .modal');
            Array.prototype.forEach.call(modals, function (modalEl) {
                if (modalEl.parentNode !== document.body) {
                    document.body.appendChild(modalEl);
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', hoistModalsToBody);
        } else {
            hoistModalsToBody();
        }
    }());
</script>

<!-- DataTables -->
<script src="../javascripts/datatables.min.js"></script>
<script>
    (function () {
        if (window.__staffTableBooted) {
            return;
        }
        window.__staffTableBooted = true;

        function initStaffTable() {
            var tableEl = document.getElementById('staffTable');
            if (!tableEl) {
                return;
            }

            var options = {
                pageLength: 15,
                lengthMenu: [10, 15, 30, 50, 100],
                order: [[1, 'asc']],
                columnDefs: [
                    { targets: [0, 3, 4, 5, 6, 8, 9], orderable: false }
                ],
                language: {
                    search: '搜尋：',
                    lengthMenu: '<span>每頁</span> _MENU_ <span>筆</span>',
                    info: '顯示 _START_ - _END_，共 _TOTAL_ 筆',
                    infoEmpty: '顯示 0 - 0，共 0 筆',
                    paginate: {
                        previous: '上一頁',
                        next: '下一頁'
                    }
                },
                layout: {
                    topStart: 'search',
                    topEnd: null,
                    bottomStart: ['pageLength', 'info'],
                    bottomEnd: 'paging'
                }
            };

            var dt;
            if (window.jQuery && jQuery.fn && jQuery.fn.DataTable) {
                dt = jQuery('#staffTable').DataTable(options);
            } else if (typeof DataTable !== 'undefined') {
                dt = new DataTable('#staffTable', options);
            } else {
                return;
            }

            var wrapper = dt.table ? dt.table().container() : tableEl.closest('.dataTables_wrapper, .dt-container');
            var toolbar = document.querySelector('.datatables-toolbar');
            var ftStart = document.querySelector('.datatables-footer .ft-start');
            var ftEnd = document.querySelector('.datatables-footer .ft-end');
            var fieldPanelToggleBtn = document.getElementById('toggleFieldSettingPanel');
            var fieldSettingPanel = document.getElementById('fieldSettingPanel');
            var advancedSearchCollapseEl = document.getElementById('adSearch');
            var filterPanelCollapseEl = document.getElementById('filterBarPanel');
            var advancedSearchCollapse = null;
            var filterPanelCollapse = null;
            var fieldOrderList = document.getElementById('fieldOrderList');
            var fieldSelectAllBtn = document.getElementById('fieldSelectAllBtn');
            var fieldResetBtn = document.getElementById('fieldResetBtn');
            var fieldApplyBtn = document.getElementById('fieldApplyBtn');
            var allColumnIndexes = [];
            var initialColumnOrder = [];
            var currentColumnOrder = [];
            var initialColumnVisibility = {};
            var currentColumnVisibility = {};
            var fieldListDragBound = false;
            var draggingFieldItem = null;

            function extractHeaderTitle(cell, fallbackIndex) {
                if (!cell) {
                    return '欄位 ' + String(fallbackIndex + 1);
                }

                var title = (cell.textContent || '').replace(/\s+/g, ' ').trim();
                if (title) {
                    return title;
                }

                var inputTitle = cell.querySelector('input[title], button[title]');
                if (inputTitle) {
                    var named = (inputTitle.getAttribute('title') || '').trim();
                    if (named) {
                        return named;
                    }
                }

                return '欄位 ' + String(fallbackIndex + 1);
            }

            function cloneVisibilityMap(sourceMap) {
                var result = {};
                allColumnIndexes.forEach(function (columnIndex) {
                    result[columnIndex] = sourceMap[columnIndex] !== false;
                });
                return result;
            }

            function setFieldPanelVisibility(isOpen) {
                if (!fieldSettingPanel) {
                    return;
                }

                fieldSettingPanel.classList.toggle('is-open', !!isOpen);
                fieldSettingPanel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
                if (fieldPanelToggleBtn) {
                    fieldPanelToggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                }
            }

            function hideAdvancedSearchPanel() {
                if (!advancedSearchCollapseEl) {
                    return;
                }

                if (advancedSearchCollapse) {
                    advancedSearchCollapse.hide();
                    return;
                }

                advancedSearchCollapseEl.classList.remove('show');
                advancedSearchCollapseEl.setAttribute('aria-expanded', 'false');
            }

            function hideFilterPanel() {
                if (!filterPanelCollapseEl) {
                    return;
                }

                if (filterPanelCollapse) {
                    filterPanelCollapse.hide();
                    return;
                }

                filterPanelCollapseEl.classList.remove('show');
                filterPanelCollapseEl.setAttribute('aria-expanded', 'false');
            }

            function getDragAfterElement(container, y) {
                var draggableItems = Array.prototype.slice.call(
                    container.querySelectorAll('.field-order-item:not(.dragging)')
                );

                return draggableItems.reduce(function (closest, item) {
                    var box = item.getBoundingClientRect();
                    var offset = y - box.top - box.height / 2;
                    if (offset < 0 && offset > closest.offset) {
                        return {
                            offset: offset,
                            element: item
                        };
                    }
                    return closest;
                }, {
                    offset: Number.NEGATIVE_INFINITY,
                    element: null
                }).element;
            }

            function bindFieldListDragEvents() {
                if (!fieldOrderList) {
                    return;
                }
                var items = fieldOrderList.querySelectorAll('.field-order-item');

                Array.prototype.forEach.call(items, function (item) {
                    item.addEventListener('dragstart', function () {
                        draggingFieldItem = item;
                        item.classList.add('dragging');
                    });

                    item.addEventListener('dragend', function () {
                        item.classList.remove('dragging');
                        draggingFieldItem = null;
                    });
                });

                if (!fieldListDragBound) {
                    fieldOrderList.addEventListener('dragover', function (event) {
                        if (!draggingFieldItem) {
                            return;
                        }

                        event.preventDefault();
                        var afterElement = getDragAfterElement(fieldOrderList, event.clientY);
                        if (!afterElement) {
                            fieldOrderList.appendChild(draggingFieldItem);
                        } else {
                            fieldOrderList.insertBefore(draggingFieldItem, afterElement);
                        }
                    });

                    fieldListDragBound = true;
                }
            }

            function renderFieldOrderList(order, visibilityMap) {
                if (!fieldOrderList) {
                    return;
                }

                fieldOrderList.innerHTML = '';
                order.forEach(function (columnIndex, position) {
                    var columnHeader = dt.column(columnIndex).header();
                    var title = extractHeaderTitle(columnHeader, columnIndex);
                    var checkId = 'field-column-' + String(columnIndex);
                    var item = document.createElement('div');
                    var handle = document.createElement('span');
                    var handleIcon = document.createElement('i');
                    var formCheck = document.createElement('div');
                    var checkbox = document.createElement('input');
                    var label = document.createElement('label');
                    var isChecked = visibilityMap[columnIndex] !== false;

                    item.className = 'field-order-item';
                    item.setAttribute('draggable', 'true');
                    item.setAttribute('data-column-index', String(columnIndex));

                    handle.className = 'field-drag-handle';
                    handle.setAttribute('aria-hidden', 'true');
                    handleIcon.className = 'bi bi-grip-vertical';
                    handle.appendChild(handleIcon);

                    formCheck.className = 'form-check mb-0';

                    checkbox.className = 'form-check-input field-toggle-check';
                    checkbox.type = 'checkbox';
                    checkbox.id = checkId;
                    checkbox.checked = isChecked;

                    label.className = 'form-check-label';
                    label.setAttribute('for', checkId);
                    label.textContent = title;

                    formCheck.appendChild(checkbox);
                    formCheck.appendChild(label);
                    item.appendChild(handle);
                    item.appendChild(formCheck);

                    if (position === 0) {
                        item.classList.add('first-item');
                    }

                    fieldOrderList.appendChild(item);
                });

                bindFieldListDragEvents();
            }

            function getCurrentPanelOrder() {
                if (!fieldOrderList) {
                    return currentColumnOrder.slice();
                }

                return Array.prototype.map.call(
                    fieldOrderList.querySelectorAll('.field-order-item'),
                    function (item) {
                        return parseInt(item.getAttribute('data-column-index'), 10);
                    }
                ).filter(function (columnIndex) {
                    return !isNaN(columnIndex);
                });
            }

            function getCurrentPanelVisibility() {
                var visibilityMap = cloneVisibilityMap(currentColumnVisibility);
                if (!fieldOrderList) {
                    return visibilityMap;
                }

                Array.prototype.forEach.call(fieldOrderList.querySelectorAll('.field-order-item'), function (item) {
                    var columnIndex = parseInt(item.getAttribute('data-column-index'), 10);
                    var checkbox = item.querySelector('.field-toggle-check');
                    if (isNaN(columnIndex) || !checkbox) {
                        return;
                    }
                    visibilityMap[columnIndex] = checkbox.checked;
                });

                return visibilityMap;
            }

            function tagVisibleCellsByColumnIndex() {
                var visibleIndexes = dt.columns(':visible').indexes().toArray();
                var sections = [];

                if (tableEl.tHead) {
                    sections.push(tableEl.tHead);
                }
                Array.prototype.forEach.call(tableEl.tBodies, function (body) {
                    sections.push(body);
                });
                if (tableEl.tFoot) {
                    sections.push(tableEl.tFoot);
                }

                sections.forEach(function (section) {
                    Array.prototype.forEach.call(section.rows, function (row) {
                        Array.prototype.forEach.call(row.children, function (cell, index) {
                            var columnIndex = visibleIndexes[index];
                            if (typeof columnIndex === 'number') {
                                cell.setAttribute('data-col-index', String(columnIndex));
                            } else {
                                cell.removeAttribute('data-col-index');
                            }
                        });
                    });
                });
            }

            function reorderVisibleColumnsByOrder(visibleOrder) {
                var sections = [];

                if (tableEl.tHead) {
                    sections.push(tableEl.tHead);
                }
                Array.prototype.forEach.call(tableEl.tBodies, function (body) {
                    sections.push(body);
                });
                if (tableEl.tFoot) {
                    sections.push(tableEl.tFoot);
                }

                sections.forEach(function (section) {
                    Array.prototype.forEach.call(section.rows, function (row) {
                        var cells = Array.prototype.slice.call(row.children);
                        if (!cells.length) {
                            return;
                        }

                        var cellMap = {};
                        cells.forEach(function (cell) {
                            var key = cell.getAttribute('data-col-index');
                            if (key !== null) {
                                cellMap[key] = cell;
                            }
                        });

                        var fragment = document.createDocumentFragment();
                        visibleOrder.forEach(function (columnIndex) {
                            var key = String(columnIndex);
                            if (cellMap[key]) {
                                fragment.appendChild(cellMap[key]);
                                delete cellMap[key];
                            }
                        });

                        Array.prototype.forEach.call(row.children, function (cell) {
                            if (cell.parentNode === row) {
                                fragment.appendChild(cell);
                            }
                        });

                        row.appendChild(fragment);
                    });
                });
            }

            function applyFieldSettingsToDataTable() {
                allColumnIndexes.forEach(function (columnIndex) {
                    var visible = currentColumnVisibility[columnIndex] !== false;
                    dt.column(columnIndex).visible(visible, false);
                });

                tagVisibleCellsByColumnIndex();
                reorderVisibleColumnsByOrder(
                    currentColumnOrder.filter(function (columnIndex) {
                        return currentColumnVisibility[columnIndex] !== false;
                    })
                );

                if (dt.columns && typeof dt.columns.adjust === 'function') {
                    dt.columns.adjust();
                }
                dt.draw(false);
            }

            function resetFieldSettingsToDefault() {
                currentColumnOrder = initialColumnOrder.slice();
                currentColumnVisibility = cloneVisibilityMap(initialColumnVisibility);
                renderFieldOrderList(currentColumnOrder, currentColumnVisibility);
            }

            function checkAllFieldSettings() {
                if (!fieldOrderList) {
                    return;
                }

                Array.prototype.forEach.call(fieldOrderList.querySelectorAll('.field-toggle-check'), function (checkbox) {
                    checkbox.checked = true;
                });
            }

            function setupFieldSettingPanel() {
                if (!fieldSettingPanel || !fieldOrderList) {
                    return;
                }

                allColumnIndexes = dt.columns().indexes().toArray();
                initialColumnOrder = allColumnIndexes.slice();
                currentColumnOrder = allColumnIndexes.slice();

                allColumnIndexes.forEach(function (columnIndex) {
                    var visible = dt.column(columnIndex).visible();
                    initialColumnVisibility[columnIndex] = visible;
                });
                currentColumnVisibility = cloneVisibilityMap(initialColumnVisibility);

                renderFieldOrderList(currentColumnOrder, currentColumnVisibility);
                setFieldPanelVisibility(false);

                if (fieldPanelToggleBtn) {
                    fieldPanelToggleBtn.addEventListener('click', function () {
                        var opened = fieldSettingPanel.classList.contains('is-open');
                        if (!opened) {
                            hideAdvancedSearchPanel();
                            hideFilterPanel();
                        }
                        setFieldPanelVisibility(!opened);
                    });
                }

                if (fieldSelectAllBtn) {
                    fieldSelectAllBtn.addEventListener('click', function () {
                        checkAllFieldSettings();
                    });
                }

                if (fieldResetBtn) {
                    fieldResetBtn.addEventListener('click', function () {
                        resetFieldSettingsToDefault();
                    });
                }

                if (fieldApplyBtn) {
                    fieldApplyBtn.addEventListener('click', function () {
                        currentColumnOrder = getCurrentPanelOrder();
                        currentColumnVisibility = getCurrentPanelVisibility();
                        applyFieldSettingsToDataTable();
                        setFieldPanelVisibility(false);
                    });
                }
            }

            function setupToolbarMutualExclusion() {
                if (!advancedSearchCollapseEl && !filterPanelCollapseEl) {
                    return;
                }

                if (window.bootstrap && bootstrap.Collapse) {
                    if (advancedSearchCollapseEl) {
                        advancedSearchCollapse = bootstrap.Collapse.getOrCreateInstance(advancedSearchCollapseEl, {
                            toggle: false
                        });
                    }

                    if (filterPanelCollapseEl) {
                        filterPanelCollapse = bootstrap.Collapse.getOrCreateInstance(filterPanelCollapseEl, {
                            toggle: false
                        });
                    }
                }

                if (advancedSearchCollapseEl) {
                    advancedSearchCollapseEl.addEventListener('show.bs.collapse', function () {
                        setFieldPanelVisibility(false);
                        hideFilterPanel();
                    });
                }

                if (filterPanelCollapseEl) {
                    filterPanelCollapseEl.addEventListener('show.bs.collapse', function () {
                        setFieldPanelVisibility(false);
                        hideAdvancedSearchPanel();
                    });
                }
            }

            function cleanupEmptyDtLayout(container) {
                if (!container) return;

                var shells = container.querySelectorAll('.dt-layout-start, .dt-layout-end');
                Array.prototype.forEach.call(shells, function (shell) {
                    if (!shell.children.length && !shell.textContent.trim()) {
                        shell.remove();
                    }
                });

                var rows = container.querySelectorAll('.dt-layout-row, .row.mt-2.justify-content-between');
                Array.prototype.forEach.call(rows, function (row) {
                    if (!row.children.length && !row.textContent.trim()) {
                        row.remove();
                    }
                });
            }

            if (wrapper && toolbar) {
                var search = wrapper.querySelector('.dt-search, .dataTables_filter');
                var toolbarSearch = toolbar.querySelector('.toolbar-search');
                if (search && toolbarSearch) {
                    toolbarSearch.appendChild(search);
                } else if (search) {
                    toolbar.appendChild(search);
                }

                var searchInput = search ? search.querySelector('input[type="search"], input') : null;
                if (searchInput) {
                    searchInput.classList.remove('form-control-sm');
                    searchInput.setAttribute('placeholder', '關鍵字搜尋');
                }
            }
            if (wrapper && ftStart) {
                var length = wrapper.querySelector('.dt-length, .dataTables_length');
                var info = wrapper.querySelector('.dt-info, .dataTables_info');
                if (length) ftStart.appendChild(length);
                if (info) ftStart.appendChild(info);
            }
            if (wrapper && ftEnd) {
                var paging = wrapper.querySelector('.dt-paging, .dataTables_paginate');
                if (paging) {
                    ftEnd.appendChild(paging);
                }
            }

            function getPageInfo() {
                if (dt && typeof dt.page === 'function' && typeof dt.page.info === 'function') {
                    return dt.page.info();
                }
                return null;
            }

            function ensurePageInputNavigation() {
                if (!ftEnd) return;

                var exists = ftEnd.querySelector('.dt-page-nav');
                if (exists) return;

                var nav = document.createElement('div');
                nav.className = 'dt-page-nav';
                nav.innerHTML = '' +
                    '<span class="dt-page-unit">第</span>' +
                    '<input type="text" class="form-control dt-page-input" inputmode="numeric" aria-label="頁碼輸入">' +
                    '<span class="dt-page-unit">頁</span>';

                ftEnd.appendChild(nav);

                var pageInput = nav.querySelector('.dt-page-input');

                function syncPageInputNavigation() {
                    var info = getPageInfo();
                    var totalPages = info && info.pages ? info.pages : 1;
                    pageInput.dataset.maxPage = String(totalPages);
                }

                function jumpToPage() {
                    var info = getPageInfo();
                    if (!info || !info.pages) return;
                    var target = parseInt(pageInput.value, 10);
                    if (isNaN(target)) return;

                    target = Math.max(1, Math.min(info.pages, target));
                    pageInput.value = String(target);
                    dt.page(target - 1).draw('page');
                }

                pageInput.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        jumpToPage();
                    }
                });

                pageInput.addEventListener('blur', function () {
                    if (!pageInput.value.trim()) {
                        syncPageInputNavigation();
                    }
                });

                syncPageInputNavigation();
            }

            function applyPaginationSizeClass() {
                var pagerList = ftEnd ? ftEnd.querySelector('ul.pagination') : null;
                var sizeSwitch = document.getElementById('switchTableSize');
                if (!pagerList) return;
                pagerList.classList.toggle('pagination-sm', !!(sizeSwitch && sizeSwitch.checked));
            }

            function applyLengthSelectSizeClass() {
                var sizeSwitch = document.getElementById('switchTableSize');
                var lengthSelect = ftStart
                    ? ftStart.querySelector('select#dt-length-0, .dt-length select, .dataTables_length select')
                    : null;
                if (!lengthSelect) return;
                lengthSelect.classList.toggle('form-select-sm', !!(sizeSwitch && sizeSwitch.checked));
            }

            function applyPageInputSizeClass() {
                var sizeSwitch = document.getElementById('switchTableSize');
                var pageInput = ftEnd ? ftEnd.querySelector('.dt-page-input') : null;
                if (!pageInput) return;
                pageInput.classList.toggle('form-control-sm', !!(sizeSwitch && sizeSwitch.checked));
            }

            function applySearchInputSizeClass() {
                if (!wrapper) return;

                var searchInputs = wrapper.querySelectorAll(
                    '.dt-search input, .dataTables_filter input, .toolbar-search input, input[type="search"].dt-input'
                );
                if (!searchInputs.length) return;

                Array.prototype.forEach.call(searchInputs, function (inputEl) {
                    inputEl.classList.remove('form-control-sm');
                });
            }

            function applySearchInputSizeClassDeferred() {
                window.setTimeout(applySearchInputSizeClass, 0);
            }

            ensurePageInputNavigation();
            applyPaginationSizeClass();
            applyLengthSelectSizeClass();
            applyPageInputSizeClass();
            applySearchInputSizeClass();
            applySearchInputSizeClassDeferred();

            cleanupEmptyDtLayout(wrapper);
            setupFieldSettingPanel();
            setupToolbarMutualExclusion();

            var headerCheck = document.getElementById('selectAllRows');
            function visibleChecks() {
                return Array.prototype.slice.call(tableEl.querySelectorAll('tbody .row-check'));
            }
            function syncHeaderCheckbox() {
                if (!headerCheck) return;
                var checks = visibleChecks();
                var total = checks.length;
                var checked = checks.filter(function (el) { return el.checked; }).length;
                headerCheck.checked = total > 0 && checked === total;
                headerCheck.indeterminate = checked > 0 && checked < total;
            }

            if (headerCheck) {
                headerCheck.addEventListener('change', function () {
                    visibleChecks().forEach(function (el) { el.checked = headerCheck.checked; });
                });
            }

            tableEl.addEventListener('change', function (event) {
                if (event.target.classList.contains('row-check')) {
                    syncHeaderCheckbox();
                }
            });

            if (dt.on) {
                dt.on('draw', function () {
                    syncHeaderCheckbox();
                    ensurePageInputNavigation();
                    applyPaginationSizeClass();
                    applyLengthSelectSizeClass();
                    applyPageInputSizeClass();
                    applySearchInputSizeClass();
                    applySearchInputSizeClassDeferred();
                    tagVisibleCellsByColumnIndex();
                    reorderVisibleColumnsByOrder(
                        currentColumnOrder.filter(function (columnIndex) {
                            return currentColumnVisibility[columnIndex] !== false;
                        })
                    );
                });
            } else if (window.jQuery) {
                jQuery('#staffTable').on('draw.dt', function () {
                    syncHeaderCheckbox();
                    ensurePageInputNavigation();
                    applyPaginationSizeClass();
                    applyLengthSelectSizeClass();
                    applyPageInputSizeClass();
                    applySearchInputSizeClass();
                    applySearchInputSizeClassDeferred();
                    tagVisibleCellsByColumnIndex();
                    reorderVisibleColumnsByOrder(
                        currentColumnOrder.filter(function (columnIndex) {
                            return currentColumnVisibility[columnIndex] !== false;
                        })
                    );
                });
            }

            var tableSizeSwitch = document.getElementById('switchTableSize');
            var datatablesWrapper = tableEl.closest('.datatables-wrapper');
            var datatablesFilterBar = document.querySelector('.datatables-filter-bar');
            function applyTableSizeClass() {
                if (!tableSizeSwitch) return;
                tableEl.classList.toggle('table-sm', !!tableSizeSwitch.checked);
                if (datatablesWrapper) {
                    datatablesWrapper.classList.toggle('content-small', !!tableSizeSwitch.checked);
                }
                if (datatablesFilterBar) {
                    datatablesFilterBar.classList.toggle('filter-bar-small', !!tableSizeSwitch.checked);
                }
                applyPaginationSizeClass();
                applyLengthSelectSizeClass();
                applyPageInputSizeClass();
                applySearchInputSizeClass();
                applySearchInputSizeClassDeferred();
            }
            if (tableSizeSwitch) {
                tableSizeSwitch.addEventListener('change', applyTableSizeClass);
                applyTableSizeClass();
            }

            syncHeaderCheckbox();
        }

        function boot() {
            initStaffTable();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
        } else {
            boot();
        }
    }());
</script>

<!-- 匯出功能 -->
<script>
    (() => {
        const getLists = () => {
            const dataList = document.querySelector(".data-list .outbound-menu");
            const outboundList = document.querySelector(".outbound-list .outbound-menu");
            if (!dataList || !outboundList) {
                return null;
            }
            return { dataList, outboundList };
        };

        const updateNumbers = (dataList, outboundList) => {
            const updateList = (list) => {
                const items = list.querySelectorAll(".data-item");
                items.forEach((item, index) => {
                    const numberEl = item.querySelector(".item-number");
                    if (numberEl) {
                        numberEl.textContent = String(index + 1).padStart(2, "0");
                    }
                });
            };

            updateList(dataList);
            updateList(outboundList);
        };

        const setItemState = (item, isOutbound) => {
            const button = item.querySelector(".btn");
            if (button) {
                button.classList.remove(isOutbound ? "btn-light" : "btn-success");
                button.classList.add(isOutbound ? "btn-success" : "btn-light");
            }
        };

        const animateMove = (item, targetList) => {
            item.classList.add("moving");
            targetList.appendChild(item);
            window.setTimeout(() => {
                item.classList.remove("moving");
            }, 2000);
        };

        const moveItem = (item, targetList, isOutbound, dataList, outboundList) => {
            setItemState(item, isOutbound);
            animateMove(item, targetList);
            updateNumbers(dataList, outboundList);
        };

        const moveAllItems = (fromList, toList, isOutbound, dataList, outboundList) => {
            const items = Array.from(fromList.querySelectorAll(".data-item"));
            if (items.length === 0) {
                return;
            }

            items.forEach((item) => {
                setItemState(item, isOutbound);
                animateMove(item, toList);
            });

            updateNumbers(dataList, outboundList);
        };

        const applyToolbarSticky = () => {
            const toolbar = document.querySelector(".outbound-toolbar");
            if (!toolbar) {
                return;
            }

            toolbar.style.position = "sticky";
            toolbar.style.top = "0";
            toolbar.style.zIndex = "10";
            toolbar.style.backgroundColor = "#fff";
        };

        const init = () => {
            document.addEventListener("shown.bs.modal", (event) => {
                if (event.target && event.target.id === "outboundModal") {
                    applyToolbarSticky();
                }
            });

            document.addEventListener("click", (event) => {
                const selectAllBtn = event.target.closest("#outboundSelectAll");
                if (selectAllBtn) {
                    event.preventDefault();
                    const lists = getLists();
                    if (!lists) {
                        return;
                    }
                    moveAllItems(lists.dataList, lists.outboundList, true, lists.dataList, lists.outboundList);
                    return;
                }

                const deselectAllBtn = event.target.closest("#outboundDeselectAll");
                if (deselectAllBtn) {
                    event.preventDefault();
                    const lists = getLists();
                    if (!lists) {
                        return;
                    }
                    moveAllItems(lists.outboundList, lists.dataList, false, lists.dataList, lists.outboundList);
                    return;
                }

                const itemBtn = event.target.closest(
                    ".data-list .outbound-menu .data-item .btn, .outbound-list .outbound-menu .data-item .btn"
                );
                if (!itemBtn) {
                    return;
                }

                const item = itemBtn.closest(".data-item");
                if (!item) {
                    return;
                }

                const lists = getLists();
                if (!lists) {
                    return;
                }

                if (lists.dataList.contains(item)) {
                    moveItem(item, lists.outboundList, true, lists.dataList, lists.outboundList);
                } else if (lists.outboundList.contains(item)) {
                    moveItem(item, lists.dataList, false, lists.dataList, lists.outboundList);
                }
            });

            const lists = getLists();
            if (lists) {
                updateNumbers(lists.dataList, lists.outboundList);
            }
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();
</script>

<!-- Bootstrap Tooltips -->
<script>
    (function () {
        var openModalCount = 0;

        function setToolbarTooltipsEnabled(enabled) {
            if (!window.bootstrap || !bootstrap.Tooltip) {
                return;
            }

            var toolbarTriggers = document.querySelectorAll('.datatables-toolbar [data-bs-toggle="tooltip"]');
            Array.prototype.forEach.call(toolbarTriggers, function (triggerEl) {
                var instance = bootstrap.Tooltip.getInstance(triggerEl);
                if (!instance) {
                    return;
                }

                if (enabled) {
                    instance.enable();
                    return;
                }

                instance.hide();
                instance.disable();
            });
        }

        function hideAllTooltips() {
            if (!window.bootstrap || !bootstrap.Tooltip) {
                return;
            }

            var activeTooltipTriggers = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            Array.prototype.forEach.call(activeTooltipTriggers, function (triggerEl) {
                var instance = bootstrap.Tooltip.getInstance(triggerEl);
                if (instance) {
                    instance.hide();
                }
            });
        }

        function initTooltips() {
            if (!window.bootstrap || !bootstrap.Tooltip) {
                return;
            }

            var tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            Array.prototype.forEach.call(tooltipTriggerList, function (triggerEl) {
                var tooltipContainer = triggerEl.closest('.modal') || document.body;
                bootstrap.Tooltip.getOrCreateInstance(triggerEl, {
                    container: tooltipContainer
                });
            });

            var modalList = document.querySelectorAll('.modal');
            Array.prototype.forEach.call(modalList, function (modalEl) {
                modalEl.addEventListener('show.bs.modal', function () {
                    openModalCount += 1;
                    hideAllTooltips();
                    setToolbarTooltipsEnabled(false);
                });

                modalEl.addEventListener('hidden.bs.modal', function () {
                    openModalCount = Math.max(0, openModalCount - 1);
                    hideAllTooltips();

                    if (openModalCount === 0) {
                        setToolbarTooltipsEnabled(true);
                    }
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTooltips);
        } else {
            initTooltips();
        }
    }());
</script>

