<!-- template: 學校聯絡人 - 計畫申請/計畫主持人帳號管理 -->
<% content_for :header_center do %>
    <span class="central-title">計畫主持人帳號管理</span>
<% end %>

<div class="container">
    <div class="page-content">

        <!-- 需要設定條件，在超過 10 筆資料才出現 -->
        <div class="page-toolbar justify-content-end">
            <div class="manager-search toolbar-clip">
                <select id="managerSearchSelect" class="form-select" data-placeholder="請輸入姓名或 email 搜尋">
                    <option value=""></option>
                </select>
            </div>
        </div>
        
        <div class="manager-list-wrapper">
            <% (1..16).map do |i| %>
            <div class="manager-card">
                <div class="card-bd">
                    <div class="item-info">
                        <span class="item-label">計畫主持人姓名</span>
                        <span class="item-value fw-bold"><%= zh_lorem_name %></span>
                    </div>
                    <div class="item-info">
                        <span class="item-label">電子信箱</span>
                        <span class="item-value fs-6"><%= lorem_email %></span>
                    </div>
                </div>
                <div class="card-ft">
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-secondary btn-sm">刪除</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#managerModal">編輯</button>
                    </div>
                    <button type="button" class="btn btn-info btn-sm shadow-none" data-bs-toggle="tooltip" data-bs-title="寄送計畫通知"><i class="fas fa-paper-plane"></i></button>
                </div>
            </div>
            <% end %>
        </div>
        <div class="form-action no-border">
            <span class="backhome">
                <a href="apply.html" class="btn btn-lg btn-light">
                    <i class="fas fa-long-arrow-alt-left"></i>
                    <span class="md-none">回上一頁</span>
                </a>
            </span>
            <button type="button" class="btn btn-lg btn-primary px-4" data-bs-toggle="modal" data-bs-target="#managerModal">
                <i class="fas fa-plus me-1"></i> 新增
            </button>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="managerModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="managerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="managerModalLabel">新增{編輯}計畫主持人</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="managerName" class="form-label">計畫主持人姓名</label>
                    <input type="text" class="form-control" id="managerName" placeholder="請輸入">
                </div>
                <div class="form-group mt-3">
                    <label for="managerEmail" class="form-label">電子信箱</label>
                    <input type="email" class="form-control" id="managerEmail" placeholder="example@example.com">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="button" class="btn btn-primary">儲存</button>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>
<script>
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
</script>

<!-- select2-->
<script src="../javascripts/select2.min.js"></script>
<script>
    ( function() {
        const $managerSearch = $( '#managerSearchSelect' );

        if ( !$managerSearch.length || typeof $.fn.select2 !== 'function' ) {
            return;
        }

        const managerCards = Array.from( document.querySelectorAll( '.manager-card' ) );
        const managerList = managerCards.map( ( card, index ) => {
            const name = card.querySelector( '.item-value.fw-bold' )?.textContent?.trim() || '';
            const email = card.querySelector( '.item-value.fs-6' )?.textContent?.trim() || '';

            card.setAttribute( 'data-manager-id', String( index ) );

            return {
                id: String( index ),
                text: `${name} (${email})`,
                name,
                email
            };
        } );

        managerList.forEach( ( item ) => {
            const option = new Option( item.text, item.id, false, false );
            $managerSearch.append( option );
        } );

        $managerSearch.select2( {
            theme: 'bootstrap-5',
            width: '100%',
            placeholder: $managerSearch.data( 'placeholder' ),
            allowClear: true,
            matcher: function( params, data ) {
                if ( $.trim( params.term ) === '' ) {
                    return data;
                }

                const keyword = params.term.toLowerCase();
                const optionText = ( data.text || '' ).toLowerCase();

                if ( optionText.includes( keyword ) ) {
                    return data;
                }

                return null;
            }
        } );

        function filterManagerCards( selectedId ) {
            managerCards.forEach( ( card ) => {
                const shouldShow = !selectedId || card.getAttribute( 'data-manager-id' ) === selectedId;
                card.style.display = shouldShow ? '' : 'none';
            } );
        }

        $managerSearch.on( 'change', function() {
            const selectedId = $( this ).val();
            filterManagerCards( selectedId );
        } );
    } )();
</script>
<% end %>

