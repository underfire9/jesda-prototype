<!-- Modal -->
<div class="modal fade" id="applyCoursesModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="applyCoursesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white" data-bs-theme="dark">
                <h1 class="modal-title fs-5" id="applyCoursesModalLabel">課程申請注意事項</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ol class="mb-5">
                    <li><strong>原提出計畫書之校為聘任單位：</strong>秉持課程資源共享促進交流的理念，以「校」為合作對象，全國夏季學院邀請夥伴學校提出優質通識課程，於課程進行期間教師仍須聘任於原提出課程之學校，若無續聘將無法開設課程。此外，教師受聘於原提出課程之學校，並非全國夏季學院聘任之教師，故全國夏季學院不會提供聘書。</li>
                    <li><strong>開課門檻：</strong><span class="text-danger">繳費人數超過15人始得開課</span>，教師可登入「全國夏季學院線上系統」查看修課人數，<span class="text-danger">課程開始前2週確認是否開課成功</span>。</li>
                </ol>
                <p class="mt-4">預計行政課程執行時程表</p>
                <div class="modal_schedule-wrapper mb-4">
                    <div class="card-item">
                        <h5 class="fw-bold">開課前 2-3 週</h5>
                        <h6 class="py-3">教師</h6>
                        <ol>
                            <li>課程開始前2週確認是否開課成功，教師可登入「全國夏季學院線上系統」隨時查看修課人數。</li>
                            <li>找尋適任之課程教學助教，並告知須全程參與全國夏季學院教學助教研習會，遲到或  缺席需進行補課。</li>
                            <li>本單位會依據最終修課人數，告知可聘任之教學助教人數。</li>
                        </ol>
                    </div>
                    <div class="card-item">
                        <h5 class="fw-bold">開課前 1 週</h5>
                        <h6 class="py-3">教學助教</h6>
                        <ol>
                            <li>完成全國夏季學院教學助教研習會培訓課程及聘僱辦理。</li>
                            <li>依規定需參與教學助教研習會後，始得正式聘任資格。</li>
                            <li>各類資料繳交情況、行政協助完成度，將佔課程結束後遴選傑出教學助教評分之20%。</li>
                        </ol>
                    </div>
                </div>
                <div class="notice-wrapper mt-4 mb-0">
                    <div class="form-check form-check-lg">
                        <input class="form-check-input" type="checkbox" value="" id="checkDefault" />
                        <label class="form-check-label" for="checkDefault">
                            同意遵守上述規範
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-lg btn-light" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-lg btn-primary" id="startApplyBtn">開始申請</button>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const startApplyBtn = document.getElementById('startApplyBtn');
    const checkDefault = document.getElementById('checkDefault');
    
    if (startApplyBtn && checkDefault) {
        startApplyBtn.addEventListener('click', function() {
            if (checkDefault.checked) {
                // 跳轉到課程申請步驟1頁面
                window.location.href = 'ca-step1.html';
            } else {
                // 提醒用戶需要同意規範
                alert('請先同意遵守上述規範才能開始申請');
            }
        });
    }
});
</script>
<% end %>

