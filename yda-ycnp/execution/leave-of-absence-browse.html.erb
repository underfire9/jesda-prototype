<!-- template: 執行 - 保留學籍申請 (瀏覽) -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="wrapper-inner">

            <%= render :partial => "/partials/execution_sidenav" %>
            
            <main class="main">
                <div class="content-title">
                    <h3>保留學籍申請</h3>
                </div>
                <div class="alert alert-danger mb-5" role="alert">
                    退件原因說明 <%= lorem_sentence %>
                </div>
                <div class="form-container">
                    <section class="form-section">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group form-group-output">
                                    <label class="form-label">已錄取之大專院校</label>
                                    <div class="output">國立臺灣體育運動大學</div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group form-group-output">
                                    <label class="form-label">已錄取之科系</label>
                                    <div class="output">運動資訊與傳播學系</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group form-group-output">
                                    <label class="form-label">日間部或夜間部</label>
                                    <div class="output">日間部</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group form-group-output">
                                    <label class="form-label">學校錄取相關證明上傳</label>
                                    <div class="output"><a href="#" download>上傳檔案名稱.pdf</a></div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group form-group-output mb-0">
                            <label class="form-label">備註說明</label>
                            <div class="output"><%= lorem_paragraphs(3) %></div>
                        </div>
                    </section>
                </div>
                <div class="form-action noborder mt-0">
                    <span class="backhome"><a href="home.html" class="btn btn-lg btn-back" title="回首頁"><i class="fas fa-long-arrow-alt-left"></i></a></span>
                </div>
            </main>
        </div>
    </div>
</div>



<% content_for :js do %>
<% end %>