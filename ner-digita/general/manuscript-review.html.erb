<!-- Review Timer -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const reviewTimingValue = document.querySelector('.review-timing-value-sec');
    const reviewSubmitBtn = document.querySelector('.btn-review-submit');
    const reviewStatusRadios = document.querySelectorAll('input[name="reviewStatus"]');
    const reviewStatus1 = document.getElementById('reviewStatus1'); // 審查中
    
    let reviewTimer;
    let reviewSeconds = 0;
    let isTimerRunning = false;
    
    // 啟動計時器
    function startReviewTimer() {
        if (isTimerRunning) return; // 防止重複啟動
        
        isTimerRunning = true;
        reviewTimer = setInterval(function() {
            reviewSeconds++;
            reviewTimingValue.textContent = reviewSeconds;
        }, 1000);
        
        console.log('審查計時器已啟動');
    }
    
    // 停止計時器
    function stopReviewTimer() {
        if (reviewTimer) {
            clearInterval(reviewTimer);
            isTimerRunning = false;
            console.log('審查計時器已停止，總計時間：' + reviewSeconds + ' 秒');
        }
    }
    
    // 啟用送出按鈕
    function enableSubmitButton() {
        reviewSubmitBtn.classList.remove('disabled');
        reviewSubmitBtn.removeAttribute('disabled');
        console.log('送出按鈕已啟用');
    }
    
    // 禁用送出按鈕
    function disableSubmitButton() {
        reviewSubmitBtn.classList.add('disabled');
        reviewSubmitBtn.setAttribute('disabled', 'disabled');
        console.log('送出按鈕已禁用');
    }
    
    // 監聽審查狀態變化
    reviewStatusRadios.forEach(function(radio) {
        radio.addEventListener('change', function() {
            if (this.checked) {
                if (this.id === 'reviewStatus1') {
                    // 選擇「審查中」時，禁用送出按鈕並繼續計時
                    disableSubmitButton();
                    if (!isTimerRunning) {
                        startReviewTimer();
                    }
                } else {
                    // 選擇其他狀態時，啟用送出按鈕並停止計時
                    stopReviewTimer();
                    enableSubmitButton();
                }
            }
        });
    });
    
    // 頁面載入時立即開始計時（因為預設選擇「審查中」）
    if (reviewStatus1 && reviewStatus1.checked) {
        startReviewTimer();
        disableSubmitButton();
    }
    
    // 在頁面卸載時清理計時器
    window.addEventListener('beforeunload', function() {
        stopReviewTimer();
    });
});
</script>


<!-- Mp3 Required -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // 監聽稿件類型選項變化
    var manuscriptTypeTape = document.getElementById('manuscriptTypeTape');
    var mp3FormGroup = document.querySelector('.form-group-mp3');
    var requiredStar = mp3FormGroup ? mp3FormGroup.querySelector('.required') : null;
    
    // 監聽所有稿件類型的變化
    var manuscriptTypeRadios = document.querySelectorAll('input[name="manuscriptTypeOptions"]');
    manuscriptTypeRadios.forEach(function(radio) {
        radio.addEventListener('change', function() {
            if (requiredStar) {
                if (manuscriptTypeTape && manuscriptTypeTape.checked) {
                    // 話帶被勾選時，顯示必填星號
                    requiredStar.classList.remove('d-none');
                } else {
                    // 其他選項被勾選時，隱藏必填星號
                    requiredStar.classList.add('d-none');
                }
            }
        });
    });

    // 監聽是否上傳官網選項變化
    var uploadOfficialYes = document.getElementById('uploadOfficialYes');
    var uploadOfficialNo = document.getElementById('uploadOfficialNo');
    
    // 取得需要控制必填星號的欄位
    var resourceLabel = document.querySelector('label[for="manuscript_resource"]');
    var categoryLabel = document.querySelector('label[for="manuscript_category"]');
    var releaseLabel = document.querySelector('label[for="manuscript_Release"]');
    
    var resourceRequired = resourceLabel ? resourceLabel.querySelector('.required') : null;
    var categoryRequired = categoryLabel ? categoryLabel.querySelector('.required') : null;
    var releaseRequired = releaseLabel ? releaseLabel.querySelector('.required') : null;
    
    // 監聽上傳官網選項的變化
    var uploadOfficialRadios = document.querySelectorAll('input[name="uploadOfficial"]');
    uploadOfficialRadios.forEach(function(radio) {
        radio.addEventListener('change', function() {
            if (uploadOfficialNo && uploadOfficialNo.checked) {
                // 選擇「否」時，隱藏必填星號
                if (resourceRequired) resourceRequired.classList.add('d-none');
                if (categoryRequired) categoryRequired.classList.add('d-none');
                if (releaseRequired) releaseRequired.classList.add('d-none');
            } else {
                // 選擇「是」時，顯示必填星號
                if (resourceRequired) resourceRequired.classList.remove('d-none');
                if (categoryRequired) categoryRequired.classList.remove('d-none');
                if (releaseRequired) releaseRequired.classList.remove('d-none');
            }
        });
    });
});
