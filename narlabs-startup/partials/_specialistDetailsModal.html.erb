<!-- Modal -->
<div class="modal fade" id="specialistDetailsModal" tabindex="-1" aria-labelledby="specialistDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="specialistDetailsModalLabel">專家詳細資訊</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row specialist-details">
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">姓名</label>
                            <div class="form-output"><%= zh_lorem_name %></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">英文姓名</label>
                            <div class="form-output"><%= lorem_name %></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">學校</label>
                            <div class="form-output"><%= lorem_words(6) %></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <div class="form-output"><%= lorem_email %></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">BaseQ</label>
                            <div class="form-output">10023</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">學校英文名</label>
                            <div class="form-output"><%= lorem_words(6) %></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">學校類型</label>
                            <div class="form-output">國內公立學校</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">學位</label>
                            <div class="form-output"><%= lorem_words(2) %></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">部門名稱</label>
                            <div class="form-output"><%= lorem_words(6) %></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">部門英文名稱</label>
                            <div class="form-output"><%= lorem_words(6) %></div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">現職單位</label>
                            <div class="form-output"><%= lorem_words(6) %></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">職稱</label>
                            <div class="form-output"><%= lorem_words(3) %></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">學門</label>
                            <div class="form-output"><%= lorem_words(6) %></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">研究領域</label>
                            <div class="form-output"><%= lorem_words(6) %></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">技術專長</label>
                            <div class="form-output"><%= lorem_words(5) %></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">期刊論文</label>
                            <div class="form-output"><%= lorem_words(5) %>, <%= lorem_words(4) %>, <%= lorem_words(6) %></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">曾執行過的產學合作計畫</label>
                            <div class="form-output"><%= lorem_words(3) %>, <%= lorem_words(4) %></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">工作地區碼</label>
                            <div class="form-output">基隆市</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>