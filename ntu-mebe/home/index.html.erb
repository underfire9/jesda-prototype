<% content_for :js do %>
<script src="../javascripts/gsap.min.js"></script>
<script src="../javascripts/ScrollTrigger.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function() {
    const landing = document.querySelector('.landing-content');
    if (!landing) return;

    const heroImg = landing.querySelector('.hero');
    if (!heroImg) return;

    const src = heroImg.getAttribute('src');
    if (!src) return;

    // 將 .hero 圖片設為背景並使用 cover
    landing.style.backgroundImage = "url('" + src + "')";
    landing.style.backgroundSize = "cover";
    landing.style.backgroundPosition = "center";
    landing.style.backgroundRepeat = "no-repeat";

    // 移除原本的 <img>
    heroImg.remove();

    // 設定 .home-content margin-top
    function setHomeContentMargin() {
        const homeContent = document.querySelector('.home-content');
        const header = document.querySelector('header') || document.querySelector('.header');
        
        if (homeContent) {
            const headerHeight = header ? header.offsetHeight : 0;
            const marginTop = window.innerHeight - headerHeight;
            homeContent.style.marginTop = marginTop + 'px';
        }
    }

    // 初始設定
    setHomeContentMargin();

    // 視窗縮放時重新計算
    window.addEventListener('resize', setHomeContentMargin);

    // 監聽捲動事件，當滾動到 .home-content 位置時移除 .header-sticky
    window.addEventListener('scroll', function() {
        const header = document.querySelector('header') || document.querySelector('.header');
        const homeContent = document.querySelector('.home-content');
        
        if (header && homeContent) {
            const scrollY = window.scrollY;
            const homeContentTop = homeContent.offsetTop;
            const headerHeight = header.offsetHeight;
            
            if (scrollY + headerHeight >= homeContentTop) {
                header.classList.remove('header-sticky');
            } else {
                header.classList.add('header-sticky');
            }
        }
    });
});
</script>

<% end %>

