<!-- template: 執行 - 成果報告 -->

<div class="container-lg">
    <div class="application-wrapper">
        <div class="wrapper-inner">
            
            <%= render :partial => "/partials/execution_sidenav" %>

            <main class="main">
                <div class="content-title" style="display: block;">
                    <h3>成果報告</h3>
                </div>
                <div class="alert alert-warning mb-4" role="alert">
                    退件原因說明 <%= lorem_sentence %>
                </div>
                <form action="home.html" method="post" enctype="multipart/form-data">
                    <div class="documents-upload-container final-upload-container">
                        <div class="documents-upload-item">
                            <div class="upload-info">
                                <%= zh_lorem_paragraphs(3) %>
                                <div class="template-wrap">
                                    <a href="#" class="btn btn-rounded btn-light" download>
                                        <i class="far fa-arrow-alt-circle-down"></i> 下載成果報告範本
                                    </a>
                                </div>
                            </div>
                            <div class="upload-wrapper">
                                <div class="drag-and-drop" role="button" tabindex="0" aria-label="上傳成果報告" data-upload-zone>
                                    <div class="file-input-wrapper">
                                        <input class="form-control" type="file" id="finalReportFile" name="finalReportFile" data-file-input hidden>
                                        <p class="note">拖曳檔案到此處，或點擊選擇檔案</p>
                                    </div>
                                </div>
                                <div class="item-file-wrapper" data-file-list></div>
                            </div>
                        </div>
                    </div>
                    <div class="form-action">
                        <button type="submit" class="btn btn-lg btn-rounded btn-main px-5">送出</button>
                    </div>
                </form>
            </main>
        </div>
    </div>
</div>



<% content_for :js do %>
<!-- 拖曳檔案上傳 -->
<script>
    (function () {
        const reportUploadItems = document.querySelectorAll('.documents-upload-item');

        reportUploadItems.forEach(function (item) {
            const reportUploadZone = item.querySelector('[data-upload-zone]');
            const reportFileInput = item.querySelector('[data-file-input]');
            const reportFileList = item.querySelector('[data-file-list]');

            if (!reportUploadZone || !reportFileInput || !reportFileList) return;

            const renderFile = function (file) {
                reportFileList.innerHTML = '';

                if (!file) return;

                const fileItem = document.createElement('div');
                fileItem.className = 'item-file';

                const fileName = document.createElement('span');
                fileName.className = 'file-name';
                fileName.textContent = file.name;

                const removeButton = document.createElement('button');
                removeButton.type = 'button';
                removeButton.className = 'btn btn-sm btn-danger';
                removeButton.title = '刪除檔案';
                removeButton.setAttribute('aria-label', '刪除檔案');
                removeButton.innerHTML = '<i class="far fa-trash-alt"></i>';

                removeButton.addEventListener('click', function () {
                    reportFileInput.value = '';
                    reportFileList.innerHTML = '';
                });

                fileItem.appendChild(fileName);
                fileItem.appendChild(removeButton);
                reportFileList.appendChild(fileItem);
            };

            const assignSingleFile = function (file) {
                if (!file) return;

                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);

                try {
                    reportFileInput.files = dataTransfer.files;
                } catch (error) {
                    reportFileInput.value = '';
                }

                renderFile(file);
            };

            reportUploadZone.addEventListener('click', function () {
                reportFileInput.click();
            });

            reportUploadZone.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    reportFileInput.click();
                }
            });

            reportUploadZone.addEventListener('dragenter', function (event) {
                event.preventDefault();
                reportUploadZone.classList.add('is-dragover');
            });

            reportUploadZone.addEventListener('dragover', function (event) {
                event.preventDefault();
                reportUploadZone.classList.add('is-dragover');
            });

            reportUploadZone.addEventListener('dragleave', function (event) {
                event.preventDefault();
                reportUploadZone.classList.remove('is-dragover');
            });

            reportUploadZone.addEventListener('drop', function (event) {
                event.preventDefault();
                reportUploadZone.classList.remove('is-dragover');

                const droppedFiles = event.dataTransfer ? event.dataTransfer.files : null;
                if (!droppedFiles || !droppedFiles.length) return;

                assignSingleFile(droppedFiles[0]);
            });

            reportFileInput.addEventListener('change', function () {
                if (!reportFileInput.files || !reportFileInput.files.length) {
                    renderFile(null);
                    return;
                }

                renderFile(reportFileInput.files[0]);
            });
        });
    })();
</script>
<% end %>