<% content_for :js do %>
<!-- 側欄選單控制 -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const asideResource = document.querySelector('.aside-resource');
    const mobileButton = document.querySelector('.btn-aside-resource');
    
    function handleOffcanvas() {
        if (window.innerWidth < 1199) {
            // 小於 1199px 時啟用 offcanvas
            asideResource.classList.add('offcanvas');
            if (mobileButton) {
                mobileButton.style.display = 'inline-block';
            }
        } else {
            // 大於等於 1199px 時移除 offcanvas
            asideResource.classList.remove('offcanvas');
            if (mobileButton) {
                mobileButton.style.display = 'none';
            }
            // 如果 offcanvas 是開啟狀態，關閉它
            const bsOffcanvas = bootstrap.Offcanvas.getInstance(asideResource);
            if (bsOffcanvas) {
                bsOffcanvas.hide();
            }
        }
    }
    
    // 初始化
    handleOffcanvas();
    
    // 監聽視窗大小變化
    window.addEventListener('resize', handleOffcanvas);
});
</script>
<% end %>

