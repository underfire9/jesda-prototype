<!-- template: 變更密碼 -->

<div class="container-lg">
	<div class="login-wrapper">
		<div class="login-card">
		    <div class="card-hd">
			    <h3>變更密碼</h3>
			</div>
			<div class="card-bd">
                <div class="form-group">
                    <label for="exampleFormControlInput1" class="form-label">信箱</label>
                    <input type="email" class="form-control" id="exampleFormControlInput1" value="abcdemail@gmail.com" disabled readonly>
                </div>
                <div class="form-group">
                    <label for="exampleFormControlInput2" class="form-label">密碼</label>
                    <input type="password" class="form-control" id="exampleFormControlInput2" />
