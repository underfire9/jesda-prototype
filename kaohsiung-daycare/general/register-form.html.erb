<!-- template: 登記報名 - 申請表 -->

<%= render :partial => "/partials/breadcrumb" %>

<div class="container-lg">
	<div class="page-content d-block">
        
        <!--div class="page-title">
            <h3>申請表</h3>
        </div-->
        
        <div class="step-wrapper">
            <div class="scrollbar-inner">
                <ul class="step-menu menu-item">
                    <li class="step-item current">
                        <span class="number">1</span>
                        <span class="description">申請表</span>
                    </li>
                    <li class="step-item">
                        <span class="number">2</span>
                        <span class="description">選擇托育機構</span>
                    </li>
                    <li class="step-item">
                        <span class="number">3</span>
                        <span class="description">選擇身分別</span>
                    </li>
                    <li class="step-item">
                        <span class="number">4</span>
                        <span class="description">上傳佐證資料</span>
                    </li>
                    <li class="step-item">
                        <span class="number">5</span>
                        <span class="description">送出申請</span>
                    </li>
                </ul>
            </div>
        </div>
        
        <div class="notice-wrapper">
            <p><%= lorem_paragraph %></p>
            <p><%= lorem_paragraph %></p>
        </div>
        
        <section class="section">
            <div class="section-title">
                <h4>幼兒</h4>
            </div>
            
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput01" class="form-label">幼兒姓名 <span class="required">*</span></label>
                        <input type="text" class="form-control" id="formInput01" />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput02" class="form-label">身分證字號 <span class="required">*</span></label>
                        <input type="text" class="form-control" id="formInput02" />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput03" class="form-label">生日 <span class="required">*</span></label>
                        <input type="date" class="form-control" id="formInput03" name="trip-start1" value="2016-01-01" min="2016-01-01" max="2024-12-31">
                    </div>
                </div>
            </div>
            
            <div class="form-group">
                <label class="form-label">幼兒於候補期間照顧情形 <span class="required">*</span></label>
                <div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="careSituation" id="careSituation1" />
                        <label class="form-check-label" for="careSituation1">
                            父母或監護人自行照顧
                        </label>
                    </div>
                    <div class="check-situation">
                        <label class="form-label">是否育嬰留職停薪</label>
                        <div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="careSuspension" id="careSuspensionYes" />
                                <label class="form-check-label" for="careSuspensionYes">
                                    是
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="careSuspension" id="careSuspensionNo" />
                                <label class="form-check-label" for="careSuspensionNo">
                                    否
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="careSituation" id="careSituation2" />
                        <label class="form-check-label" for="careSituation2">
                            祖父母
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="careSituation" id="careSituation3" />
                        <label class="form-check-label" for="careSituation3">
                            其他三等親內親屬
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="careSituation" id="careSituation4" />
                        <label class="form-check-label" for="careSituation4">
                            準公托
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="careSituation" id="careSituation5" />
                        <label class="form-check-label" for="careSituation5">
                            私托
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="careSituation" id="careSituation6" />
                        <label class="form-check-label" for="careSituation6">
                            保母
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="careSituation" id="careSituation7" />
                        <label class="form-check-label" for="careSituation7">
                            其他
                        </label>
                    </div>
                    <div class="check-situation check-other">
                        <input type="text" class="form-control" id="" placeholder="請輸入其他" />
                    </div>
                </div>
            </div>
            
            <div class="form-group">
                <label class="form-label">通訊地址 <span class="required">*</span></label>
                <div class="row">
                    <div class="col-sm-3">
                        <div class="mb-2">
                            <select class="form-select" aria-label="選擇縣市">
                                <option selected>請選擇縣市</option>
                                <option value="1">One</option>
                                <option value="2">Two</option>
                                <option value="3">Three</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="mb-2">
                            <select class="form-select" aria-label="選擇區域">
                                <option selected>請選擇區域</option>
                                <option value="1">One</option>
                                <option value="2">Two</option>
                                <option value="3">Three</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="mb-2">
                            <input type="text" class="form-control" id="" placeholder="請輸入地址" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput100" class="form-label">住家電話 (連絡電話)</label>
                        <input type="text" class="form-control" id="formInput100" />
                    </div>
                </div>
            </div>
        </section>
        
        <section class="section">
            <div class="section-title">
                <h4>申請人</h4>
            </div>
            
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput05" class="form-label">姓名 <span class="required">*</span></label>
                        <input type="text" class="form-control" id="formInput05" placeholder="請輸入"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput205" class="form-label">稱謂 <span class="required">*</span></label>
                        <input type="text" class="form-control" id="formInput205" placeholder="請輸入"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="" class="form-label">聯絡電話(手機)</label>
                        <input type="text" class="form-control" id="" placeholder="請輸入" />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput07" class="form-label">服務單位</label>
                        <input type="text" class="form-control" id="formInput07" placeholder="請輸入"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput08" class="form-label">職稱</label>
                        <input type="text" class="form-control" id="formInput08" placeholder="請輸入"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="" class="form-label">Email</label>
                        <input type="text" class="form-control" id="" value="<%= lorem_email %>" disabled readonly />
                    </div>
                </div>
            </div>
        </section>
        
        <section class="section">
            <div class="section-title">
                <h4>第二位聯絡人</h4>
            </div>
            
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput05" class="form-label">姓名 <span class="required">*</span></label>
                        <input type="text" class="form-control" id="formInput05" placeholder="請輸入"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput205" class="form-label">稱謂 <span class="required">*</span></label>
                        <input type="text" class="form-control" id="formInput205" placeholder="請輸入"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="" class="form-label">聯絡電話(手機)</label>
                        <input type="text" class="form-control" id="" placeholder="請輸入" />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput07" class="form-label">服務單位</label>
                        <input type="text" class="form-control" id="formInput07" placeholder="請輸入"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="formInput08" class="form-label">職稱</label>
                        <input type="text" class="form-control" id="formInput08" placeholder="請輸入"/>
                    </div>
                </div>
            </div>
        </section>
        
        <section class="section">
            <label class="form-label text-danger">本公托遵循個資保護法之相關條例，您的資料僅做為幼兒登記托育之使用，並依程序提報社會局做為比對依據</label>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="checkAgree" />
                <label class="form-check-label" for="checkAgree">
                    我同意
                </label>
            </div>
        </section>
        
        <div class="form-action">
            <button type="button" class="btn btn-lg btn-primary">儲存</button>
            <button type="button" class="btn btn-lg btn-light">下一步</button>
        </div>
        
	</div>
</div>

<!-- Modal -->
<div class="modal fade" id="attentionModal" tabindex="-1" aria-labelledby="attentionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="attentionModalLabel">注意事項</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><%= lorem_sentence %></p>
                <p><%= lorem_sentence %></p>
                <ol>
                    <% (1..6).map do |i| %>
                    <li><%= lorem_sentence %></li>
                    <% end %>
                </ol>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="applicantAttorney" tabindex="-1" aria-labelledby="applicantAttorneyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="applicantAttorneyModalLabel">上傳委託書</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input class="form-control" type="file" id="formFile" />
                </div>

                <!-- 檔案上傳後顯示，js 麻煩出程師協助 -->
                <div class="mb-3">
                    <button type="button" class="btn btn-rounded btn-danger" title="刪除檔案"><i class="fas fa-times"></i> 刪除檔案</button>
                </div>
                <a href="#">下載委託書範本</a>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="button" class="btn btn-primary">確定</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="secondAttorney" tabindex="-1" aria-labelledby="secondAttorneyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="secondAttorneyModalLabel">上傳委託書</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input class="form-control" type="file" id="formFile" />
                </div>

                <!-- 檔案上傳後顯示，js 麻煩出程師協助 -->
                <div class="mb-3">
                    <button type="button" class="btn btn-rounded btn-danger" title="刪除檔案"><i class="fas fa-times"></i> 刪除檔案</button>
                </div>
                <a href="#">下載委託書範本</a>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="button" class="btn btn-primary">確定</button>
            </div>
        </div>
    </div>
</div>


<% content_for :js do %>

<!-- mobile 視窗指定卷軸位置 -->
<script>
$(document).ready(function() {
    // 判斷是否為小視窗
    if ($(window).width() <= 768) {
        // 設定橫向卷軸到指定的 .current 元素位置
        var currentItem = $('.step-item.current');
        if (currentItem.length) {
            var scrollPosition = currentItem.position().left;
            $('.scrollbar-inner').scrollLeft(scrollPosition);
        }
    }
});
</script>
<% end %>










