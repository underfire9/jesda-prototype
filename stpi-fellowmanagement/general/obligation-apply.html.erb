<!-- 返國任職紀錄 Modal -->
<div class="modal fade" id="appointmentModal" tabindex="-1" aria-labelledby="appointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="appointmentModalLabel">返國任職紀錄</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body mb-0">
                <div class="row">
                    <div class="col-12">
                        <div class="mb-4">
                            <label for="companyName" class="form-label">任職機構</label>
                            <input type="text" class="form-control" id="companyName" placeholder="請輸入">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label for="departmentName" class="form-label">部門</label>
                            <input type="text" class="form-control" id="departmentName" placeholder="請輸入">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label for="titleName" class="form-label">職銜</label>
                            <input type="text" class="form-control" id="titleName" placeholder="請輸入">
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mb-4">
                            <label class="form-label">任職起訖日期</label>
                            <div class="d-flex">
                                <input type="date" class="form-control me-2" />
                                <span class="align-self-center">~</span>
                                <input type="date" class="form-control ms-2" />
                            </div>
                            <div class="mt-1 text-end">小計 <strong>35</strong> 日</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label for="employmentCertificate" class="form-label">在職證明</label>
                            <input type="file" class="form-control" id="employmentCertificate">
                            <div class="form-text text-muted">檔案格式 pdf、jpg、png、gif，最大 10MB</div>
                            <div class="file-pill d-inline-block mt-1">
                                <a href="#" target="_blank" class="filename"><%= lorem_words(10) %>.pdf</a>
                                <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label for="employmentDays" class="form-label">任職日數</label>
                            <input type="number" class="form-control" id="employmentDays" placeholder="請輸入">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary">送出</button>
            </div>
        </div>
    </div>
</div>

<!-- 公開演講授課紀錄 Modal -->
<div class="modal fade" id="speechModal" tabindex="-1" aria-labelledby="speechModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="speechModalLabel">公開演講授課紀錄</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body mb-0">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label for="speechTitle" class="form-label">演講題目</label>
                            <input type="text" class="form-control" id="speechTitle" placeholder="請輸入">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label for="location" class="form-label">地點</label>
                            <input type="text" class="form-control" id="location" placeholder="請輸入">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label for="videoUrl" class="form-label">影片網址</label>
                            <input type="text" class="form-control" id="videoUrl" placeholder="請輸入">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label for="speechDate" class="form-label">日期</label>
                            <input type="date" class="form-control" id="speechDate" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label for="speechCertificate" class="form-label">證明文件</label>
                            <input type="file" class="form-control" id="speechCertificate">
                            <div class="form-text text-muted">檔案格式 pdf、jpg、png、gif，最大 10MB</div>
                            <div class="file-pill d-inline-block mt-1">
                                <a href="#" target="_blank" class="filename"><%= lorem_words(10) %>.pdf</a>
                                <button type="button" class="btn btn-sm btn-rounded btn-dark" title="移除">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label for="speechHours" class="form-label">時數</label>
                            <input type="number" class="form-control" id="speechHours" placeholder="請輸入">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary">送出</button>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>
    <script>
    // 控制 obligation-list-wrap 內 .obligation-empty 顯示/隱藏
    $(document).ready(function() {
        $('.obligation-list-wrap').each(function() {
            var $wrap = $(this);
            var hasItem = $wrap.find('.obligation-item').length > 0;
            $wrap.find('.obligation-empty').toggle(!hasItem);
        });
    });
    </script>
<% end %>

