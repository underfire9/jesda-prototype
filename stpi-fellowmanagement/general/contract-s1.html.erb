<!-- template: 計畫合約簽章 - 填寫合約資料 -->

<div class="container-lg">

    <div class="step-wrapper">
        <ul class="step-menu menu-item">
            <li class="step-item current">
                <span class="number">1</span>
                <span class="description">填寫合約資料</span>
            </li>
            <li class="step-item">
                <span class="number">2</span>
                <span class="description">下載合約與上傳附件</span>
            </li>
            <li class="step-item">
                <span class="number">3</span>
                <span class="description">送出申請</span>
            </li>
        </ul>
    </div>

    <div class="notice-wrapper">
        <p><%= zh_lorem_paragraph %></p>
        <p><%= zh_lorem_paragraph %></p>
    </div>

    <div class="form-group">
        <label class="form-label fw-bold">合約繳交方式</label>
        <div class="form-check-wrapper">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="contractPayment" id="payment01" value="none">
                <label class="form-check-label" for="payment01">
                    實體文件簽署繳交，由後台上傳
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="contractPayment" id="payment02" value="male">
                <label class="form-check-label" for="payment02">
                    線上簽署上傳
                </label>
            </div>
        </div>
    </div>

    <section class="section">
        <div class="section-title">
            <h4>學員資料</h4>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="ex-input01" class="form-label">學員姓名</label>
                    <input type="text" class="form-control" id="ex-input01" value="王小明" disabled readonly>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="ex-input01" class="form-label">學員英文姓名</label>
                    <input type="text" class="form-control" id="ex-input01" value="Wang Xiao Ming" disabled readonly>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="ex-input07" class="form-label">身份證字號</label>
                    <input type="text" class="form-control" id="ex-input07" value="A123456789" disabled readonly>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="ex-input10" class="form-label">通訊地址</label>
                    <input type="text" class="form-control" id="ex-input10" value="台北市大安區復興南路一段390號" disabled readonly>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="ex-input41" class="form-label">匯款銀行名稱</label>
                    <input type="text" class="form-control" id="ex-input41" value="中國信託商業銀行" disabled readonly>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="ex-input42" class="form-label">匯款銀行代碼</label>
                    <input type="text" class="form-control" id="ex-input42" value="822" disabled readonly>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="ex-input43" class="form-label">匯款銀行分行名稱</label>
                    <input type="text" class="form-control" id="ex-input43" value="台北分行" disabled readonly>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="ex-input44" class="form-label">匯款銀行帳戶號碼</label>
                    <input type="text" class="form-control" id="ex-input44" value="123456789012" disabled readonly>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-title">
            <h4>保人1</h4>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor1-name" class="form-label">姓名</label>
                    <input type="text" class="form-control" id="guarantor1-name">
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor1-email" class="form-label">電子信箱</label>
                    <input type="email" class="form-control" id="guarantor1-email">
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor1-id" class="form-label">身份證字號</label>
                    <input type="text" class="form-control" id="guarantor1-id">
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-title">
            <h4>保人2</h4>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor2-name" class="form-label">姓名</label>
                    <input type="text" class="form-control" id="guarantor2-name">
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor2-email" class="form-label">電子信箱</label>
                    <input type="email" class="form-control" id="guarantor2-email">
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="guarantor2-id" class="form-label">身份證字號</label>
                    <input type="text" class="form-control" id="guarantor2-id">
                </div>
            </div>
        </div>
    </section>

    <div class="form-action">
        <button type="button" class="btn btn-lg btn-outline-primary">暫存</button>
        <button type="submit" class="btn btn-lg btn-primary">下一步</button>
    </div>

</div>



<% content_for :js do %>

<% end %>

