<!-- template: Coming soon -->

<div class="container-lg">
    <div class="lego-container">

        <!-- source: https://codepen.io/chrisgannon/pen/yXmbMg -->
        <div id="animationWindow" class="lego-window"></div>
        <div class="copywriting"><h3>功能尚未開放</h3></div>
    </div>
</div>

<% content_for :js do %>
<script src="../javascripts/bodymovin.min.js"></script>
<script>
    var animData = {
        wrapper: document.querySelector("#animationWindow"),
        animType: "svg",
        loop: true,
        prerender: true,
        autoplay: true,
        path: "https://s3-us-west-2.amazonaws.com/s.cdpn.io/35984/LEGO_loader_chrisgannon.json",
    };
    var anim = bodymovin.loadAnimation(animData);
    anim.setSpeed(1);
</script>
<% end %>

