<!-- template: 教師 / 課程作業列表 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>課程作業</h3>
        </div>
        <div class="d-flex gap-2 mb-4">
            <a href="#" class="btn btn-lg btn-light px-3" title="回列表"><i class="fas fa-long-arrow-alt-left"></i></a>
            <a href="#" class="btn btn-lg btn-main px-4"><i class="fas fa-plus"></i> 新增</a>
        </div>
        <ol class="row g-5 courses-announcement-list assignment-list">
            <% (1..11).map do |i| %>
            <li class="col-md-6">
                <div class="inner-wrap">
                    <span class="num"></span>
                    <h5 class="fw-semibold mb-3"><%= zh_lorem_sentence %></h5>
                    <div class="mb-2">
                        <span class="d-block fs-6 text-muted">作業上傳期限</span>
                        <span class="d-block fw-medium">2026-05-0<%= i %> 12:00</span>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <span class="d-block fs-6 text-muted">已交人數</span>
                            <span class="d-block fw-bold">999</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="d-block fs-6 text-muted">未繳人數</span>
                            <span class="d-block fw-bold">999</span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between gap-2 border-top pt-3">
                        <div>
                            <button class="btn btn-outline-secondary">刪除</button>
                        </div>
                        <div>
                            <a href="#" class="btn btn-outline-dark">編輯</a>
                            <a href="#" class="btn btn-outline-dark">紀錄</a>
                        </div>
                    </div>
                </div>
            </li>
            <% end %>
        </ol>
    </div>
</div>



<% content_for :js do %>

    <!-- 列表編號 -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const announcementItems = document.querySelectorAll('.courses-announcement-list li');
        
        announcementItems.forEach((item, index) => {
            const numElement = item.querySelector('.num');
            if (numElement) {
                const number = (index + 1).toString().padStart(2, '0');
                numElement.textContent = number;
            }
        });
    });
    </script>
<% end %>

