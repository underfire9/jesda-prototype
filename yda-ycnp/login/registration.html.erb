<!-- template: 申請 - 註冊基本資料 -->

<div class="container-lg">
    <div class="alert alert-warning alert-registration" role="alert">您的身分證字號無法通過系統自動資格判斷，請填寫完整的註冊資料，提交後由本署審查，審查通過後即可完成註冊並登入系統，進行後續申請程序。感謝您的配合。</div>
	<div class="registration-wrapper">
        <h3 class="mb-5">註冊基本資料</h3>
		<div class="row">
		    <div class="col-sm-6 col-md-4">
                <div class="form-group">
                    <label for="exampleForm01" class="form-label">姓名</label>
                    <input type="text" class="form-control" id="exampleForm01" />
                </div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="form-group">
                    <label for="exampleForm02" class="form-label">身分證字號</label>
                    <input type="text" class="form-control" id="exampleForm02" />
                </div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="form-group">
                    <label for="exampleForm03" class="form-label">出生日期</label>
                    <input type="date" id="exampleForm03" class="form-control" name="born-start" value="2000-01-01" min="2000-01-01" max="2010-12-31" />
                </div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="form-group">
                    <label class="form-label">性別</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="gender" id="radioMale" value="option1" />
                            <label class="form-check-label" for="radioMale">男</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="gender" id="radioFemale" value="option2" />
                            <label class="form-check-label" for="radioFemale">女</label>
                        </div>
                    </div>
                </div>
            </div>
		</div>
        <div class="row">
		    <div class="col-md-6">
                <div class="form-group">
                    <label for="exampleForm04" class="form-label">註冊帳號</label>
                    <input type="email" class="form-control" id="exampleForm04" placeholder="email@example.com" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="exampleForm05" class="form-label">就讀學校</label>
                    <input type="text" class="form-control" id="exampleForm05" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">學校類型</label>
                    <select class="form-select" aria-label="Default select example">
                        <option selected>Open this select menu</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">學籍狀況</label>
                    <select class="form-select" aria-label="Default select example">
                        <option selected>Open this select menu</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="exampleForm06" class="form-label">在校最後註冊學年</label>
                    <input type="number" class="form-control" id="exampleForm06" min="100" max="200" value="114"/>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">在校最後註冊學期</label>
                    <select class="form-select" aria-label="Default select example">
                        <option selected>Open this select menu</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">在校最後年級</label>
                    <select class="form-select" aria-label="Default select example">
                        <option selected>Open this select menu</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">學制</label>
                    <select class="form-select" aria-label="Default select example">
                        <option selected>Open this select menu</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
            </div>
		</div>
        <div class="form-action">
            <button type="submit" class="btn btn-lg btn-primary">送出申請</button>
        </div>
	</div>
</div>



<% content_for :js do %>

<% end %>

