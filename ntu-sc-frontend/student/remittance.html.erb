<!-- template: 學生 / 匯款帳號設定 -->

<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>匯款帳號設定</h3>
        </div>
        <div class="remittance-wrapper">
            <div class="form-group">
                <label class="form-label">戶名</label>
                <div class="fs-5">王小明</div>
            </div>
            <div class="form-group">
                <label class="form-label" for="bankCode">銀行代號</label>
                <div class="sorting-item">
                    <select class="form-select" id="bankCode" data-placeholder="請選擇">
                        <option></option>
                        <option>Reactive</option>
                        <option>Solution</option>
                        <option>Conglomeration</option>
                        <option>Algoritm</option>
                        <option>Holistic</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" for="branchCode">分行代號</label>
                <div class="sorting-item">
                    <select class="form-select" id="branchCode" data-placeholder="請選擇">
                        <option></option>
                        <option>Reactive</option>
                        <option>Solution</option>
                        <option>Conglomeration</option>
                        <option>Algoritm</option>
                        <option>Holistic</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" for="remittanceAccount">匯款帳戶</label>
                <input type="text" id="remittanceAccount" class="form-control" placeholder="請輸入">
            </div>
            <div class="form-action">
                <button type="button" class="btn btn-main btn-lg btn-save">儲存</button>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>
    <!-- Select2 -->
    <script src="../javascripts/select2.min.js"></script>
    <script>
    $( '#bankCode' ).select2( {
        theme: "bootstrap-5",
        width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
        placeholder: $( this ).data( 'placeholder' ),
    } );
    $( '#branchCode' ).select2( {
        theme: "bootstrap-5",
        width: $( this ).data( 'width' ) ? $( this ).data( 'width' ) : $( this ).hasClass( 'w-100' ) ? '100%' : 'style',
        placeholder: $( this ).data( 'placeholder' ),
    } );
    </script>
<% end %>

