<!-- template: 技術提供者 - 檢視洽詢內容 -->

<!-- 產學媒合所有頁面都沒有 breadcrumb 麵包屑 -->

<div class="container-fixed">
    <div class="matchmaking-container commercial-container">
        <div class="page-title">
            <h2>商化技術洽詢表</h2>
        </div>

        <%= render :partial => "/partials/inquiry-form" %>

        <div class="page-title pt-5">
            <h2>技術提供者回覆洽詢</h2>
        </div>
        
        <div class="mb-5">

            <!-- 若修改 radio id 請調整下方開關合作方式區塊的 js -->
            <div class="form-check form-switch switch-lg">
                <input class="form-check-input" type="checkbox" role="switch" id="providerInquiryYes" checked>
                <label class="form-check-label" for="providerInquiryYes">同意洽詢</label>
            </div>
        </div>

        <div class="cooperation-methods">
            <div class="form-section">
                <div class="form-group">
                    <div class="form-section-title">
                        <h4>合作方式</h4>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="inlineCheckbox51" value="option1" />
                        <label class="form-check-label" for="inlineCheckbox51">技術移轉</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="inlineCheckbox52" value="option2" />
                        <label class="form-check-label" for="inlineCheckbox52">技術授權</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="inlineCheckbox53" value="option3" />
                        <label class="form-check-label" for="inlineCheckbox53">共同創業</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="inlineCheckbox54" value="option4" />
                        <label class="form-check-label" for="inlineCheckbox54">合作研發</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="inlineCheckbox55" value="option5" />
                        <label class="form-check-label" for="inlineCheckbox55">其他</label>
                    </div>
                    <div class="d-inline-block">
                        <input type="text" class="form-control" id="otherCooperationMethod" placeholder="請輸入">
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="efci020" class="form-label">主要應用領域</label>
                            <input type="text" class="form-control" id="efci020">
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="efci021" class="form-label">技術應用方式</label>
                            <input type="text" class="form-control" id="efci021">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-action">
            <a href="provider-inquiry.html" class="turnback turnback-orange">
                <svg width="72" height="48" viewBox="0 0 72 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.99951 24H64" stroke="#CEDADA" stroke-linecap="round"></path>
                <path d="M13 29.5L7.99951 24L13 18.5" stroke="#f0851c" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>取消回列表</span>
            </a>
            <button type="submit" class="btn btn-lg btn-main px-4">送出申請</button>
        </div>
    </div>
</div>



<% content_for :js do %>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const applicationSelect = document.querySelector('.select-application');
        const companyApplication = document.querySelector('.company-application');
        const personalApplication = document.querySelector('.personal-application');
        const companySelect = document.querySelector('.select-application-company');
        const providerInquiryYes = document.getElementById('providerInquiryYes');
        const cooperationMethods = document.querySelector('.cooperation-methods');

        function toggleApplication() {
            if (applicationSelect.value === 'companyApplication') {
                companyApplication.style.display = 'block';
                personalApplication.style.display = 'none';
                companySelect.style.display = 'block';
            } else if (applicationSelect.value === 'personalApplication') {
                companyApplication.style.display = 'none';
                personalApplication.style.display = 'block';
                companySelect.style.display = 'none';
            }
        }

        function toggleCooperationMethods() {
            cooperationMethods.style.display = providerInquiryYes.checked ? 'block' : 'none';
        }

        // Initialize visibility on page load
        toggleApplication();
        toggleCooperationMethods();

        // Add event listeners for changes
        applicationSelect.addEventListener('change', toggleApplication);
        providerInquiryYes.addEventListener('change', toggleCooperationMethods);
    });
</script>
<% end %>

