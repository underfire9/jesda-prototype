<!-- template: 教師 / 成績圖表 -->
<div class="page-content">
    <div class="container-lg">
        <div class="page-title">
            <h3>成績圖表</h3>
        </div>
        <p>假圖表，工程師決定要用這套 Chart.js 還是 Webix 套件</p>
        <div class="row">
            <div class="col-lg-6">
                <div class="border rounded-3 p-4 mb-4">
                    <h4 class="mb-4">成績長條圖</h4>
                    <canvas id="barChart"></canvas>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="border rounded-3 p-4 mb-4">
                    <h4 class="mb-4">成績餅圖</h4>
                    <canvas id="pieChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // 成績資料
        const gradeLabels = ['A+', 'A', 'B', 'C', 'D', 'E', 'S'];
        const gradeData = [12, 19, 15, 8, 5, 3, 10]; // 範例資料
        
        // 長條圖
        const barCtx = document.getElementById('barChart').getContext('2d');
        const barChart = new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: gradeLabels,
                datasets: [{
                    label: '學生人數',
                    data: gradeData,
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.8)',
                        'rgba(54, 162, 235, 0.8)',
                        'rgba(255, 206, 86, 0.8)',
                        'rgba(75, 192, 192, 0.8)',
                        'rgba(153, 102, 255, 0.8)',
                        'rgba(255, 159, 64, 0.8)',
                        'rgba(201, 203, 207, 0.8)'
                    ],
                    borderColor: [
                        'rgba(255, 99, 132, 1)',
                        'rgba(54, 162, 235, 1)',
                        'rgba(255, 206, 86, 1)',
                        'rgba(75, 192, 192, 1)',
                        'rgba(153, 102, 255, 1)',
                        'rgba(255, 159, 64, 1)',
                        'rgba(201, 203, 207, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
        
        // 餅圖
        const pieCtx = document.getElementById('pieChart').getContext('2d');
        const pieChart = new Chart(pieCtx, {
            type: 'doughnut',
            data: {
                labels: gradeLabels,
                datasets: [{
                    label: '學生人數',
                    data: gradeData,
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.8)',
                        'rgba(54, 162, 235, 0.8)',
                        'rgba(255, 206, 86, 0.8)',
                        'rgba(75, 192, 192, 0.8)',
                        'rgba(153, 102, 255, 0.8)',
                        'rgba(255, 159, 64, 0.8)',
                        'rgba(201, 203, 207, 0.8)'
                    ],
                    borderColor: [
                        'rgba(255, 99, 132, 1)',
                        'rgba(54, 162, 235, 1)',
                        'rgba(255, 206, 86, 1)',
                        'rgba(75, 192, 192, 1)',
                        'rgba(153, 102, 255, 1)',
                        'rgba(255, 159, 64, 1)',
                        'rgba(201, 203, 207, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'right'
                    }
                }
            }
        });
    });
    </script>
<% end %>

