<!-- template: 計畫主持人 - 計畫申請 -->
<% content_for :header_center do %>
    <span class="central-title manager-central-title">未來政策領導人才實習計畫-台瑞跨國智庫研究與公共政策人才培育</span>
<% end %>

<% content_for :header_dropdown do %>
    <%= render :partial => "/partials/manager_dropdown" %>
<% end %>

<div class="container">
    <div class="page-content">

        <!-- 多一個 manager-apply-container -->
        <div class="apply-container manager-apply-container">

            <!-- container-half -->
            <div class="container-half">
                <div class="section-mission">
                    <div class="section-hd">
                        <div class="application-title">受理申請補助計畫書</div>
                        <div class="date-range"><span class="text-nowrap">2026年01月01日 00:00</span> 至 <span class="text-nowrap">2026年08月31日 23:59</span></div>
                    </div>
                    <div class="section-bd">
                        <div class="mission-bundle">
                            <div class="item-mission completed">
                                <div class="item-status" title="已完成"></div>
                                <div class="item-end">
                                    <h5><a href="apply-plan-info.html">實習計畫基本資料</a></h5>
                                    <p class="brief">編輯實習計畫名稱、團員出國彙整資訊、團員清單資料</p>
                                </div>
                            </div>
                        </div>
                        <div class="mission-bundle">
                            <div class="item-mission unfinished">
                                <div class="item-status" title="未填寫"></div>
                                <div class="item-end">
                                    <h5><a href="apply-company.html">實習機構維護</a></h5>
                                    <p class="brief">填寫本計畫案之出國實習機構資料與上傳實習機構同意書</p>
                                </div>
                            </div>
                        </div>
                        <div class="mission-bundle">
                            <div class="item-mission danger">
                                <div class="item-status" title="警告"></div>
                                <div class="item-end">
                                    <div class="note-danger mb-2">學校應提出校內學生相關配合款，不得少於本部核定補助金額之百分之二十</div>
                                    <h5><a href="apply-student-list.html">計畫團員資料</a></h5>
                                    <p class="brief">編輯計畫團員名單與出國資料</p>
                                </div>
                            </div>
                        </div>
                        <div class="mission-bundle">
                            <div class="item-mission unnecessary">
                                <div class="item-status"></div>
                                <div class="item-end">
                                    <h5><a href="apply-plan-edit.html">填寫子計畫案內容</a></h5>
                                    <p class="brief">填寫本子計畫案內容</p>
                                </div>
                            </div>
                            <div class="item-mission unfinished">
                                <div class="item-status" title="未填寫"></div>
                                <div class="item-end">
                                    <p class="brief">(一) 計畫構想頁(需一千五百字至二千字摘要，包括赴新南向國家實習機構簡介、效益)</p>
                                </div>
                            </div>
                            <div class="item-mission unfinished">
                                <div class="item-status" title="未填寫"></div>
                                <div class="item-end">
                                    <p class="brief">(二) 實習機構考評輔導學生方式</p>
                                </div>
                            </div>
                            <div class="item-mission unfinished">
                                <div class="item-status" title="未填寫"></div>
                                <div class="item-end">
                                    <p class="brief">(三) 國外實習執行內容(含實習待遇、實習時數、預定取得簽證種類、保險範圍及期間等)，選送生辦理國外實習期間之醫療及意外保險，並應依當地國法令規定申請可於當地國境內從事實習之簽證及 符合當地國境內實習勞動條件，俾確保執行本計畫案之合法性</p>
                                </div>
                            </div>
                            <div class="item-mission unfinished">
                                <div class="item-status" title="未填寫"></div>
                                <div class="item-end">
                                    <p class="brief">(四) 計畫主持人與該機構合作時間</p>
                                </div>
                            </div>
                            <div class="item-mission unnecessary">
                                <div class="item-status"></div>
                                <div class="item-end">
                                    <p class="brief">(五) 計畫主持人過去三年執行學海築夢計畫報告【近三年內均未獲補助者得填無】</p>
                                    <div class="item-mission unfinished">
                                        <div class="item-status" title="未填寫"></div>
                                        <div class="item-end">
                                            <p class="brief">1. 過去三年計畫案執行成效相關媒體報導</p>
                                        </div>
                                    </div>
                                    <div class="item-mission unfinished">
                                        <div class="item-status" title="未填寫"></div>
                                        <div class="item-end">
                                            <p class="brief">2. 過去三年計畫案對參與學生之具體影響，特別在職業生涯部分</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 送件前 -->
                        <div class="mission-bundle">
                            <div class="text-center">
                                <button type="button" class="btn btn-lg btn-rounded btn-primary px-5">完成實習計畫資料填寫</button>
                            </div>
                        </div>

                        <!-- 送件後 -->
                        <div class="mission-bundle submitted">
                            <div class="text-center">
                                計畫書已送件
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
            <div class="container-half">
                <div class="section-mission">
                    <div class="section-hd">
                        <div class="application-title">維護計畫團員資料</div>
                        <div class="date-range"><span class="text-nowrap">2026年01月01日 00:00</span> 至 <span class="text-nowrap">2026年08月31日 23:59</span></div>
                    </div>
                    <div class="section-bd">
                        <div class="mission-bundle">
                            <div class="item-mission unfinished">
                                <div class="item-status" title="未上傳"></div>
                                <div class="item-end">
                                    <h5><a href="maintain-airfare-upload.html">實習機構提供機票證明文件上傳</a></h5>
                                    <div class="files-status">
                                        <span class="badge text-bg-dark">已上傳 1 件</span>
                                        <span class="badge text-bg-success">已通過 1 件</span>
                                        <span class="badge text-bg-secondary">未通過 0 件</span>
                                    </div>
                                    <div class="text-danger"><i class="fas fa-info-circle me-1"></i> 若實習機構有提供機票才需上傳</div>
                                    <p class="brief">經教育部審查確認後計畫團員對應機構之來回機票金額才可以輸入0元</p>
                                </div>
                            </div>
                        </div>
                        <div class="mission-bundle">
                            <div class="item-mission unnecessary">
                                <div class="item-status"></div>
                                <div class="item-end">
                                    <h5><a href="maintain-student-list.html">計畫團員資料維護</a></h5>
                                    <p class="brief">編輯計畫團員名單與出國資料</p>
                                </div>
                            </div>
                        </div>
                        <div class="mission-bundle">
                            <div class="item-mission unnecessary">
                                <div class="item-status"></div>
                                <div class="item-end">
                                    <h5><a href="maintain-company.html">實習機構檢視</a></h5>
                                    <p class="brief">檢視本計畫案之出國實習機構資料與實習機構同意書</p>
                                </div>
                            </div>
                        </div>
                        <div class="mission-bundle">
                            <div class="item-mission unfinished">
                                <div class="item-status" title="未上傳"></div>
                                <div class="item-end">
                                    <h5><a href="maintain-upload-report.html">計畫成果報告 PDF 上傳</a></h5>
                                    <p class="brief">上傳本子計畫案成果報告</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- demo only 套版請拿掉 -->
                <div class="mt-5">
                    <button type="button" class="btn btn-link" id="liveToastBtn">警告 toast demo</button>
                </div>
                
            </div>
        </div>
        <div class="form-action">
            <span class="backhome">
                <a href="dashboard.html" class="btn btn-lg btn-light">
                    <i class="fas fa-long-arrow-alt-left"></i>
                    <span class="md-none">回上一頁</span>
                </a>
            </span>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3">
    <div
        id="liveToast"
        class="toast align-items-center text-bg-danger border-0"
        role="alert"
        aria-live="assertive"
        aria-atomic="true"
    >
        <div class="toast-body">
            <div class="d-flex gap-4">
                <div class="ps-2 fs-5"><i class="fas fa-exclamation-triangle"></i></div>
                <div>
                    <h5 class="mb-0">錯誤</h5>
                    <p class="fs-6 mb-0 text-nowrap">承辦人完成經費請領後，始得維護資料</p>
                </div>
            </div>
        </div>
    </div>
</div>

<% content_for :js do %>
<!-- Bootstrap Toast -->
<script>
    const toastTrigger = document.getElementById('liveToastBtn')
    const toastLiveExample = document.getElementById('liveToast')

    if (toastTrigger) {
        toastTrigger.addEventListener('click', () => {
            const toast = new bootstrap.Toast(toastLiveExample, {
                autohide: true,
                delay: 8000
            })

            toast.show()
        })
    }
</script>
<% end %>

