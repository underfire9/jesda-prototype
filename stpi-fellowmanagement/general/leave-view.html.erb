<!-- template: 請假申請 - 檢視 -->

<div class="container-lg">
    <div class="leave-container-head">
        <h2 class="mb-0 fw-light">請假作業</h2>
    </div>
    <div class="request-form-wrapper">
        <div class="notice-wrapper">
            <p><%= zh_lorem_paragraph %></p>
        </div>
        <form action="#" method="post">
            <div class="form-group">
                <label class="form-label">請假日期</label>
                <div class="range-wrap">
                    <div class="date-inner"><span class="leave-form-output">2025-10-21</span></div>
                    <div class="text-center">至</div>
                    <div class="date-inner"><span class="leave-form-output">2025-10-22</span></div>
                </div>
                <div class="d-flex gap-3 form-text mt-2">
                    <span>共計：<strong>1</strong> 天</span>
                    <span>剩餘免扣款請假天數：<strong>3</strong> 天</span>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">請假類型</label>
                <span class="leave-form-output">自定義請假類型</span>
            </div>
            <div class="form-group">
                <label class="form-label">前往國家</label>
                <span class="leave-form-output">哥斯大黎加共和國</span>
            </div>
            <div class="form-group">
                <label for="leaveReason" class="form-label">請假原因</label>
                <textarea id="leaveReason" name="leaveReason" class="form-control" rows="3" readonly><%= zh_lorem_paragraph %></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">相關證明文件</label>
                <span class="leave-form-output"><a href="#" target="_blank" class="filename"><%= lorem_words(4) %>.pdf</a></span>
            </div>
            <div class="form-group">
                <label class="form-label">目前狀態</label>
                <h4 class="fw-semibold">審查中</h4>
                <p>審查意見<%= zh_lorem_paragraph %></p>
            </div>

            <!-- 以下按鈕正常尺寸不要給 btn-lg & 使用這裡的 wording -->
            <div class="form-action">
                <span class="backhome">
                    <a href="#" class="btn btn-link"><i class="fas fa-long-arrow-alt-left"></i> 返回</a>
                </span>
                <button type="submit" class="btn btn-outline-danger">撤回申請</button>
            </div>
        </form>
    </div>
</div>



<% content_for :js do %>

<% end %>

