<!-- template: 教師 / 停修審查列表 -->

<div class="page-content">
    <div class="container-lg">
        <div class="page-title mobile-only">
            <h3>停修審查</h3>
        </div>
        <div class="row">
            <div class="col-lg-3">
                <div class="mb-3">
                    <select class="form-select w-auto" aria-label="選擇年度">
                        <option selected>115</option>
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                    </select>
                </div>
                <div class="mb-3">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="學生姓名" aria-label="Recipient’s username" aria-describedby="button-addon2">
                        <button class="btn btn-outline-secondary" type="button" id="button-addon2"><i class="fas fa-search"></i></button>
                    </div>
                </div>
                <div class="mb-3">
                    <select class="form-select" aria-label="教師核定狀態">
                        <option selected>教師核定狀態</option>
                        <option value="1">AAAAA</option>
                        <option value="2">BBBBBBBBB</option>
                        <option value="3">未通過</option>
                    </select>
                </div>
                <p class="mb-5">blah blah blah <%= lorem_sentence %></p>
            </div>
            <div class="col-lg-9">
                <div class="row g-4">
                    <% (1..5).map do |i| %>
                    <div class="col-md-6">
                        <div class="border rounded-3 p-4">
                            <h5 class="mb-3">
                                <span class="d-inline-block me-2 text-muted">11300045</span>
                                <span class="d-inline-block fw-medium"><%= zh_lorem_name %></span>
                            </h5>
                            <p><%= zh_lorem_paragraph %></p>
                            <ul class="menu-item">
                                <li class="border-bottom py-2">
                                    <span class="d-block mb-1 fs-6 text-muted">就讀學系</span>
                                    <span class="d-block fw-bold"><%= zh_lorem_words(10) %></span>
                                </li>
                                <li class="border-bottom py-2">
                                    <span class="d-block mb-1 fs-6 text-muted">申請送出時間</span>
                                    <span class="d-block fw-bold">2025-07-23 16:21</span>
                                </li>
                                <li class="border-bottom py-2">
                                    <span class="d-block mb-1 fs-6 text-muted">教師審查狀態</span>
                                    <span class="d-block fw-bold">未核定</span>
                                </li>
                            </ul>
                            <div class="text-end mt-3">
                                <a href="#" class="btn btn-outline-dark">開啟審查</a>
                            </div>
                        </div>
                    </div>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</div>



<% content_for :js do %>

<% end %>

