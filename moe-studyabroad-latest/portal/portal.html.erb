<% content_for :js do %>
<!-- Cloud animation offset script -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const clouds = Array.from(document.querySelectorAll(".cloud-wrapper .cloud"));
        if (!clouds.length) return;

        const count = clouds.length;
        const slice = 1 / count;
        const fractions = Array.from({ length: count }, (_, i) => {
            const jitter = (Math.random() - 0.5) * slice;
            let value = i * slice + jitter;
            if (value < 0) value += 1;
            if (value > 1) value -= 1;
            return value;
        });

        for (let i = fractions.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [fractions[i], fractions[j]] = [fractions[j], fractions[i]];
        }

        clouds.forEach((cloud, index) => {
            const durationValue = getComputedStyle(cloud).animationDuration;
            const duration = parseFloat(durationValue);
            if (!duration || Number.isNaN(duration)) return;
            const offset = fractions[index] * duration;
            cloud.style.animationDelay = `-${offset}s`;
        });
    });
</script>
<% end %>

