                        </span>
                        <span class="ft-end">
                            <a href="#" class="btn btn-lg btn-main">
                                <span>開始申請</span>
                            </a>
                        </span>
                    </div>
                </div>
                <div class="section-card mb-4">
                    <h5>課程待補件</h5>
                    <div class="status-wrap">
                        <span class="wrap-label">待補件數</span>
                        <span class="wrap-status">1</span>
                    </div>
                    <div class="card-ft mt-4">
                        <span class="ft-start">
                            <a href="activation-apply.html" class="btn btn-dark">
                                <span>前往補件</span>
                            </a>
                        </span>
                    </div>
                </div>
