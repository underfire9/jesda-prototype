<!-- template: 托育機構一覽表 -->

<%= render :partial => "/partials/breadcrumb" %>

<div class="container-lg">
	<div class="page-content d-block">
        
        <div class="page-title">
            <h3>托育機構一覽表</h3>
        </div>
        
        <div class="area-select">
            <div class="select-wrap">
                <select class="form-select" aria-label="選擇區域">
                    <option selected>請選擇區域</option>
                    <option value="1">One</option>
                    <option value="2">Two</option>
                    <option value="3">Three</option>
                </select>
            </div>
            <div class="link-wrap"><a href="https://socmap.kcg.gov.tw/app32/" class="btn btn-outline-dark" target="_blank" title="地圖查詢"><i class="fas fa-map"></i> 地圖查詢</a></div>
        </div>
        
        
        <div class="institution-list-wrapper">
            <div class="cards-list">

                <% (1..9).map do |i| %>
                <div class="institution-card">
                    <div class="institution-photo">
                        <div class="offical-link">
                            <a href="#" class="" title="官方網站"><i class="fas fa-globe-asia"></i></a>
                            <a href="#" class="" title="Facebook"><i class="fab fa-facebook"></i></a>
                        </div>

                        <!-- 後台請提供 16:9 比例圖片裁切工具，尺寸 800 x 450 -->
                        <img src="https://placehold.jp/ddddd<%= i %>/7777<%= i %>7/800x450.png" alt="..." />
                    </div>
                    <h4 class="institution-name">高雄市鳳山自強公共托嬰中心</h4>
                    <div class="institution-content">
                        
                        <ul class="menu-item menu-detail">
                            <li>
                                <span class="label">委辦</span>
                                <span class="output">財團法人靖娟兒童安全文教基金會</span>
                            </li>
                            <li>
                                <span class="label">地址</span>
                                <span class="output">高雄市左營區自由三路478號</span>
                            </li>
                            <li>
                                <span class="label">電話</span>
                                <span class="output">07-3593855</span>
                            </li>
                            <li>
                                <span class="label">評鑑</span>
                                <span class="output">優等</span>
                            </li>
                        </ul>
                        <div class="card-foot">
                            <a href="#" class="btn btn-primary btn-rounded fw-bold" title="招生簡章">招生簡章</a>
                            <a href="#" class="btn btn-light btn-rounded fw-bold" title="候補名單">候補名單</a>
                        </div>
                    </div>
                </div>
                <% end %>

            </div>
            
            <nav aria-label="...">
                <ul class="pagination justify-content-end">
                    <li class="page-item disabled">
                        <a class="page-link" title="{連結名稱}">上一頁</a>
                    </li>
                    <li class="page-item"><a class="page-link" href="#" title="{連結名稱}">1</a></li>
                    <li class="page-item active" aria-current="page">
                        <a class="page-link" href="#" title="{連結名稱}">2</a>
                    </li>
                    <li class="page-item"><a class="page-link" href="#" title="{連結名稱}">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#" title="{連結名稱}">下一頁</a>
                    </li>
                </ul>
            </nav>
        </div>
        
	</div>
</div>

<% content_for :js do %>

<% end %>










