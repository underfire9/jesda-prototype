<!-- 欄位展示、隱藏 -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const specialTalentYes = document.getElementById('special_talent_yes');
        const specialTalentNo = document.getElementById('special_talent_no');
        const talentsSection = document.querySelector('.has-talents');

        const toggleTalentsSection = () => {
            if (!talentsSection) {
                return;
            }
            talentsSection.style.display = specialTalentYes && specialTalentYes.checked ? '' : 'none';
        };

        if (specialTalentYes) {
            specialTalentYes.addEventListener('change', toggleTalentsSection);
        }
        if (specialTalentNo) {
            specialTalentNo.addEventListener('change', toggleTalentsSection);
        }

        // 預設隱藏
        toggleTalentsSection();
    });
</script>

