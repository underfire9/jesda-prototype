<% content_for :title do %>Download Documents<% end %>
<% content_for :title_key do %>download.title<% end %>
<% content_for :page do %>download<% end %>
<% content_for :app_status do %>admitted<% end %>
<% content_for :portal_status do %>
<span class="chip chip--dot chip--ok" data-i18n="status.admitted">Admitted</span>
<p data-i18n="portal.arriving" data-i18n-vars='{"date":"2026-02-16"}'>Arriving 2026-02-16</p>
<% end %>

<div class="container">
  <header class="masthead">
    <p class="eyebrow" data-bi-en="2025 Graduate Visiting Research" data-bi-zh="2025 來校訪問研究生">2025 Graduate Visiting Research</p>
    <h1 class="masthead__title" data-i18n="download.title">Download Documents</h1>
    <p class="masthead__lead" data-i18n="download.lead">Print these documents and bring them on registration day.</p>
  </header>

  <div class="page-grid">
    <aside class="page-grid__aside">
      <%= render :partial => "/partials/portal_nav" %>
    </aside>

    <div class="page-grid__main">
      <section class="card" aria-labelledby="download-section-title">
        <div class="card__head">
          <h2 class="card__title" id="download-section-title" data-i18n="download.section">Documents</h2>
        </div>
        <!-- 註冊手續單版型不在切版範圍內，此處只提供下載列 -->
        <div class="download-list">
          <div class="download-row">
            <span class="download-row__type" aria-hidden="true">PDF</span>
            <div class="download-row__body">
              <p class="download-row__title" id="download-checklist" data-i18n="download.checklist">Registration checklist</p>
              <p class="download-row__meta">PDF · 210 KB · <span data-i18n="download.updated" data-i18n-vars='{"date":"2026-01-10"}'>Updated 2026-01-10</span></p>
            </div>
            <a class="btn" href="#" download aria-describedby="download-checklist" data-i18n="common.download">Download</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
